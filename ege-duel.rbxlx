{"id":"math_prof-239","group":"g_two_lines","number":12,"topic":"Графики функций","text":"На рисунке изображены графики двух линейных функций. На каждой прямой отмечены две точки с целыми координатами. Найдите абсциссу точки пересечения графиков.","answers":["12"],"points":1,"kind":"number","explanation":"Уравнения прямых: y = x - 3 и y = 0,5x + 3. Приравниваем и получаем x = 12.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",150.0,250.0,390.0,10.0,2],["line",10.0,170.0,330.0,10.0,1],["circle",150.0,250.0,3.5,2],["circle",390.0,10.0,3.5,2],["circle",50.0,150.0,3.5,2],["circle",330.0,10.0,3.5,2]]}},
{"id":"math_prof-240","group":"g_parabola","number":12,"topic":"Графики функций","text":"На рисунке изображён график функции f(x) = ax² + bx + c. На графике отмечены вершина параболы и две соседние точки с целыми координатами. Найдите c.","answers":["17"],"points":1,"kind":"number","explanation":"Вершина параболы находится в точке (3; -1), a = 2: f(x) = 2x² - 12x + 17.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",234.0,20.4,236.0,34.4,2],["line",236.0,34.4,238.0,47.6,2],["line",238.0,47.6,240.0,60.0,2],["line",240.0,60.0,242.0,71.6,2],["line",242.0,71.6,244.0,82.4,2],["line",244.0,82.4,246.0,92.4,2],["line",246.0,92.4,248.0,101.6,2],["line",248.0,101.6,250.0,110.0,2],["line",250.0,110.0,252.0,117.6,2],["line",252.0,117.6,254.0,124.4,2],["line",254.0,124.4,256.0,130.4,2],["line",256.0,130.4,258.0,135.6,2],["line",258.0,135.6,260.0,140.0,2],["line",260.0,140.0,262.0,143.6,2],["line",262.0,143.6,264.0,146.4,2],["line",264.0,146.4,266.0,148.4,2],["line",266.0,148.4,268.0,149.6,2],["line",268.0,149.6,270.0,150.0,2],["line",270.0,150.0,272.0,149.6,2],["line",272.0,149.6,274.0,148.4,2],["line",274.0,148.4,276.0,146.4,2],["line",276.0,146.4,278.0,143.6,2],["line",278.0,143.6,280.0,140.0,2],["line",280.0,140.0,282.0,135.6,2],["line",282.0,135.6,284.0,130.4,2],["line",284.0,130.4,286.0,124.4,2],["line",286.0,124.4,288.0,117.6,2],["line",288.0,117.6,290.0,110.0,2],["line",290.0,110.0,292.0,101.6,2],["line",292.0,101.6,294.0,92.4,2],["line",294.0,92.4,296.0,82.4,2],["line",296.0,82.4,298.0,71.6,2],["line",298.0,71.6,300.0,60.0,2],["line",300.0,60.0,302.0,47.6,2],["line",302.0,47.6,304.0,34.4,2],["line",304.0,34.4,306.0,20.4,2],["circle",250.0,110.0,3.5,2],["circle",270.0,150.0,3.5,2],["circle",290.0,110.0,3.5,2]]}}
