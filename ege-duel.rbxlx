        <Item class="StringValue" referent="31">
          <Properties>
            <string name="Name">01</string>
            <string name="Value"><![CDATA[{"subject": "history", "tasks": [
{"id":"history-001","group":"даты: Древняя Русь","text":"В каком году произошло Крещение Руси?","answers":["988"],"points":1,"kind":"number","explanation":"Князь Владимир крестил Русь в 988 году."},
{"id":"history-002","group":"даты: Древняя Русь","text":"В каком году состоялась Куликовская битва?","answers":["1380"],"points":1,"kind":"number","explanation":"Войско Дмитрия Донского победило Мамая в 1380 году."},
{"id":"history-003","group":"даты: Древняя Русь","text":"В каком году произошло Ледовое побоище?","answers":["1242"],"points":1,"kind":"number","explanation":"Александр Невский разбил рыцарей на Чудском озере в 1242 году."},
{"id":"history-004","group":"даты: Древняя Русь","text":"В каком году произошло стояние на реке Угре, положившее конец ордынской зависимости Руси?","answers":["1480"],"points":1,"kind":"number","explanation":"Стояние на Угре при Иване III произошло в 1480 году."},
{"id":"history-005","group":"даты: Московское царство","text":"В каком году Иван IV венчался на царство?","answers":["1547"],"points":1,"kind":"number","explanation":"Иван IV стал первым русским царём в 1547 году."},
{"id":"history-006","group":"даты: Московское царство","text":"В каком году войска Ивана IV взяли Казань?","answers":["1552"],"points":1,"kind":"number","explanation":"Казанское ханство было присоединено в 1552 году."},
{"id":"history-007","group":"даты: Московское царство","text":"В каком году Земский собор избрал на царство Михаила Романова?","answers":["1613"],"points":1,"kind":"number","explanation":"Династия Романовых началась в 1613 году."},
{"id":"history-008","group":"даты: Российская империя","text":"В каком году состоялась Полтавская битва?","answers":["1709"],"points":1,"kind":"number","explanation":"Пётр I разбил шведскую армию под Полтавой в 1709 году."},
{"id":"history-009","group":"даты: Российская империя","text":"В каком году был основан Санкт-Петербург?","answers":["1703"],"points":1,"kind":"number","explanation":"Город основан Петром I в 1703 году."},
{"id":"history-010","group":"даты: Российская империя","text":"В каком году был основан Московский университет?","answers":["1755"],"points":1,"kind":"number","explanation":"Университет основан в 1755 году по проекту Ломоносова и Шувалова."},
{"id":"history-011","group":"даты: Российская империя","text":"В каком году произошло Бородинское сражение?","answers":["1812"],"points":1,"kind":"number","explanation":"Сражение состоялось в ходе Отечественной войны 1812 года."},
{"id":"history-012","group":"даты: Российская империя","text":"В каком году произошло восстание декабристов на Сенатской площади?","answers":["1825"],"points":1,"kind":"number","explanation":"Восстание произошло 14 декабря 1825 года."},
{"id":"history-013","group":"даты: Российская империя","text":"В каком году в России было отменено крепостное право?","answers":["1861"],"points":1,"kind":"number","explanation":"Манифест Александра II подписан в 1861 году."},
{"id":"history-014","group":"даты: XX век","text":"В каком году началась Первая русская революция?","answers":["1905"],"points":1,"kind":"number","explanation":"Революция началась после событий 9 января 1905 года."},
{"id":"history-015","group":"даты: XX век","text":"В каком году был образован СССР?","answers":["1922"],"points":1,"kind":"number","explanation":"Договор об образовании СССР подписан в декабре 1922 года."},
{"id":"history-016","group":"даты: XX век","text":"В каком году началась Великая Отечественная война?","answers":["1941"],"points":1,"kind":"number","explanation":"Война началась 22 июня 1941 года."},
{"id":"history-017","group":"даты: XX век","text":"В каком году состоялся первый полёт человека в космос?","answers":["1961"],"points":1,"kind":"number","explanation":"Юрий Гагарин совершил полёт 12 апреля 1961 года."},
{"id":"history-018","group":"даты: XX век","text":"В каком году прекратил существование СССР?","answers":["1991"],"points":1,"kind":"number","explanation":"СССР распался в декабре 1991 года."},
{"id":"history-019","group":"личности","text":"Назовите имя князя, при котором произошло Крещение Руси.","answers":["Владимир"],"points":1,"kind":"exact","explanation":"Русь крестил князь Владимир Святославич."},
{"id":"history-020","group":"личности","text":"Кто командовал русской армией в Бородинском сражении? Запишите номер ответа.\n1) А. В. Суворов\n2) П. И. Багратион\n3) М. И. Кутузов\n4) М. Б. Барклай де Толли","answers":["3"],"points":1,"kind":"exact","explanation":"Главнокомандующим был М. И. Кутузов."},
{"id":"history-021","group":"личности","text":"Кто стал первым российским императором? Запишите номер ответа.\n1) Пётр I\n2) Иван IV\n3) Павел I\n4) Александр I","answers":["1"],"points":1,"kind":"exact","explanation":"Пётр I принял титул императора в 1721 году."},
{"id":"history-022","group":"личности","text":"Кто был первым Президентом России? Запишите номер ответа.\n1) М. С. Горбачёв\n2) В. В. Путин\n3) Н. С. Хрущёв\n4) Б. Н. Ельцин","answers":["4"],"points":1,"kind":"exact","explanation":"Б. Н. Ельцин избран в 1991 году. М. С. Горбачёв был президентом СССР."},
{"id":"history-023","group":"хронология","text":"Расположите события в хронологическом порядке. Запишите цифры без пробелов.\n1) Куликовская битва\n2) Крещение Руси\n3) Полтавская битва\n4) Ледовое побоище","answers":["2413"],"points":1,"kind":"order","explanation":"988, 1242, 1380, 1709."},
{"id":"history-024","group":"хронология","text":"Расположите события в хронологическом порядке. Запишите цифры без пробелов.\n1) отмена крепостного права\n2) восстание декабристов\n3) Отечественная война с Наполеоном\n4) Крымская война","answers":["3241"],"points":1,"kind":"order","explanation":"1812, 1825, 1853-1856, 1861."},
{"id":"history-025","group":"хронология","text":"Расположите события в хронологическом порядке. Запишите цифры без пробелов.\n1) образование СССР\n2) Октябрьская революция\n3) начало Великой Отечественной войны\n4) полёт Ю. А. Гагарина в космос","answers":["2134"],"points":1,"kind":"order","explanation":"1917, 1922, 1941, 1961."},
{"id":"history-026","group":"соответствие","text":"Установите соответствие между событиями и правителями. Запишите три цифры в порядке событий А, Б, В.\n\nА) Северная война\nБ) опричнина\nВ) отмена крепостного права\n\n1) Иван IV\n2) Пётр I\n3) Александр II\n4) Екатерина II","answers":["213"],"points":2,"kind":"order","explanation":"Северная война шла при Петре I, опричнину ввёл Иван IV, крепостное право отменил Александр II."},
{"id":"history-027","group":"соответствие","text":"Установите соответствие между событиями и датами. Запишите три цифры в порядке событий А, Б, В.\n\nА) Сталинградская битва\nБ) Бородинское сражение\nВ) битва на реке Калке\n\n1) 1223 год\n2) 1812 год\n3) 1942-1943 годы\n4) 1709 год","answers":["321"],"points":2,"kind":"order","explanation":"Сталинградская битва 1942-1943, Бородино 1812, Калка 1223."},
{"id":"history-028","group":"термины","text":"Как называлась политика Ивана IV в 1565-1572 годах, при которой часть земель страны была выделена в особый царский удел?","answers":["опричнина"],"points":1,"kind":"exact","explanation":"Опричнина сопровождалась террором против бояр и разделом страны на опричнину и земщину."},
{"id":"history-029","group":"термины","text":"Как в Древней Руси назывался объезд князем подвластных земель для сбора дани?","answers":["полюдье"],"points":1,"kind":"exact","explanation":"Полюдье проходило зимой, князь с дружиной объезжал земли и собирал дань."},
{"id":"history-030","group":"века","text":"Какие из событий произошли в XVIII веке? Запишите номера без пробелов.\n1) Полтавская битва\n2) Куликовская битва\n3) основание Московского университета\n4) Бородинское сражение\n5) восстание под предводительством Е. И. Пугачёва","answers":["135"],"points":2,"kind":"set","explanation":"Полтава 1709, университет 1755, восстание Пугачёва 1773-1775. Куликовская битва была в XIV веке, Бородино в XIX."},
{"id":"history-031","group":"hist_date","text":"В каком году закончилась Великая Отечественная война?","answers":["1945"],"points":1,"kind":"number","explanation":"Это произошло в 1945 году."},
{"id":"history-032","group":"hist_date","text":"В каком году началось правление Александра I?","answers":["1801"],"points":1,"kind":"number","explanation":"Это произошло в 1801 году."},
{"id":"history-033","group":"hist_date","text":"В каком году началась Крымская война?","answers":["1853"],"points":1,"kind":"number","explanation":"Это произошло в 1853 году."},
{"id":"history-034","group":"hist_date","text":"В каком году была введена всеобщая воинская повинность?","answers":["1874"],"points":1,"kind":"number","explanation":"Это произошло в 1874 году."},
{"id":"history-035","group":"hist_date","text":"В каком году началось правление Екатерины II?","answers":["1762"],"points":1,"kind":"number","explanation":"Это произошло в 1762 году."},
{"id":"history-036","group":"hist_date","text":"В каком году князь Олег объединил Новгород и Киев?","answers":["882"],"points":1,"kind":"number","explanation":"Это произошло в 882 году."},
{"id":"history-037","group":"hist_date","text":"В каком году советские войска были введены в Афганистан?","answers":["1979"],"points":1,"kind":"number","explanation":"Это произошло в 1979 году."},
{"id":"history-038","group":"hist_date","text":"В каком году был созван первый Земский собор?","answers":["1549"],"points":1,"kind":"number","explanation":"Это произошло в 1549 году."},
{"id":"history-039","group":"hist_date","text":"В каком году был заключён Брестский мир?","answers":["1918"],"points":1,"kind":"number","explanation":"Это произошло в 1918 году."},
