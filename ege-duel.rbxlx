{"id":"math_base-058","group":"b3_price_graph","number":3,"topic":"Чтение графиков и диаграмм","text":"На рисунке жирными точками показана цена акции компании на момент закрытия биржевых торгов во все рабочие дни с 1 по 12 число месяца. По горизонтали указываются числа месяца, по вертикали цена акции в рублях. Определите по рисунку наименьшую цену акции за указанный период. Ответ дайте в рублях.","answers":["16"],"points":1,"kind":"number","explanation":"По рисунку получаем 16.","figure":{"w":420,"h":260,"items":[["line",46.0,228.0,46.0,20.0,0],["line",75.0,228.0,75.0,20.0,0],["text",75.0,241.0,"1","c"],["line",104.0,228.0,104.0,20.0,0],["text",104.0,241.0,"2","c"],["line",133.0,228.0,133.0,20.0,0],["text",133.0,241.0,"3","c"],["line",162.0,228.0,162.0,20.0,0],["text",162.0,241.0,"4","c"],["line",191.0,228.0,191.0,20.0,0],["text",191.0,241.0,"5","c"],["line",220.0,228.0,220.0,20.0,0],["text",220.0,241.0,"6","c"],["line",249.0,228.0,249.0,20.0,0],["text",249.0,241.0,"7","c"],["line",278.0,228.0,278.0,20.0,0],["text",278.0,241.0,"8","c"],["line",307.0,228.0,307.0,20.0,0],["text",307.0,241.0,"9","c"],["line",336.0,228.0,336.0,20.0,0],["text",336.0,241.0,"10","c"],["line",365.0,228.0,365.0,20.0,0],["text",365.0,241.0,"11","c"],["line",394.0,228.0,394.0,20.0,0],["text",394.0,241.0,"12","c"],["line",46.0,228.0,394.0,228.0,0],["line",46.0,215.0,394.0,215.0,0],["line",46.0,202.0,394.0,202.0,0],["text",38.0,202.0,"8","r"],["line",46.0,189.0,394.0,189.0,0],["line",46.0,176.0,394.0,176.0,0],["text",38.0,176.0,"16","r"],["line",46.0,163.0,394.0,163.0,0],["line",46.0,150.0,394.0,150.0,0],["text",38.0,150.0,"24","r"],["line",46.0,137.0,394.0,137.0,0],["line",46.0,124.0,394.0,124.0,0],["text",38.0,124.0,"32","r"],["line",46.0,111.0,394.0,111.0,0],["line",46.0,98.0,394.0,98.0,0],["text",38.0,98.0,"40","r"],["line",46.0,85.0,394.0,85.0,0],["line",46.0,72.0,394.0,72.0,0],["text",38.0,72.0,"48","r"],["line",46.0,59.0,394.0,59.0,0],["line",46.0,46.0,394.0,46.0,0],["text",38.0,46.0,"56"