{"id":"informatics-020","group":"fig_roads","number":1,"topic":"Анализ информационных моделей","text":"На рисунке показана схема дорог между пунктами А, Б, В, Г, Д, Е. Числа обозначают длины дорог в километрах. Найдите длину кратчайшего пути из пункта А в пункт Е.","answers":["16"],"points":1,"kind":"number","explanation":"Перебираем маршруты из А в Е и выбираем самый короткий: 16 км.","figure":{"w":420,"h":260,"items":[["line",40.0,130.0,150.0,45.0,1],["text",86.4,110.5,"8","c"],["line",40.0,130.0,150.0,215.0,1],["text",70.6,170.0,"7","c"],["line",150.0,45.0,280.0,45.0,1],["text",195.5,58.0,"1","c"],["line",150.0,215.0,280.0,215.0,1],["text",195.5,228.0,"2","c"],["line",280.0,45.0,385.0,130.0,1],["text",308.6,84.9,"7","c"],["line",280.0,215.0,385.0,130.0,1],["text",324.9,195.4,"8","c"],["line",150.0,45.0,150.0,215.0,1],["text",137.0,104.5,"1","c"],["line",280.0,45.0,280.0,215.0,1],["text",267.0,104.5,"8","c"],["line",150.0,215.0,280.0,45.0,1],["text",205.8,163.4,"9","c"],["circle",40.0,130.0,15.0,1],["text",40.0,130.0,"А","c"],["circle",150.0,45.0,15.0,1],["text",150.0,45.0,"Б","c"],["circle",150.0,215.0,15.0,1],["text",150.0,215.0,"В","c"],["circle",280.0,45.0,15.0,1],["text",280.0,45.0,"Г","c"],["circle",280.0,215.0,15.0,1],["text",280.0,215.0,"Д","c"],["circle",385.0,130.0,15.0,1],["text",385.0,130.0,"Е","c"]]}},
{"id":"informatics-021","group":"l_truth_table","number":2,"topic":"Таблицы истинности логических выражений","text":"Логическая функция F задаётся выражением (z → y) ∧ (y → w) ∧ (w → x). На рисунке приведён фрагмент таблицы истинности функции F, содержащий все наборы аргументов, при которых функция истинна. Определите, какому столбцу таблицы соответствует каждая из переменных w, x, y, z. В ответе запишите буквы w, x, y, z в том порядке, в котором идут соответствующие им столбцы, без пробелов и запятых.","answers":["zwxy"],"points":1,"kind":"exact","explanation":"Функция истинна на 5 наборах; сравнивая их со строками таблицы, получаем порядок столбцов zwxy.","figure":{"w":380,"h":212,"items":[["line",10.0,10.0,370.0,10.0,1],["line",10.0,42.0,370.0,42.0,0],["line",10.0,74.0,370.0,74.0,0],["line",10.0,106.0,370.0,106.0,0],["line",10.0,138.0,370.0,138.0,0],["line",10.0,170.0,370.0,170.0,0],["line",10.0,202.0,370.0,202.0,1],["line",10.0,10.0,10.0,202.0,1],["line",82.0,10.0,82.0,202.0,1],["line",154.0,10.0,154.0,202.0,0],["line",226.0,10.0,226.0,202.0,0],["line",298.0,10.0,298.0,202.0,0],["line",370.0,10.0,370.0,202.0,1],["text",46.0,26.0,"Перем. 1","c"],["text",118.0,26.0,"Перем. 2","c"],["text",190.0,26.0,"Перем. 3","c"],["text",262.0,26.0,"Перем. 4","c"],["text",334.0,26.0,"F","c"],["text",46.0,58.0,"1","c"],["text",118.0,58.0,"1","c"],["text",190.0,58.0,"1","c"],["text",262.0,58.0,"1","c"],["text",334.0,58.0,"1","c"],["text",46.0,90.0,"0","c"],["text",118.0,90.0,"1","c"],["text",190.0,90.0,"1","c"],["text",262.0,90.0,"0","c"],["text",334.0,90.0,"1","c"],["text",46.0,122.0,"0","c"],["text",118.0,122.0,"0","c"],["text",190.0,122.0,"0","c"],["text",262.0,122.0,"0","c"],["text",334.0,122.0,"1","c"],["text",46.0,154.0,"0","c"],["text",118.0,154.0,"0","c"],["text",190.0,154.0,"1","c"],["text",262.0,154.0,"0","c"],["text",334.0,154.0,"1","c"],["text",46.0,186.0,"0","c"],["text",118.0,186.0,"1","c"],["text",190.0,186.0,"1","c"],["text",262.0,186.0,"1","c"],["text",334.0,186.0,"1","c"]]}},
{"id":"informatics-022","group":"l_truth_table","number":2,"topic":"Таблицы истинности логических выражений","text":"Логическая функция F задаётся выражением ((z → y) ∧ x) ∨ ¬w. На рисунке приведён фрагмент таблицы истинности функции F, содержащий все наборы аргументов, при которых функция ложна. Определите, какому столбцу таблицы соответствует каждая из переменных w, x, y, z. В ответе запишите буквы w, x, y, z в том порядке, в котором идут соответствующие им столбцы, без пробелов и запятых.","answers":["zywx"],"points":1,"kind":"exact","explanation":"Функция ложна на 5 наборах; сравнивая их со строками таблицы, получаем порядок столбцов zywx.","figure":{"w":380,"h":212,"items":[["line",10.0,10.0,370.0,10.0,1],["line",10.0,42.0,370.0,42.0,0],["line",10.0,74.0,370.0,74.0,0],["line",10.0,106.0,370.0,106.0,0],["line",10.0,138.0,370.0,138.0,0],["line",10.0,170.0,370.0,170.0,0],["line",10.0,202.0,370.0,202.0,1],["line",10.0,10.0,10.0,202.0,1],["line",82.0,10.0,82.0,202.0,1],["line",154.0,10.0,154.0,202.0,0],["line",226.0,10.0,226.0,202.0,0],["line",298.0,10.0,298.0,202.0,0],["line",370.0,10.0,370.0,202.0,1],["text",46.0,26.0,"Перем. 1","c"],["text",118.0,26.0,"Перем. 2","c"],["text",190.0,26.0,"Перем. 3","c"],["text",262.0,26.0,"Перем. 4","c"],["text",334.0,26.0,"F","c"],["text",46.0,58.0,"0","c"],["text",118.0,58.0,"1","c"],["text",190.0,58.0,"1","c"],["text",262.0,58.0,"0","c"],["text",334.0,58.0,"0","c"],["text",46.0,90.0,"1","c"],["text",118.0,90.0,"0","c"],["text",190.0,90.0,"1","c"],["text",262.0,90.0,"0","c"],["text",334.0,90.0,"0","c"],["text",46.0,122.0,"1","c"],["text",118.0,122.0,"0","c"],["text",190.0,122.0,"1","c"],["text",262.0,122.0,"1","c"],["text",334.0,122.0,"0","c"],["text",46.0,154.0,"1","c"],["text",118.0,154.0,"1","c"],["text",190.0,154.0,"1","c"],["text",262.0,154.0,"0","c"],["text",334.0,154.0,"0","c"],["text",46.0,186.0,"0","c"],["text",118.0,186.0,"0","c"],["text",190.0,186.0,"1","c"],["text",262.0,186.0,"0","c"],["text",334.0,186.0,"0","c"]]}},
{"id":"informatics-023","group":"l_truth_table","number":2,"topic":"Таблицы истинности логических выражений","text":"Логическая функция F задаётся выражением ((x → z) ∧ w) ∨ ¬y. На рисунке приведён фрагмент таблицы истинности функции F, содержащий все наборы аргументов, при которых функция ложна. Определите, какому столбцу таблицы соответствует каждая из переменных w, x, y, z. В ответе запишите буквы w, x, y, z в том порядке, в котором идут соответствующие им столбцы, без пробелов и запятых.","answers":["wyxz"],"points":1,"kind":"exact","explanation":"Функция ложна на 5 наборах; сравнивая их со строками таблицы, получаем порядок столбцов wyxz.","figure":{"w":380,"h":212,"items":[["line",10.0,10.0,370.0,10.0,1],["line",10.0,42.0,370.0,42.0,0],["line",10.0,74.0,370.0,74.0,0],["line",10.0,106.0,370.0,106.0,0],["line",10.0,138.0,370.0,138.0,0],["line",10.0,170.0,370.0,170.0,0],["line",10.0,202.0,370.0,202.0,1],["line",10.0,10.0,10.0,202.0,1],["line",82.0,10.0,82.0,202.0,1],["line",154.0,10.0,154.0,202.0,0],["line",226.0,10.0,226.0,202.0,0],["line",298.0,10.0,298.0,202.0,0],["line",370.0,10.0,370.0,202.0,1],["text",46.0,26.0,"Перем. 1","c"],["text",118.0,26.0,"Перем. 2","c"],["text",190.0,26.0,"Перем. 3","c"],["text",262.0,26.0,"Перем. 4","c"],["text",334.0,26.0,"F","c"],["text",46.0,58.0,"1","c"],["text",118.0,58.0,"1","c"],["text",190.0,58.0,"1","c"],["text",262.0,58.0,"0","c"],["text",334.0,58.0,"0","c"],["text",46.0,90.0,"0","c"],["text",118.0,90.0,"1","c"],["text",190.0,90.0,"0","c"],["text",262.0,90.0,"1","c"],["text",334.0,90.0,"0","c"],["text",46.0,122.0,"0","c"],["text",118.0,122.0,"1","c"],["text",190.0,122.0,"1","c"],["text",262.0,122.0,"0","c"],["text",334.0,122.0,"0","c"],["text",46.0,154.0,"0","c"],["text",118.0,154.0,"1","c"],["text",190.0,154.0,"1","c"],["text",262.0,154.0,"1","c"],["text",334.0,154.0,"0","c"],["text",46.0,186.0,"0","c"],["text",118.0,186.0,"1","c"],["text",190.0,186.0,"0","c"],["text",262.0,186.0,"0","c"],["text",334.0,186.0,"0","c"]]}},
