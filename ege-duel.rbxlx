{"id":"geography-196","group":"fig_climate","text":"На рисунке показана климатическая диаграмма: линия с точками показывает среднюю температуру по месяцам, светлые столбики показывают количество осадков. По горизонтали указаны номера месяцев. Определите годовую амплитуду температур: разность между температурой самого тёплого и самого холодного месяца.","answers":["16"],"points":1,"kind":"number","explanation":"14 - (-2) = 16 °C.","figure":{"w":420,"h":260,"items":[["rect",53.0,191.0,15.0,45.0,0],["text",60.5,248.0,"1","c"],["rect",82.0,182.0,15.0,54.0,0],["text",89.5,248.0,"2","c"],["rect",111.0,218.0,15.0,18.0,0],["text",118.5,248.0,"3","c"],["rect",140.0,209.0,15.0,27.0,0],["text",147.5,248.0,"4","c"],["rect",169.0,200.0,15.0,36.0,0],["text",176.5,248.0,"5","c"],["rect",198.0,218.0,15.0,18.0,0],["text",205.5,248.0,"6","c"],["rect",227.0,146.0,15.0,90.0,0],["text",234.5,248.0,"7","c"],["rect",256.0,155.0,15.0,81.0,0],["text",263.5,248.0,"8","c"],["rect",285.0,218.0,15.0,18.0,0],["text",292.5,248.0,"9","c"],["rect",314.0,173.0,15.0,63.0,0],["text",321.5,248.0,"10","c"],["rect",343.0,155.0,15.0,81.0,0],["text",350.5,248.0,"11","c"],["rect",372.0,182.0,15.0,54.0,0],["text",379.5,248.0,"12","c"],["line",46.0,197.6,394.0,197.6,0],["text",40.0,197.6,"-24","r"],["line",46.0,184.0,394.0,184.0,0],["line",46.0,170.4,394.0,170.4,0],["text",40.0,170.4,"-16","r"],["line",46.0,156.8,394.0,156.8,0],["line",46.0,143.2,394.0,143.2,0],["text",40.0,143.2,"-8","r"],["line",46.0,129.6,394.0,129.6,0],["line",46.0,116.0,394.0,116.0,0],["text",40.0,116.0,"0","r"],["line",46.0,102.4,394.0,102.4,0],["line",46.0,88.8,394.0,88.8,0],["text",40.0,88.8,"8","r"],["line",46.0,75.2,394.0,75.2,0],["line",46.0,61.6,394.0,61.6,0],["text",40.0,61.6,"16","r"],["line",46.0,48.0,394.0,48.0,0],["line",46.0,34.4,394.0,34.4,0],["text",40.0,34.4,"24","r"],["line",46.0,20.8,394.0,20.8,0],["line",46.0,116.0,394.0,116.0,1],["line",46.0,14.0,46.0,236.0,1],["line",46.0,236.0,394.0,236.0,1],["line",60.5,122.8,89.5,