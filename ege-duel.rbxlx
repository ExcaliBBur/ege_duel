        <Item class="StringValue" referent="63">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "social", "tasks": [
{"id":"social-001","group":"конституция","text":"Что, согласно Конституции РФ, является высшей ценностью? Запишите номер ответа.\n1) государство\n2) собственность\n3) человек, его права и свободы\n4) закон","answers":["3"],"points":1,"kind":"exact","explanation":"Статья 2 Конституции РФ: человек, его права и свободы являются высшей ценностью."},
{"id":"social-002","group":"конституция","text":"На сколько лет избирается Президент РФ?","answers":["6"],"points":1,"kind":"number","explanation":"Срок полномочий Президента РФ составляет шесть лет."},
{"id":"social-003","group":"конституция","text":"На сколько лет избирается Государственная Дума?","answers":["5"],"points":1,"kind":"number","explanation":"Государственная Дума избирается на пять лет."},
{"id":"social-004","group":"конституция","text":"Сколько депутатов в Государственной Думе?","answers":["450"],"points":1,"kind":"number","explanation":"По Конституции РФ Государственная Дума состоит из 450 депутатов."},
{"id":"social-005","group":"конституция","text":"С какого возраста гражданин России может быть избран Президентом РФ?","answers":["35"],"points":1,"kind":"number","explanation":"Президентом может быть избран гражданин не моложе 35 лет."},
{"id":"social-006","group":"конституция","text":"Какой документ имеет высшую юридическую силу в России? Запишите одно слово.","answers":["конституция"],"points":1,"kind":"exact","explanation":"Конституция РФ имеет высшую юридическую силу и прямое действие."},
{"id":"social-007","group":"власть","text":"Какая ветвь власти принимает законы? Запишите номер ответа.\n1) исполнительная\n2) законодательная\n3) судебная","answers":["2"],"points":1,"kind":"exact","explanation":"Законы принимает законодательная власть, в России это Федеральное собрание."},
{"id":"social-008","group":"власть","text":"Кто является Верховным главнокомандующим Вооружёнными силами РФ? Запишите номер ответа.\n1) Президент РФ\n2) министр обороны\n3) Председатель Правительства\n4) председатель Совета Федерации","answers":["1"],"points":1,"kind":"exact","explanation":"По Конституции РФ это Президент."},
{"id":"social-009","group":"власть","text":"Какова форма государственного устройства России? Запишите номер ответа.\n1) унитарное государство\n2) конфедерация\n3) федерация","answers":["3"],"points":1,"kind":"exact","explanation":"Россия является федеративным государством."},
{"id":"social-010","group":"власть","text":"Как называется форма правления, при которой верховная власть передаётся по наследству? Запишите одно слово.","answers":["монархия"],"points":1,"kind":"exact","explanation":"При монархии власть принадлежит одному лицу и обычно наследуется."},
{"id":"social-011","group":"власть","text":"Установите соответствие между функциями и органами власти РФ. Запишите три цифры в порядке функций А, Б, В.\n\nА) принятие федеральных законов\nБ) осуществление правосудия\nВ) исполнение федерального бюджета\n\n1) Правительство РФ\n2) Федеральное собрание\n3) суды","answers":["231"],"points":2,"kind":"order","explanation":"Законы принимает Федеральное собрание, правосудие осуществляют суды, бюджет исполняет Правительство."},
{"id":"social-012","group":"право","text":"С какого возраста наступает полная гражданская дееспособность по общему правилу?","answers":["18"],"points":1,"kind":"number","explanation":"Полная дееспособность наступает с 18 лет."},
{"id":"social-013","group":"право","text":"С какого возраста по общему правилу наступает уголовная ответственность в России?","answers":["16"],"points":1,"kind":"number","explanation":"По общему правилу с 16 лет, за отдельные тяжкие преступления с 14 лет."},
{"id":"social-014","group":"право","text":"В каком возрасте гражданин России получает паспорт?","answers":["14"],"points":1,"kind":"number","explanation":"Паспорт гражданина РФ выдаётся в 14 лет."},
{"id":"social-015","group":"право","text":"С какого возраста гражданин России имеет право голосовать на выборах?","answers":["18"],"points":1,"kind":"number","explanation":"Активное избирательное право возникает с 18 лет."},
{"id":"social-016","group":"право","text":"С какого возраста по общему правилу допускается заключение трудового договора?","answers":["16"],"points":1,"kind":"number","explanation":"По Трудовому кодексу РФ общий возраст равен 16 годам."},
{"id":"social-017","group":"право","text":"Какая отрасль права регулирует имущественные и связанные с ними личные неимущественные отношения? Запишите номер ответа.\n1) уголовное право\n2) административное право\n3) трудовое право\n4) гражданское право","answers":["4"],"points":1,"kind":"exact","explanation":"Это предмет гражданского права."},
{"id":"social-018","group":"экономика","text":"Как называется устойчивое повышение общего уровня цен? Запишите одно слово.","answers":["инфляция"],"points":1,"kind":"exact","explanation":"Инфляция снижает покупательную способность денег."},
{"id":"social-019","group":"экономика","text":"Как называется рынок, на котором товар продаёт единственная фирма? Запишите одно слово.","answers":["монополия"],"points":1,"kind":"exact","explanation":"При монополии у продавца нет конкурентов."},
{"id":"social-020","group":"экономика","text":"Что из перечисленного относится к факторам производства? Запишите номера без пробелов.\n1) труд\n2) земля\n3) прибыль\n4) капитал\n5) налог","answers":["124"],"points":2,"kind":"set","explanation":"Факторы производства: труд, земля, капитал, предпринимательские способности. Прибыль это доход, налог это платёж государству."},
{"id":"social-021","group":"экономика","text":"Как при прочих равных условиях меняется величина спроса на товар, когда его цена растёт? Запишите номер ответа.\n1) увеличивается\n2) уменьшается\n3) не меняется","answers":["2"],"points":1,"kind":"exact","explanation":"Закон спроса: чем выше цена, тем меньше величина спроса."},
{"id":"social-022","group":"экономика","text":"Какой из налогов является прямым? Запишите номер ответа.\n1) налог на добавленную стоимость\n2) акциз\n3) налог на доходы физических лиц\n4) таможенная пошлина","answers":["3"],"points":1,"kind":"exact","explanation":"Прямой налог взимается непосредственно с дохода или имущества. НДС, акцизы и пошлины входят в цену товара, это косвенные налоги."},
{"id":"social-023","group":"экономика","text":"Как называется безработица, связанная с поиском нового места работы и ожиданием выхода на него? Запишите номер ответа.\n1) циклическая\n2) структурная\n3) сезонная\n4) фрикционная","answers":["4"],"points":1,"kind":"exact","explanation":"Фрикционная безработица кратковременна и возникает при смене работы."},
{"id":"social-024","group":"экономика","text":"Какая из функций принадлежит Центральному банку РФ? Запишите номер ответа.\n1) приём вкладов у населения\n2) эмиссия денег\n3) выдача ипотечных кредитов гражданам\n4) страхование имущества","answers":["2"],"points":1,"kind":"exact","explanation":"Только Центральный банк выпускает в обращение наличные деньги."},
{"id":"social-025","group":"общество","text":"Как называется переход человека из одной социальной группы в другую? Запишите номер ответа.\n1) социальная стратификация\n2) социализация\n3) социальная мобильность\n4) адаптация","answers":["3"],"points":1,"kind":"exact","explanation":"Социальная мобильность бывает вертикальной и горизонтальной."},
{"id":"social-026","group":"общество","text":"Как называется процесс усвоения человеком социальных норм и культурных ценностей общества? Запишите одно слово.","answers":["социализация"],"points":1,"kind":"exact","explanation":"Социализация продолжается всю жизнь."},
{"id":"social-027","group":"человек","text":"Какая из потребностей человека относится к биологическим? Запишите номер ответа.\n1) в общении\n2) в пище\n3) в самореализации\n4) в уважении","answers":["2"],"points":1,"kind":"exact","explanation":"Биологические потребности связаны с поддержанием жизни: пища, вода, сон."},
{"id":"social-028","group":"человек","text":"Что относится к формам чувственного познания? Запишите номера без пробелов.\n1) ощущение\n2) понятие\n3) восприятие\n4) суждение\n5) представление","answers":["135"],"points":2,"kind":"set","explanation":"Чувственное познание: ощущение, восприятие, представление. Понятие и суждение относятся к рациональному познанию."},
{"id":"social-029","group":"человек","text":"Что относится к формам рационального познания? Запишите номера без пробелов.\n1) ощущение\n2) понятие\n3) суждение\n4) восприятие\n5) умозаключение","answers":["235"],"points":2,"kind":"set","explanation":"Рациональное познание: понятие, суждение, умозаключение."},
{"id":"social-030","group":"экономика","text":"Как называется тип экономической системы, в которой основные решения о производстве принимает государство? Запишите номер ответа.\n1) традиционная\n2) рыночная\n3) командная","answers":["3"],"points":1,"kind":"exact","explanation":"В командной экономике государство планирует, что, как и для кого производить."},
{"id":"social-031","group":"soc_term","text":"Какой термин соответствует определению: «план доходов и расходов государства на год»? Запишите номер ответа.\n1) спрос\n2) государственный бюджет\n3) санкция\n4) референдум","answers":["2"],"points":1,"kind":"exact","explanation":"Это государственный бюджет."},
{"id":"social-032","group":"soc_term","text":"Какой термин соответствует определению: «всенародное голосование по важному вопросу»? Запишите номер ответа.\n1) этнос\n2) референдум\n3) социальная роль\n4) республика","answers":["2"],"points":1,"kind":"exact","explanation":"Это референдум."},
{"id":"social-033","group":"soc_term","text":"Что называют словом «республика»? Запишите номер ответа.\n1) усвоение человеком норм и ценностей общества\n2) желание и возможность продавцов продать товар по определённой цене\n3) всенародное голосование по важному вопросу\n4) форма правления, при которой высшие органы власти избираются на срок","answers":["4"],"points":1,"kind":"exact","explanation":"Республика: форма правления, при которой высшие органы власти избираются на срок."},
{"id":"social-034","group":"soc_term","text":"Какой термин соответствует определению: «переход человека из одной социальной группы в другую»? Запишите номер ответа.\n1) прибыль\n2) социализация\n3) социальная мобильность\n4) дееспособность","answers":["3"],"points":1,"kind":"exact","explanation":"Это социальная мобильность."},
{"id":"social-035","group":"soc_term","text":"Какой термин соответствует определению: «желание и возможность продавцов продать товар по определённой цене»? Запишите номер ответа.\n1) инфляция\n2) республика\n3) монархия\n4) предложение","answers":["4"],"points":1,"kind":"exact","explanation":"Это предложение."},
{"id":"social-036","group":"soc_term","text":"Какой термин соответствует определению: «устойчивое повышение общего уровня цен»? Запишите номер ответа.\n1) дефицит бюджета\n2) гражданство\n3) безработица\n4) инфляция","answers":["4"],"points":1,"kind":"exact","explanation":"Это инфляция."},
{"id":"social-037","group":"soc_term","text":"Какой термин соответствует определению: «способность иметь права и нести обязанности, возникающая с рождения»? Запишите номер ответа.\n1) правоспособность\n2) гражданство\n3) государственный бюджет\n4) санкция","answers":["1"],"points":1,"kind":"exact","explanation":"Это правоспособность."},
{"id":"social-038","group":"soc_term","text":"Что называют словом «социальная стратификация»? Запишите номер ответа.\n1) деление общества на слои по доходу, власти, образованию и престижу\n2) верховенство государственной власти внутри страны и её независимость вовне\n3) обязательный платёж граждан и фирм государству\n4) желание и возможность покупателей приобрести товар по определённой цене","answers":["1"],"points":1,"kind":"exact","explanation":"Социальная стратификация: деление общества на слои по доходу, власти, образованию и престижу."},
{"id":"social-039","group":"soc_term","text":"Какой термин соответствует определению: «нормы поведения, основанные на представлениях о добре и зле»? Запишите номер ответа.\n1) этнос\n2) государственный бюджет\n3) мораль\n4) республика","answers":["3"],"points":1,"kind":"exact","explanation":"Это мораль."},
{"id":"social-040","group":"soc_term","text":"Что называют словом «референдум»? Запишите номер ответа.\n1) всенародное голосование по важному вопросу\n2) желание и возможность покупателей приобрести товар по определённой цене\n3) обязательный платёж граждан и фирм государству\n4) рынок, на котором товар продаёт единственная фирма","answers":["1"],"points":1,"kind":"exact","explanation":"Референдум: всенародное голосование по важному вопросу."},
{"id":"social-041","group":"soc_term","text":"Что называют словом «конкуренция»? Запишите номер ответа.\n1) соперничество продавцов за покупателей\n2) устойчивая правовая связь человека с государством\n3) усвоение человеком норм и ценностей общества\n4) способность своими действиями приобретать права и нести обязанности","answers":["1"],"points":1,"kind":"exact","explanation":"Конкуренция: соперничество продавцов за покупателей."},
{"id":"social-042","group":"soc_term","text":"Какой термин соответствует определению: «виновное противоправное деяние, причиняющее вред обществу»? Запишите номер ответа.\n1) социальная мобильность\n2) предложение\n3) социальный статус\n4) правонарушение","answers":["4"],"points":1,"kind":"exact","explanation":"Это правонарушение."},
{"id":"social-043","group":"soc_term","text":"Что называют словом «дефицит бюджета»? Запишите номер ответа.\n1) всенародное голосование по важному вопросу\n2) положение человека в обществе\n3) деление общества на слои по доходу, власти, образованию и престижу\n4) превышение расходов государства над его доходами","answers":["4"],"points":1,"kind":"exact","explanation":"Дефицит бюджета: превышение расходов государства над его доходами."},
{"id":"social-044","group":"soc_term","text":"Какой термин соответствует определению: «исторически сложившаяся общность людей с общим языком и культурой»? Запишите номер ответа.\n1) этнос\n2) социальная мобильность\n3) прибыль\n4) спрос","answers":["1"],"points":1,"kind":"exact","explanation":"Это этнос."},
{"id":"social-045","group":"soc_term","text":"Что называют словом «санкция»? Запишите номер ответа.\n1) реакция общества на поведение человека: поощрение или наказание\n2) превышение расходов государства над его доходами\n3) переход человека из одной социальной группы в другую\n4) устойчивое повышение общего уровня цен","answers":["1"],"points":1,"kind":"exact","explanation":"Санкция: реакция общества на поведение человека: поощрение или наказание."},
{"id":"social-046","group":"soc_term","text":"Какой термин соответствует определению: «форма правления, при которой высшие органы власти избираются на срок»? Запишите номер ответа.\n1) прибыль\n2) предложение\n3) республика\n4) референдум","answers":["3"],"points":1,"kind":"exact","explanation":"Это республика."},
{"id":"social-047","group":"soc_term","text":"Что называют словом «налог»? Запишите номер ответа.\n1) усвоение человеком норм и ценностей общества\n2) положение человека в обществе\n3) разница между выручкой фирмы и её издержками\n4) обязательный платёж граждан и фирм государству","answers":["4"],"points":1,"kind":"exact","explanation":"Налог: обязательный платёж граждан и фирм государству."},
{"id":"social-048","group":"soc_term","text":"Что называют словом «дееспособность»? Запишите номер ответа.\n1) форма правления, при которой власть главы государства передаётся по наследству\n2) способность своими действиями приобретать права и нести обязанности\n3) план доходов и расходов государства на год\n4) реакция общества на поведение человека: поощрение или наказание","answers":["2"],"points":1,"kind":"exact","explanation":"Дееспособность: способность своими действиями приобретать права и нести обязанности."},
