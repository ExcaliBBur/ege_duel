{"id":"math_base-060","group":"b3_line_chart","number":3,"topic":"Чтение графиков и диаграмм","text":"На рисунке точками показана температура воздуха в полдень в течение 10 дней. По горизонтали указаны дни, по вертикали температура в градусах Цельсия. Определите наименьшую температуру за этот период.","answers":["8"],"points":1,"kind":"number","explanation":"Самая низкая точка графика соответствует 8 °C.","figure":{"w":420,"h":260,"items":[["line",46.0,228.0,46.0,20.0,0],["line",80.0,228.0,80.0,20.0,0],["text",80.0,241.0,"1","c"],["line",114.0,228.0,114.0,20.0,0],["text",114.0,241.0,"2","c"],["line",148.0,228.0,148.0,20.0,0],["text",148.0,241.0,"3","c"],["line",182.0,228.0,182.0,20.0,0],["text",182.0,241.0,"4","c"],["line",216.0,228.0,216.0,20.0,0],["text",216.0,241.0,"5","c"],["line",250.0,228.0,250.0,20.0,0],["text",250.0,241.0,"6","c"],["line",284.0,228.0,284.0,20.0,0],["text",284.0,241.0,"7","c"],["line",318.0,228.0,318.0,20.0,0],["text",318.0,241.0,"8","c"],["line",352.0,228.0,352.0,20.0,0],["text",352.0,241.0,"9","c"],["line",386.0,228.0,386.0,20.0,0],["text",386.0,241.0,"10","c"],["line",46.0,228.0,386.0,228.0,0],["line",46.0,215.0,386.0,215.0,0],["line",46.0,202.0,386.0,202.0,0],["text",38.0,202.0,"4","r"],["line",46.0,189.0,386.0,189.0,0],["line",46.0,176.0,386.0,176.0,0],["text",38.0,176.0,"8","r"],["line",46.0,163.0,386.0,163.0,0],["line",46.0,150.0,386.0,150.0,0],["text",38.0,150.0,"12","r"],["line",46.0,137.0,386.0,137.0,0],["line",46.0,124.0,386.0,124.0,0],["text",38.0,124.0,"16","r"],["line",46.0,111.0,386.0,111.0,0],["line",46.0,98.0,386.0,98.0,0],["text",38.0,98.0,"20","r"],["line",46.0,85.0,386.0,85.0,0],["line",46.0,72.0,386.0,72.0,0],["text",38.0,72.0,"24","r"],["line",46.0,59.0,386.0,59.0,0],["line",46.0,46.0,386.0,46.0,0],["text",38.0,46.0,"28","r"],["line",46.0,33.0,386.0,33.0,0],["line",46.0,20.0,386.0,20.0,0],["text",38.0,20.0,"32","r"],["line",46.0,228.0,399.6,228.0,1],["line",46.0,228.0,46.0,14.8,1],["text",38.0,241.0,"0","r"],["text",54.0,10.0,"°C","l"],["text",412.0,215.0,"день","r"],["line",80.0,176.0,114.0,124.0,2],["line",114.0,124.0,148.0,124.0,2],["line",148.0,124.0,182.0,176.0,2],["line",182.0,176.0,216.0,72.0,2],["line",216.0,72.0,250.0,59.0,2],["line",250.0,59.0,284.0,85.0,2],["line",284.0,85.0,318.0,137.0,2],["line",318.0,137.0,352.0,176.0,2],["line",352.0,176.0,386.0,124.0,2],["circle",80.0,176.0,3.5,2],["circle",114.0,124.0,3.5,2],["circle",148.0,124.0,3.5,2],["circle",182.0,176.0,3.5,2],["circle",216.0,72.0,3.5,2],["circle",250.0,59.0,3.5,2],["circle",284.0,85.0,3.5,2],["circle",318.0,137.0,3.5,2],["circle",352.0,176.0,3.5,2],["circle",386.0,124.0,3.5,2]]}},
{"id":"math_base-061","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Мощность постоянного тока (в ваттах) вычисляется по формуле P = I²R, где I это сила тока (в амперах), R это сопротивление (в омах). Пользуясь этой формулой, найдите R (в омах), если мощность составляет 40 Вт, а сила тока равна 2 А.","answers":["10"],"points":1,"kind":"number","explanation":"R = P : I² = 40 : 4 = 10."},
{"id":"math_base-062","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Площадь четырёхугольника можно вычислить по формуле S = d₁ · d₂ · sin α : 2, где d₁ и d₂ это длины диагоналей четырёхугольника, α это угол между диагоналями. Пользуясь этой формулой, найдите площадь S, если d₁ = 14, d₂ = 12, а sin α = 0,6.","answers":["50,4"],"points":1,"kind":"number","explanation":"S = 14 · 12 · 0,6 : 2 = 50,4."},
{"id":"math_base-063","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Мощность постоянного тока (в ваттах) вычисляется по формуле P = I²R, где I это сила тока (в амперах), R это сопротивление (в омах). Пользуясь этой формулой, найдите R (в омах), если мощность составляет 175 Вт, а сила тока равна 5 А.","answers":["7"],"points":1,"kind":"number","explanation":"R = P : I² = 175 : 25 = 7."},
{"id":"math_base-064","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Площадь четырёхугольника можно вычислить по формуле S = d₁ · d₂ · sin α : 2, где d₁ и d₂ это длины диагоналей четырёхугольника, α это угол между диагоналями. Пользуясь этой формулой, найдите площадь S, если d₁ = 12, d₂ = 16, а sin α = 0,8.","answers":["76,8"],"points":1,"kind":"number","explanation":"S = 12 · 16 · 0,8 : 2 = 76,8."},
{"id":"math_base-065","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Кинетическая энергия тела (в джоулях) вычисляется по формуле E = mv² : 2, где m это масса тела (в килограммах), а v это его скорость (в м/с). Пользуясь этой формулой, найдите E (в джоулях), если v = 7 м/с и m = 2 кг.","answers":["49"],"points":1,"kind":"number","explanation":"E = 2 · 7² : 2 = 49."},
{"id":"math_base-066","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Второй закон Ньютона можно записать в виде F = ma, где F это сила (в ньютонах), действующая на тело, m это его масса (в килограммах), a это ускорение (в м/с²). Пользуясь этой формулой, найдите m (в килограммах), если F = 200 Н и a = 10 м/с².","answers":["20"],"points":1,"kind":"number","explanation":"m = F : a = 200 : 10 = 20."},
{"id":"math_base-067","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Площадь треугольника вычисляется по формуле S = a · h : 2, где a это сторона треугольника, h это высота, проведённая к этой стороне. Пользуясь этой формулой, найдите сторону a, если площадь треугольника равна 48, а высота h равна 6.","answers":["16"],"points":1,"kind":"number","explanation":"a = 2S : h = 96 : 6 = 16."},
{"id":"math_base-068","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Центростремительное ускорение при движении по окружности (в м/с²) вычисляется по формуле a = ω²R, где ω это угловая скорость (в с⁻¹), R это радиус окружности (в метрах). Пользуясь этой формулой, найдите радиус R, если угловая скорость равна 2 с⁻¹, а центростремительное ускорение равно 24 м/с². Ответ дайте в метрах.","answers":["6"],"points":1,"kind":"number","explanation":"R = a : ω² = 24 : 4 = 6."},
{"id":"math_base-069","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Кинетическая энергия тела (в джоулях) вычисляется по формуле E = mv² : 2, где m это масса тела (в килограммах), а v это его скорость (в м/с). Пользуясь этой формулой, найдите E (в джоулях), если v = 5 м/с и m = 4 кг.","answers":["50"],"points":1,"kind":"number","explanation":"E = 4 · 5² : 2 = 50."},
{"id":"math_base-070","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Второй закон Ньютона можно записать в виде F = ma, где F это сила (в ньютонах), действующая на тело, m это его масса (в килограммах), a это ускорение (в м/с²). Пользуясь этой формулой, найдите m (в килограммах), если F = 133 Н и a = 7 м/с².","answers":["19"],"points":1,"kind":"number","explanation":"m = F : a = 133 : 7 = 19."},
{"id":"math_base-071","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Работа постоянного тока (в джоулях) вычисляется по формуле A = I²Rt, где I это сила тока (в амперах), R это сопротивление (в омах), t это время (в секундах). Пользуясь этой формулой, найдите A (в джоулях), если t = 6 с, I = 3 А и R = 10 Ом.","answers":["540"],"points":1,"kind":"number","explanation":"A = 3² · 10 · 6 = 540."},
{"id":"math_base-072","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Работа постоянного тока (в джоулях) вычисляется по формуле A = I²Rt, где I это сила тока (в амперах), R это сопротивление (в омах), t это время (в секундах). Пользуясь этой формулой, найдите A (в джоулях), если t = 6 с, I = 6 А и R = 3 Ом.","answers":["648"],"points":1,"kind":"number","explanation":"A = 6² · 3 · 6 = 648."},
{"id":"math_base-073","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Мощность постоянного тока (в ваттах) вычисляется по формуле P = I²R, где I это сила тока (в амперах), R это сопротивление (в омах). Пользуясь этой формулой, найдите R (в омах), если мощность составляет 56 Вт, а сила тока равна 2 А.","answers":["14"],"points":1,"kind":"number","explanation":"R = P : I² = 56 : 4 = 14."},
{"id":"math_base-074","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Мощность постоянного тока (в ваттах) вычисляется по формуле P = I²R, где I это сила тока (в амперах), R это сопротивление (в омах). Пользуясь этой формулой, найдите R (в омах), если мощность составляет 144 Вт, а сила тока равна 4 А.","answers":["9"],"points":1,"kind":"number","explanation":"R = P : I² = 144 : 16 = 9."},
{"id":"math_base-075","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Второй закон Ньютона можно записать в виде F = ma, где F это сила (в ньютонах), действующая на тело, m это его масса (в килограммах), a это ускорение (в м/с²). Пользуясь этой формулой, найдите m (в килограммах), если F = 140 Н и a = 7 м/с².","answers":["20"],"points":1,"kind":"number","explanation":"m = F : a = 140 : 7 = 20."},
{"id":"math_base-076","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Центростремительное ускорение при движении по окружности (в м/с²) вычисляется по формуле a = ω²R, где ω это угловая скорость (в с⁻¹), R это радиус окружности (в метрах). Пользуясь этой формулой, найдите радиус R, если угловая скорость равна 6 с⁻¹, а центростремительное ускорение равно 432 м/с². Ответ дайте в метрах.","answers":["12"],"points":1,"kind":"number","explanation":"R = a : ω² = 432 : 36 = 12."},
{"id":"math_base-077","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Площадь четырёхугольника можно вычислить по формуле S = d₁ · d₂ · sin α : 2, где d₁ и d₂ это длины диагоналей четырёхугольника, α это угол между диагоналями. Пользуясь этой формулой, найдите площадь S, если d₁ = 12, d₂ = 16, а sin α = 0,5.","answers":["48"],"points":1,"kind":"number","explanation":"S = 12 · 16 · 0,5 : 2 = 48."},
{"id":"math_base-078","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Чтобы перевести температуру из шкалы Цельсия в шкалу Фаренгейта, пользуются формулой tF = 1,8tC + 32, где tC это температура в градусах по шкале Цельсия, tF это температура в градусах по шкале Фаренгейта. Скольким градусам по шкале Фаренгейта соответствует 30 градусов по шкале Цельсия?","answers":["86"],"points":1,"kind":"number","explanation":"tF = 1,8 · (30) + 32 = 86."},
{"id":"math_base-079","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Площадь четырёхугольника можно вычислить по формуле S = d₁ · d₂ · sin α : 2, где d₁ и d₂ это длины диагоналей четырёхугольника, α это угол между диагоналями. Пользуясь этой формулой, найдите площадь S, если d₁ = 3, d₂ = 7, а sin α = 0,6.","answers":["6,3"],"points":1,"kind":"number","explanation":"S = 3 · 7 · 0,6 : 2 = 6,3."},
{"id":"math_base-080","group":"b4_formula","number":4,"topic":"Преобразования выражений","text":"Площадь четырёхугольника можно вычислить по формуле S = d₁ · d₂ · sin α : 2, где d₁ и d₂ это длины диагоналей четырёхугольника, α это угол между диагоналями. Пользуясь этой формулой, найдите площадь S, если d₁ = 14, d₂ = 4, а sin α = 0,5.","answers":["14"],"points":1,"kind":"number","explanation":"S = 14 · 4 · 0,5 : 2 = 14."},
{"id":"math_base-081","group":"b5_taxi","number":5,"topic":"Начала теории вероятностей","text":"В фирме такси в наличии 10 легковых автомобилей; 2 из них чёрные с жёлтыми надписями на боках, остальные жёлтые с чёрными надписями. Найдите вероятность того, что на случайный вызов приедет машина жёлтого цвета с чёрными надписями.","answers":["0,8"],"points":1,"kind":"number","explanation":"Жёлтых машин 8, вероятность равна 8 : 10 = 0,8."},
{"id":"math_base-082","group":"b5_pen","number":5,"topic":"Начала теории вероятностей","text":"Вероятность того, что новая шариковая ручка пишет плохо (или не пишет), равна 0,22. Покупатель в магазине выбирает один такой товар. Найдите вероятность того, что этого не произойдёт.","answers":["0,78"],"points":1,"kind":"number","explanation":"1 - 0,22 = 0,78."},
{"id":"math_base-083","group":"b5_topics","number":5,"topic":"Начала теории вероятностей","text":"На экзамене по геометрии школьник отвечает на один вопрос из списка экзаменационных вопросов. Вероятность того, что это вопрос по теме «Площадь», равна 0,33. Вероятность того, что это вопрос по теме «Параллелограмм», равна 0,25. Вопросов, которые одновременно относятся к этим двум темам, нет. Найдите вероятность того, что на экзамене школьнику достанется вопрос по одной из этих двух тем.","answers":["0,58"],"points":1,"kind":"number","explanation":"События несовместны: 0,33 + 0,25 = 0,58."},
{"id":"math_base-084","group":"pr_sportsmen","number":5,"topic":"Начала теории вероятностей","text":"В чемпионате по фигурному катанию участвуют 80 спортсменок: 5 из России, 14 из США, остальные из Китая. Порядок, в котором выступают спортсменки, определяется жребием. Найдите вероятность того, что спортсменка, выступающая первой, окажется из Китая.","answers":["0,7625"],"points":1,"kind":"number","explanation":"Из Китая выступает 61 спортсменок, вероятность равна 61 : 80 = 0,7625."},
{"id":"math_base-085","group":"pr_defect","number":5,"topic":"Начала теории вероятностей","text":"В среднем из 250 чайников, поступивших в продажу, 33 имеют дефект. Найдите вероятность того, что один случайно выбранный для контроля товар исправен.","answers":["0,868"],"points":1,"kind":"number","explanation":"Исправных 217, вероятность равна 217 : 250 = 0,868."},
