{"id":"geography-228","group":"fig_wind_rose","text":"На рисунке показана роза ветров за месяц. Расстояние между соседними окружностями соответствует одному дню. Ветер какого направления дул чаще всего? Запишите номер ответа.\n1) юго-западный\n2) северо-западный\n3) северо-восточный\n4) южный","answers":["1"],"points":1,"kind":"exact","explanation":"Дальше всего от центра точка на луче «ЮЗ»: это юго-западный ветер.","figure":{"w":420,"h":260,"items":[["circle",210.0,130.0,17.0,0],["circle",210.0,130.0,34.0,0],["circle",210.0,130.0,51.0,0],["circle",210.0,130.0,68.0,0],["circle",210.0,130.0,85.0,0],["circle",210.0,130.0,102.0,0],["line",210.0,130.0,210.0,28.0,0],["text",210.0,15.0,"С","c"],["line",210.0,130.0,282.1,57.9,0],["text",291.3,48.7,"СВ","c"],["line",210.0,130.0,312.0,130.0,0],["text",325.0,130.0,"В","c"],["line",210.0,130.0,282.1,202.1,0],["text",291.3,211.3,"ЮВ","c"],["line",210.0,130.0,210.0,232.0,0],["text",210.0,245.0,"Ю","c"],["line",210.0,130.0,137.9,202.1,0],["text",128.7,211.3,"ЮЗ","c"],["line",210.0,130.0,108.0,130.0,0],["text",95.0,130.0,"З","c"],["line",210.0,130.0,137.9,57.9,0],["text",128.7,48.7,"СЗ","c"],["line",210.0,96.0,246.1,93.9,2],["line",246.1,93.9,261.0,130.0,2],["line",261.0,130.0,234.0,154.0,2],["line",234.0,154.0,210.0,147.0,2],["line",210.0,147.0,137.9,202.1,2],["line",137.9,202.1,142.0,130.0,2],["line",142.0,130.0,186.0,106.0,2],["line",186.0,106.0,210.0,96.0,2],["circle",210.0,96.0,3.0,2],["circle",246.1,93.9,3.0,2],["circle",261.0,130.0,3.0,2],["circle",234.0,154.0,3.0,2],["circle",210.0,147.0,3.0,2],["circle",137.9,202.1,3.0,2],["circle",142.0,130.0,3.0,2],["circle",186.0,106.0,3.0,2]]}}
