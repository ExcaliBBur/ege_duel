{"id":"math_base-134","group":"b7_speed_intervals","number":7,"topic":"Анализ графиков и диаграмм","text":"На графике показано изменение температуры воздуха в течение 12 часов. По горизонтали указано время в часах, по вертикали температура в градусах Цельсия. Пользуясь графиком, поставьте в соответствие каждому интервалу времени характеристику изменения температуры на этом интервале. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) 0:00-3:00\nБ) 3:00-6:00\nВ) 6:00-9:00\nГ) 9:00-12:00\n\n1) температура падала быстрее всего\n2) температура росла медленнее всего\n3) температура падала медленнее всего\n4) температура росла быстрее всего","answers":["314</string>
          </Properties>
        </Item>
        <Item class="StringValue" referent="45">
          <Properties>
            <string name="Name">04</string>
            <string name="Value">2"],"points":1,"kind":"order","explanation":"Скорость изменения температуры видна по наклону отрезка графика: чем круче, тем быстрее.","figure":{"w":420,"h":260,"items":[["line",46.0,228.0,46.0,28.0,0],["line",74.0,228.0,74.0,28.0,0],["line",102.0,228.0,102.0,28.0,0],["line",130.0,228.0,130.0,28.0,0],["text",130.0,241.0,"3","c"],["line",158.0,228.0,158.0,28.0,0],["line",186.0,228.0,186.0,28.0,0],["line",214.0,228.0,214.0,28.0,0],["text",214.0,241.0,"6","c"],["line",242.0,228.0,242.0,28.0,0],["line",270.0,228.0,270.0,28.0,0],["line",298.0,228.0,298.0,28.0,0],["text",298.0,241.0,"9","c"],["line",326.0,228.0,326.0,28.0,0],["line",354.0,228.0,354.0,28.0,0],["line",382.0,228.0,382.0,28.0,0],["text",382.0,241.0,"12","c"],["line",46.0,228.0,382.0,228.0,0],["line",46.0,218.0,382.0,218.0,0],["line",46.0,208.0,382.0,208.0,0],["text",38.0,208.0,"2","r"],["line",46.0,198.0,382.0,198.0,0],["line",46.0,188.0,382.0,188.0,0],["text",38.0,188.0,"4","r"],["line",46.0,178.0,382.0,178.0,0],["line",46.0,168.0,382.0,168.0,0],["text",38.0,168.0,"6","r"],["line",46.0,158.0,382.0,158.0,0],["line",46.0,148.0,382.0,148.0,0],["text",38.0,148.0,"8","r"],["line",46.0,138.0,382.0,138.0,0],["line",46.0,128.0,382.0,128.0,0],["text",38.0,128.0,"10","r"],["line",46.0,118.0,382.0,118.0,0],["line",46.0,108.0,382.0,108.0,0],["text",38.0,108.0,"12","r"],["line",46.0,98.0,382.0,98.0,0],["line",46.0,88.0,382.0,88.0,0],["text",38.0,88.0,"14","r"],["line",46.0,78.0,382.0,78.0,0],["line",46.0,68.0,382.0,68.0,0],["text",38.0,68.0,"16","r"],["line",46.0,58.0,382.0,58.0,0],["line",46.0,48.0,382.0,48.0,0],["text",38.0,48.0,"18","r"],["line",46.0,38.0,382.0,38.0,0],["line",46.0,28.0,382.0,28.0,0],["text",38.0,28.0,"20","r"],["line",46.0,228.0,393.2,228.0,1],["line",46.0,228.0,46.0,24.0,1],["text",38.0,241.0,"0","r"],["text",54.0,18.0,"°C","l"],["text",408.0,215.0,"ч","r"],["line",46.0,118.0,130.0,148.0,2],["line",130.0,148.0,214.0,208.0,2],["line",214.0,208.0,298.0,148.0,2],["line"