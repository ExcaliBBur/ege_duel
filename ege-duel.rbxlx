      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Scoring</string>
          <string name="Source"><![CDATA[-- Проверка ответов и подсчёт баллов. Модуль не использует API Roblox, поэтому его можно тестировать отдельно.
local Text = require(script.Parent.Text)

local Scoring = {}

local function toNumber(s: string): number?
	return tonumber((string.gsub(s, ",", ".")))
end

local function gradeSet(given: string, expected: string, points: number): number
	local givenSet, expectedSet = {}, {}
	for _, ch in Text.chars(given) do
		givenSet[ch] = true
	end
	for _, ch in Text.chars(expected) do
		expectedSet[ch] = true
	end
	local missing, extra = 0, 0
	for ch in expectedSet do
		if not givenSet[ch] then
			missing += 1
		end
	end
	for ch in givenSet do
		if not expectedSet[ch] then
			extra += 1
		end
	end
	local errors = math.max(missing, extra)
	if errors == 0 then
		return points
	elseif errors == 1 and points >= 2 then
		return points - 1
	end
	return 0
end

local function gradeOrder(given: string, expected: string, points: number): number
	if given == expected then
		return points
	end
	if points < 2 then
		return 0
	end
	local a, b = Text.chars(given), Text.chars(expected)
	if #a ~= #b then
		return 0
	end
	local mismatches = 0
	for index = 1, #a do
		if a[index] ~= b[index] then
			mismatches += 1
		end
	end
	return if mismatches == 1 then points - 1 else 0
end

-- Сколько баллов даёт ответ rawAnswer на задание task.
-- Виды заданий: exact (точное совпадение), number (число), set (цифры в любом порядке), order (последовательность).
function Scoring.grade(task, rawAnswer: string?): number
	local given = Text.normalize(rawAnswer or "")
	if given == "" then
		return 0
	end
	local kind = task.kind or "exact"
	local points = task.points or 1
	local best = 0
	for _, accepted in task.answers do
		local expected = Text.normalize(accepted)
		local earned = 0
		if kind == "number" then
			local x, y = toNumber(given), toNumber(expected)
			if x and y then
				if math.abs(x - y) < 1e-9 then
					earned = points
				end
			elseif given == expected then
				earned = points
			end
		elseif kind == "set" then
			earned = gradeSet(given, expected, points)
		elseif kind == "order" then
			earned = gradeOrder(given, expected, points)
		elseif given == expected then
			earned = points
		end
		best = math.max(best, earned)
	end
	return best
end

-- Итог по работе: баллы, число верных и частично верных ответов.
function Scoring.summarize(tasks, answers)
	local summary = {
		earned = 0,
		max = 0,
		correct = 0,
		partial = 0,
		answered = 0,
		total = #tasks,
		perTask = {},
	}
	for index, task in tasks do
		local points = task.points or 1
		local answer = answers[index]
		local earned = Scoring.grade(task, answer)
		summary.max += points
		summary.earned += earned
		summary.perTask[index] = earned
		if answer ~= nil and Text.normalize(answer) ~= "" then
			summary.answered += 1
		end
		if earned == points then
			summary.correct += 1
		elseif earned > 0 then
			summary.partial += 1
		end
	end
	return summary
end

function Scoring.percent(earned: number, max: number): number
	if max <= 0 then
		return 0
	end
	return math.floor(earned / max * 100 + 0.5)
end

-- Исход матча для игрока a против игрока b.
-- Поля: earned, max, elapsed (секунд до сдачи работы), left (вышел из игры во время матча).
-- Возвращает "win" | "lose" | "draw" и причину "score" | "time" | "walkover".
function Scoring.decide(a, b): (string, string)
	if b.left and not a.left then
		return "win", "walkover"
	elseif a.left and not b.left then
		return "lose", "walkover"
	end
	-- Сравниваем доли earned/max без деления, чтобы не зависеть от округления.
	local left, right = a.earned * b.max, b.earned * a.max
	if left > right then
		return "win", "score"
	elseif left < right then
		return "lose", "score"
	end
	if a.elapsed < b.elapsed then
		return "win", "time"
	elseif a.elapsed > b.elapsed then
		return "lose", "time"
	end
	return "draw", "score"
end

return Scoring
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[-- Настройки матча, общие для сервера и клиента.
local Settings = {}

Settings.timeOptions = { 10, 20, 30, 45 } -- минуты
Settings.countOptions = { 8, 12, 16, 20 } -- число заданий
Settings.defaultTime = 20
Settings.defaultCount = 12

Settings.countdownSeconds = 3
Settings.answerMaxChars = 17 -- как в бланке ответов №1
Settings.graceSeconds = 1.5 -- сколько сервер ждёт последние ответы после конца времени

function Settings.isTimeOption(value: any): boolean
	return table.find(Settings.timeOptions, value) ~= nil
end

function Settings.isCountOption(value: any): boolean
	return table.find(Settings.countOptions, value) ~= nil
end

return Settings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Subjects</string>
          <string name="Source"><![CDATA[-- Список предметов. id совпадает с именем файла в bank/dist.
local Subjects = {}

Subjects.list = {
	{ id = "russian", name = "Русский язык" },
	{ id = "math_base", name = "Математика, база" },
	{ id = "math_prof", name = "Математика, профиль" },
	{ id = "physics", name = "Физика" },
	{ id = "chemistry", name = "Химия" },
	{ id = "biology", name = "Биология" },
	{ id = "informatics", name = "Информатика" },
	{ id = "history", name = "История" },
	{ id = "social", name = "Обществознание" },
	{ id = "geography", name = "География" },
	{ id = "literature", name = "Литература" },
	{ id = "english", name = "Английский язык" },
}

Subjects.byId = {}
for _, subject in Subjects.list do
	Subjects.byId[subject.id] = subject
end

function Subjects.nameOf(id: string?): string
	local subject = id and Subjects.byId[id]
	return if subject then subject.name else "не выбран"
end

return Subjects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Text</string>
          <string name="Source"><![CDATA[-- Работа с текстом ответов. string.lower не умеет кириллицу, поэтому регистр меняем по кодам символов.
local Text = {}

local function lowerCode(code: number): number
	if code >= 0x41 and code <= 0x5A then
		return code + 32
	elseif code >= 0x410 and code <= 0x42F then
		return code + 32
	elseif code == 0x401 or code == 0x451 then
		return 0x435 -- Ё и ё считаем буквой е
	end
	return code
end

local function upperCode(code: number): number
	if code >= 0x61 and code <= 0x7A then
		return code - 32
	elseif code >= 0x430 and code <= 0x44F then
		return code - 32
	elseif code == 0x451 then
		return 0x401
	end
	return code
end

local function isSpace(code: number): boolean
	return code == 32 or code == 9 or code == 10 or code == 13 or code == 0xA0
end

local function isDash(code: number): boolean
	return code == 0x2212 or code == 0x2013 or code == 0x2014
end

-- Массив кодов символов; для битой строки возвращает пустой массив.
function Text.codes(s: string): { number }
	local result = {}
	if type(s) ~= "string" or utf8.len(s) == nil then
		return result
	end
	for _, code in utf8.codes(s) do
		table.insert(result, code)
	end
	return result
end

function Text.length(s: string): number
	return #Text.codes(s)
end

-- Массив отдельных символов строки.
function Text.chars(s: string): { string }
	local result = {}
	for _, code in Text.codes(s) do
		table.insert(result, utf8.char(code))
	end
	return result
end

function Text.upper(s: string): string
	local out = {}
	for _, code in Text.codes(s) do
		table.insert(out, utf8.char(upperCode(code)))
	end
	return table.concat(out)
end

-- Обрезает строку до maxChars символов.
function Text.truncate(s: string, maxChars: number): string
	local out = {}
	for index, code in Text.codes(s) do
		if index > maxChars then
			break
		end
		table.insert(out, utf8.char(code))
	end
	return table.concat(out)
end

-- Приводит ответ к виду для сравнения: без пробелов, строчными буквами, ё как е, любое тире как минус.
function Text.normalize(s: string): string
	local out = {}
	for _, code in Text.codes(s) do
		if not isSpace(code) then
			if isDash(code) then
				code = 0x2D
			end
			table.insert(out, utf8.char(lowerCode(code)))
		end
	end
	return table.concat(out)
end

return Text
]]></string>
        </Properties>
