{"id":"math_base-111","group":"b6_internet","number":6,"topic":"Выбор оптимального варианта","text":"Интернет-провайдер предлагает три тарифных плана. Пользователь предполагает, что его трафик составит 800 Мб в месяц, и исходя из этого выбирает наиболее дешёвый тарифный план. Сколько рублей заплатит пользователь за месяц, если его трафик действительно будет равен 800 Мб?","answers":["1000"],"points":1,"kind":"number","explanation":"Стоимость по планам: 2400, 1000, 1000 руб. Наименьшая равна 1000 руб.","figure":{"w":430,"h":156,"items":[["line",10.0,10.0,420.0,10.0,1],["line",10.0,44.0,420.0,44.0,0],["line",10.0,78.0,420.0,78.0,0],["line",10.0,112.0,420.0,112.0,0],["line",10.0,146.0,420.0,146.0,1],["line",10.0,10.0,10.0,146.0,1],["line",90.0,10.0,90.0,146.0,1],["line",255.0,10.0,255.0,146.0,0],["line",420.0,10.0,420.0,146.0,1],["text",50.0,27.0,"Тариф","c"],["text",172.5,27.0,"Абонентская плата","c"],["text",337.5,27.0,"Плата за трафик","c"],["text",50.0,61.0,"План 1","c"],["text",172.5,61.0,"нет","c"],["text",337.5,61.0,"3 руб. за 1 Мб","c"],["text",50.0,95.0,"План 2","c"],["text",172.5,95.0,"550 руб. за 500 Мб","c"],["text",337.5,95.0,"1,5 руб. за 1 Мб сверх","c"],["text",50.0,129.0,"План 3","c"],["text",172.5,129.0,"1000 руб. за 1000 Мб","c"],["text",337.5,129.0,"1 руб. за 1 Мб сверх","c"]]}},
