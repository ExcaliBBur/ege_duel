{"id":"physics-413","group":"fig_iu_graph","text":"На рисунке показан график зависимости силы тока в резисторе от напряжения на нём. Найдите сопротивление резистора. Ответ дайте в омах.","answers":["0,4"],"points":1,"kind":"number","explanation":"В отмеченной точке U = 2 В, I = 5 А; R = U : I = 0,4 Ом.","figure":{"w":420,"h":260,"items":[["line",54.0,225.0,54.0,45.0,0],["line",96.0,225.0,96.0,45.0,0],["text",96.0,238.0,"2","c"],["line",138.0,225.0,138.0,45.0,0],["text",138.0,238.0,"4","c"],["line",180.0,225.0,180.0,45.0,0],["text",180.0,238.0,"6","c"],["line",222.0,225.0,222.0,45.0,0],["text",222.0,238.0,"8","c"],["line",264.0,225.0,264.0,45.0,0],["text",264.0,238.0,"10","c"],["line",306.0,225.0,306.0,45.0,0],["text",306.0,238.0,"12","c"],["line",348.0,225.0,348.0,45.0,0],["text",348.0,238.0,"14","c"],["line",390.0,225.0,390.0,45.0,0],["text",390.0,238.0,"16","c"],["line",54.0,225.0,390.0,225.0,0],["line",54.0,207.0,390.0,207.0,0],["line",54.0,189.0,390.0,189.0,0],["text",46.0,189.0,"1","r"],["line",54.0,171.0,390.0,171.0,0],["line",54.0,153.0,390.0,153.0,0],["text",46.0,153.0,"2","r"],["line",54.0,135.0,390.0,135.0,0],["line",54.0,117.0,390.0,117.0,0],["text",46.0,117.0,"3","r"],["line",54.0,99.0,390.0,99.0,0],["line",54.0,81.0,390.0,81.0,0],["text",46.0,81.0,"4","r"],["line",54.0,63.0,390.0,63.0,0],["line",54.0,45.0,390.0,45.0,0],["text",46.0,45.0,"5","r"],["line",54.0,225.0,406.8,225.0,1],["line",54.0,225.0,54.0,37.8,1],["text",46.0,238.0,"0","r"],["text",62.0,35.0,"I, А","l"],["text",414.0,212.0,"U, В","r"],["line",54.0,225.0,96.0,45.0,2],["circle",96.0,45.0,4.0,2]]}},
{"id":"physics-414","group":"fig_iu_graph","text":"На рисунке показан график зависимости силы тока в резисторе от напряжения на нём. Найдите сопротивление резистора. Ответ дайте в омах.","answers":["4"],"points":1,"kind":"number","explanation":"В отмеченной точке U = 10 В, I = 2,5 А; R = U : I = 4 Ом.","figure":{"w":420,"h":260,"items":[["line",54.0,225.0,54.0,45.0,0],["line",96.0,225.0,96.0,45.0,0],["text",96.0,238.0,"2","c"],["line",138.0,225.0,138.0,45.0,0],["text",138.0,238.0,"4","c"],["line",180.0,225.0,180.0,45.0,0],["text",180.0,238.0,"6","c"],["line",222.0,225.0,222.0,45.0,0],["text",222.0,238.0,"8","c"],["line",264.0,225.0,264.0,45.0,0],["text",264.0,238.0,"10","c"],["line",306.0,225.0,306.0,45.0,0],["text",306.0,238.0,"12","c"],["line",348.0,225.0,348.0,45.0,0],["text",348.0,238.0,"14","c"],["line",390.0,225.0,390.0,45.0,0],["text",390.0,238.0,"16","c"],["line",54.0,225.0,390.0,225.0,0],["line",54.0,207.0,390.0,207.0,0],["line",54.0,189.0,390.0,189.0,0],["text",46.0,189.0,"1","r"],["line",54.0,171.0,390.0,171.0,0],["line",54.0,153.0,390.0,153.0,0],["text",46.0,153.0,"2","r"],["line",54.0,135.0,390.0,135.0,0],["line",54.0,117.0,390.0,117.0,0],["text",46.0,117.0,"3","r"],["line",54.0,99.0,390.0,99.0,0],["line",54.0,81.0,390.0,81.0,0],["text",46.0,81.0,"4","r"],["line",54.0,63.0,390.0,63.0,0],["line",54.0,45.0,390.0,45.0,0],["text",46.0,45.0,"5","r"],["line",54.0,225.0,406.8,225.0,1],["line",54.0,225.0,54.0,37.8,1],["text",46.0,238.0,"0","r"],["text",62.0,35.0,"I, А","l"],["text",414.0,212.0,"U, В","r"],["line",54.0,225.0,390.0,81.0,2],["circle",264.0,135.0,4.0,2]]}}
