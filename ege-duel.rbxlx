			items = {{"line", 60, 20, 60, 230, 1}, {"line", 60, 230, 400, 230, 1}, {"text", 44, 26, "P", "c"}, {"text", 392, 246, "Q", "c"}, {"line", 170, 50, 340, 210, 1}, {"line", 100, 50, 270, 210, 2}, {"text", 170, 30, "D", "c"}, {"text", 100, 30, "D₁", "c"}, {"line", 255, 130, 193, 130, 1}, {"line", 193, 130, 200.7, 125.4, 1}, {"line", 193, 130, 200.7, 134.6, 1}},
			w = 420,
		},
		group = "fig_market",
		id = "social-133",
		kind = "exact",
		points = 1,
		text = "На рисунке показано изменение на рынке игрушек: линия спроса переместилась из положения D в положение D₁ (P цена товара, Q количество товара). Что могло вызвать такое изменение? Запишите номер ответа.\n1) рост доходов покупателей\n2) успешная рекламная кампания товара\n3) ожидание покупателями роста цен\n4) снижение доходов покупателей",
	}, {
		answers = {"3"},
		explanation = "Сдвиг линии влево означает уменьшение спроса. Подходит причина: снижение доходов покупателей.",
		figure = {
			h = 260,
			items = {{"line", 60, 20, 60, 230, 1}, {"line", 60, 230, 400, 230, 1}, {"text", 44, 26, "P", "c"}, {"text", 392, 246, "Q", "c"}, {"line", 170, 50, 340, 210, 1}, {"line", 100, 50, 270, 210, 2}, {"text", 170, 30, "D", "c"}, {"text", 100, 30, "D₁", "c"}, {"line", 255, 130, 193, 130, 1}, {"line", 193, 130, 200.7, 125.4, 1}, {"line", 193, 130, 200.7, 134.6, 1}},
			w = 420,
		},
		group = "fig_market",
		id = "social-134",
		kind = "exact",
		points = 1,
		text = "На рисунке показано изменение на рынке велосипедов: линия спроса переместилась из положения D в положение D₁ (P цена товара, Q количество товара). Что могло вызвать такое изменение? Запишите номер ответа.\n1) рост затрат на оплату труда\n2) рост цен на товары-заменители\n3) снижение доходов покупателей\n4) повышение налогов на производителей",
	}, {
		answers = {"2"},
		explanation = "Сдвиг линии влево означает уменьшение предложения. Подходит причина: рост затрат на оплату труда.",
		figure = {
			h = 260,
			items = {{"line", 60, 20, 60, 230, 1}, {"line", 60, 230, 400, 230, 1}, {"text", 44, 26, "P", "c"}, {"text", 392, 246, "Q", "c"}, {"line", 170, 210, 340, 50, 1}, {"line", 100, 210, 270, 50, 2}, {"text", 340, 34, "S", "c"}, {"text", 270, 34, "S₁", "c"}, {"line", 255, 130, 193, 130, 1}, {"line", 193, 130, 200.7, 125.4, 1}, {"line", 193, 130, 200.7, 134.6, 1}},
			w = 420,
		},
		group = "fig_market",
		id = "social-135",
		kind = "exact",
		points = 1,
		text = "На рисунке показано изменение на рынке велосипедов: линия предложения переместилась из положения S в положение S₁ (P цена товара, Q количество товара). Что могло вызвать такое изменение? Запишите номер ответа.\n1) снижение доходов покупателей\n2) рост затрат на оплату труда\n3) рост числа продавцов на рынке\n4) ожидание покупателями роста цен",
	}, {
		answers = {"1"},
		explanation = "Сдвиг линии влево означает уменьшение спроса. Подходит причина: товар вышел из моды.",
		figure = {
			h = 260,
			items = {{"line", 60, 20, 60, 230, 1}, {"line", 60, 230, 400, 230, 1}, {"text", 44, 26, "P", "c"}, {"text", 392, 246, "Q", "c"}, {"line", 170, 50, 340, 210, 1}, {"line", 100, 50, 270, 210, 2}, {"text", 170, 30, "D", "c"}, {"text", 100, 30, "D₁", "c"}, {"line", 255, 130, 193, 130, 1}, {"line", 193, 130, 200.7, 125.4, 1}, {"line", 193, 130, 200.7, 134.6, 1}},
			w = 420,
		},
		group = "fig_market",
		id = "social-136",
		kind = "exact",
		points = 1,
		text = "На рисунке показано изменение на рынке молочных продуктов: линия спроса переместилась из положения D в положение D₁ (P цена товара, Q количество товара). Что могло вызвать такое изменение? Запишите номер ответа.\n1) товар вышел из моды\n2) уход части фирм с рынка\n3) повышение налогов на производителей\n4) снижение налогов на производителей",
	}, {
		answers = {"2"},
		explanation = "Сдвиг линии влево означает уменьшение спроса. Подходит причина: товар вышел из моды.",
		figure = {
			h = 260,
			items = {{"line", 60, 20, 60, 230, 1}, {"line", 60, 230, 400, 230, 1}, {"text", 44, 26, "P", "c"}, {"text", 392, 246, "Q", "c"}, {"line", 170, 50, 340, 210, 1}, {"line", 100, 50, 270, 210, 2}, {"text", 170, 30, "D", "c"}, {"text", 100, 30, "D₁", "c"}, {"line", 255, 130, 193, 130, 1}, {"line", 193, 130, 200.7, 125.4, 1}, {"line", 193, 130, 200.7, 134.6, 1}},
			w = 420,
		},
		group = "fig_market",
		id = "social-137",
		kind = "exact",
		points = 1,
		text = "На рисунке показано изменение на рынке яблок: линия спроса переместилась из положения D в положение D₁ (P цена товара, Q количество товара). Что могло вызвать такое изменение? Запишите номер ответа.\n1) внедрение новой производительной технологии\n2) товар вышел из моды\n3) рост цен на товары-заменители\n4) снижение цен на сырьё",
	}, {
		answers = {"4"},
		explanation = "Сдвиг линии влево означает уменьшение спроса. Подходит причина: снижение доходов покупателей.",
		figure = {
			h = 260,
			items = {{"line", 60, 20, 60, 230, 1}, {"line", 60, 230, 400, 230, 1}, {"text", 44, 26, "P", "c"}, {"text", 392, 246, "Q", "c"}, {"line", 170, 50, 340, 210, 1}, {"line", 100, 50, 270, 210, 2}, {"text", 170, 30, "D", "c"}, {"text", 100, 30, "D₁", "c"}, {"line", 255, 130, 193, 130, 1}, {"line", 193, 130, 200.7, 125.4, 1}, {"line", 193, 130, 200.7, 134.6, 1}},
			w = 420,
		},
		group = "fig_market",
		id = "social-138",
		kind = "exact",
		points = 1,
		text = "На рисунке показано изменение на рынке мебели: линия спроса переместилась из положения D в положение D₁ (P цена товара, Q количество товара). Что могло вызвать такое изменение? Запишите номер ответа.\n1) повышение налогов на производителей\n2) ожидание покупателями роста цен\n3) рост числа продавцов на рынке\n4) снижение доходов покупателей",
	}},
}</string>
