{"id":"biology-191","group":"fig_dna","text":"На рисунке показана последовательность нуклеотидов одной цепи ДНК. Запишите последовательность иРНК, которая синтезируется на этой цепи. Буквы записывайте подряд, без пробелов.","answers":["АЦЦГГУААЦ"],"points":1,"kind":"exact","explanation":"По правилу комплементарности: А соединяется с У, Т с А, Г с Ц, Ц с Г. Получается АЦЦГГУААЦ.","figure":{"w":420,"h":110,"items":[["line",48.0,35.0,84.0,35.0,1],["line",84.0,35.0,84.0,75.0,1],["line",84.0,75.0,48.0,75.0,1],["line",48.0,75.0,48.0,35.0,1],["text",66.0,55.0,"Т","c"],["line",84.0,35.0,120.0,35.0,1],["line",120.0,35.0,120.0,75.0,1],["line",120.0,75.0,84.0,75.0,1],["line",84.0,75.0,84.0,35.0,1],["text",102.0,55.0,"Г","c"],["line",120.0,35.0,156.0,35.0,1],["line",156.0,35.0,156.0,75.0,1],["line",156.0,75.0,120.0,75.0,1],["line",120.0,75.0,120.0,35.0,1],["text",138.0,55.0,"Г","c"],["line",156.0,35.0,192.0,35.0,1],["line",192.0,35.0,192.0,75.0,1],["line",192.0,75.0,156.0,75.0,1],["line",156.0,75.0,156.0,35.0,1],["text",174.0,55.0,"Ц","c"],["line",192.0,35.0,228.0,35.0,1],["line",228.0,35.0,228.0,75.0,1],["line",228.0,75.0,192.0,75.0,1],["line",192.0,75.0,192.0,35.0,1],["text",210.0,55.0,"Ц","c"],["line",228.0,35.0,264.0,35.0,1],["line",264.0,35.0,264.0,75.0,1],["line",264.0,75.0,228.0,75.0,1],["line",228.0,75.0,228.0,35.0,1],["text",246.0,55.0,"А","c"],["line",264.0,35.0,300.0,35.0,1],["line",300.0,35.0,300.0,75.0,1],["line",300.0,75.0,264.0,75.0,1],["line",264.0,75.0,264.0,35.0,1],["text",282.0,55.0,"Т","c"],["line",300.0,35.0,336.0,35.0,1],["line",336.0,35.0,336.0,75.0,1],["line",336.0,75.0,300.0,75.0,1],["line",300.0,75.0,300.0,35.0,1],["text",318.0,55.0,"Т","c"],["line",336.0,35.0,372.0,35.0,1],["line",372.0,35.0,372.0,75.0,1],["line",372.0,75.0,336.0,75.0,1],["line",336.0,75.0,336.0,35.0,1],["text",354.0,55.0,"Г","c"]]}},
{"id":"biology-192","group":"fig_dna","text":"На рисунке показана последовательность нуклеотидов одной цепи ДНК. Запишите последовательность иРНК, которая синтезируется на этой цепи. Буквы записывайте подряд, без пробелов.","answers":["УГААЦАААА"],"points":1,"kind":"exact","explanation":"По правилу комплементарности: А соединяется с У, Т с А, Г с Ц, Ц с Г. Получается УГААЦАААА.","figure":{"w":420,"h":110,"items":[["line",48.0,35.0,84.0,35.0,1],["line",84.0,35.0,84.0,75.0,1],["line",84.0,75.0,48.0,75.0,1],["line",48.0,75.0,48.0,35.0,1],["text",66.0,55.0,"А","c"],["line",84.0,35.0,120.0,35.0,1],["line",120.0,35.0,120.0,75.0,1],["line",120.0,75.0,84.0,75.0,1],["line",84.0,75.0,84.0,35.0,1],["text",102.0,55.0,"Ц","c"],["line",120.0,35.0,156.0,35.0,1],["line",156.0,35.0,156.0,75.0,1],["line",156.0,75.0,120.0,75.0,1],["line",120.0,75.0,120.0,35.0,1],["text",138.0,55.0,"Т","c"],["line",156.0,35.0,192.0,35.0,1],["line",192.0,35.0,192.0,75.0,1],["line",192.0,75.0,156.0,75.0,1],["line",156.0,75.0,156.0,35.0,1],["text",174.0,55.0,"Т","c"],["line",192.0,35.0,228.0,35.0,1],["line",228.0,35.0,228.0,75.0,1],["line",228.0,75.0,192.0,75.0,1],["line",192.0,75.0,192.0,35.0,1],["text",210.0,55.0,"Г","c"],["line",228.0,35.0,264.0,35.0,1],["line",264.0,35.0,264.0,75.0,1],["line",264.0,75.0,228.0,75.0,1],["line",228.0,75.0,228.0,35.0,1],["text",246.0,55.0,"Т","c"],["line",264.0,35.0,300.0,35.0,1],["line",300.0,35.0,300.0,75.0,1],["line",300.0,75.0,264.0,75.0,1],["line",264.0,75.0,264.0,35.0,1],["text",282.0,55.0,"Т","c"],["line",300.0,35.0,336.0,35.0,1],["line",336.0,35.0,336.0,75.0,1],["line",336.0,75.0,300.0,75.0,1],["line",300.0,75.0,300.0,35.0,1],["text",318.0,55.0,"Т","c"],["line",336.0,35.0,372.0,35.0,1],["line",372.0,35.0,372.0,75.0,1],["line",372.0,75.0,336.0,75.0,1],["line",336.0,75.0,336.0,35.0,1],["text",354.0,55.0,"Т","c"]]}}
