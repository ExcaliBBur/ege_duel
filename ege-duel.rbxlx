{"id":"math_base-331","group":"b17_linear","number":17,"topic":"Простейшие уравнения","text":"Найдите корень уравнения -2x - 6 = 10.","answers":["-8"],"points":1,"kind":"number","explanation":"-2x = 16, x = -8."},
