            <string name="Value">{"subject": "informatics", "tasks": [
{"id":"informatics-001","group":"m_graph_table","number":1,"topic":"Анализ информационных моделей","text":"На рисунке справа схема дорог района изображена в виде графа, в таблице слева содержатся сведения о длинах этих дорог (в километрах). Таблицу и схему рисовали независимо друг от друга, поэтому нумерация населённых пунктов в таблице никак не связана с буквенными обозначениями на графе. Определите длину дороги из пункта Б в пункт Е. В ответе запишите целое число.","answers":["19"],"points":1,"kind":"number","explanation":"Пункты сопоставляются по числу дорог, выходящих из них. Пункт Б это П3, пункт Е это П1; длина дороги между ними 19 км.","figure":{"w":450,"h":240,"items":[["line",8.0,8.0,225.0,8.0,1],["line",8.0,8.0,8.0,225.0,1],["line",8.0,39.0,225.0,39.0,1],["line",39.0,8.0,39.0,225.0,1],["line",8.0,70.0,225.0,70.0,0],["line",70.0,8.0,70.0,225.0,0],["line",8.0,101.0,225.0,101.0,0],["line",101.0,8.0,101.0,225.0,0],["line",8.0,132.0,225.0,132.0,0],["line",132.0,8.0,132.0,225.0,0],["line",8.0,163.0,225.0,163.0,0],["line",163.0,8.0,163.0,225.0,0],["line",8.0,194.0,225.0,194.0,0],["line",194.0,8.0,194.0,225.0,0],["line",8.0,225.0,225.0,225.0,1],["line",225.0,8.0,225.0,225.0,1],["text",54.5,23.5,"П1","c"],["text",23.5,54.5,"П1","c"],["text",85.5,23.5,"П2","c"],["text",23.5,85.5,"П2","c"],["text",116.5,23.5,"П3","c"],["text",23.5,116.5,"П3","c"],["text",147.5,23.5,"П4","c"],["text",23.5,147.5,"П4","c"],["text",178.5,23.5,"П5","c"],["text",23.5,178.5,"П5","c"],["text",209.5,23.5,"П6","c"],["text",23.5,209.5,"П6","c"],["text",116.5,85.5,"30","c"],["text",85.5,116.5,"30","c"],["text",209.5,85.5,"38","c"],["text",85.5,209.5,"38","c"],["text",178.5,85.5,"20","c"],["text",85.5,178.5,"20","c"],["text",54.5,85.5,"21","c"],["text",85.5,54.5,"21","c"],["text",147.5,116.5,"34","c"],["text",116.5,147.5,"34","c"],["text",54.5,116.5,"19","c"],["text",116.5,54.5,"19","c"],["text",178.5,209.5,"32","c"],["text",209.5,178.5,"32","c"],["text",54.5,147.5,"48","c"],["text",147.5,54.5,"4