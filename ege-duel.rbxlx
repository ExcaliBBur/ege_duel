        <Item class="StringValue" referent="31">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "history", "tasks": [
{"id":"history-001","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началась русско-японская война\nБ) произошла Невская битва\nВ) началось правление Александра I\nГ) началась Крымская война\n\n1) 1240 г.\n2) 1801 г.\n3) 1853 г.\n4) 1904 г.\n5) 1929 г.\n6) 1985 г.","answers":["4123"],"points":2,"kind":"order","explanation":"началась русско-японская война: 1904 г; произошла Невская битва: 1240 г; началось правление Александра I: 1801 г; началась Крымская война: 1853 г."},
{"id":"history-002","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) советские войска были введены в Афганистан\nБ) народовольцы убили Александра II\nВ) прервалась династия Рюриковичей на московском престоле\nГ) было принято Соборное уложение\n\n1) 1598 г.\n2) 1649 г.\n3) 1654 г.\n4) 1881 г.\n5) 1979 г.\n6) 1980 г.","answers":["5412"],"points":2,"kind":"order","explanation":"советские войска были введены в Афганистан: 1979 г; народовольцы убили Александра II: 1881 г; прервалась династия Рюриковичей на московском престоле: 1598 г; было принято Соборное уложение: 1649 г."},
{"id":"history-003","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) был принят Судебник Ивана IV\nБ) СССР вступил в Лигу Наций\nВ) произошла Октябрьская революция\nГ) была принята «брежневская» Конституция СССР\n\n1) 1550 г.\n2) 1874 г.\n3) 1917 г.\n4) 1934 г.\n5) 1939 г.\n6) 1977 г.","answers":["1436"],"points":2,"kind":"order","explanation":"был принят Судебник Ивана IV: 1550 г; СССР вступил в Лигу Наций: 1934 г; произошла Октябрьская революция: 1917 г; была принята «брежневская» Конституция СССР: 1977 г."},
{"id":"history-004","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) была полностью снята блокада Ленинграда\nБ) в Москве прошли летние Олимпийские игры\nВ) начала работу I Государственная дума\nГ) началась сплошная коллективизация\n\n1) 1906 г.\n2) 1921 г.\n3) 1929 г.\n4) 1936 г.\n5) 1944 г.\n6) 1980 г.","answers":["5613"],"points":2,"kind":"order","explanation":"была полностью снята блокада Ленинграда: 1944 г; в Москве прошли летние Олимпийские игры: 1980 г; начала работу I Государственная дума: 1906 г; началась сплошная коллективизация: 1929 г."},
{"id":"history-005","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) была введена Табель о рангах\nБ) советские войска были введены в Афганистан\nВ) началась Первая мировая война\nГ) была проведена судебная реформа Александра II\n\n1) 1097 г.\n2) 1722 г.\n3) 1803 г.\n4) 1864 г.\n5) 1914 г.\n6) 1979 г.","answers":["2654"],"points":2,"kind":"order","explanation":"была введена Табель о рангах: 1722 г; советские войска были введены в Афганистан: 1979 г; началась Первая мировая война: 1914 г; была проведена судебная реформа Александра II: 1864 г."},
{"id":"history-006","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) было принято Соборное уложение\nБ) Россия была провозглашена империей\nВ) началась сплошная коллективизация\nГ) начала работу I Государственная дума\n\n1) 1223 г.\n2) 1649 г.\n3) 1721 г.\n4) 1906 г.\n5) 1929 г.\n6) 1989 г.","answers":["2354"],"points":2,"kind":"order","explanation":"было принято Соборное уложение: 1649 г; Россия была провозглашена империей: 1721 г; началась сплошная коллективизация: 1929 г; начала работу I Государственная дума: 1906 г."},
{"id":"history-007","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) был принят Судебник Ивана III\nБ) была введена всеобщая воинская повинность\nВ) началась Сталинградская битва\nГ) началась Северная война\n\n1) 1497 г.\n2) 1565 г.\n3) 1700 г.\n4) 1722 г.\n5) 1874 г.\n6) 1942 г.","answers":["1563"],"points":2,"kind":"order","explanation":"был принят Судебник Ивана III: 1497 г; была введена всеобщая воинская повинность: 1874 г; началась Сталинградская битва: 1942 г; началась Северная война: 1700 г."},
{"id":"history-008","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) произошла битва на реке Калке\nБ) произошла Невская битва\nВ) началось нашествие Батыя на Русь\nГ) состоялся Любечский съезд князей\n\n1) 1097 г.\n2) 1223 г.\n3) 1237 г.\n4) 1240 г.\n5) 1497 г.\n6) 1977 г.","answers":["2431"],"points":2,"kind":"order","explanation":"произошла битва на реке Калке: 1223 г; произошла Невская битва: 1240 г; началось нашествие Батыя на Русь: 1237 г; состоялся Любечский съезд князей: 1097 г."},
{"id":"history-009","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) в СССР испытали первую атомную бомбу\nБ) был заключён Брестский мир\nВ) Крым был присоединён к Российской империи\nГ) была проведена судебная реформа Александра II\n\n1) 1147 г.\n2) 1783 г.\n3) 1864 г.\n4) 1918 г.\n5) 1949 г.\n6) 1985 г.","answers":["5423"],"points":2,"kind":"order","explanation":"в СССР испытали первую атомную бомбу: 1949 г; был заключён Брестский мир: 1918 г; Крым был присоединён к Российской империи: 1783 г; была проведена судебная реформа Александра II: 1864 г."},
{"id":"history-010","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началась Сталинградская битва\nБ) произошла Невская битва\nВ) была введена Табель о рангах\nГ) ополчение Минина и Пожарского освободило Москву\n\n1) 1240 г.\n2) 1612 г.\n3) 1722 г.\n4) 1814 г.\n5) 1942 г.\n6) 1979 г.","answers":["5132"],"points":2,"kind":"order","explanation":"началась Сталинградская битва: 1942 г; произошла Невская битва: 1240 г; была введена Табель о рангах: 1722 г; ополчение Минина и Пожарского освободило Москву: 1612 г."},
{"id":"history-011","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) был принят Судебник Ивана IV\nБ) варяги во главе с Рюриком были призваны на княжение\nВ) произошла авария на Чернобыльской АЭС\nГ) умер И. В. Сталин\n\n1) 862 г.\n2) 1550 г.\n3) 1891 г.\n4) 1953 г.\n5) 1980 г.\n6) 1986 г.","answers":["2164"],"points":2,"kind":"order","explanation":"был принят Судебник Ивана IV: 1550 г; варяги во главе с Рюриком были призваны на княжение: 862 г; произошла авария на Чернобыльской АЭС: 1986 г; умер И. В. Сталин: 1953 г."},
{"id":"history-012","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) был принят Судебник Ивана IV\nБ) началась Крымская война\nВ) началась опричнина\nГ) умер И. В. Сталин\n\n1) 1550 г.\n2) 1565 г.\n3) 1803 г.\n4) 1853 г.\n5) 1914 г.\n6) 1953 г.","answers":["1426"],"points":2,"kind":"order","explanation":"был принят Судебник Ивана IV: 1550 г; началась Крымская война: 1853 г; началась опричнина: 1565 г; умер И. В. Сталин: 1953 г."},
{"id":"history-013","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) был издан указ о вольных хлебопашцах\nБ) началось правление Екатерины II\nВ) в Москве прошли летние Олимпийские игры\nГ) произошла Невская битва\n\n1) 882 г.\n2) 1240 г.\n3) 1762 г.\n4) 1803 г.\n5) 1881 г.\n6) 1980 г.","answers":["4362"],"points":2,"kind":"order","explanation":"был издан указ о вольных хлебопашцах: 1803 г; началось правление Екатерины II: 1762 г; в Москве прошли летние Олимпийские игры: 1980 г; произошла Невская битва: 1240 г."},
{"id":"history-014","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) варяги во главе с Рюриком были призваны на княжение\nБ) СССР вступил в Лигу Наций\nВ) в СССР запустили первый искусственный спутник Земли\nГ) было принято Соборное уложение\n\n1) 862 г.\n2) 1649 г.\n3) 1874 г.\n4) 1934 г.\n5) 1943 г.\n6) 1957 г.","answers":["1462"],"points":2,"kind":"order","explanation":"варяги во главе с Рюриком были призваны на княжение: 862 г; СССР вступил в Лигу Наций: 1934 г; в СССР запустили первый искусственный спутник Земли: 1957 г; было принято Соборное уложение: 1649 г."},
{"id":"history-015","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) произошла Октябрьская революция\nБ) началась Первая мировая война\nВ) началась сплошная коллективизация\nГ) были изданы Жалованные грамоты дворянству и городам\n\n1) 1785 г.\n2) 1801 г.\n3) 1874 г.\n4) 1914 г.\n5) 1917 г.\n6) 1929 г.","answers":["5461"],"points":2,"kind":"order","explanation":"произошла Октябрьская революция: 1917 г; началась Первая мировая война: 1914 г; началась сплошная коллективизация: 1929 г; были изданы Жалованные грамоты дворянству и городам: 1785 г."},
{"id":"history-016","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) варяги во главе с Рюриком были призваны на княжение\nБ) завершился вывод советских войск из Афганистана\nВ) в СССР испытали первую атомную бомбу\nГ) началась опричнина\n\n1) 862 г.\n2) 1565 г.\n3) 1939 г.\n4) 1944 г.\n5) 1949 г.\n6) 1989 г.","answers":["1652"],"points":2,"kind":"order","explanation":"варяги во главе с Рюриком были призваны на княжение: 862 г; завершился вывод советских войск из Афганистана: 1989 г; в СССР испытали первую атомную бомбу: 1949 г; началась опричнина: 1565 г."},
{"id":"history-017","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началось восстание под предводительством Е. И. Пугачёва\nБ) началась Крымская война\nВ) началось правление Екатерины II\nГ) был принят Судебник Ивана III\n\n1) 1497 г.\n2) 1649 г.\n3) 1762 г.\n4) 1773 г.\n5) 1853 г.\n6) 1917 г.","answers":["4531"],"points":2,"kind":"order","explanation":"началось восстание под предводительством Е. И. Пугачёва: 1773 г; началась Крымская война: 1853 г; началось правление Екатерины II: 1762 г; был принят Судебник Ивана III: 1497 г."},
{"id":"history-018","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) народовольцы убили Александра II\nБ) в СССР запустили первый искусственный спутник Земли\nВ) состоялся XX съезд КПСС\nГ) состоялся Любечский съезд князей\n\n1) 1097 г.\n2) 1881 г.\n3) 1939 г.\n4) 1956 г.\n5) 1957 г.\n6) 1986 г.","answers":["2541"],"points":2,"kind":"order","explanation":"народовольцы убили Александра II: 1881 г; в СССР запустили первый искусственный спутник Земли: 1957 г; состоялся XX съезд КПСС: 1956 г; состоялся Любечский съезд князей: 1097 г."},
{"id":"history-019","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) М. С. Горбачёв стал Генеральным секретарём ЦК КПСС\nБ) началась Первая мировая война\nВ) Россия была провозглашена империей\nГ) в Москве прошли летние Олимпийские игры\n\n1) 1721 г.\n2) 1803 г.\n3) 1914 г.\n4) 1943 г.\n5) 1980 г.\n6) 1985 г.","answers":["6315"],"points":2,"kind":"order","explanation":"М. С. Горбачёв стал Генеральным секретарём ЦК КПСС: 1985 г; началась Первая мировая война: 1914 г; Россия была провозглашена империей: 1721 г; в Москве прошли летние Олимпийские игры: 1980 г."},
{"id":"history-020","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) СССР вступил в Лигу Наций\nБ) состоялся Любечский съезд князей\nВ) произошла Курская битва\nГ) произошла авария на Чернобыльской АЭС\n\n1) 882 г.\n2) 1097 г.\n3) 1934 г.\n4) 1943 г.\n5) 1944 г.\n6) 1986 г.","answers":["3246"],"points":2,"kind":"order","explanation":"СССР вступил в Лигу Наций: 1934 г; состоялся Любечский съезд князей: 1097 г; произошла Курская битва: 1943 г; произошла авария на Чернобыльской АЭС: 1986 г."},
{"id":"history-021","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) началась опричнина\n2) началось нашествие Батыя на Русь\n3) начался переход к новой экономической политике (нэпу)","answers":["213"],"points":1,"kind":"order","explanation":"По порядку: 1237 г, 1565 г, 1921 г."},
{"id":"history-022","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) началась Сталинградская битва\n2) началось строительство Транссибирской магистрали\n3) был принят Судебник Ивана IV","answers":["321"],"points":1,"kind":"order","explanation":"По порядку: 1550 г, 1891 г, 1942 г."},
