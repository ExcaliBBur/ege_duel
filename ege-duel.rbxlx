{"id":"informatics-341","group":"fig_paths","number":23,"topic":"Анализ графов","text":"На рисунке показана схема дорог между городами А, Б, В, Г, Д, Е, Ж. По каждой дороге можно ехать только в направлении стрелки. Сколько существует различных путей из города А в город Ж?","answers":["4"],"points":1,"kind":"number","explanation":"Для каждого города считаем число путей как сумму путей в города, из которых в него ведут стрелки. В город Ж ведёт 4.","figure":{"w":420,"h":260,"items":[["line",51.9,120.8,137.3,54.8,1],["line",137.3,54.8,134.1,63.2,1],["line",137.3,54.8,128.4,55.8,1],["line",55.0,130.0,134.0,130.0,1],["line",134.0,130.0,126.3,134.6,1],["line",134.0,130.0,126.3,125.4,1],["line",51.9,139.2,137.3,205.2,1],["line",137.3,205.2,128.4,204.2,1],["line",137.3,205.2,134.1,196.8,1],["line",283.5,81.5,370.6,123.1,1],["line",370.6,123.1,361.6,124.0,1],["line",370.6,123.1,365.6,115.6,1],["line",283.5,178.5,370.6,136.9,1],["line",370.6,136.9,365.6,144.4,1],["line",370.6,136.9,361.6,136.0,1],["line",164.6,48.6,254.5,71.1,1],["line",254.5,71.1,245.9,73.7,1],["line",254.5,71.1,248.1,64.7,1],["line",163.6,123.8,255.5,81.7,1],["line",255.5,81.7,250.4,89.1,1],["line",255.5,81.7,246.5,80.7,1],["line",163.6,136.2,255.5,178.3,1],["line",255.5,178.3,246.5,179.3,1],["line",255.5,178.3,250.4,170.9,1],["line",164.6,211.4,254.5,188.9,1],["line",254.5,188.9,248.1,195.3,1],["line",254.5,188.9,245.9,186.3,1],["circle",40.0,130.0,15.0,1],["text",40.0,130.0,"А","c"],["circle",150.0,45.0,15.0,1],["text",150.0,45.0,"Б","c"],["circle",150.0,130.0,15.0,1],["text",150.0,130.0,"В","c"],["circle",150.0,215.0,15.0,1],["text",150.0,215.0,"Г","c"],["circle",270.0,75.0,15.0,1],["text",270.0,75.0,"Д","c"],["circle",270.0,185.0,15.0,1],["text",270.0,185.0,"Е","c"],["circle",385.0,130.0,15.0,1],["text",385.0,130.0,"Ж","c"]]}},
{"id":"informatics-342","group":"fig_paths","number":23,"topic":"Анализ графов","text":"На рисунке показана схема дорог между городами А, Б, В, Г, Д, Е, Ж. По каждой дороге можно ехать только в направлении стрелки. Сколько существует различных путей из города А в город Ж?","answers":["12"],"points":1,"kind":"number","explanation":"Для каждого города считаем число путей как сумму путей в города, из которых в него ведут стрелки. В город Ж ведёт 12.","figure":{"w":420,"h":260,"items":[["line",51.9,120.8,137.3,54.8,1],["line",137.3,54.8,134.1,63.2,1],["line",137.3,54.8,128.4,55.8,1],["line",55.0,130.0,134.0,130.0,1],["line",134.0,130.0,126.3,134.6,1],["line",134.0,130.0,126.3,125.4,1],["line",51.9,139.2,137.3,205.2,1],["line",137.3,205.2,128.4,204.2,1],["line",137.3,205.2,134.1,196.8,1],["line",283.5,81.5,370.6,123.1,1],["line",370.6,123.1,361.6,124.0,1],["line",370.6,123.1,365.6,115.6,1],["line",283.5,178.5,370.6,136.9,1],["line",370.6,136.9,365.6,144.4,1],["line",370.6,136.9,361.6,136.0,1],["line",150.0,60.0,150.0,114.0,1],["line",150.0,114.0,145.4,106.3,1],["line",150.0,114.0,154.6,106.3,1],["line",150.0,200.0,150.0,146.0,1],["line",150.0,146.0,154.6,153.7,1],["line",150.0,146.0,145.4,153.7,1],["line",164.6,48.6,254.5,71.1,1],["line",254.5,71.1,245.9,73.7,1],["line",254.5,71.1,248.1,64.7,1],["line",163.6,123.8,255.5,81.7,1],["line",255.5,81.7,250.4,89.1,1],["line",255.5,81.7,246.5,80.7,1],["line",163.6,136.2,255.5,178.3,1],["line",255.5,178.3,246.5,179.3,1],["line",255.5,178.3,250.4,170.9,1],["line",164.6,211.4,254.5,188.9,1],["line",254.5,188.9,248.1,195.3,1],["line",254.5,188.9,245.9,186.3,1],["line",270.0,90.0,270.0,169.0,1],["line",270.0,169.0,265.4,161.3,1],["line",270.0,169.0,274.6,161.3,1],["circle",40.0,130.0,15.0,1],["text",40.0,130.0,"А","c"],["circle",150.0,45.0,15.0,1],["text",150.0,45.0,"Б","c"],["circle",150.0,130.0,15.0,1],["text",150.0,130.0,"В","c"],["circle",150.0,215.0,15.0,1],["text",150.0,215.0,"Г","c"],["circle",270.0,75.0,15.0,1],["text",270.0,