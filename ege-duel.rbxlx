          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "geography", "tasks": [
{"id":"geography-001","group":"рекорды","text":"Назовите самое глубокое озеро мира. Запишите одно слово.","answers":["Байкал"],"points":1,"kind":"exact","explanation":"Глубина Байкала превышает 1600 метров."},
{"id":"geography-002","group":"рекорды","text":"Назовите высочайшую вершину России. Запишите одно слово.","answers":["Эльбрус"],"points":1,"kind":"exact","explanation":"Высота Эльбруса 5642 метра."},
{"id":"geography-003","group":"рекорды","text":"Назовите высочайшую вершину мира. Запишите одно слово.","answers":["Эверест","Джомолунгма"],"points":1,"kind":"exact","explanation":"Эверест, он же Джомолунгма, имеет высоту около 8849 метров."},
{"id":"geography-004","group":"рекорды","text":"Назовите самый большой по площади материк. Запишите одно слово.","answers":["Евразия"],"points":1,"kind":"exact","explanation":"Площадь Евразии около 54 млн км²."},
{"id":"geography-005","group":"рекорды","text":"Назовите самый маленький по площади материк. Запишите одно слово.","answers":["Австралия"],"points":1,"kind":"exact","explanation":"Площадь Австралии около 7,7 млн км²."},
{"id":"geography-006","group":"рекорды","text":"Назовите самый большой океан Земли. Запишите одно слово.","answers":["Тихий","Тихий океан"],"points":1,"kind":"exact","explanation":"Тихий океан занимает около трети поверхности планеты."},
{"id":"geography-007","group":"рекорды","text":"Назовите крупнейшую жаркую пустыню мира. Запишите одно слово.","answers":["Сахара"],"points":1,"kind":"exact","explanation":"Сахара расположена на севере Африки."},
{"id":"geography-008","group":"столицы","text":"Какой город является столицей Австралии? Запишите номер ответа.\n1) Сидней\n2) Мельбурн\n3) Канберра\n4) Перт","answers":["3"],"points":1,"kind":"exact","explanation":"Столица Австралии Канберра."},
{"id":"geography-009","group":"столицы","text":"Какой город является столицей Канады? Запишите номер ответа.\n1) Торонто\n2) Оттава\n3) Монреаль\n4) Ванкувер","answers":["2"],"points":1,"kind":"exact","explanation":"Столица Канады Оттава."},
{"id":"geography-010","group":"столицы","text":"Какой город является столицей Бразилии? Запишите номер ответа.\n1) Бразилиа\n2) Рио-де-Жанейро\n3) Сан-Паулу\n4) Буэнос-Айрес","answers":["1"],"points":1,"kind":"exact","explanation":"Столица Бразилии город Бразилиа."},
{"id":"geography-011","group":"столицы","text":"Какой город является столицей Турции? Запишите номер ответа.\n1) Стамбул\n2) Измир\n3) Анталья\n4) Анкара","answers":["4"],"points":1,"kind":"exact","explanation":"Столица Турции Анкара."},
{"id":"geography-012","group":"общие сведения","text":"Сколько часовых зон установлено на территории России?","answers":["11"],"points":1,"kind":"number","explanation":"В России 11 часовых зон."},
{"id":"geography-013","group":"общие сведения","text":"Сколько материков на Земле?","answers":["6"],"points":1,"kind":"number","explanation":"Евразия, Африка, Северная Америка, Южная Америка, Австралия, Антарктида."},
{"id":"geography-014","group":"общие сведения","text":"Через какой город проходит нулевой (Гринвичский) меридиан? Запишите номер ответа.\n1) Париж\n2) Лондон\n3) Берлин\n4) Мадрид","answers":["2"],"points":1,"kind":"exact","explanation":"Гринвич это район Лондона."},
{"id":"geography-015","group":"общие сведения","text":"Какой пролив разделяет Евразию и Северную Америку? Запишите одно слово.","answers":["Берингов","Берингов пролив"],"points":1,"kind":"exact","explanation":"Берингов пролив соединяет Северный Ледовитый и Тихий океаны."},
{"id":"geography-016","group":"общие сведения","text":"В каком океане находится Марианская впадина? Запишите номер ответа.\n1) Атлантический\n2) Индийский\n3) Тихий\n4) Северный Ледовитый","answers":["3"],"points":1,"kind":"exact","explanation":"Марианская впадина находится на западе Тихого океана."},
{"id":"geography-017","group":"общие сведения","text":"Какая природная зона занимает наибольшую площадь в России? Запишите номер ответа.\n1) тундра\n2) тайга\n3) степь\n4) смешанные леса","answers":["2"],"points":1,"kind":"exact","explanation":"Тайга занимает большую часть Сибири и север Европейской России."},
{"id":"geography-018","group":"масштаб","text":"Масштаб карты 1 : 100 000. Сколько километров на местности соответствует отрезку длиной 5 см на карте?","answers":["5"],"points":1,"kind":"number","explanation":"В 1 см 1 км, значит 5 см это 5 км."},
{"id":"geography-019","group":"масштаб","text":"Масштаб карты 1 : 50 000. Сколько километров на местности соответствует отрезку длиной 4 см на карте?","answers":["2"],"points":1,"kind":"number","explanation":"В 1 см 0,5 км, значит 4 см это 2 км."},
{"id":"geography-020","group":"масштаб","text":"Масштаб карты 1 : 25 000. Сколько километров на местности соответствует отрезку длиной 12 см на карте?","answers":["3"],"points":1,"kind":"number","explanation":"В 1 см 0,25 км, значит 12 см это 3 км."},
{"id":"geography-021","group":"атмосфера","text":"У подножия горы температура воздуха равна +20 °C. Какой будет температура на высоте 2000 м, если она понижается на 6 °C на каждый километр подъёма? Ответ дайте в градусах.","answers":["8"],"points":1,"kind":"number","explanation":"20 - 6 · 2 = 8 °C."},
{"id":"geography-022","group":"атмосфера","text":"У подножия горы температура воздуха равна +15 °C. Какой будет температура на высоте 3000 м, если она понижается на 6 °C на каждый километр подъёма? Ответ дайте в градусах.","answers":["-3"],"points":1,"kind":"number","explanation":"15 - 6 · 3 = -3 °C."},
{"id":"geography-023","group":"атмосфера","text":"У подножия холма атмосферное давление равно 760 мм рт. ст. Каким оно будет на вершине на высоте 210 м, если давление падает на 1 мм рт. ст. на каждые 10,5 м подъёма?","answers":["740"],"points":1,"kind":"number","explanation":"210 : 10,5 = 20; 760 - 20 = 740 мм рт. ст."},
{"id":"geography-024","group":"время","text":"В Москве (UTC+3) полдень, 12 часов. Сколько часов в этот момент в Новосибирске (UTC+7)?","answers":["16"],"points":1,"kind":"number","explanation":"Разница 4 часа: 12 + 4 = 16."},
{"id":"geography-025","group":"время","text":"В Екатеринбурге (UTC+5) 9 часов утра. Сколько часов в этот момент во Владивостоке (UTC+10)?","answers":["14"],"points":1,"kind":"number","explanation":"Разница 5 часов: 9 + 5 = 14."},
{"id":"geography-026","group":"население","text":"В городе живёт 500 тысяч человек. За год родилось 6 тысяч человек, умерло 4 тысячи. Найдите естественный прирост населения в расчёте на 1000 жителей.","answers":["4"],"points":1,"kind":"number","explanation":"(6000 - 4000) : 500 000 · 1000 = 4."},
{"id":"geography-027","group":"население","text":"Площадь района равна 200 км², в нём живёт 50 тысяч человек. Найдите плотность населения. Ответ дайте в человеках на квадратный километр.","answers":["250"],"points":1,"kind":"number","explanation":"50 000 : 200 = 250 человек на км²."},
{"id":"geography-028","group":"положение","text":"Расположите города с запада на восток. Запишите цифры без пробелов.\n1) Новосибирск\n2) Калининград\n3) Владивосток\n4) Москва","answers":["2413"],"points":1,"kind":"order","explanation":"Калининград, Москва, Новосибирск, Владивосток."},
{"id":"geography-029","group":"положение","text":"Расположите города с севера на юг. Запишите цифры без пробелов.\n1) Мурманск\n2) Сочи\n3) Москва\n4) Санкт-Петербург","answers":["1432"],"points":1,"kind":"order","explanation":"Мурманск, Санкт-Петербург, Москва, Сочи."},
{"id":"geography-030","group":"положение","text":"Какие из стран имеют сухопутную границу с Россией? Запишите номера без пробелов.\n1) Финляндия\n2) Турция\n3) Казахстан\n4) Иран\n5) Монголия","answers":["135"],"points":2,"kind":"set","explanation":"С Россией граничат Финляндия, Казахстан и Монголия. С Турцией и Ираном общей сухопутной границы нет."},
{"id":"geography-031","group":"geo_capital","text":"Какой город является столицей Португалии? Запишите номер ответа.\n1) Душанбе\n2) Лиссабон\n3) Найроби\n4) Эр-Рияд","answers":["2"],"points":1,"kind":"exact","explanation":"Столица Португалии: Лиссабон."},
{"id":"geography-032","group":"geo_capital","text":"Какой город является столицей Эфиопии? Запишите номер ответа.\n1) Лондон\n2) Брюссель\n3) Аддис-Абеба\n4) Улан-Батор","answers":["3"],"points":1,"kind":"exact","explanation":"Столица Эфиопии: Аддис-Абеба."},
{"id":"geography-033","group":"geo_capital","text":"Какой город является столицей Китая? Запишите номер ответа.\n1) Пекин\n2) Ханой\n3) Сеул\n4) Бангкок","answers":["1"],"points":1,"kind":"exact","explanation":"Столица Китая: Пекин."},
{"id":"geography-034","group":"geo_capital","text":"Какой город является столицей Монголии? Запишите номер ответа.\n1) Улан-Батор\n2) Токио\n3) Мадрид\n4) Брюссель","answers":["1"],"points":1,"kind":"exact","explanation":"Столица Монголии: Улан-Батор."},
{"id":"geography-035","group":"geo_capital","text":"Какой город является столицей Аргентины? Запишите номер ответа.\n1) Бангкок\n2) Буэнос-Айрес\n3) Тегеран\n4) Вена","answers":["2"],"points":1,"kind":"exact","explanation":"Столица Аргентины: Буэнос-Айрес."},
{"id":"geography-036","group":"geo_capital","text":"Какой город является столицей Армении? Запишите номер ответа.\n1) Ереван\n2) Тегеран\n3) Брюссель\n4) Стокгольм","answers":["1"],"points":1,"kind":"exact","explanation":"Столица Армении: Ереван."},
{"id":"geography-037","group":"geo_capital","text":"Какой город является столицей Франции? Запишите номер ответа.\n1) Тбилиси\n2) София\n3) Астана\n4) Париж","answers":["4"],"points":1,"kind":"exact","explanation":"Столица Франции: Париж."},
{"id":"geography-038","group":"geo_capital","text":"Какой город является столицей Таджикистана? Запишите номер ответа.\n1) Вена\n2) Сантьяго\n3) Душанбе\n4) Варшава","answers":["3"],"points":1,"kind":"exact","explanation":"Столица Таджикистана: Душанбе."},
