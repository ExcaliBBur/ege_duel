        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">Perf</string>
            <string name="Source"><![CDATA[-- Диагностика производительности. Работает только при запуске в Studio: раз в 5 секунд пишет в Output
-- строку с меткой EGEPERF (частота кадров, время процессора и видеокарты на кадр, самый долгий кадр).
-- По этим строкам в журнале Studio можно понять, на каком экране игра тормозит.
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Perf = {}

local phase = "класс"

-- Название текущего экрана, попадает в строку диагностики.
function Perf.setPhase(name: string)
	phase = name
end

function Perf.start()
	if not RunService:IsStudio() then
		return
	end
	local frames, cpu, gpu, worst, since = 0, 0, 0, 0, os.clock()
	RunService.RenderStepped:Connect(function(dt: number)
		frames += 1
		cpu += Stats.RenderCPUFrameTime
		gpu += Stats.RenderGPUFrameTime
		worst = math.max(worst, dt)
		local elapsed = os.clock() - since
		if elapsed >= 5 then
			print(string.format(
				"EGEPERF экран=%s кадров_в_секунду=%.0f процессор_мс=%.1f видеокарта_мс=%.1f худший_кадр_мс=%.0f скрипты_мс=%.2f",
				phase, frames / elapsed, cpu / frames * 1000, gpu / frames * 1000, worst * 1000, Stats.HeartbeatTime * 1000
			))
			frames, cpu, gpu, worst, since = 0, 0, 0, 0, os.clock()
		end
	end)
end

return Perf
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">Reference</string>
            <string name="Source"><![CDATA[-- Справочные материалы, которые выдают на экзамене: таблица Менделеева и ряд активности металлов
-- для химии, справочные данные для физики, формулы для математики, калькулятор там, где он разрешён.
-- Вкладки строятся только при открытии и удаляются при закрытии, чтобы не держать лишние объекты.
local Ui = require(script.Parent.Ui)
local Calculator = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Calculator)

local Reference = {}

local C = Ui.colors

-- Символ и относительная атомная масса, округлённая как в школьной таблице. Индекс равен порядковому номеру.
local ELEMENTS = {
	{ "H", "1" }, { "He", "4" }, { "Li", "7" }, { "Be", "9" }, { "B", "11" }, { "C", "12" }, { "N", "14" },
	{ "O", "16" }, { "F", "19" }, { "Ne", "20" }, { "Na", "23" }, { "Mg", "24" }, { "Al", "27" }, { "Si", "28" },
	{ "P", "31" }, { "S", "32" }, { "Cl", "35,5" }, { "Ar", "40" }, { "K", "39" }, { "Ca", "40" }, { "Sc", "45" },
	{ "Ti", "48" }, { "V", "51" }, { "Cr", "52" }, { "Mn", "55" }, { "Fe", "56" }, { "Co", "59" }, { "Ni", "59" },
	{ "Cu", "64" }, { "Zn", "65" }, { "Ga", "70" }, { "Ge", "73" }, { "As", "75" }, { "Se", "79" }, { "Br", "80" },
	{ "Kr", "84" }, { "Rb", "85" }, { "Sr", "88" }, { "Y", "89" }, { "Zr", "91" }, { "Nb", "93" }, { "Mo", "96" },
	{ "Tc", "98" }, { "Ru", "101" }, { "Rh", "103" }, { "Pd", "106" }, { "Ag", "108" }, { "Cd", "112" },
	{ "In", "115" }, { "Sn", "119" }, { "Sb", "122" }, { "Te", "128" }, { "I", "127" }, { "Xe", "131" },
	{ "Cs", "133" }, { "Ba", "137" }, { "La", "139" }, { "Ce", "140" }, { "Pr", "141" }, { "Nd", "144" },
	{ "Pm", "145" }, { "Sm", "150" }, { "Eu", "152" }, { "Gd", "157" }, { "Tb", "159" }, { "Dy", "163" },
	{ "Ho", "165" }, { "Er", "167" }, { "Tm", "169" }, { "Yb", "173" }, { "Lu", "175" }, { "Hf", "178" },
	{ "Ta", "181" }, { "W", "184" }, { "Re", "186" }, { "Os", "190" }, { "Ir", "192" }, { "Pt", "195" },
	{ "Au", "197" }, { "Hg", "201" }, { "Tl", "204" }, { "Pb", "207" }, { "Bi", "209" }, { "Po", "209" },
	{ "At", "210" }, { "Rn", "222" }, { "Fr", "223" }, { "Ra", "226" }, { "Ac", "227" }, { "Th", "232" },
	{ "Pa", "231" }, { "U", "238" }, { "Np", "237" }, { "Pu", "244" }, { "Am", "243" }, { "Cm", "247" },
	{ "Bk", "247" }, { "Cf", "251" }, { "Es", "252" }, { "Fm", "257" }, { "Md", "258" }, { "No", "259" },
	{ "Lr", "262" }, { "Rf", "267" }, { "Db", "268" }, { "Sg", "269" }, { "Bh", "270" }, { "Hs", "277" },
	{ "Mt", "278" }, { "Ds", "281" }, { "Rg", "282" }, { "Cn", "285" }, { "Nh", "286" }, { "Fl", "289" },
	{ "Mc", "290" }, { "Lv", "293" }, { "Ts", "294" }, { "Og", "294" },
}

-- Место элемента в длинной форме таблицы: строка (1-7 периоды, 8 лантаноиды, 9 актиноиды) и столбец (группа).
local function placeOf(number: number): (number, number)
	if number == 1 then
		return 1, 1
	elseif number == 2 then
		return 1, 18
	elseif number <= 10 then
		return 2, if number <= 4 then number - 2 else number + 8
	elseif number <= 18 then
		return 3, if number <= 12 then number - 10 else number
	elseif number <= 36 then
		return 4, number - 18
	elseif number <= 54 then
		return 5, number - 36
	elseif number <= 57 then
		return 6, number - 54
	elseif number <= 71 then
		return 8, number - 54 -- лантаноиды: церий в 4-м столбце
	elseif number <= 86 then
		return 6, number - 68
	elseif number <= 89 then
		return 7, number - 86
	elseif number <= 103 then
		return 9, number - 86 -- актиноиды: торий в 4-м столбце
	end
	return 7, number - 100
end

local BLOCK_COLORS = {
	s = Color3.fromRGB(251, 227, 237),
	p = Color3.fromRGB(251, 239, 211),
	d = Color3.fromRGB(221, 241, 242),
	f = Color3.fromRGB(223, 243, 231),
}

local function blockOf(row: number, column: number, number: number): string
	if row >= 8 then
		return "f"
	elseif column <= 2 or number == 2 then
		return "s"
	elseif column >= 13 then
		return "p"
	end
	return "d"
end

local function buildPeriodicTable(parent: Instance)
	local cellWidth, cellHeight = 47, 46
	local left, top = 12, 8
	for number, element in ELEMENTS do
		local row, column = placeOf(number)
		local y = top + (row - 1) * cellHeight + (if row >= 8 then 14 else 0)
		local cell = Ui.frame({
			Position = UDim2.fromOffset(left + (column - 1) * cellWidth, y),
			Size = UDim2.fromOffset(cellWidth - 2, cellHeight - 2),
			BackgroundColor3 = BLOCK_COLORS[blockOf(row, column, number)],
			Parent = parent,
		})
		Ui.label({
			Text = tostring(number),
			TextSize = 10,
			TextColor3 = C.muted,
			TextWrapped = false,
			Position = UDim2.fromOffset(3, 1),
			Size = UDim2.fromOffset(30, 11),
			Parent = cell,
		})
		Ui.label({
			Text = element[1],
			Font = Ui.fonts.bold,
			TextSize = 17,
			TextWrapped = false,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 11),
			Size = UDim2.new(1, 0, 0, 20),
			Parent = cell,
		})
		Ui.label({
			Text = element[2],
			TextSize = 10,
			TextWrapped = false,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, 31),
			Size = UDim2.new(1, 0, 0, 12),
			Parent = cell,
		})
	end
	Ui.label({
		Text = "В клетке: порядковый номер, символ, относительная атомная масса. Строки внизу: лантаноиды (58-71) и актиноиды (90-103). "
			.. "Номер периода равен номеру строки, номер группы равен номеру столбца.",
		TextSize = 13,
		TextColor3 = C.muted,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(left, top + 9 * cellHeight + 22),
		Size = UDim2.new(1, -24, 0, 40),
		Parent = parent,
	})
end

local function buildSheet(parent: Instance, text: string)
	local scroll = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 1, -16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = parent,
	})
	Ui.label({
		Text = text,
		TextSize = 17,
		LineHeight = 1.25,
		TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, -14, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = scroll,
	})
end

local CALCULATOR_KEYS = {
	{ "C", "←", "√", "÷" },
	{ "7", "8", "9", "×" },
	{ "4", "5", "6", "-" },
	{ "1", "2", "3", "+" },
	{ "±", "0", ",", "=" },
}

local function buildCalculator(parent: Instance)
	local press = Calculator.new()
	local holder = Ui.frame({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 16),
		Size = UDim2.fromOffset(368, 420),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local display = Ui.label({
		Name = "Display",
		Text = "0",
		Font = Ui.fonts.mono,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.sunken,
		Size = UDim2.new(1, 0, 0, 64),
		Parent = holder,
	})
	Ui.corner(8).Parent = display
	Ui.new("UIPadding", { PaddingRight = UDim.new(0, 14), Parent = display })
	for rowIndex, row in CALCULATOR_KEYS do
		for columnIndex, key in row do
			local isAction = not string.match(key, "^[%d,]$")
			local button = Ui.button(key, if key == "=" then "primary" elseif isAction then "selected" else "plain", {
				Name = "Key" .. key,
				TextSize = 22,
				Position = UDim2.fromOffset((columnIndex - 1) * 94, 76 + (rowIndex - 1) * 66),
				Size = UDim2.fromOffset(86, 58),
				Parent = holder,
			})
			button.Activated:Connect(function()
				display.Text = press(key)
			end)
		end
	end
	Ui.label({
		Text = "Обычный непрограммируемый калькулятор, как разрешено на экзамене.",
		TextSize = 13,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 444),
		Size = UDim2.fromOffset(600, 20),
		Parent = parent,
	})
end

local ACTIVITY_SERIES = [[Электрохимический ряд напряжений металлов

Li   K   Ba   Ca   Na   Mg   Al   Mn   Zn   Cr   Fe   Co   Ni   Sn   Pb   (H₂)   Cu   Hg   Ag   Pt   Au

Слева направо активность металлов уменьшается.

Металлы, стоящие левее водорода, вытесняют водород из растворов кислот. Металлы правее водорода с растворами кислот без окислительных свойств не реагируют.

Более активный металл вытесняет менее активный из раствора его соли. Самые активные металлы (от Li до Na) в растворе реагируют прежде всего с водой.]]

local PHYSICS_SHEET = [[Десятичные приставки
гига (Г) 10⁹     мега (М) 10⁶     кило (к) 10³     гекто (г) 10²
деци (д) 10⁻¹     санти (с) 10⁻²     милли (м) 10⁻³     микро (мк) 10⁻⁶     нано (н) 10⁻⁹     пико (п) 10⁻¹²

Константы
число π = 3,14
ускорение свободного падения на Земле g = 10 м/с²
гравитационная постоянная G = 6,7 · 10⁻¹¹ Н·м²/кг²
универсальная газовая постоянная R = 8,31 Дж/(моль·К)
постоянная Больцмана k = 1,38 · 10⁻²³ Дж/К
постоянная Авогадро N = 6 · 10²³ моль⁻¹
скорость света в вакууме c = 3 · 10⁸ м/с
коэффициент в законе Кулона k = 9 · 10⁹ Н·м²/Кл²
модуль заряда электрона e = 1,6 · 10⁻¹⁹ Кл
постоянная Планка h = 6,6 · 10⁻³⁴ Дж·с

Соотношения между единицами
температура: 0 К = -273 °C
атомная единица массы: 1 а. е. м. = 1,66 · 10⁻²⁷ кг
1 электронвольт: 1 эВ = 1,6 · 10⁻¹⁹ Дж

Массы частиц
электрон 9,1 · 10⁻³¹ кг     протон 1,673 · 10⁻²⁷ кг     нейтрон 1,675 · 10⁻²⁷ кг

Плотность, кг/м³
вода 1000     древесина (сосна) 400     керосин 800     подсолнечное масло 900
алюминий 2700     железо 7800     ртуть 13 600

Удельная теплоёмкость, Дж/(кг·К)
вода 4200     лёд 2100     железо 460     свинец 130     алюминий 900     медь 380     чугун 500

Удельная теплота
парообразования воды 2,3 · 10⁶ Дж/кг     плавления льда 3,3 · 10⁵ Дж/кг     плавления свинца 2,5 · 10⁴ Дж/кг

Нормальные условия: давление 10⁵ Па, температура 0 °C

Молярная масса, г/моль
водород 2     гелий 4     литий 6     неон 20     азот 28     воздух 29     кислород 32     аргон 40
вода 18     углекислый газ 44]]

local MATH_PROFILE_SHEET = [[Справочные материалы

sin²α + cos²α = 1

sin 2α = 2 · sin α · cos α

cos 2α = cos²α - sin²α

sin (α + β) = sin α · cos β + cos α · sin β

cos (α + β) = cos α · cos β - sin α · sin β]]

local MATH_BASE_SHEET = [[Формулы сокращённого умножения
(a + b)² = a² + 2ab + b²     (a - b)² = a² - 2ab + b²     a² - b² = (a + b)(a - b)

Степени (знак ^ означает возведение в степень)
a^n · a^m = a^(n+m)     a^n : a^m = a^(n-m)     (a^n)^m = a^(n·m)     a^(-n) = 1 : a^n     a⁰ = 1

Квадратный корень
√(a · b) = √a · √b     √(a : b) = √a : √b     (√a)² = a

Квадратное уравнение ax² + bx + c = 0
D = b² - 4ac     x = (-b ± √D) : (2a)

Прогрессии
арифметическая: n-й член равен a₁ + d · (n - 1), сумма первых n членов равна (a₁ + aₙ) · n : 2
геометрическая: n-й член равен b₁ · q^(n-1)

Логарифмы
log (b · c) = log b + log c     log (b : c) = log b - log c     log (b^n) = n · log b
(основание логарифмов одинаковое)

Вероятность
P = m : n, где m это число благоприятных исходов, n это число всех исходов

Таблица квадратов
11² = 121   12² = 144   13² = 169   14² = 196   15² = 225   16² = 256   17² = 289   18² = 324   19² = 361
20² = 400   21² = 441   22² = 484   23² = 529   24² = 576   25² = 625

Площади
треугольник: a · h : 2     прямоугольный треугольник: a · b : 2, c² = a² + b²
прямоугольник: a · b     параллелограмм: a · h     трапеция: (a + b) : 2 · h
круг: πr²     длина окружности: 2πr

Объёмы и поверхности
куб: a³     прямоугольный параллелепипед: a · b · c     цилиндр: πr²h     конус: πr²h : 3
шар: 4πr³ : 3     площадь сферы: 4πr²

Значения тригонометрических функций
угол      0°     30°     45°     60°     90°
sin       0      1/2     √2/2    √3/2    1
cos       1      √3/2    √2/2    1/2     0
tg        0      √3/3    1       √3      нет

sin²α + cos²α = 1     tg α = sin α : cos α]]

-- Какие вкладки есть у предмета. Если предмета здесь нет, справочных материалов на экзамене не дают.
local TABS = {
	chemistry = {
		{ title = "Таблица Менделеева", build = buildPeriodicTable },
		{ title = "Ряд активности металлов", build = function(parent)
			buildSheet(parent, ACTIVITY_SERIES)
		end },
		{ title = "Калькулятор", build = buildCalculator },
	},
	physics = {
		{ title = "Справочные данные", build = function(parent)
			buildSheet(parent, PHYSICS_SHEET)
		end },
		{ title = "Калькулятор", build = buildCalculator },
	},
	math_base = {
		{ title = "Формулы", build = function(parent)
			buildSheet(parent, MATH_BASE_SHEET)
		end },
	},
	math_prof = {
		{ title = "Формулы", build = function(parent)
			buildSheet(parent, MATH_PROFILE_SHEET)
		end },
	},
	geography = {
		{ title = "Калькулятор", build = buildCalculator },
	},
}

function Reference.hasMaterials(subjectId: string): boolean
	return TABS[subjectId] ~= nil
end

-- Создаёт окно справочных материалов поверх экрана экзамена. Возвращает { open(subjectId), close(), isOpen() }.
function Reference.create(parent: Instance)
	local panel = {}
	local content: Frame? = nil
	local tabButtons = {}

	local frame = Ui.frame({
		Name = "Reference",
		Size = UDim2.fromScale(1, 1),
		Active = true,
		Visible = false,
		ZIndex = 25,
		Parent = parent,
	}, { Ui.corner(14) })
	local header = Ui.frame({ Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.sunken, Parent = frame }, { Ui.corner(14) })
	Ui.label({
		Text = "Справочные материалы",
		Font = Ui.fonts.bold,
		TextSize = 18,
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.fromOffset(260, 56),
		Parent = header,
	})
	local closeButton = Ui.button("Вернуться к заданию", "primary", {
		Name = "Close",
		Position = UDim2.new(1, -236, 0, 9),
		Size = UDim2.fromOffset(220, 38),
		Parent = header,
	})
	local tabRow = Ui.frame({
		Position = UDim2.fromOffset(20, 64),
		Size = UDim2.new(1, -40, 0, 36),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	local body = Ui.frame({
		Name = "Body",
		Position = UDim2.fromOffset(20, 106),
		Size = UDim2.new(1, -40, 1, -122),
		BackgroundTransparency = 1,
		Parent = frame,
	})

	local function clear()
		if content then
			content:Destroy()
			content = nil
		end
	end

	local function showTab(tabs, index: number)
		clear()
		content = Ui.frame({ Name = "Content", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = body })
		tabs[index].build(content)
		for buttonIndex, button in tabButtons do
			Ui.styleButton(button, if buttonIndex == index then "selected" else "plain")
		end
	end

	function panel.open(subjectId: string)
		local tabs = TABS[subjectId]
		if not tabs then
			return
		end
		for _, button in tabButtons do
			button:Destroy()
		end
		tabButtons = {}
		for index, tab in tabs do
			local button = Ui.button(tab.title, "plain", {
				Name = "Tab" .. index,
				TextSize = 15,
				Position = UDim2.fromOffset((index - 1) * 250, 0),
				Size = UDim2.fromOffset(240, 36),
				Parent = tabRow,
			})
			button.Activated:Connect(function()
				showTab(tabs, index)
			end)
			tabButtons[index] = button
		end
		showTab(tabs, 1)
		frame.Visible = true
	end

	function panel.close()
		frame.Visible = false
		clear()
	end

	function panel.isOpen(): boolean
		return frame.Visible
	end

	closeButton.Activated:Connect(panel.close)
	return panel
end

return Reference
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">ResultsScreen</string>
            <string name="Source"><![CDATA[-- Экран итогов: исход, баллы и число верных ответов у обоих, разбор своей работы, реванш.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Ui = require(script.Parent.Ui)
local Figure = require(script.Parent.Figure)

local ResultsScreen = {}

local C = Ui.colors

local OUTCOME_TITLES = { win = "Победа", lose = "Поражение", draw = "Ничья" }

local function reasonText(outcome: string, reason: string): string
	if reason == "walkover" then
		return if outcome == "win" then "Соперник вышел из игры" else "Вы вышли из игры"
	elseif outcome == "draw" then
		return "Доля баллов и время сдачи совпали"
	elseif reason == "time" then
		return "Доля баллов равная, победил сдавший работу раньше"
	end
	return "Сравниваем долю набранных баллов от максимума по своему предмету"
end

-- Карточка игрока. Возвращает функцию заполнения.
local function scoreCard(parent: Instance, x: number, mine: boolean)
	local card = Ui.frame({
		Position = UDim2.fromOffset(x, 84),
		Size = UDim2.fromOffset(430, 150),
		Parent = parent,
	}, { Ui.corner(10) })
	local stroke = Ui.stroke(C.line, 1.5)
	stroke.Parent = card

	local pill = Ui.pill("", if mine then C.accent else C.rival, if mine then C.accentSoft else C.rivalSoft, {
		Position = UDim2.fromOffset(14, 12),
		Size = UDim2.fromOffset(402, 26),
		BackgroundTransparency = 0,
		Parent = card,
	})
	local percent = Ui.label({
		Font = Ui.fonts.display,
		TextSize = 44,
		Position = UDim2.fromOffset(14, 46),
		Size = UDim2.fromOffset(150, 56),
		Parent = card,
	})
	local points = Ui.label({ TextSize = 15, Position = UDim2.fromOffset(170, 48), Size = UDim2.fromOffset(250, 22), Parent = card })
	local correct = Ui.label({
		TextSize = 15,
		Font = Ui.fonts.bold,
		Position = UDim2.fromOffset(170, 72),
		Size = UDim2.fromOffset(250, 22),
		Parent = card,
	})
	local extra = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		Position = UDim2.fromOffset(14, 110),
		Size = UDim2.fromOffset(402, 30),
		Parent = card,
	})

	return function(data, winner: boolean)
		pill.Text = string.format("%s · %s", if mine then "Вы" else data.name, Subjects.nameOf(data.subject))
		percent.Text = data.percent .. "%"
		points.Text = string.format(
			"%d из %d %s",
			data.earned,
			data.max,
			Ui.plural(data.max, "первичного балла", "первичных баллов", "первичных баллов")
		)
		correct.Text = string.format("Верных ответов: %d из %d", data.correct, data.total)
		local parts = {}
		if data.partial > 0 then
			table.insert(parts, "частично верных: " .. data.partial)
		end
		table.insert(parts, "без ответа: " .. (data.total - data.answered))
		table.insert(parts, "время: " .. Ui.clock(data.elapsed))
		extra.Text = table.concat(parts, " · ")
		stroke.Color = if winner then (if mine then C.accent else C.rival) else C.line
		stroke.Thickness = if winner then 3 else 1.5
	end
end

-- actions: rematch(), leave()
function ResultsScreen.create(parent: Instance, actions)
	local screen = {}
	local state = nil
	local onlyMistakes = true

	local frame = Ui.frame({ Name = "Results", Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent }, { Ui.corner(14) })

	local header = Ui.frame({ Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = C.sunken, Parent = frame }, { Ui.corner(14) })
	local title = Ui.label({
		Font = Ui.fonts.display,
		TextSize = 26,
		Position = UDim2.fromOffset(20, 8),
		Size = UDim2.new(1, -40, 0, 32),
		Parent = header,
	})
	local reason = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		Position = UDim2.fromOffset(20, 40),
		Size = UDim2.new(1, -40, 0, 22),
		Parent = header,
	})

	local fillMine = scoreCard(frame, 20, true)
	local fillRival = scoreCard(frame, 470, false)

	Ui.caption("РАЗБОР ВАШЕЙ РАБОТЫ", { Position = UDim2.fromOffset(20, 250), Size = UDim2.fromOffset(400, 16), Parent = frame })
	local filterButton = Ui.button("", "plain", {
		TextSize = 14,
		Position = UDim2.new(1, -220, 0, 242),
		Size = UDim2.fromOffset(200, 30),
		Parent = frame,
	})

	local list = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 280),
		Size = UDim2.new(1, -40, 0, 262),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	}, {
		Ui.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local emptyNote = Ui.label({
		Text = "Ошибок нет. Все ответы верные.",
		TextColor3 = C.ok,
		Font = Ui.fonts.bold,
		Position = UDim2.fromOffset(20, 290),
		Size = UDim2.new(1, -40, 0, 30),
		Visible = false,
		Parent = frame,
	})

	local leaveButton = Ui.button("Встать из-за стола", "plain", {
		Position = UDim2.new(0, 20, 1, -64),
		Size = UDim2.fromOffset(210, 44),
		Parent = frame,
	})
	leaveButton.Activated:Connect(actions.leave)

	local rematchNote = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0, 240, 1, -64),
		Size = UDim2.new(1, -480, 0, 44),
		Parent = frame,
	})
	local rematchButton = Ui.button("Реванш", "primary", {
		Position = UDim2.new(1, -220, 1, -64),
		Size = UDim2.fromOffset(200, 44),
		Parent = frame,
	})
	rematchButton.Activated:Connect(function()
		if state and state.rivalPresent and not state.rematch.me then
			actions.rematch()
		end
	end)

	local function reviewRow(index: number, item)
		local full = item.earned == item.points
		local row = Ui.frame({
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = if full then C.okSoft elseif item.earned > 0 then C.warnSoft else C.dangerSoft,
			LayoutOrder = index,
		}, {
			Ui.corner(8),
			Ui.new("UIPadding", {
				PaddingTop = UDim.new(0, 10),
				PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
			}),
			Ui.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		})

		local yours = if item.your == "" then "ответа нет" else "ваш ответ: " .. item.your
		Ui.label({
			Text = string.format("№ %d · %d из %d · %s · верно: %s", item.number or index, item.earned, item.points, yours, item.correct),
			Font = Ui.fonts.bold,
			TextSize = 15,
			TextColor3 = if full then C.ok elseif item.earned > 0 then C.warn else C.danger,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			Parent = row,
		})
		Ui.label({
			Text = item.text,
			TextSize = 14,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			Parent = row,
		})
		local figure = Figure.render(item.figure, row)
		if figure then
			figure.LayoutOrder = 3
		end
		if item.explanation and item.explanation ~= "" then
			Ui.label({
				Text = "Пояснение: " .. item.explanation,
				TextSize = 14,
				TextColor3 = C.muted,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextYAlignment = Enum.TextYAlignment.Top,
				LayoutOrder = 4,
				Parent = row,
			})
		end
		return row
	end

	local function renderReview()
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local shown = 0
		for index, item in state.review do
			if not onlyMistakes or item.earned < item.points then
				reviewRow(index, item).Parent = list
				shown += 1
			end
		end
		list.CanvasPosition = Vector2.zero
		emptyNote.Visible = shown == 0
		filterButton.Text = if onlyMistakes then "Показать все задания" else "Показать только ошибки"
	end

	filterButton.Activated:Connect(function()
		if state then
			onlyMistakes = not onlyMistakes
			renderReview()
		end
	end)

	local function renderRematch()
		if not state.rivalPresent then
			rematchNote.Text = "Соперник ушёл. Можно остаться за партой и подождать нового."
			rematchButton.Text = "Реванш"
			Ui.styleButton(rematchButton, "disabled")
		elseif state.rematch.me then
			rematchNote.Text = "Ждём ответа соперника."
			rematchButton.Text = "Реванш предложен"
			Ui.styleButton(rematchButton, "disabled")
		elseif state.rematch.rival then
			rematchNote.Text = "Соперник хочет реванш."
			rematchButton.Text = "Принять реванш"
			Ui.styleButton(rematchButton, "primary")
		else
			rematchNote.Text = "Перед реваншем можно сменить предмет и настройки."
			rematchButton.Text = "Реванш"
			Ui.styleButton(rematchButton, "primary")
		end
	end

	function screen.show(newState)
		state = newState
		onlyMistakes = true

		title.Text = OUTCOME_TITLES[state.outcome] or "Итоги"
		title.TextColor3 = if state.outcome == "win" then C.ok elseif state.outcome == "lose" then C.danger else C.ink
		reason.Text = reasonText(state.outcome, state.reason)

		fillMine(state.me, state.outcome == "win")
		fillRival(state.rival, state.outcome == "lose")
		renderReview()
		renderRematch()
		frame.Visible = true
	end

	-- Обновление без перерисовки разбора: реванш и уход соперника.
	function screen.update(patch)
		if not state then
			return
		end
		state.rivalPresent = patch.rivalPresent
		state.rematch = patch.rematch
		renderRematch()
	end

	function screen.isVisible(): boolean
		return frame.Visible
	end

	function screen.hide()
		if frame.Visible then
			-- Разбор может содержать сотни объектов (строки и рисунки), скрытым он не нужен.
			for _, child in list:GetChildren() do
				if child:IsA("Frame") then
					child:Destroy()
				end
			end
		end
		frame.Visible = false
	end

	return screen
end

return ResultsScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">SetupScreen</string>
            <string name="Source"><![CDATA[-- Экран настройки матча: свой предмет, выбор соперника, голосование за время и число заданий.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Settings = require(Shared.Settings)
local Ui = require(script.Parent.Ui)

local SetupScreen = {}

local C = Ui.colors

-- Ряд кнопок голосования. Возвращает рамку и функцию обновления (мой голос, голос соперника).
local function voteRow(parent: Instance, y: number, title: string, options: { number }, suffix: string, onVote: (number) -> ())
	Ui.caption(title, { Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(700, 16), Parent = parent })
	local buttons, marks = {}, {}
	for index, option in options do
		local x = 20 + (index - 1) * 142
		local button = Ui.button(if option == 0 then "вся часть 1" else option .. suffix, "plain", {
			Name = "Vote" .. option,
			TextSize = 15,
			Position = UDim2.fromOffset(x, y + 22),
			Size = UDim2.fromOffset(130, 40),
			Parent = parent,
		})
		button.Activated:Connect(function()
			onVote(option)
		end)
		buttons[option] = button
		marks[option] = Ui.label({
			Text = "выбор соперника",
			TextSize = 12,
			Font = Ui.fonts.bold,
			TextColor3 = C.rival,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(x, y + 64),
			Size = UDim2.fromOffset(130, 14),
			Visible = false,
			Parent = parent,
		})
	end
	return function(mine: number, rivals: number, fullText: string?)
		if fullText and buttons[0] then
			buttons[0].Text = fullText
		end
		for option, button in buttons do
			Ui.styleButton(button, if option == mine then "selected" else "plain")
			marks[option].Visible = option == rivals
		end
	end
end

-- actions: setSubject(id), voteTime(n), voteCount(n), ready(bool), leave()
function SetupScreen.create(parent: Instance, actions)
	local screen = {}
	local state = nil

	local frame = Ui.frame({ Name = "Setup", Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent }, { Ui.corner(14) })

	local header = Ui.frame({ Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.sunken, Parent = frame }, { Ui.corner(14) })
	Ui.label({
		Text = "Настройка матча",
		Font = Ui.fonts.bold,
		TextSize = 20,
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(0.6, 0, 1, 0),
		Parent = header,
	})
	local tableLabel = Ui.label({
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -220, 0, 0),
		Size = UDim2.fromOffset(200, 56),
		Parent = header,
	})

	-- Мой предмет.
	Ui.pill("Вы", C.accent, C.accentSoft, { Position = UDim2.fromOffset(20, 70), Size = UDim2.fromOffset(60, 26), Parent = frame })
	Ui.caption("ВАШ ПРЕДМЕТ", { Position = UDim2.fromOffset(92, 75), Size = UDim2.fromOffset(300, 16), Parent = frame })

	local subjectButtons = {}
	for index, subject in Subjects.list do
		local column = (index - 1) % 3
		local row = (index - 1) // 3
		local button = Ui.button(subject.name, "plain", {
			TextSize = 14,
			Position = UDim2.fromOffset(20 + column * 184, 106 + row * 48),
			Size = UDim2.fromOffset(174, 40),
			Parent = frame,
		})
		button.Activated:Connect(function()
			if state and (state.counts[subject.id] or 0) > 0 then
				actions.setSubject(subject.id)
			end
		end)
		subjectButtons[subject.id] = button
	end

	-- Соперник.
	local rivalPanel = Ui.frame({
		Position = UDim2.fromOffset(590, 70),
		Size = UDim2.fromOffset(310, 226),
		BackgroundColor3 = C.rivalSoft,
		Parent = frame,
	}, { Ui.corner(10) })
	local rivalName = Ui.label({
		Font = Ui.fonts.bold,
		TextColor3 = C.rival,
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 24),
		Parent = rivalPanel,
	})
	Ui.caption("ПРЕДМЕТ СОПЕРНИКА", { Position = UDim2.fromOffset(16, 52), Size = UDim2.new(1, -32, 0, 16), Parent = rivalPanel })
	local rivalSubject = Ui.label({
		Font = Ui.fonts.bold,
		TextSize = 22,
		Position = UDim2.fromOffset(16, 72),
		Size = UDim2.new(1, -32, 0, 60),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = rivalPanel,
	})
	local rivalReady = Ui.pill("", C.muted, C.surface, {
		Position = UDim2.fromOffset(16, 180),
		Size = UDim2.fromOffset(150, 28),
		Parent = rivalPanel,
	})

	local updateTime = voteRow(frame, 312, "ВРЕМЯ НА РАБОТУ", Settings.timeOptions, " мин", actions.voteTime)
	local updateCount = voteRow(frame, 402, "ЗАДАНИЯ: ВСЯ ПЕРВАЯ ЧАСТЬ ИЛИ СОКРАЩЁННЫЙ ВАРИАНТ ПО НОМЕРАМ", Settings.countOptions, "", actions.voteCount)

	local status = Ui.label({
		TextSize = 15,
		Position = UDim2.fromOffset(20, 496),
		Size = UDim2.new(1, -40, 0, 40),
		Parent = frame,
	})

	local leaveButton = Ui.button("Встать из-за стола", "plain", {
		Position = UDim2.new(0, 20, 1, -64),
		Size = UDim2.fromOffset(210, 44),
		Parent = frame,
	})
	leaveButton.Activated:Connect(actions.leave)

	local readyButton = Ui.button("Готов", "primary", {
		Position = UDim2.new(1, -260, 1, -64),
		Size = UDim2.fromOffset(240, 44),
		Parent = frame,
	})
	readyButton.Activated:Connect(function()
		if state and state.me.subject then
			actions.ready(not state.me.ready)
		end
	end)

	local function render()
		local me, rival = state.me, state.rival
		tableLabel.Text = "Парта " .. state.tableId

		for id, button in subjectButtons do
			if (state.counts[id] or 0) == 0 then
				Ui.styleButton(button, "disabled")
			elseif id == me.subject then
				Ui.styleButton(button, "selected")
			else
				Ui.styleButton(button, "plain")
			end
		end

		rivalName.Text = "Соперник: " .. rival.name
		rivalSubject.Text = if rival.subject then Subjects.nameOf(rival.subject) else "выбирает…"
		rivalSubject.TextColor3 = if rival.subject then C.ink else C.muted
		rivalReady.Text = if rival.ready then "Готов" else "Не готов"
		rivalReady.TextColor3 = if rival.ready then C.ok else C.muted

		updateTime(me.time, rival.time)
		-- У предмета с разбивкой по номерам показываем размер первой части.
		local full = me.subject and state.fullCounts and state.fullCounts[me.subject] or 0
		updateCount(me.count, rival.count, if full > 0 then string.format("вся часть 1 (%d)", full) else "вся часть 1")

		local notes = {}
		if me.subject and me.subject == rival.subject then
			table.insert(notes, "Предмет одинаковый: вы получите один и тот же вариант.")
		end
		if me.time ~= rival.time and me.count ~= rival.count then
			table.insert(notes, "Время и число заданий не совпали: их выберет жребий.")
		elseif me.time ~= rival.time then
			table.insert(notes, "Время не совпало: его выберет жребий.")
		elseif me.count ~= rival.count then
			table.insert(notes, "Число заданий не совпало: его выберет жребий.")
		end
		if not me.subject then
			table.insert(notes, "Выберите предмет, чтобы нажать «Готов».")
		elseif me.ready and not rival.ready then
			table.insert(notes, "Ждём, пока соперник нажмёт «Готов».")
		end
		status.Text = table.concat(notes, "\n")
		status.TextColor3 = if me.time ~= rival.time or me.count ~= rival.count then C.warn else C.muted

		if not me.subject then
			readyButton.Text = "Готов"
			Ui.styleButton(readyButton, "disabled")
		elseif me.ready then
			readyButton.Text = "Отменить готовность"
			Ui.styleButton(readyButton, "plain")
		else
			readyButton.Text = "Готов"
			Ui.styleButton(readyButton, "primary")
		end
	end

	function screen.show(newState)
		state = newState
		render()
		frame.Visible = true
	end

	function screen.hide()
		frame.Visible = false
	end

	return screen
end

return SetupScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Общие цвета и заготовки элементов интерфейса.
local Ui = {}

Ui.colors = {
	surface = Color3.fromRGB(255, 255, 255),
	sunken = Color3.fromRGB(240, 235, 242),
	ink = Color3.fromRGB(27, 20, 32),
	muted = Color3.fromRGB(107, 96, 114),
	line = Color3.fromRGB(224, 216, 228),
	accent = Color3.fromRGB(184, 21, 90), -- вы
	accentSoft = Color3.fromRGB(251, 227, 237),
	rival = Color3.fromRGB(13, 118, 128), -- соперник
	rivalSoft = Color3.fromRGB(221, 241, 242),
	ok = Color3.fromRGB(28, 127, 71),
	okSoft = Color3.fromRGB(223, 243, 231),
	warn = Color3.fromRGB(154, 98, 8),
	warnSoft = Color3.fromRGB(251, 239, 211),
	danger = Color3.fromRGB(190, 40, 40),
	dangerSoft = Color3.fromRGB(250, 226, 226),
}

Ui.fonts = {
	regular = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
	display = Enum.Font.GothamBlack,
	mono = Enum.Font.RobotoMono,
}

-- Создаёт объект, задаёт свойства и вкладывает детей.
function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Ui.stroke(color: Color3, thickness: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.frame(props: { [string]: any }?, children: { Instance }?): Frame
	local merged = { BackgroundColor3 = Ui.colors.surface, BorderSizePixel = 0 }
	for key, value in props or {} do
		merged[key] = value
	end
	return Ui.new("Frame", merged, children)
end

function Ui.label(props: { [string]: any }?): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		Font = Ui.fonts.regular,
		TextSize = 16,
		TextColor3 = Ui.colors.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		Text = "",
	}
	for key, value in props or {} do
		merged[key] = value
	end
	return Ui.new("TextLabel", merged)
end

-- Маленькая надпись заглавными буквами над блоком.
function Ui.caption(text: string, props: { [string]: any }?): TextLabel
	local merged = {
		Text = text,
		Font = Ui.fonts.bold,
		TextSize = 12,
		TextColor3 = Ui.colors.muted,
		Size = UDim2.new(1, 0, 0, 16),
	}
	for key, value in props or {} do
		merged[key] = value
	end
	return Ui.label(merged)
end

-- Цветная плашка с текстом.
function Ui.pill(text: string, textColor: Color3, backColor: Color3, props: { [string]: any }?): TextLabel
	local merged = {
		Text = text,
		Font = Ui.fonts.bold,
		TextSize = 14,
		TextColor3 = textColor,
		BackgroundColor3 = backColor,
		BackgroundTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.fromOffset(200, 26),
	}
	for key, value in props or {} do
		merged[key] = value
	end
	local pill = Ui.label(merged)
	Ui.corner(13).Parent = pill
	return pill
end

local BUTTON_STYLES = {
	primary = { back = "accent", text = "surface", line = "accent" },
	plain = { back = "surface", text = "ink", line = "line" },
	selected = { back = "accentSoft", text = "accent", line = "accent" },
	rival = { back = "rivalSoft", text = "rival", line = "rival" },
	warn = { back = "warnSoft", text = "warn", line = "warn" },
	danger = { back = "dangerSoft", text = "danger", line = "danger" },
	disabled = { back = "sunken", text = "muted", line = "line" },
}

-- Меняет оформление кнопки: primary, plain, selected, rival, warn, danger, disabled.
function Ui.styleButton(button: TextButton, style: string)
	local spec = BUTTON_STYLES[style] or BUTTON_STYLES.plain
	button.BackgroundColor3 = Ui.colors[spec.back]
	button.TextColor3 = Ui.colors[spec.text]
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Ui.colors[spec.line]
	end
	button.Active = style ~= "disabled"
	button.AutoButtonColor = style ~= "disabled"
end

function Ui.button(text: string, style: string, props: { [string]: any }?): TextButton
	local merged = {
		Text = text,
		Font = Ui.fonts.bold,
		TextSize = 16,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(160, 44),
		TextWrapped = true,
	}
	for key, value in props or {} do
		merged[key] = value
	end
	local button = Ui.new("TextButton", merged, { Ui.corner(8), Ui.stroke(Ui.colors.line, 1.5) })
	Ui.styleButton(button, style)
	return button
end

-- "мм:сс" из числа секунд.
function Ui.clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

-- Форма слова по числу: plural(3, "задание", "задания", "заданий").
function Ui.plural(n: number, one: string, few: string, many: string): string
	local tens, units = n % 100, n % 10
	if tens >= 11 and tens <= 14 then
		return many
	elseif units == 1 then
		return one
	elseif units >= 2 and units <= 4 then
		return few
	end
	return many
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
