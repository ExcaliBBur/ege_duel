          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "math_base", "tasks": [
{"id":"math_base-001","group":"b1_packs","number":1,"topic":"Простейшие текстовые задачи","text":"В летнем лагере на каждого участника полагается 60 г сахара в день. В лагере 143 человек. Сколько килограммовых пачек сахара понадобится на весь лагерь на 4 дней?","answers":["35"],"points":1,"kind":"number","explanation":"Нужно 60 · 143 · 4 = 34320 г, то есть 34,32 кг. Пачек нужно 35."},
{"id":"math_base-002","group":"b1_boats","number":1,"topic":"Простейшие текстовые задачи","text":"Теплоход рассчитан на 850 пассажиров и 20 членов команды. Каждая спасательная шлюпка может вместить 50 человек. Какое наименьшее число шлюпок должно быть на теплоходе, чтобы в случае необходимости в них можно было разместить всех пассажиров и всех членов команды?","answers":["18"],"points":1,"kind":"number","explanation":"Всего 870 человек. 870 : 50 = 17,4, шлюпок нужно 18."},
{"id":"math_base-003","group":"b1_promo","number":1,"topic":"Простейшие текстовые задачи","text":"Шоколадка стоит 55 рублей. В воскресенье в супермаркете действует специальное предложение: заплатив за две шоколадки, покупатель получает три (одну в подарок). Какое наибольшее количество шоколадок можно получить, потратив не более 350 рублей в воскресенье?","answers":["9"],"points":1,"kind":"number","explanation":"На 350 рублей можно оплатить 6 шоколадок, за каждые две оплаченные дают ещё одну: 6 + 3 = 9."},
{"id":"math_base-004","group":"b1_floor","number":1,"topic":"Простейшие текстовые задачи","text":"Тетрадь стоит 18 рублей 50 копеек. Какое наибольшее число тетрадей можно купить на 300 рублей?","answers":["16"],"points":1,"kind":"number","explanation":"300 : 18,5 ≈ 16,22; целое число покупок равно 16."},
{"id":"math_base-005","group":"b1_bags","number":1,"topic":"Простейшие текстовые задачи","text":"Для приготовления маринада для огурцов на 1 литр воды требуется 10 г лимонной кислоты. Лимонная кислота продаётся в пакетиках по 25 г. Какое наименьшее число пакетиков нужно купить хозяйке для приготовления 7 литров маринада?","answers":["3"],"points":1,"kind":"number","explanation":"Нужно 70 г кислоты, 70 : 25 = 2,8, пакетиков нужно 3."},
{"id":"math_base-006","group":"b1_packs","number":1,"topic":"Простейшие текстовые задачи","text":"В летнем лагере на каждого участника полагается 60 г сахара в день. В лагере 253 человек. Сколько килограммовых пачек сахара понадобится на весь лагерь на 5 дней?","answers":["76"],"points":1,"kind":"number","explanation":"Нужно 60 · 253 · 5 = 75900 г, то есть 75,9 кг. Пачек нужно 76."},
{"id":"math_base-007","group":"b1_boats","number":1,"topic":"Простейшие текстовые задачи","text":"Теплоход рассчитан на 700 пассажиров и 30 членов команды. Каждая спасательная шлюпка может вместить 50 человек. Какое наименьшее число шлюпок должно быть на теплоходе, чтобы в случае необходимости в них можно было разместить всех пассажиров и всех членов команды?","answers":["15"],"points":1,"kind":"number","explanation":"Всего 730 человек. 730 : 50 = 14,6, шлюпок нужно 15."},
{"id":"math_base-008","group":"b1_promo","number":1,"topic":"Простейшие текстовые задачи","text":"Шоколадка стоит 25 рублей. В воскресенье в супермаркете действует специальное предложение: заплатив за две шоколадки, покупатель получает три (одну в подарок). Какое наибольшее количество шоколадок можно получить, потратив не более 400 рублей в воскресенье?","answers":["24"],"points":1,"kind":"number","explanation":"На 400 рублей можно оплатить 16 шоколадок, за каждые две оплаченные дают ещё одну: 16 + 8 = 24."},
{"id":"math_base-009","group":"b1_floor","number":1,"topic":"Простейшие текстовые задачи","text":"Пакет сока стоит 46 рублей 80 копеек. Какое наибольшее число пакетов сока можно купить на 80 рублей?","answers":["1"],"points":1,"kind":"number","explanation":"80 : 46,8 ≈ 1,71; целое число покупок равно 1."},
{"id":"math_base-010","group":"b1_bags","number":1,"topic":"Простейшие текстовые задачи","text":"Для приготовления маринада для огурцов на 1 литр воды требуется 15 г лимонной кислоты. Лимонная кислота продаётся в пакетиках по 10 г. Какое наименьшее число пакетиков нужно купить хозяйке для приготовления 5 литров маринада?","answers":["8"],"points":1,"kind":"number","explanation":"Нужно 75 г кислоты, 75 : 10 = 7,5, пакетиков нужно 8."},
{"id":"math_base-011","group":"b1_packs","number":1,"topic":"Простейшие текстовые задачи","text":"В летнем лагере на каждого участника полагается 50 г сахара в день. В лагере 159 человек. Сколько килограммовых пачек сахара понадобится на весь лагерь на 8 дней?","answers":["64"],"points":1,"kind":"number","explanation":"Нужно 50 · 159 · 8 = 63600 г, то есть 63,6 кг. Пачек нужно 64."},
{"id":"math_base-012","group":"b1_boats","number":1,"topic":"Простейшие текстовые задачи","text":"Теплоход рассчитан на 850 пассажиров и 30 членов команды. Каждая спасательная шлюпка может вместить 80 человек. Какое наименьшее число шлюпок должно быть на теплоходе, чтобы в случае необходимости в них можно было разместить всех пассажиров и всех членов команды?","answers":["11"],"points":1,"kind":"number","explanation":"Всего 880 человек. 880 : 80 = 11, шлюпок нужно 11."},
{"id":"math_base-013","group":"b1_promo","number":1,"topic":"Простейшие текстовые задачи","text":"Шоколадка стоит 30 рублей. В воскресенье в супермаркете действует специальное предложение: заплатив за две шоколадки, покупатель получает три (одну в подарок). Какое наибольшее количество шоколадок можно получить, потратив не более 400 рублей в воскресенье?","answers":["19"],"points":1,"kind":"number","explanation":"На 400 рублей можно оплатить 13 шоколадок, за каждые две оплаченные дают ещё одну: 13 + 6 = 19."},
{"id":"math_base-014","group":"b1_floor","number":1,"topic":"Простейшие текстовые задачи","text":"Билет на автобус стоит 23 рублей 50 копеек. Какое наибольшее число билетов можно купить на 500 рублей?","answers":["21"],"points":1,"kind":"number","explanation":"500 : 23,5 ≈ 21,28; целое число покупок равно 21."},
{"id":"math_base-015","group":"b1_bags","number":1,"topic":"Простейшие текстовые задачи","text":"Для приготовления маринада для огурцов на 1 литр воды требуется 12 г лимонной кислоты. Лимонная кислота продаётся в пакетиках по 20 г. Какое наименьшее число пакетиков нужно купить хозяйке для приготовления 4 литров маринада?","answers":["3"],"points":1,"kind":"number","explanation":"Нужно 48 г кислоты, 48 : 20 = 2,4, пакетиков нужно 3."},
{"id":"math_base-016","group":"b1_packs","number":1,"topic":"Простейшие текстовые задачи","text":"В летнем лагере на каждого участника полагается 50 г сахара в день. В лагере 247 человек. Сколько килограммовых пачек сахара понадобится на весь лагерь на 6 дней?","answers":["75"],"points":1,"kind":"number","explanation":"Нужно 50 · 247 · 6 = 74100 г, то есть 74,1 кг. Пачек нужно 75."},
{"id":"math_base-017","group":"b1_boats","number":1,"topic":"Простейшие текстовые задачи","text":"Теплоход рассчитан на 550 пассажиров и 25 членов команды. Каждая спасательная шлюпка может вместить 60 человек. Какое наименьшее число шлюпок должно быть на теплоходе, чтобы в случае необходимости в них можно было разместить всех пассажиров и всех членов команды?","answers":["10"],"points":1,"kind":"number","explanation":"Всего 575 человек. 575 : 60 ≈ 9,58, шлюпок нужно 10."},
{"id":"math_base-018","group":"b1_promo","number":1,"topic":"Простейшие текстовые задачи","text":"Шоколадка стоит 55 рублей. В воскресенье в супермаркете действует специальное предложение: заплатив за две шоколадки, покупатель получает три (одну в подарок). Какое наибольшее количество шоколадок можно получить, потратив не более 400 рублей в воскресенье?","answers":["10"],"points":1,"kind":"number","explanation":"На 400 рублей можно оплатить 7 шоколадок, за каждые две оплаченные дают ещё одну: 7 + 3 = 10."},
{"id":"math_base-019","group":"b1_bags","number":1,"topic":"Простейшие текстовые задачи","text":"Для приготовления маринада для огурцов на 1 литр воды требуется 15 г лимонной кислоты. Лимонная кислота продаётся в пакетиках по 20 г. Какое наименьшее число пакетиков нужно купить хозяйке для приготовления 14 литров маринада?","answers":["11"],"points":1,"kind":"number","explanation":"Нужно 210 г кислоты, 210 : 20 = 10,5, пакетиков нужно 11."},
{"id":"math_base-020","group":"b1_packs","number":1,"topic":"Простейшие текстовые задачи","text":"В летнем лагере на каждого участника полагается 60 г сахара в день. В лагере 127 человек. Сколько килограммовых пачек сахара понадобится на весь лагерь на 7 дней?","answers":["54"],"points":1,"kind":"number","explanation":"Нужно 60 · 127 · 7 = 53340 г, то есть 53,34 кг. Пачек нужно 54."},
{"id":"math_base-021","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) скорость роста бамбука\nБ) скорость света в вакууме\nВ) скорость велосипедиста\nГ) скорость пассажирского самолёта\n\n1) 900 км/ч\n2) 50 см/сутки\n3) 18 км/ч\n4) 300 000 км/с","answers":["2431"],"points":1,"kind":"order","explanation":"скорость роста бамбука: 50 см/сутки; скорость света в вакууме: 300 000 км/с; скорость велосипедиста: 18 км/ч; скорость пассажирского самолёта: 900 км/ч."},
{"id":"math_base-022","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) площадь экрана смартфона\nБ) площадь дачного участка\nВ) площадь баскетбольной площадки\nГ) площадь озера Байкал\n\n1) 90 кв. см\n2) 31 500 кв. км\n3) 6 соток\n4) 420 кв. м","answers":["1342"],"points":1,"kind":"order","explanation":"площадь экрана смартфона: 90 кв. см; площадь дачного участка: 6 соток; площадь баскетбольной площадки: 420 кв. м; площадь озера Байкал: 31 500 кв. км."},
{"id":"math_base-023","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) высота горы Эверест\nБ) диаметр монеты\nВ) длина экватора Земли\nГ) длина школьного коридора\n\n1) 8848 м\n2) 40 м\n3) 40 000 км\n4) 20 мм","answers":["1432"],"points":1,"kind":"order","explanation":"высота горы Эверест: 8848 м; диаметр монеты: 20 мм; длина экватора Земли: 40 000 км; длина школьного коридора: 40 м."},
{"id":"math_base-024","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) масса железнодорожного состава\nБ) масса новорождённого ребёнка\nВ) масса легкового автомобиля\nГ) масса школьного ластика\n\n1) 15 г\n2) 3500 г\n3) 1,2 т\n4) 4000 т","answers":["4231"],"points":1,"kind":"order","explanation":"масса железнодорожного состава: 4000 т; масса новорождённого ребёнка: 3500 г; масса легкового автомобиля: 1,2 т; масса школьного ластика: 15 г."},
{"id":"math_base-025","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) объём грузового отсека транспортного самолёта\nБ) объём бутылки растительного масла\nВ) объём ящика с инструментами\nГ) объём воды в Азовском море\n\n1) 1 л\n2) 76 л\n3) 256 куб. км\n4) 150 куб. м","answers":["4123"],"points":1,"kind":"order","explanation":"объём грузового отсека транспортного самолёта: 150 куб. м; объём бутылки растительного масла: 1 л; объём ящика с инструментами: 76 л; объём воды в Азовском море: 256 куб. км."},
{"id":"math_base-026","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) толщина листа бумаги\nБ) высота жилого дома\nВ) рост ребёнка\nГ) длина автобусного маршрута\n\n1) 0,1 мм\n2) 30 м\n3) 110 см\n4) 32 км","answers":["1234"],"points":1,"kind":"order","explanation":"толщина листа бумаги: 0,1 мм; высота жилого дома: 30 м; рост ребёнка: 110 см; длина автобусного маршрута: 32 км."},
{"id":"math_base-027","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) масса одной ягоды клубники\nБ) масса мобильного телефона\nВ) масса курицы\nГ) масса взрослого слона\n\n1) 100 г\n2) 5 т\n3) 12,5 г\n4) 3 кг","answers":["3142"],"points":1,"kind":"order","explanation":"масса одной ягоды клубники: 12,5 г; масса мобильного телефона: 100 г; масса курицы: 3 кг; масса взрослого слона: 5 т."},
{"id":"math_base-028","group":"b2_units","number":2,"topic":"Размеры и единицы измерения","text":"Установите соответствие между величинами и их возможными значениями: к каждому элементу первого столбца подберите соответствующий элемент из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) время обращения Луны вокруг Земли\nБ) время одного оборота Земли вокруг своей оси\nВ) длительность школьного урока\nГ) время, за которое свет от Солнца доходит до Земли\n\n1) 24 часа\n2) 8 минут\n3) 27 суток\n4) 45 минут","answers":["3142"],"points":1,"kind":"order","explanation":"время обращения Луны вокруг Земли: 27 суток; время одного оборота Земли вокруг своей оси: 24 часа; длительность школьного урока: 45 минут; время, за которое свет от Солнца доходит до Земли: 8 минут."},
