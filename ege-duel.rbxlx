{"id":"math_base-101","group":"b6_carriers","number":6,"topic":"Выбор оптимального варианта","text":"Для транспортировки 30 тонн груза на 1800 км можно воспользоваться услугами одной из трёх фирм-перевозчиков. В таблице показаны стоимость перевозки одним автомобилем на 100 км и грузоподъёмность автомобилей каждого перевозчика. Сколько рублей придётся заплатить за самую дешёвую перевозку?","answers":["151200"],"points":1,"kind":"number","explanation":"Стоимость у перевозчиков: А: 151200 руб, Б: 280800 руб, В: 475200 руб. Самая дешёвая перевозка стоит 151200 руб.","figure":{"w":430,"h":156,"items":[["line",10.0,10.0,420.0,10.0,1],["line",10.0,44.0,420.0,44.0,0],["line",10.0,78.0,420.0,78.0,0],["line",10.0,112.0,420.0,112.0,0],["line",10.0,146.0,420.0,146.0,1],["line",10.0,10.0,10.0,146.0,1],["line",120.0,10.0,120.0,146.0,1],["line",270.0,10.0,270.0,146.0,0],["line",420.0,10.0,420.0,146.0,1],["text",65.0,27.0,"Перевозчик","c"],["text",195.0,27.0,"Цена, руб. за 100 км","c"],["text",345.0,27.0,"Грузоподъёмность, т","c"],["text",65.0,61.0,"А","c"],["text",195.0,61.0,"2800","c"],["text",345.0,61.0,"12","c"],["text",65.0,95.0,"Б","c"],["text",195.0,95.0,"5200","c"],["text",345.0,95.0,"12","c"],["text",65.0,129.0,"В","c"],["text",195.0,129.0,"4400","c"],["text",345.0,129.0,"5","c"]]}},
{"id":"math_base-102","group":"b6_internet","number":6,"topic":"Выбор оптимального варианта","text":"Интернет-провайдер предлагает три тарифных плана. Пользователь предполагает, что его трафик составит 1150 Мб в месяц, и исходя из этого выбирает наиболее дешёвый тарифный план. Сколько рублей заплатит пользователь за месяц, если его трафик действительно будет равен 1150 Мб?","answers":["1200"],"points":1,"kind":"number","explanation":"Стоимость по планам: 3450, 1475, 1200 руб. Наименьшая равна 1200 руб.","figure":{"w":430,"h":156,"items":[["line",10.0,10.0,420.0,10.0,1],["line",10.0,44.0,420.0,44.0,0],["line",10.0,78.0,420.0,78.0,0],["line",10.0,112.0,420.0,112.0,0],["line",10.0,146.0,420.0,146.0,1],["line",10.0,10.0,10.0,146.0,1],["line",90.0,10.0,90.0,146.0,1],["line",255.0,10.0,255.0,146.0,0],["line",420.0,10.0,420.0,146.0,1],["text",50.0,27.0,"Тариф","c"],["text",172.5,27.0,"Абонентская плата","c"],["text",337.5,27.0,"Плата за трафик","c"],["text",50.0,61.0,"План 1","c"],["text",172.5,61.0,"нет","c"],["text",337.5,61.0,"3 руб. за 1 Мб","c"],["text",50.0,95.0,"План 2","c"],["text",172.5,95.0,"500 руб. за 500 Мб","c"],["text",337.5,95.0,"1,5 руб. за 1 Мб сверх","c"],["text",50.0,129.0,"План 3","c"],["text",172.5,129.0,"1200 руб. за 1200 Мб","c"],["text",337.5,129.0,"1 руб. за 1 Мб сверх","c"]]}},
{"id":"math_base-103","group":"b6_route","number":6,"topic":"Выбор оптимального варианта","text":"Из пункта А в пункт Б можно добраться тремя способами. В таблице показано время, которое нужно затратить на каждый участок пути. Какое наименьшее время потребуется на дорогу? Ответ дайте в часах.","answers":["1,75"],"points":1,"kind":"number","explanation":"Время в пути: Автобус: 185 мин, Электричка: 155 мин, Маршрутное такси: 105 мин. Наименьшее время 105 мин, это 1,75 ч.","figure":{"w":470,"h":156,"items":[["line",10.0,10.0,460.0,10.0,1],["line",10.0,44.0,460.0,44.0,0],["line",10.0,78.0,460.0,78.0,0],["line",10.0,112.0,460.0,112.0,0],["line",10.0,146.0,460.0,146.0,1],["line",10.0,10.0,10.0,146.0,1],["line",160.0,10.0,160.0,146.0,1],["line",260.0,10.0,260.0,146.0,0],["line",360.0,10.0,360.0,146.0,0],["line",460.0,10.0,460.0,146.0,1],["text",85.0,27.0,"Вид транспорта","c"],["text",210.0,27.0,"До станции","c"],["text",310.0,27.0,"В пути","c"],["text",410.0,27.0,"От станции","c"],["text",85.0,61.0,"Автобус","c"],["text",210.0,61.0,"40 мин","c"],["text",310.0,61.0,"130 мин","c"],["text",410.0,61.0,"15 мин","c"],["text",85.0,95.0,"Электричка","c"],["text",210.0,95.0,"35 мин","c"],["text",310.0,95.0,"115 мин","c"],["text",410.0,95.0,"5 мин","c"],["text",85.0,129.0,"Маршрутное такси","c"],["text",210.0,129.0,"5 мин","c"],["text",310.0,129.0,"95 мин","c"],["text",410.0,129.0,"5 мин","c"]]}},
