{"id":"chemistry-175","group":"fig_skeleton","text":"На рисунке показан углеродный скелет молекулы углеводорода. Двойная линия обозначает двойную связь. Все остальные валентности углерода заняты атомами водорода. Сколько атомов водорода в молекуле этого вещества?","answers":["20"],"points":1,"kind":"number","explanation":"Атомов углерода 9, двойных связей нет: это алкан, водорода 2 · 9 + 2 = 20.","figure":{"w":420,"h":260,"items":[["line",42.0,150.0,90.0,110.0,1],["line",90.0,110.0,138.0,150.0,1],["line",138.0,150.0,186.0,110.0,1],["line",186.0,110.0,234.0,150.0,1],["line",234.0,150.0,282.0,110.0,1],["line",282.0,110.0,330.0,150.0,1],["line",330.0,150.0,378.0,110.0,1],["line",234.0,150.0,234.0,196.0,1],["circle",234.0,196.0,11.0,1],["text",234.0,196.0,"C","c"],["circle",42.0,150.0,11.0,1],["text",42.0,150.0,"C","c"],["circle",90.0,110.0,11.0,1],["text",90.0,110.0,"C","c"],["circle",138.0,150.0,11.0,1],["text",138.0,150.0,"C","c"],["circle",186.0,110.0,11.0,1],["text",186.0,110.0,"C","c"],["circle",234.0,150.0,11.0,1],["text",234.0,150.0,"C","c"],["circle",282.0,110.0,11.0,1],["text",282.0,110.0,"C","c"],["circle",330.0,150.0,11.0,1],["text",330.0,150.0,"C","c"],["circle",378.0,110.0,11.0,1],["text",378.0,110.0,"C","c"]]}},
{"id":"chemistry-176","group":"fig_skeleton","text":"На рисунке показан углеродный скелет молекулы углеводорода. Двойная линия обозначает двойную связь. Все остальные валентности углерода заняты атомами водорода. Сколько всего атомов (углерода и водорода) в молекуле этого вещества?","answers":["21"],"points":1,"kind":"number","explanation":"Углерода 7, водорода 14, всего 21.","figure":{"w":420,"h":260,"items":[["line",66.0,150.0,114.0,110.0,1],["line",114.0,110.0,162.0,150.0,1],["line",162.0,150.0,210.0,110.0,1],["line",210.0,110.0,258.0,150.0,1],["line",258.0,150.0,306.0,110.0,1],["line",306.0,110.0,354.0,150.0,1],["line",306.0,117.0,354.0,157.0,1],["circle",66.0,150.0,11.0,1],["text",66.0,150.0,"C","c"],["circle",114.0,110.0,11.0,1],["text",114.0,110.0,"C","c"],["circle",162.0,150.0,11.0,1],["text",162.0,150.0,"C","c"],["circle",210.0,110.0,11.0,1],["text",210.0,110.0,"C","c"],["circle",258.0,150.0,11.0,1],["text",258.0,150.0,"C","c"],["circle",306.0,110.0,11.0,1],["text",306.0,110.0,"C","c"],["circle",354.0,150.0,11.0,1],["text",354.0,150.0,"C","c"]]}},
