{"id":"math_prof-223","group":"g_hyperbola","number":12,"topic":"Графики функций","text":"На рисунке изображён график функции f(x) = k/x + a. На графике отмечены точки с целыми координатами. Найдите f(20).","answers":["-2,7"],"points":1,"kind":"number","explanation":"По отмеченным точкам k = 6, a = -3; f(20) = 6 : (20) + (-3) = -2,7.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",10.0,202.0,12.8,202.2,2],["line",12.8,202.2,15.6,202.3,2],["line",15.6,202.3,18.4,202.5,2],["line",18.4,202.5,21.2,202.7,2],["line",21.2,202.7,24.0,202.9,2],["line",24.0,202.9,26.8,203.1,2],["line",26.8,203.1,29.6,203.3,2],["line",29.6,203.3,32.4,203.5,2],["line",32.4,203