{"id":"math_prof-166","group":"d_graph_points","number":9,"topic":"Производная и первообразная","text":"На рисунке изображён график функции y = f(x). На оси абсцисс отмечены семь точек: x₁, x₂, x₃, x₄, x₅, x₆, x₇. В скольких из этих точек производная функции f(x) отрицательна?","answers":["5"],"points":1,"kind":"number","explanation":"Производная отрицательна там, где функция убывает. Таких точек 5.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["line",20.0,133.4,23.8,146.2,1],["line",23.8,146.2,27.6,158.0,1],["line",27.6,158.0,31.4,168.3,1],["line",31.4,168.3,35.2,176.6,1],["line",35.2,176.6,39.0,182.6,1],["line",39.0,182.6,42.8,186.0,1],["line",42.8,186.0,46.6,186.9,1],["line",46.6,186.9,50.4,185.1,1],["line",50.4,185.1,54.2,181.0,1],["l