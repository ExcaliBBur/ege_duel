  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Bank</string>
          <string name="Source"><![CDATA[-- Банк заданий. Сначала берётся копия, встроенная в игру (ServerStorage.Bank),
-- затем, если задан Config.bankBaseUrl, предметы обновляются свежими файлами из интернета.
local HttpService = game:GetService("HttpService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Config = require(script.Parent.Config)

local Bank = {}

local tasksBySubject: { [string]: { any } } = {}

local VALID_KINDS = { exact = true, number = true, set = true, order = true }

local FIGURE_FIELDS = { line = 6, rect = 6, circle = 5, text = 5 } -- вид фигуры и число полей
local FIGURE_MAX_ITEMS = 240

-- Рисунок к заданию: размеры и список простых фигур. Некорректный рисунок отбрасывается целиком.
local function sanitizeFigure(raw: any): any
	if type(raw) ~= "table" or type(raw.w) ~= "number" or type(raw.h) ~= "number" or type(raw.items) ~= "table" then
		return nil
	end
	if #raw.items == 0 or #raw.items > FIGURE_MAX_ITEMS then
		return nil
	end
	local items = {}
	for _, shape in raw.items do
		if type(shape) ~= "table" or FIGURE_FIELDS[shape[1]] ~= #shape then
			return nil
		end
		-- Все поля, кроме вида фигуры и текста подписи, должны быть числами.
		for index = 2, #shape do
			local isLabel = shape[1] == "text" and index >= 4
			if type(shape[index]) ~= (if isLabel then "string" else "number") then
				return nil
			end
		end
		table.insert(items, table.clone(shape))
	end
	return { w = math.clamp(raw.w, 50, 800), h = math.clamp(raw.h, 50, 600), items = items }
end

-- Оставляет только корректные задания, чтобы битый файл из интернета не сломал матч.
local function sanitize(rawTasks: any): { any }
	local result = {}
	if type(rawTasks) ~= "table" then
		return result
	end
	for _, raw in rawTasks do
		if type(raw) == "table" and type(raw.text) == "string" and raw.text ~= "" and type(raw.answers) == "table" then
			local answers = {}
			for _, answer in raw.answers do
				if type(answer) == "string" and answer ~= "" then
					table.insert(answers, answer)
				end
			end
			local points = if raw.points == 2 or raw.points == 3 then raw.points else 1
			local kind = if VALID_KINDS[raw.kind] then raw.kind else "exact"
			if #answers > 0 then
				table.insert(result, {
					id = tostring(raw.id or #result + 1),
					group = if type(raw.group) == "string" then raw.group else nil,
					text = raw.text,
					answers = answers,
					points = points,
					kind = kind,
					explanation = if type(raw.explanation) == "string" then raw.explanation else "",
					figure = sanitizeFigure(raw.figure),
					-- Номер задания в ЕГЭ и его тема. У предметов без разбивки по номерам этих полей нет.
					number = if type(raw.number) == "number" and raw.number % 1 == 0 and raw.number > 0 then raw.number else nil,
					topic = if type(raw.topic) == "string" then raw.topic else nil,
				})
			end
		end
	end
	return result
end

-- Встроенная копия хранится не модулями Luau, а текстом: папка предмета с кусками JSON в StringValue.
-- Большие модули Studio разбирает как код, и частота кадров от этого падает в несколько раз.
local function readEmbedded(folder: Instance): string
	local chunks = folder:GetChildren()
	table.sort(chunks, function(a, b)
		return a.Name < b.Name
	end)
	local parts = {}
	for _, chunk in chunks do
		if chunk:IsA("StringValue") then
			table.insert(parts, chunk.Value)
		end
	end
	return table.concat(parts)
end

local function loadBuiltIn()
	local folder = ServerStorage:FindFirstChild("Bank")
	if not folder then
		warn("[Bank] В ServerStorage нет папки Bank, банк пуст")
		return
	end
	for _, subject in Subjects.list do
		local subjectFolder = folder:FindFirstChild(subject.id)
		if subjectFolder then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(readEmbedded(subjectFolder))
			end)
			if ok and type(data) == "table" then
				tasksBySubject[subject.id] = sanitize(data.tasks)
			else
				warn("[Bank] Не удалось прочитать встроенную копию предмета " .. subject.id)
			end
		end
	end
end

local function fetchJson(url: string): any?
	local ok, body = pcall(function()
		return HttpService:GetAsync(url, true)
	end)
	if not ok then
		return nil
	end
	local decoded, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	return if decoded then data else nil
end

local function loadOnline()
	local base = Config.bankBaseUrl
	if base == "" then
		return
	end
	local index = fetchJson(base .. "/index.json")
	if type(index) ~= "table" or type(index.subjects) ~= "table" then
		warn("[Bank] Не удалось скачать index.json, остаётся встроенный банк")
		return
	end
	local updated = 0
	for _, subject in Subjects.list do
		local entry = index.subjects[subject.id]
		if type(entry) == "table" and type(entry.file) == "string" then
			local data = fetchJson(base .. "/" .. entry.file)
			local tasks = if type(data) == "table" then sanitize(data.tasks) else {}
			if #tasks > 0 then
				tasksBySubject[subject.id] = tasks
				updated += 1
			end
		end
	end
	print(string.format("[Bank] Из интернета обновлено предметов: %d", updated))
end

function Bank.load()
	loadBuiltIn()
	-- Скачивание не должно задерживать запуск сервера.
	task.spawn(loadOnline)
end

function Bank.getTasks(subjectId: string): { any }
	return tasksBySubject[subjectId] or {}
end

function Bank.count(subjectId: string): number
	return #Bank.getTasks(subjectId)
end

-- Сколько заданий в полном варианте предмета: число номеров первой части, для которых есть задания.
-- Для предмета без разбивки по номерам возвращает 0.
function Bank.fullCount(subjectId: string): number
	local seen, count = {}, 0
	for _, task in Bank.getTasks(subjectId) do
		if task.number and not seen[task.number] then
			seen[task.number] = true
			count += 1
		end
	end
	return count
end

-- Случайное задание без рисунка из любого предмета, для доски «Задача дня».
function Bank.randomTextTask()
	local candidates = {}
	for _, subject in Subjects.list do
		for _, task in Bank.getTasks(subject.id) do
			if not task.figure then
				table.insert(candidates, { subject = subject.name, task = task })
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[math.random(#candidates)]
end

-- Проверка одного задания: используется тестами.
Bank.sanitize = sanitize

return Bank
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Настройки сервера.
local Config = {}

-- Адрес папки с банком заданий в интернете (там должны лежать index.json и файлы предметов из bank/dist).
-- Пустая строка: используется только копия банка, встроенная в игру.
-- Если скачать не удалось, игра тоже берёт встроенную копию.
Config.bankBaseUrl = "https://raw.githubusercontent.com/ExcaliBBur/ege_duel/main/bank/dist"

Config.tableCount = 6

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Duel</string>
          <string name="Source"><![CDATA[-- Матчи за партами. У каждой парты своё состояние:
--   idle       за партой никого или один игрок ждёт соперника
--   setup      двое выбирают предметы и голосуют за время и число заданий
--   countdown  отсчёт перед началом
--   exam       идёт экзамен
--   results    показаны итоги, можно взять реванш
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Settings = require(Shared.Settings)
local Scoring = require(Shared.Scoring)
local Text = require(Shared.Text)
local Bank = require(script.Parent.Bank)
local Variant = require(script.Parent.Variant)

local Duel = {}

local stateEvent: RemoteEvent -- сервер -> клиент: снимок состояния по фазе
local rivalEvent: RemoteEvent -- сервер -> клиент: прогресс соперника во время экзамена
local actionEvent: RemoteEvent -- клиент -> сервер: действия игрока

local tables = {}
local entryByPlayer = {} -- [Player] = { tbl, slot }

local function now(): number
	return Workspace:GetServerTimeNow()
end

local function rivalOf(tbl, slot)
	return tbl.slots[3 - slot.index]
end

local function isPresent(slot): boolean
	if slot == nil or slot.left then
		return false
	end
	return slot.bot or slot.player.Parent ~= nil
end

-- Тестовому сопернику сообщения не отправляются.
local function sendState(slot, payload)
	if isPresent(slot) and not slot.bot then
		stateEvent:FireClient(slot.player, payload)
	end
end

local function sendRival(slot, payload)
	if isPresent(slot) and not slot.bot then
		rivalEvent:FireClient(slot.player, payload)
	end
end

local function newSlot(player: Player, index: number)
	return {
		player = player,
		index = index,
		name = player.DisplayName,
		subject = nil,
		timeVote = Settings.defaultTime,
		countVote = Settings.defaultCount,
		ready = false,
		tasks = {},
		answers = {},
		answered = 0,
		submitted = false,
		elapsed = 0,
		left = false,
		rematch = false,
	}
end

-- Тестовый соперник: доступен только в Studio, чтобы проверять игру в одиночку.
local function newBotSlot(index: number)
	return {
		bot = true,
		index = index,
		name = "Тестовый соперник",
		subject = nil,
		timeVote = Settings.defaultTime,
		countVote = Settings.defaultCount,
		ready = false,
		tasks = {},
		answers = {},
		answered = 0,
		submitted = false,
		elapsed = 0,
		left = false,
		rematch = false,
	}
end

local function formatClock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

local function refreshStatus(tbl)
	local phase = tbl.phase
	if phase == "idle" then
		local hasPlayer = tbl.slots[1] ~= nil or tbl.slots[2] ~= nil
		tbl.setStatus(if hasPlayer then "Ждёт соперника" else "Свободно", false)
	elseif phase == "setup" then
		tbl.setStatus("Выбирают предметы", true)
	elseif phase == "countdown" then
		tbl.setStatus("Матч начинается", true)
	elseif phase == "exam" then
		local a, b = tbl.slots[1], tbl.slots[2]
		tbl.setStatus(
			string.format("Решено %d и %d · осталось %s", a.answered, b.answered, formatClock(tbl.endsAt - now())),
			true
		)
	elseif phase == "results" then
		tbl.setStatus("Матч окончен", true)
	end
	for index, prompt in tbl.prompts do
		prompt.Enabled = phase == "idle" and tbl.slots[index] == nil
	end
	if tbl.setLamp then
		tbl.setLamp(phase == "exam") -- настольная лампа горит, пока идёт экзамен
	end
end

local function bankCounts()
	local counts = {}
	for _, subject in Subjects.list do
		counts[subject.id] = Bank.count(subject.id)
	end
	return counts
end

-- Размер первой части по предметам, чтобы на экране настройки было видно, сколько заданий в полном варианте.
local function fullCounts()
	local counts = {}
	for _, subject in Subjects.list do
		counts[subject.id] = Bank.fullCount(subject.id)
	end
	return counts
end

local function rivalProgress(slot)
	return {
		answered = slot.answered,
		total = #slot.tasks,
		submitted = slot.submitted,
		left = slot.left,
	}
end

local function snapshotFor(tbl, slot)
	local rival = rivalOf(tbl, slot)
	local phase = tbl.phase
	if phase == "idle" then
		return { phase = "waiting", tableId = tbl.id, canAddBot = RunService:IsStudio() }
	elseif phase == "setup" then
		return {
			phase = "setup",
			tableId = tbl.id,
			counts = bankCounts(),
			fullCounts = fullCounts(),
			me = { subject = slot.subject, time = slot.timeVote, count = slot.countVote, ready = slot.ready },
			rival = {
				name = rival.name,
				subject = rival.subject,
				time = rival.timeVote,
				count = rival.countVote,
				ready = rival.ready,
			},
		}
	elseif phase == "countdown" then
		local settings = tbl.settings
		return {
			phase = "countdown",
			tableId = tbl.id,
			startsAt = tbl.startsAt,
			time = settings.time,
			count = settings.count,
			lotTime = settings.lotTime,
			lotCount = settings.lotCount,
			subject = slot.subject,
			rivalName = rival.name,
			rivalSubject = rival.subject,
		}
	elseif phase == "exam" then
		local publicTasks = {}
		for index, task in slot.tasks do
			-- Правильные ответы клиенту не отправляются.
			publicTasks[index] = {
				text = task.text,
				points = task.points,
				figure = task.figure,
				number = task.number,
				topic = task.topic,
			}
		end
		local progress = rivalProgress(rival)
		progress.name = rival.name
		progress.subject = rival.subject
		return {
			phase = "exam",
			tableId = tbl.id,
			subject = slot.subject,
			startedAt = tbl.startedAt,
			endsAt = tbl.endsAt,
			tasks = publicTasks,
			rival = progress,
		}
	end
	return { phase = "none" }
end

local function push(tbl)
	for _, slot in tbl.slots do
		if isPresent(slot) and not slot.bot then
			sendState(slot, snapshotFor(tbl, slot))
		end
	end
	refreshStatus(tbl)
end

local function standUp(player: Player, seat: Seat)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or seat.Occupant ~= humanoid then
		return
	end
	local weld = seat:FindFirstChild("SeatWeld")
	if weld then
		weld:Destroy()
	end
	humanoid.Sit = false
	-- Отодвигаем персонажа в сторону, чтобы он тут же не сел обратно от касания стула.
	task.defer(function()
		if character.Parent then
			character:PivotTo(seat.CFrame * CFrame.new(4.5, 3, 0))
		end
	end)
end

local function reseat(tbl, slot)
	if tbl.slots[slot.index] ~= slot or not isPresent(slot) then
		return
	end
	if tbl.phase ~= "exam" and tbl.phase ~= "countdown" then
		return
	end
	local seat = tbl.seats[slot.index]
	if seat.Occupant then
		return
	end
	local character = slot.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		seat:Sit(humanoid)
	end
end

-- Убирает игрока из-за парты. В фазах exam и countdown не вызывается.
local function removeSlot(tbl, index: number)
	local slot = tbl.slots[index]
	if not slot then
		return
	end
	tbl.slots[index] = nil
	if not slot.bot then
		if entryByPlayer[slot.player] and entryByPlayer[slot.player].slot == slot then
			entryByPlayer[slot.player] = nil
		end
		sendState(slot, { phase = "none" })
	end

	local other = tbl.slots[3 - index]
	local previous = tbl.phase
	tbl.phase = "idle"
	if other and other.bot then
		-- Тестовый соперник уходит вместе с игроком.
		tbl.slots[3 - index] = nil
	elseif other then
		other.ready = false
		other.rematch = false
		if previous == "results" then
			-- Оставшийся игрок продолжает смотреть итоги, пока сам не встанет или не придёт новый соперник.
			sendState(other, {
				phase = "resultsUpdate",
				rivalPresent = false,
				rematch = { me = false, rival = false },
			})
		elseif previous == "setup" then
			sendState(other, snapshotFor(tbl, other))
		end
	end
	refreshStatus(tbl)
end

-- Тестовый соперник соглашается с голосами игрока и всегда готов.
local function syncBot(tbl)
	for _, slot in tbl.slots do
		if slot.bot then
			local human = rivalOf(tbl, slot)
			if human then
				slot.timeVote = human.timeVote
				slot.countVote = human.countVote
			end
			slot.ready = slot.subject ~= nil
		end
	end
end

local function enterSetup(tbl)
	tbl.phase = "setup"
	for _, slot in tbl.slots do
		slot.ready = false
		slot.rematch = false
	end
	syncBot(tbl)
	push(tbl)
end

local function buildCard(slot)
	local summary = slot.summary
	return {
		name = slot.name,
		subject = slot.subject,
		earned = summary.earned,
		max = summary.max,
		percent = Scoring.percent(summary.earned, summary.max),
		correct = summary.correct,
		partial = summary.partial,
		answered = summary.answered,
		total = summary.total,
		elapsed = slot.elapsed,
	}
end

local function buildReview(slot)
	local review = {}
	for index, task in slot.tasks do
		review[index] = {
			text = task.text,
			your = slot.answers[index] or "",
			correct = task.answers[1],
			points = task.points,
			earned = slot.summary.perTask[index],
			explanation = task.explanation,
			figure = task.figure,
			number = task.number,
		}
	end
	return review
end

-- Доска побед: считает матчи между живыми игроками за время работы сервера.
local scores = {} -- [userId] = { name, wins, games }
local showScoreboard: ((string) -> ())? = nil

local function recordResult(slot, rival, outcome: string)
	if slot.bot or rival.bot then
		return
	end
	local userId = slot.player.UserId
	local entry = scores[userId] or { name = slot.name, wins = 0, games = 0 }
	scores[userId] = entry
	entry.games += 1
	if outcome == "win" then
		entry.wins += 1
	end
end

local function refreshScoreboard()
	if not showScoreboard then
		return
	end
	local rows = {}
	for _, entry in scores do
		table.insert(rows, entry)
	end
	table.sort(rows, function(x, y)
		if x.wins ~= y.wins then
			return x.wins > y.wins
		end
		return x.name < y.name
	end)
	local lines = {}
	for place = 1, math.min(#rows, 8) do
		local entry = rows[place]
		table.insert(lines, string.format("%d. %s: побед %d из %d", place, entry.name, entry.wins, entry.games))
	end
	showScoreboard(if #lines > 0 then table.concat(lines, "\n") else "Пока никто не сыграл.\nСтаньте первыми!")
end

local function finish(tbl)
	tbl.matchId += 1 -- отменяет таймер конца экзамена
	tbl.phase = "results"
	local a, b = tbl.slots[1], tbl.slots[2]
	for _, slot in { a, b } do
		if not slot.submitted then
			slot.submitted = true
			slot.elapsed = tbl.duration
		end
		slot.summary = Scoring.summarize(slot.tasks, slot.answers)
		slot.rematch = slot.bot == true -- тестовый соперник всегда согласен на реванш
	end

	for _, slot in { a, b } do
		local rival = rivalOf(tbl, slot)
		local outcome, reason = Scoring.decide(
			{ earned = slot.summary.earned, max = slot.summary.max, elapsed = slot.elapsed, left = slot.left },
			{ earned = rival.summary.earned, max = rival.summary.max, elapsed = rival.elapsed, left = rival.left }
		)
		recordResult(slot, rival, outcome)
		if outcome == "win" and isPresent(slot) and tbl.celebrate then
			tbl.celebrate(slot.index)
		end
		if isPresent(slot) then
			sendState(slot, {
				phase = "results",
				tableId = tbl.id,
				outcome = outcome,
				reason = reason,
				me = buildCard(slot),
				rival = buildCard(rival),
				review = buildReview(slot),
				rematch = { me = false, rival = rival.rematch },
				rivalPresent = isPresent(rival),
			})
		end
	end

	-- Вышедших из игры убираем, парта освобождается для нового соперника.
	for index = 1, 2 do
		local slot = tbl.slots[index]
		if slot and not isPresent(slot) then
			tbl.slots[index] = nil
			tbl.phase = "idle"
		end
	end
	refreshStatus(tbl)
	refreshScoreboard()
end

local function allDone(tbl): boolean
	for _, slot in tbl.slots do
		if not slot.submitted and not slot.left then
			return false
		end
	end
	return true
end

local function notifyRival(tbl, slot)
	sendRival(rivalOf(tbl, slot), rivalProgress(slot))
end

local BOT_ANSWER_SECONDS = 4
local BOT_CORRECT_CHANCE = 0.6

-- Тестовый соперник отвечает на одно задание раз в несколько секунд, затем сдаёт работу.
local function runBot(tbl, slot, matchId: number)
	local function active(): boolean
		return tbl.matchId == matchId and tbl.phase == "exam" and tbl.slots[slot.index] == slot
	end
	for index, botTask in slot.tasks do
		task.wait(BOT_ANSWER_SECONDS)
		if not active() or now() >= tbl.endsAt then
			return
		end
		slot.answers[index] = if math.random() < BOT_CORRECT_CHANCE then botTask.answers[1] else "0"
		slot.answered = index
		notifyRival(tbl, slot)
	end
	task.wait(BOT_ANSWER_SECONDS)
	if active() and not slot.submitted then
		slot.submitted = true
		slot.elapsed = math.clamp(now() - tbl.startedAt, 0, tbl.duration)
		notifyRival(tbl, slot)
		if allDone(tbl) then
			finish(tbl)
		end
	end
end

local function startExam(tbl)
	local settings = tbl.settings
	local seed = os.time() + math.floor(os.clock() * 1000) + tbl.id * 7919
	local variants = {}
	for _, slot in tbl.slots do
		-- Одинаковый предмет даёт обоим один и тот же вариант.
		if not variants[slot.subject] then
			variants[slot.subject] = Variant.pick(Bank.getTasks(slot.subject), settings.count, seed)
		end
		slot.tasks = variants[slot.subject]
		slot.answers = {}
		slot.answered = 0
		slot.submitted = false
		slot.elapsed = 0
		slot.ready = false
		slot.rematch = false
	end

	tbl.matchId += 1
	local matchId = tbl.matchId
	tbl.duration = settings.time * 60
	tbl.startedAt = now()
	tbl.endsAt = tbl.startedAt + tbl.duration
	tbl.phase = "exam"
	push(tbl)

	task.delay(tbl.duration + Settings.graceSeconds, function()
		if tbl.matchId == matchId and tbl.phase == "exam" then
			finish(tbl)
		end
	end)

	for _, slot in tbl.slots do
		if slot.bot then
			task.spawn(runBot, tbl, slot, matchId)
		end
	end
end

-- fixed: настройки прошлого матча при реванше; без них настройки берутся из голосов.
local function startCountdown(tbl, fixed)
	local a, b = tbl.slots[1], tbl.slots[2]
	local settings = { lotTime = false, lotCount = false }
	if fixed then
		settings.time = fixed.time
		settings.count = fixed.count
	else
		settings.time = a.timeVote
		settings.count = a.countVote
		if a.timeVote ~= b.timeVote then
			settings.lotTime = true
			settings.time = if math.random(2) == 1 then a.timeVote else b.timeVote
		end
		if a.countVote ~= b.countVote then
			settings.lotCount = true
			settings.count = if math.random(2) == 1 then a.countVote else b.countVote
		end
	end
	tbl.settings = settings

	-- Если был жребий, даём две лишние секунды прочитать его результат.
	local seconds = Settings.countdownSeconds + (if settings.lotTime or settings.lotCount then 2 else 0)
	tbl.matchId += 1
	local matchId = tbl.matchId
	tbl.startsAt = now() + seconds
	tbl.phase = "countdown"
	push(tbl)

	task.delay(seconds, function()
		if tbl.matchId == matchId and tbl.phase == "countdown" then
			startExam(tbl)
		end
	end)
end

local function resetReady(tbl)
	for _, slot in tbl.slots do
		slot.ready = false
	end
	syncBot(tbl)
end

local handlers = {}

function handlers.setSubject(tbl, slot, value)
	if tbl.phase ~= "setup" then
		return
	end
	if type(value) ~= "string" or not Subjects.byId[value] or Bank.count(value) == 0 then
		return
	end
	slot.subject = value
	resetReady(tbl)
	push(tbl)
end

function handlers.voteTime(tbl, slot, value)
	if tbl.phase ~= "setup" or not Settings.isTimeOption(value) then
		return
	end
	slot.timeVote = value
	resetReady(tbl)
	push(tbl)
end

function handlers.voteCount(tbl, slot, value)
	if tbl.phase ~= "setup" or not Settings.isCountOption(value) then
		return
	end
	slot.countVote = value
	resetReady(tbl)
	push(tbl)
end

function handlers.ready(tbl, slot, value)
	if tbl.phase ~= "setup" then
		return
	end
	if value == true and not slot.subject then
		return
	end
	slot.ready = value == true
	local rival = rivalOf(tbl, slot)
	if slot.ready and rival.ready then
		startCountdown(tbl, nil)
	else
		push(tbl)
	end
end

-- Сажает напротив тестового соперника. Работает только в Studio.
function handlers.addBot(tbl, slot)
	if not RunService:IsStudio() or tbl.phase ~= "idle" then
		return
	end
	local index = 3 - slot.index
	if tbl.slots[index] or tbl.seats[index].Occupant then
		return
	end
	local available = {}
	for _, subject in Subjects.list do
		if Bank.count(subject.id) > 0 then
			table.insert(available, subject.id)
		end
	end
	if #available == 0 then
		return
	end
	local bot = newBotSlot(index)
	bot.subject = available[math.random(#available)]
	tbl.slots[index] = bot
	enterSetup(tbl)
end

function handlers.leave(tbl, slot)
	if tbl.phase == "exam" or tbl.phase == "countdown" then
		return
	end
	local player, seat = slot.player, tbl.seats[slot.index]
	removeSlot(tbl, slot.index)
	standUp(player, seat)
end

function handlers.answer(tbl, slot, payload)
	if tbl.phase ~= "exam" or slot.submitted then
		return
	end
	if now() > tbl.endsAt + Settings.graceSeconds or type(payload) ~= "table" then
		return
	end
	local index, value = payload.index, payload.value
	if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > #slot.tasks then
		return
	end
	if type(value) ~= "string" or #value > 200 then
		return
	end
	-- В бланке дробная часть отделяется запятой, поэтому точка всегда заменяется на запятую.
	slot.answers[index] = (string.gsub(Text.truncate(value, Settings.answerMaxChars), "%.", ","))

	local answered = 0
	for taskIndex = 1, #slot.tasks do
		local answer = slot.answers[taskIndex]
		if answer and Text.normalize(answer) ~= "" then
			answered += 1
		end
	end
	if answered ~= slot.answered then
		slot.answered = answered
		notifyRival(tbl, slot)
	end
end

function handlers.submit(tbl, slot)
	if tbl.phase ~= "exam" or slot.submitted then
		return
	end
	slot.submitted = true
	slot.elapsed = math.clamp(now() - tbl.startedAt, 0, tbl.duration)
	notifyRival(tbl, slot)
	local rival = rivalOf(tbl, slot)
	if rival.bot and not rival.submitted then
		-- Тестовый соперник не заставляет себя ждать.
		rival.submitted = true
		rival.elapsed = slot.elapsed
	end
	if allDone(tbl) then
		finish(tbl)
	end
end

function handlers.rematch(tbl, slot)
	if tbl.phase ~= "results" then
		return
	end
	local rival = rivalOf(tbl, slot)
	if not isPresent(rival) then
		return
	end
	slot.rematch = true
	if rival.rematch then
		-- Оба согласны: возвращаемся к настройке. Прошлые предметы и голоса остаются выбранными,
		-- их можно поменять перед новым матчем.
		enterSetup(tbl)
		return
	end
	sendState(slot, {
		phase = "resultsUpdate",
		rivalPresent = true,
		rematch = { me = true, rival = false },
	})
	sendState(rival, {
		phase = "resultsUpdate",
		rivalPresent = true,
		rematch = { me = false, rival = true },
	})
end

local function onAction(player: Player, action: any, payload: any)
	local entry = entryByPlayer[player]
	if not entry or type(action) ~= "string" then
		return
	end
	local handler = handlers[action]
	if handler then
		handler(entry.tbl, entry.slot, payload)
	end
end

local function onOccupantChanged(tbl, index: number)
	local seat = tbl.seats[index]
	local humanoid = seat.Occupant
	local slot = tbl.slots[index]

	if humanoid then
		local player = Players:GetPlayerFromCharacter(humanoid.Parent)
		if not player then
			return
		end
		if slot and slot.player == player then
			return -- игрок вернулся на своё место
		end
		-- Чужое место, идущий матч или игрок уже числится за другой партой: сесть нельзя.
		if slot or tbl.phase ~= "idle" or entryByPlayer[player] then
			task.defer(standUp, player, seat)
			return
		end
		local created = newSlot(player, index)
		tbl.slots[index] = created
		entryByPlayer[player] = { tbl = tbl, slot = created }
		if tbl.slots[1] and tbl.slots[2] then
			enterSetup(tbl)
		else
			push(tbl)
		end
	elseif slot then
		if tbl.phase == "exam" or tbl.phase == "countdown" then
			-- Во время матча место сохраняется за игроком, возвращаем его за парту.
			task.delay(0.3, reseat, tbl, slot)
		else
			removeSlot(tbl, index)
		end
	end
end

local function onPlayerRemoving(player: Player)
	local entry = entryByPlayer[player]
	if not entry then
		return
	end
	local tbl, slot = entry.tbl, entry.slot
	if tbl.phase == "exam" then
		entryByPlayer[player] = nil
		slot.left = true
		if not slot.submitted then
			slot.submitted = true
			slot.elapsed = tbl.duration
		end
		local rival = rivalOf(tbl, slot)
		if not isPresent(rival) or rival.bot then
			-- Вышли оба или остался только тестовый соперник: матч просто сбрасывается.
			tbl.matchId += 1
			tbl.slots = {}
			tbl.phase = "idle"
			refreshStatus(tbl)
			return
		end
		notifyRival(tbl, slot)
		if allDone(tbl) then
			finish(tbl)
		end
	else
		if tbl.phase == "countdown" then
			tbl.matchId += 1 -- отменяет старт экзамена
			tbl.phase = "setup"
		end
		removeSlot(tbl, slot.index)
	end
end

local function onCharacterAdded(player: Player)
	local entry = entryByPlayer[player]
	if entry then
		task.delay(1, reseat, entry.tbl, entry.slot)
	end
end

local function newRemote(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = ReplicatedStorage:WaitForChild("Remotes")
	return remote
end

-- worldTables: список парт из World.build. setScoreboard: функция, которая пишет текст на доску побед.
function Duel.start(worldTables, setScoreboard: ((string) -> ())?)
	showScoreboard = setScoreboard
	refreshScoreboard()

	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	folder.Parent = ReplicatedStorage

	stateEvent = newRemote("State")
	rivalEvent = newRemote("Rival")
	actionEvent = newRemote("Action")
	actionEvent.OnServerEvent:Connect(onAction)

	for _, worldTable in worldTables do
		local tbl = {
			id = worldTable.id,
			seats = worldTable.seats,
			prompts = worldTable.prompts,
			setStatus = worldTable.setStatus,
			setLamp = worldTable.setLamp,
			celebrate = worldTable.celebrate,
			phase = "idle",
			slots = {},
			matchId = 0,
		}
		table.insert(tables, tbl)

		for index, seat in tbl.seats do
			seat:GetPropertyChangedSignal("Occupant"):Connect(function()
				onOccupantChanged(tbl, index)
			end)
			tbl.prompts[index].Triggered:Connect(function(player: Player)
				if seat.Occupant or tbl.slots[index] or tbl.phase ~= "idle" or entryByPlayer[player] then
					return
				end
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.Health > 0 and not humanoid.Sit then
					seat:Sit(humanoid)
				end
			end)
		end
		refreshStatus(tbl)
	end

	Players.PlayerRemoving:Connect(onPlayerRemoving)
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			onCharacterAdded(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end

	-- Таймер на табличках парт.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, tbl in tables do
				if tbl.phase == "exam" then
					refreshStatus(tbl)
				end
			end
		end
	end)
end

return Duel
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Точка входа сервера: загружает банк заданий, строит класс и запускает матчи за партами.
local Config = require(script.Parent.Config)
local World = require(script.Parent.World)
local Bank = require(script.Parent.Bank)
local Duel = require(script.Parent.Duel)

Bank.load()
local world = World.build(Config.tableCount, { randomTask = Bank.randomTextTask })
Duel.start(world.tables, world.setScoreboard)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Variant</string>
          <string name="Source"><![CDATA[-- Составление варианта. Если у заданий есть номера ЕГЭ, вариант собирается по номерам:
-- по одному заданию на номер, в порядке номеров, как на экзамене. Иначе берутся случайные задания разных тем.
-- Свой генератор случайных чисел нужен, чтобы один и тот же seed давал один и тот же вариант.
local Variant = {}

local MODULUS = 2147483647

local function newRandom(seed: number)
	local state = math.floor(seed) % MODULUS
	if state <= 0 then
		state += MODULUS - 1
	end
	-- Возвращает целое от 1 до n.
	return function(n: number): number
		state = (state * 48271) % MODULUS
		return state % n + 1
	end
end

local function shuffle(list, random)
	for index = #list, 2, -1 do
		local other = random(index)
		list[index], list[other] = list[other], list[index]
	end
end

-- Номера ЕГЭ, для которых в банке есть задания, по возрастанию.
function Variant.numbersOf(tasks): { number }
	local seen, numbers = {}, {}
	for _, task in tasks do
		if task.number and not seen[task.number] then
			seen[task.number] = true
			table.insert(numbers, task.number)
		end
	end
	table.sort(numbers)
	return numbers
end

-- Вариант по номерам. count = 0 означает всю первую часть; иначе номера делятся на count
-- подряд идущих групп и из каждой берётся один случайный номер, чтобы сокращённый вариант
-- охватывал экзамен от начала до конца.
local function pickByNumbers(tasks, numbers: { number }, count: number, random)
	local byNumber = {}
	for _, task in tasks do
		if task.number then
			byNumber[task.number] = byNumber[task.number] or {}
			table.insert(byNumber[task.number], task)
		end
	end

	local chosen = numbers
	if count > 0 and count < #numbers then
		chosen = {}
		for group = 1, count do
			local first = math.floor((group - 1) * #numbers / count) + 1
			local last = math.floor(group * #numbers / count)
			table.insert(chosen, numbers[first + random(last - first + 1) - 1])
		end
	end

	local picked = {}
	for _, number in chosen do
		local pool = byNumber[number]
		table.insert(picked, pool[random(#pool)])
	end
	return picked
end

-- Выбирает count заданий без учёта номеров. Задания с одинаковым group берутся по очереди,
-- чтобы темы не повторялись подряд.
local function pickByGroups(tasks, count: number, random)
	local groups, order = {}, {}
	for _, task in tasks do
		local key = task.group or task.id or "общая"
		if not groups[key] then
			groups[key] = {}
			table.insert(order, key)
		end
		table.insert(groups[key], task)
	end
	table.sort(order)
	shuffle(order, random)
	for _, key in order do
		shuffle(groups[key], random)
	end

	local picked = {}
	local round = 1
	while #picked < count do
		local added = false
		for _, key in order do
			local task = groups[key][round]
			if task then
				table.insert(picked, task)
				added = true
				if #picked >= count then
					break
				end
			end
		end
		if not added then
			break
		end
		round += 1
	end
	return picked
end

-- count = 0 означает всю первую часть (для банка без номеров это 20 заданий).
function Variant.pick(tasks, count: number, seed: number)
	local random = newRandom(seed)
	local numbers = Variant.numbersOf(tasks)
	if #numbers > 0 then
		return pickByNumbers(tasks, numbers, count, random)
	end
	return pickByGroups(tasks, if count > 0 then count else 20, random)
end

return Variant
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Строит класс кодом при запуске сервера: комната, окна, доски, плакаты, мебель, парты
-- и интерактивные предметы (глобус, книжные полки, выключатель, звонок, доска «Задача дня»).
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local World = {}

local COLORS = {
	floor = Color3.fromRGB(196, 164, 124),
	rug = Color3.fromRGB(120, 36, 70),
	wall = Color3.fromRGB(244, 240, 232),
	panel = Color3.fromRGB(86, 122, 118),
	trim = Color3.fromRGB(250, 250, 250),
	beam = Color3.fromRGB(110, 82, 58),
	glass = Color3.fromRGB(170, 215, 240),
	table = Color3.fromRGB(176, 132, 92),
	wood = Color3.fromRGB(128, 92, 62),
	leg = Color3.fromRGB(90, 84, 96),
	seatA = Color3.fromRGB(184, 21, 90),
	seatB = Color3.fromRGB(13, 118, 128),
	board = Color3.fromRGB(34, 60, 48),
	ink = Color3.fromRGB(27, 20, 32),
	paper = Color3.fromRGB(255, 255, 255),
	active = Color3.fromRGB(184, 21, 90),
	lampOn = Color3.fromRGB(255, 232, 170),
	lampOff = Color3.fromRGB(150, 146, 140),
	plant = Color3.fromRGB(58, 138, 72),
	pot = Color3.fromRGB(170, 96, 60),
	ocean = Color3.fromRGB(46, 120, 190),
	brass = Color3.fromRGB(200, 160, 60),
}

local BOOK_COLORS = {
	Color3.fromRGB(184, 21, 90),
	Color3.fromRGB(13, 118, 128),
	Color3.fromRGB(214, 160, 40),
	Color3.fromRGB(60, 90, 160),
	Color3.fromRGB(90, 150, 80),
	Color3.fromRGB(150, 70, 50),
}

local POSTERS = {
	{ text = "a² + b² = c²\nтеорема Пифагора", color = Color3.fromRGB(251, 227, 237) },
	{ text = "ЖИ, ШИ пиши с буквой И\nЧА, ЩА пиши с буквой А", color = Color3.fromRGB(221, 241, 242) },
	{ text = "F = m · a\nвторой закон Ньютона", color = Color3.fromRGB(251, 239, 211) },
	{ text = "H₂O   CO₂   NaCl   O₂\nхимия вокруг нас", color = Color3.fromRGB(223, 243, 231) },
	{ text = "1 байт = 8 бит\n1 Кбайт = 1024 байта", color = Color3.fromRGB(230, 228, 250) },
	{ text = "988 · 1242 · 1380 · 1812 · 1861 · 1961\nдаты, которые стоит помнить", color = Color3.fromRGB(251, 227, 237) },
	{ text = "sin²α + cos²α = 1\nосновное тригонометрическое тождество", color = Color3.fromRGB(221, 241, 242) },
	{ text = "be · was / were · been\ngo · went · gone", color = Color3.fromRGB(251, 239, 211) },
}

local GLOBE_FACTS = {
	"Байкал содержит около пятой части всей незамёрзшей пресной воды планеты.",
	"Россия расположена в 11 часовых зонах.",
	"Тихий океан больше, чем вся суша Земли вместе взятая.",
	"Сахара по площади сравнима с Китаем.",
	"Самая высокая вершина России, Эльбрус, поднимается на 5642 метра.",
	"Экватор пересекает три материка: Африку, Южную Америку и острова Азии.",
	"Марианская впадина глубже, чем высота Эвереста.",
	"Антарктида это самый высокий материк: её средняя высота больше двух километров.",
}

local BOOK_FACTS = {
	"Онегинская строфа состоит из 14 строк, как и сонет.",
	"Гоголь назвал «Мёртвые души» поэмой, хотя они написаны прозой.",
	"ДНК человека на 99,9% одинакова у всех людей.",
	"Ноль не является ни положительным, ни отрицательным числом.",
	"Слово «робот» придумал чешский писатель Карел Чапек в 1920 году.",
	"В сердце человека четыре камеры, а у лягушки три.",
	"Звук в воздухе проходит примерно 340 метров за секунду.",
	"В русском алфавите 33 буквы, из них 10 гласных.",
	"Первым программистом считают Аду Лавлейс, она жила в XIX веке.",
}

local function newPart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function newPrompt(part: BasePart, actionText: string, objectText: string): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	return prompt
end

local function newSound(parent: Instance, soundId: string, volume: number, speed: number?): Sound
	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume
	sound.PlaybackSpeed = speed or 1
	sound.RollOffMaxDistance = 80
	sound.Parent = parent
	return sound
end

-- Надписи на грани детали. Возвращает SurfaceGui.
local function newSurface(part: BasePart, face: Enum.NormalId): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = part
	return gui
end

local function newText(parent: Instance, text: string, size: UDim2, position: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

-- Всплывающая подпись над предметом. Возвращает функцию показа текста на несколько секунд.
-- toward: сдвиг подписи в сторону комнаты, чтобы она не уходила в стену за предметом.
local function newBubble(part: BasePart, height: number, toward: Vector3?): (string) -> ()
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Bubble"
	billboard.Size = UDim2.fromOffset(340, 96)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, height, 0) + (toward or Vector3.zero)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 60
	billboard.Enabled = false
	billboard.Parent = part

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = COLORS.paper
	frame.BorderSizePixel = 0
	frame.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = COLORS.active
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, -20, 1, -12)
	label.Position = UDim2.fromOffset(10, 6)
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 16
	label.TextWrapped = true
	label.TextColor3 = COLORS.ink
	label.Parent = frame

	local token = 0
	return function(text: string)
		token += 1
		local mine = token
		label.Text = text
		billboard.Enabled = true
		task.delay(7, function()
			if token == mine then
				billboard.Enabled = false
			end
		end)
	end
end

-- Выдаёт факты по кругу в случайном порядке, чтобы они не повторялись подряд.
local function factCycle(facts: { string }): () -> string
	local order, position = {}, 0
	return function(): string
		if position >= #order then
			order = table.clone(facts)
			for index = #order, 2, -1 do
				local other = math.random(index)
				order[index], order[other] = order[other], order[index]
			end
			position = 0
		end
		position += 1
		return order[position]
	end
end

-- Стена вдоль оси X (север и юг) или Z (запад и восток) с панелью внизу и плинтусом.
local function buildWall(parent: Instance, name: string, center: Vector3, length: number, alongX: boolean, inward: Vector3)
	local function size(thickness: number, height: number): Vector3
		return if alongX then Vector3.new(length, height, thickness) else Vector3.new(thickness, height, length)
	end
	newPart(parent, name, size(1, 16), CFrame.new(center.X, 8, center.Z), COLORS.wall)
	local panelAt = center + inward * 0.6
	newPart(parent, name .. "Panel", size(0.2, 4.5), CFrame.new(panelAt.X, 2.25, panelAt.Z), COLORS.panel)
	local trimAt = center + inward * 0.65
	newPart(parent, name .. "Trim", size(0.3, 0.35), CFrame.new(trimAt.X, 4.65, trimAt.Z), COLORS.trim)
end

local function buildWindow(parent: Instance, x: number, z: number, inward: Vector3)
	local at = Vector3.new(x, 9.5, z) + inward * 0.55
	local glass = newPart(parent, "Window", Vector3.new(0.15, 6.5, 9), CFrame.new(at), COLORS.glass, Enum.Material.Glass)
	glass.Transparency = 0.35
	glass.Reflectance = 0.15
	local frameAt = at + inward * 0.05
	newPart(parent, "WindowTop", Vector3.new(0.3, 0.4, 9.8), CFrame.new(frameAt.X, 12.95, frameAt.Z), COLORS.trim)
	newPart(parent, "WindowSill", Vector3.new(0.9, 0.4, 10.2), CFrame.new(frameAt.X + inward.X * 0.3, 6.05, frameAt.Z), COLORS.trim)
	newPart(parent, "WindowLeft", Vector3.new(0.3, 7.3, 0.4), CFrame.new(frameAt.X, 9.5, frameAt.Z - 4.7), COLORS.trim)
	newPart(parent, "WindowRight", Vector3.new(0.3, 7.3, 0.4), CFrame.new(frameAt.X, 9.5, frameAt.Z + 4.7), COLORS.trim)
	newPart(parent, "WindowBar", Vector3.new(0.25, 6.5, 0.25), CFrame.new(frameAt.X, 9.5, frameAt.Z), COLORS.trim)
	newPart(parent, "WindowCross", Vector3.new(0.25, 0.25, 9), CFrame.new(frameAt.X, 9.5, frameAt.Z), COLORS.trim)
end

local function buildPoster(parent: Instance, size: Vector3, cframe: CFrame, face: Enum.NormalId, poster)
	local part = newPart(parent, "Poster", size, cframe, poster.color)
	local gui = newSurface(part, face)
	newText(gui, poster.text, UDim2.fromScale(0.9, 0.84), UDim2.fromScale(0.05, 0.08), COLORS.ink)
end

local function buildPlant(parent: Instance, x: number, z: number)
	newPart(parent, "Pot", Vector3.new(2.2, 2, 2.2), CFrame.new(x, 1, z), COLORS.pot)
	for index, offset in { Vector3.new(0, 3.4, 0), Vector3.new(0.7, 4.4, 0.3), Vector3.new(-0.6, 4.6, -0.4), Vector3.new(0.1, 5.5, 0) } do
		local leaf = newPart(parent, "Leaves" .. index, Vector3.new(2.6, 2.6, 2.6), CFrame.new(x + offset.X, offset.Y, z + offset.Z), COLORS.plant, Enum.Material.Grass)
		leaf.Shape = Enum.PartType.Ball
	end
end

local function buildBookshelf(parent: Instance, x: number, z: number): Part
	local model = Instance.new("Model")
	model.Name = "Bookshelf"
	model.Parent = parent
	local back = newPart(model, "Back", Vector3.new(8, 9, 0.4), CFrame.new(x, 4.5, z + 0.8), COLORS.wood, Enum.Material.Wood)
	newPart(model, "SideLeft", Vector3.new(0.4, 9, 2), CFrame.new(x - 4, 4.5, z), COLORS.wood, Enum.Material.Wood)
	newPart(model, "SideRight", Vector3.new(0.4, 9, 2), CFrame.new(x + 4, 4.5, z), COLORS.wood, Enum.Material.Wood)
	for level = 0, 3 do
		local y = 0.2 + level * 2.9
		newPart(model, "Shelf", Vector3.new(8, 0.3, 2), CFrame.new(x, y, z), COLORS.wood, Enum.Material.Wood)
		if level < 3 then
			local cursor = x - 3.6
			while cursor < x + 3.2 do
				local width = 0.3 + math.random() * 0.4
				local height = 1.5 + math.random() * 0.9
				newPart(
					model,
					"Book",
					Vector3.new(width, height, 1.3),
					CFrame.new(cursor + width / 2, y + 0.15 + height / 2, z),
					BOOK_COLORS[math.random(#BOOK_COLORS)]
				)
				cursor += width + 0.05
			end
		end
	end
	return back
end

local function buildRoom(parent: Instance)
	newPart(parent, "Floor", Vector3.new(84, 1, 64), CFrame.new(0, -0.5, 0), COLORS.floor, Enum.Material.WoodPlanks)
	newPart(parent, "Rug", Vector3.new(10, 0.1, 40), CFrame.new(0, 0.05, 4), COLORS.rug, Enum.Material.Fabric)

	buildWall(parent, "WallNorth", Vector3.new(0, 0, -32.5), 84, true, Vector3.new(0, 0, 1))
	buildWall(parent, "WallSouth", Vector3.new(0, 0, 32.5), 84, true, Vector3.new(0, 0, -1))
	buildWall(parent, "WallWest", Vector3.new(-42.5, 0, 0), 66, false, Vector3.new(1, 0, 0))
	buildWall(parent, "WallEast", Vector3.new(42.5, 0, 0), 66, false, Vector3.new(-1, 0, 0))

	for _, z in { -20, 0, 20 } do
		buildWindow(parent, -42, z, Vector3.new(1, 0, 0))
		buildWindow(parent, 42, z, Vector3.new(-1, 0, 0))
	end

	-- Плакаты между окнами на боковых стенах и на задней стене.
	local sideSpots = { -10, 10 }
	for index, z in sideSpots do
		buildPoster(parent, Vector3.new(0.2, 4.6, 6.4), CFrame.new(-41.85, 9.6, z), Enum.NormalId.Right, POSTERS[index])
		buildPoster(parent, Vector3.new(0.2, 4.6, 6.4), CFrame.new(41.85, 9.6, z), Enum.NormalId.Left, POSTERS[index + 2])
	end
	for index, x in { -27, -16, 16, 27 } do
		buildPoster(parent, Vector3.new(7.4, 4.6, 0.2), CFrame.new(x, 10.6, 31.85), Enum.NormalId.Front, POSTERS[index + 4])
	end

	-- Невидимый потолок: со шкафа или парты нельзя перепрыгнуть через стену.
	local ceiling = newPart(parent, "Ceiling", Vector3.new(86, 1, 66), CFrame.new(0, 16.7, 0), COLORS.wall)
	ceiling.Transparency = 1
	ceiling.CastShadow = false

	-- Балки под потолком: к ним подвешены лампы.
	for _, z in { -10, 14 } do
		newPart(parent, "Beam", Vector3.new(84, 0.8, 1), CFrame.new(0, 15.6, z), COLORS.beam, Enum.Material.Wood)
	end
	for _, x in { -24, 0, 24 } do
		newPart(parent, "CrossBeam", Vector3.new(1, 0.6, 64), CFrame.new(x, 15.9, 0), COLORS.beam, Enum.Material.Wood)
	end

	-- Дверь на задней стене.
	newPart(parent, "Door", Vector3.new(5, 9, 0.6), CFrame.new(0, 4.5, 31.6), COLORS.wood, Enum.Material.Wood)
	newPart(parent, "DoorFrame", Vector3.new(5.8, 9.4, 0.4), CFrame.new(0, 4.7, 31.75), COLORS.trim)
	newPart(parent, "DoorKnob", Vector3.new(0.5, 0.5, 0.5), CFrame.new(1.8, 4.4, 31.15), COLORS.brass, Enum.Material.Metal).Shape =
		Enum.PartType.Ball

	buildPlant(parent, -39, -29)
	buildPlant(parent, 39, -29)
	buildPlant(parent, -39, 27)
	buildPlant(parent, 39, 27)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(10, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.05, 25)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Parent = parent

	Lighting.ClockTime = 14
	Lighting.Brightness = 2
	Lighting.Ambient = Color3.fromRGB(130, 126, 134)
end

-- Доска с заголовком и текстом. Возвращает надпись с текстом.
local function buildBoard(parent: Instance, name: string, x: number, width: number, title: string): (Part, TextLabel)
	newPart(parent, name .. "Frame", Vector3.new(width + 0.8, 9.8, 0.3), CFrame.new(x, 9.5, -31.85), COLORS.wood, Enum.Material.Wood)
	local board = newPart(parent, name, Vector3.new(width, 9, 0.3), CFrame.new(x, 9.5, -31.7), COLORS.board)
	local gui = newSurface(board, Enum.NormalId.Back)
	newText(gui, title, UDim2.fromScale(0.9, 0.2), UDim2.fromScale(0.05, 0.04), COLORS.paper, Enum.Font.GothamBlack)
	local body = newText(gui, "", UDim2.fromScale(0.9, 0.68), UDim2.fromScale(0.05, 0.28), COLORS.paper, Enum.Font.GothamMedium)
	body.TextYAlignment = Enum.TextYAlignment.Top
	return board, body
end

-- Доска «Задача дня»: по нажатию показывает случайное задание из банка, через 20 секунд ответ.
local function buildDailyTask(parent: Instance, randomTask: (() -> any)?)
	local board, body = buildBoard(parent, "DailyTaskBoard", 28, 20, "ЗАДАЧА ДНЯ")
	body.TextXAlignment = Enum.TextXAlignment.Left
	body.Text = "Подойдите к доске и нажмите E, чтобы получить задачу."
	local prompt = newPrompt(board, "Новая задача", "Задача дня")
	prompt.MaxActivationDistance = 16

	local token = 0
	prompt.Triggered:Connect(function()
		local picked = randomTask and randomTask()
		if not picked then
			body.Text = "Банк заданий пуст."
			return
		end
		token += 1
		local mine = token
		body.Text = string.format("%s\n\n%s\n\nОтвет появится через 20 секунд.", picked.subject, picked.task.text)
		task.delay(20, function()
			if token == mine then
				body.Text = string.format(
					"%s\n\n%s\n\nОтвет: %s\n%s",
					picked.subject,
					picked.task.text,
					picked.task.answers[1],
					picked.task.explanation
				)
			end
		end)
	end)
end

local function buildTeacherCorner(parent: Instance)
	newPart(parent, "TeacherDesk", Vector3.new(12, 0.5, 4.5), CFrame.new(-22, 3.4, -25), COLORS.wood, Enum.Material.Wood)
	newPart(parent, "TeacherDeskFront", Vector3.new(12, 3.1, 0.4), CFrame.new(-22, 1.6, -23), COLORS.wood, Enum.Material.Wood)
	for _, dx in { -5.6, 5.6 } do
		newPart(parent, "TeacherDeskSide", Vector3.new(0.4, 3.1, 4.5), CFrame.new(-22 + dx, 1.6, -25), COLORS.wood, Enum.Material.Wood)
	end

	-- Глобус: его можно покрутить и узнать факт.
	newPart(parent, "GlobeStand", Vector3.new(1.4, 0.3, 1.4), CFrame.new(-25, 3.8, -25), COLORS.brass, Enum.Material.Metal)
	newPart(parent, "GlobeAxis", Vector3.new(0.2, 1, 0.2), CFrame.new(-25, 4.4, -25), COLORS.brass, Enum.Material.Metal)
	local globe = newPart(parent, "Globe", Vector3.new(2.8, 2.8, 2.8), CFrame.new(-25, 6.1, -25), COLORS.ocean)
	globe.Shape = Enum.PartType.Ball
	local landSpots = {
		{ Vector3.new(0.9, 0.5, 0.8), 1.2 },
		{ Vector3.new(-0.8, 0.2, 0.95), 1 },
		{ Vector3.new(0.3, -0.6, -1.05), 1.1 },
		{ Vector3.new(-1.05, -0.4, -0.5), 0.9 },
		{ Vector3.new(0.2, 1.15, -0.3), 0.8 },
	}
	local lands = {}
	for index, spot in landSpots do
		local land = newPart(parent, "GlobeLand" .. index, Vector3.one * spot[2], globe.CFrame * CFrame.new(spot[1]), COLORS.plant)
		land.Shape = Enum.PartType.Ball
		land.CanCollide = false
		lands[index] = { part = land, offset = CFrame.new(spot[1]) }
	end

	-- Глобус вращается только несколько секунд после толчка. В покое детали не двигаются,
	-- и серверу нечего рассылать игрокам.
	local angle = 0
	local base = globe.CFrame
	local spinning = false
	local speed = 0
	local function spin()
		speed = 9
		if spinning then
			return
		end
		spinning = true
		task.spawn(function()
			while speed > 0.2 do
				local dt = task.wait(0.05)
				angle += speed * dt
				speed -= 2.2 * dt
				local turned = base * CFrame.Angles(0, angle, 0)
				globe.CFrame = turned
				for _, land in lands do
					land.part.CFrame = turned * land.offset
				end
			end
			spinning = false
		end)
	end

	local showFact = newBubble(globe, 3.5)
	local nextFact = factCycle(GLOBE_FACTS)
	newPrompt(globe, "Покрутить", "Глобус").Triggered:Connect(function()
		spin()
		showFact(nextFact())
	end)

	-- Стопка тетрадей и кружка для уюта.
	for index = 0, 3 do
		newPart(parent, "Notebook", Vector3.new(1.6, 0.12, 2.1), CFrame.new(-19, 3.72 + index * 0.13, -25) * CFrame.Angles(0, index * 0.15, 0), BOOK_COLORS[index % #BOOK_COLORS + 1])
	end
	newPart(parent, "Mug", Vector3.new(0.6, 0.7, 0.6), CFrame.new(-17.4, 4, -24.2), COLORS.trim)
end

local function buildShelves(parent: Instance)
	local nextFact = factCycle(BOOK_FACTS)
	for _, x in { -35, 35 } do
		local back = buildBookshelf(parent, x, 30.6)
		local showFact = newBubble(back, 3, Vector3.new(0, 0, -3))
		newPrompt(back, "Открыть книгу", "Книжная полка").Triggered:Connect(function()
			showFact(nextFact())
		end)
	end
end

-- Подвесные лампы, выключатель и школьный звонок у двери.
local function buildLights(parent: Instance, spots: { Vector3 })
	local lamps = {}
	for _, spot in spots do
		newPart(parent, "LampCord", Vector3.new(0.15, 3.6, 0.15), CFrame.new(spot.X, 13.4, spot.Z), COLORS.leg)
		local shade = newPart(parent, "Lamp", Vector3.new(2.4, 1, 2.4), CFrame.new(spot.X, 11.2, spot.Z), COLORS.lampOn, Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Range = 26
		light.Brightness = 1.1
		light.Color = COLORS.lampOn
		light.Parent = shade
		table.insert(lamps, { shade = shade, light = light })
	end

	local switch = newPart(parent, "LightSwitch", Vector3.new(0.8, 1.2, 0.2), CFrame.new(5, 6, 31.88), COLORS.trim)
	local click = newSound(switch, "rbxasset://sounds/switch.wav", 0.6)
	local on = true
	local prompt = newPrompt(switch, "Выключить свет", "Выключатель")
	prompt.Triggered:Connect(function()
		on = not on
		click:Play()
		prompt.ActionText = if on then "Выключить свет" else "Включить свет"
		for _, lamp in lamps do
			lamp.light.Enabled = on
			lamp.shade.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
			lamp.shade.Color = if on then COLORS.lampOn else COLORS.lampOff
		end
	end)

	local bell = newPart(parent, "Bell", Vector3.new(1.6, 1.6, 0.6), CFrame.new(-5, 11, 31.7), COLORS.brass, Enum.Material.Metal)
	local ring = newSound(bell, "rbxasset://sounds/electronicpingshort.wav", 0.7, 0.7)
	local ringing = false
	newPrompt(bell, "Позвонить", "Школьный звонок").Triggered:Connect(function()
		if ringing then
			return
		end
		ringing = true
		local rest = bell.CFrame
		for strike = 1, 6 do
			ring:Play()
			bell.CFrame = rest * CFrame.Angles(0, 0, if strike % 2 == 0 then 0.12 else -0.12)
			task.wait(0.22)
		end
		bell.CFrame = rest
		ringing = false
	end)

	-- Часы над дверью показывают время сервера.
	local clock = newPart(parent, "Clock", Vector3.new(3.2, 3.2, 0.3), CFrame.new(0, 11.4, 31.8), COLORS.trim)
	local face = newSurface(clock, Enum.NormalId.Front)
	local time = newText(face, "", UDim2.fromScale(0.86, 0.5), UDim2.fromScale(0.07, 0.25), COLORS.ink, Enum.Font.RobotoMono)
	task.spawn(function()
		while true do
			time.Text = os.date("%H:%M")
			task.wait(15)
		end
	end)
end

local function buildSeat(parent: Instance, name: string, position: Vector3, lookAt: Vector3, color: Color3): (Seat, ProximityPrompt)
	local facing = CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z))

	local seat = Instance.new("Seat")
	seat.Name = name
	seat.Anchored = true
	seat.Size = Vector3.new(2.6, 0.4, 2.6)
	seat.CFrame = facing
	seat.Color = color
	seat.Material = Enum.Material.SmoothPlastic
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Parent = parent

	newPart(parent, name .. "Base", Vector3.new(1.6, 1.5, 1.6), CFrame.new(position.X, 0.75, position.Z), COLORS.leg)
	-- Спинка стоит позади сидящего, то есть с обратной стороны от парты.
	newPart(parent, name .. "Back", Vector3.new(2.6, 2.6, 0.3), facing * CFrame.new(0, 1.5, 1.45), color)

	local prompt = newPrompt(seat, "Сесть", "")
	prompt.MaxActivationDistance = 9
	return seat, prompt
end

local function buildTable(parent: Instance, id: number, center: Vector3)
	local model = Instance.new("Model")
	model.Name = "Table" .. id
	model.Parent = parent

	local top = newPart(model, "Top", Vector3.new(9, 0.4, 4.4), CFrame.new(center.X, 3.3, center.Z), COLORS.table, Enum.Material.Wood)
	for _, dx in { -4, 4 } do
		for _, dz in { -1.8, 1.8 } do
			newPart(model, "Leg", Vector3.new(0.4, 3.1, 0.4), CFrame.new(center.X + dx, 1.55, center.Z + dz), COLORS.leg)
		end
	end

	local seatA, promptA = buildSeat(model, "SeatA", Vector3.new(center.X, 1.7, center.Z - 3.8), center, COLORS.seatA)
	local seatB, promptB = buildSeat(model, "SeatB", Vector3.new(center.X, 1.7, center.Z + 3.8), center, COLORS.seatB)
	promptA.ObjectText = "Парта " .. id
	promptB.ObjectText = "Парта " .. id

	-- Бланки на парте.
	for _, dz in { -1.1, 1.1 } do
		newPart(model, "Sheet", Vector3.new(1.5, 0.05, 2), CFrame.new(center.X - 1.2, 3.53, center.Z + dz), COLORS.paper)
	end

	-- Настольная лампа: горит, пока за партой идёт экзамен.
	newPart(model, "DeskLampBase", Vector3.new(0.9, 0.2, 0.9), CFrame.new(center.X + 3.6, 3.6, center.Z), COLORS.leg)
	newPart(model, "DeskLampStem", Vector3.new(0.15, 1.6, 0.15), CFrame.new(center.X + 3.6, 4.4, center.Z), COLORS.leg)
	local shade = newPart(model, "DeskLampShade", Vector3.new(1.1, 0.6, 1.1), CFrame.new(center.X + 3.6, 5.4, center.Z), COLORS.lampOff)
	local lampLight = Instance.new("PointLight")
	lampLight.Range = 14
	lampLight.Brightness = 1.6
	lampLight.Color = COLORS.active
	lampLight.Enabled = false
	lampLight.Parent = shade

	-- Салют над местом победителя.
	local fanfare = newSound(top, "rbxasset://sounds/victory.wav", 0.5)
	local emitters = {}
	for index, seat in { seatA, seatB } do
		local holder = newPart(model, "Confetti" .. index, Vector3.one, CFrame.new(seat.Position + Vector3.new(0, 7, 0)), COLORS.paper)
		holder.Transparency = 1
		holder.CanCollide = false
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(1.5, 2.5)
		emitter.Speed = NumberRange.new(8, 16)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Acceleration = Vector3.new(0, -18, 0)
		emitter.Size = NumberSequence.new(0.5)
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, COLORS.seatA),
			ColorSequenceKeypoint.new(0.5, COLORS.brass),
			ColorSequenceKeypoint.new(1, COLORS.seatB),
		})
		emitter.Parent = holder
		emitters[index] = emitter
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "Status"
	billboard.Size = UDim2.fromScale(5.6, 1.6) -- размер в студах: издалека табличка уменьшается и не закрывает соседние
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.MaxDistance = 90
	billboard.Parent = top

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = COLORS.paper
	frame.BorderSizePixel = 0
	frame.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.18, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = COLORS.leg
	stroke.Parent = frame

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.fromScale(0.9, 0.4)
	title.Position = UDim2.fromScale(0.05, 0.08)
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.TextColor3 = COLORS.ink
	title.Text = "Парта " .. id
	title.Parent = frame

	local status = Instance.new("TextLabel")
	status.BackgroundTransparency = 1
	status.Size = UDim2.fromScale(0.92, 0.38)
	status.Position = UDim2.fromScale(0.04, 0.54)
	status.Font = Enum.Font.GothamMedium
	status.TextScaled = true
	status.TextColor3 = COLORS.ink
	status.TextWrapped = true
	status.Text = "Свободно"
	status.Parent = frame

	return {
		id = id,
		seats = { seatA, seatB },
		prompts = { promptA, promptB },
		setStatus = function(text: string, active: boolean?)
			status.Text = text
			stroke.Color = if active then COLORS.active else COLORS.leg
		end,
		setLamp = function(on: boolean)
			if lampLight.Enabled ~= on then
				lampLight.Enabled = on
				shade.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
				shade.Color = if on then COLORS.active else COLORS.lampOff
			end
		end,
		celebrate = function(seatIndex: number)
			local emitter = emitters[seatIndex]
			if emitter then
				emitter:Emit(80)
				fanfare:Play()
			end
		end,
	}
end

-- Запасная защита: если персонаж всё же оказался за пределами класса, возвращаем его ко входу.
local ROOM_HALF_X, ROOM_HALF_Z, ROOM_TOP, ROOM_BOTTOM = 43, 33, 18, -4
local RETURN_POINT = CFrame.new(0, 4, 25)

local function isOutside(position: Vector3): boolean
	return math.abs(position.X) > ROOM_HALF_X
		or math.abs(position.Z) > ROOM_HALF_Z
		or position.Y > ROOM_TOP
		or position.Y < ROOM_BOTTOM
end

World.isOutside = isOutside

local function keepPlayersInside()
	task.spawn(function()
		while true do
			task.wait(0.5)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") and isOutside(root.Position) then
					root.AssemblyLinearVelocity = Vector3.zero
					character:PivotTo(RETURN_POINT)
				end
			end
		end
	end)
end

local TABLE_COLUMNS = { -24, 0, 24 }
local TABLE_ROWS = { -10, 14 }

-- options.randomTask: функция, которая возвращает { subject = название, task = задание } для доски «Задача дня».
-- Возвращает { tables = список парт, setScoreboard = функция записи текста на доску побед }.
-- Парта: { id, seats, prompts, setStatus, setLamp, celebrate }.
function World.build(tableCount: number, options: { randomTask: (() -> any)? }?)
	local classroom = Instance.new("Folder")
	classroom.Name = "Classroom"
	classroom.Parent = Workspace

	buildRoom(classroom)

	-- Три доски на передней стене: победы, главная, задача дня.
	local _, mainBody = buildBoard(classroom, "Board", 0, 30, "ЕГЭ-ДУЭЛЬ")
	mainBody.Text = "Сядьте за парту вдвоём, выберите каждый свой предмет и время.\nПобеждает тот, кто лучше сдал свой экзамен."
	local _, scoreBody = buildBoard(classroom, "ScoreBoard", -28, 20, "ДОСКА ПОБЕД")
	scoreBody.TextXAlignment = Enum.TextXAlignment.Left
	buildDailyTask(classroom, options and options.randomTask)

	buildTeacherCorner(classroom)
	buildShelves(classroom)

	local tables, lampSpots = {}, {}
	local id = 0
	for _, z in TABLE_ROWS do
		for _, x in TABLE_COLUMNS do
			id += 1
			if id <= tableCount then
				table.insert(tables, buildTable(classroom, id, Vector3.new(x, 0, z)))
			end
			table.insert(lampSpots, Vector3.new(x, 0, z))
		end
	end
	buildLights(classroom, lampSpots)
	keepPlayersInside()

	return {
		tables = tables,
		setScoreboard = function(text: string)
			scoreBody.Text = text
		end,
	}
end

return World
