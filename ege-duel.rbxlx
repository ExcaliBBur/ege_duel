{"id":"physics-390","group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость периода колебаний пружинного маятника от амплитуды колебаний. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["45"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («амплитуда»), остальные характеристики у них должны совпадать: это установки 4 и 5.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Жёсткость","c"],["text",241.5,28.0,"Масса груза","c"],["text",366.5,28.0,"Амплитуда","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"120 Н/м","c"],["text",241.5,64.0,"400 г","c"],["text",366.5,64.0,"6 см","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"40 Н/м","c"],["text",241.5,100.0,"400 г","c"],["text",366.5,100.0,"4 см","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"120 Н/м","c"],["text",241.5,136.0,"200 г","c"],["text",366.5,136.0,"6 см","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"80 Н/м","c"],["text",241.5,172.0,"100 г","c"],["text",366.5,172.0,"6 см","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"80 Н/м","c"],["text",241.5,208.0,"100 г","c"],["text",366.5,208.0,"2 см","c"]]}},
{"id":"physics-391","group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость ёмкости плоского конденсатора от расстояния между пластинами. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["34"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («расстояние»), остальные характеристики у них должны совпадать: это установки 3 и 4.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Площадь пластин","c"],["text",241.5,28.0,"Расстояние","c"],["text",366.5,28.0,"Диэлектрик","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"100 см²","c"],["text",241.5,64.0,"1 мм","c"],["text",366.5,64.0,"парафин","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"200 см²","c"],["text",241.5,100.0,"2 мм","c"],["text",366.5,100.0,"слюда","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"100 см²","c"],["text",241.5,136.0,"2 мм","c"],["text",366.5,136.0,"воздух","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"100 см²","c"],["text",241.5,172.0,"4 мм","c"],["text",366.5,172.0,"воздух","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"50 см²","c"],["text",241.5,208.0,"2 мм","c"],["text",366.5,208.0,"парафин","c"]]}},
