{"id":"math_base-321","group":"b17_linear","number":17,"topic":"Простейшие уравнения","text":"Найдите корень уравнения -x + 21 = 18.","answers":["3"],"points":1,"kind":"number","explanation":"-1x = -3, x = 3."},
