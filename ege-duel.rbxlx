        <Item class="StringValue" referent="35">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "history", "tasks": [
{"id":"history-001","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) народовольцы убили Александра II\nБ) была принята «брежневская» Конституция СССР\nВ) в Москве прошли летние Олимпийские игры\nГ) началось правление Екатерины II\n\n1) 1097 г.\n2) 1721 г.\n3) 1762 г.\n4) 1881 г.\n5) 1977 г.\n6) 1980 г.","answers":["4563"],"points":2,"kind":"order","explanation":"народовольцы убили Александра II: 1881 г; была принята «брежневская» Конституция СССР: 1977 г; в Москве прошли летние Олимпийские игры: 1980 г; началось правление Екатерины II: 1762 г."},
{"id":"history-002","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) в СССР испытали первую атомную бомбу\nБ) началась Крымская война\nВ) был принят Судебник Ивана IV\nГ) было принято Соборное уложение\n\n1) 1550 г.\n2) 1598 г.\n3) 1649 г.\n4) 1853 г.\n5) 1934 г.\n6) 1949 г.","answers":["6413"],"points":2,"kind":"order","explanation":"в СССР испытали первую атомную бомбу: 1949 г; началась Крымская война: 1853 г; был принят Судебник Ивана IV: 1550 г; было принято Соборное уложение: 1649 г."},
{"id":"history-003","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началась русско-японская война\nБ) советские войска были введены в Афганистан\nВ) началось нашествие Батыя на Русь\nГ) была принята «сталинская» Конституция СССР\n\n1) 862 г.\n2) 1237 г.\n3) 1904 г.\n4) 1918 г.\n5) 1936 г.\n6) 1979 г.","answers":["3625"],"points":2,"kind":"order","explanation":"началась русско-японская война: 1904 г; советские войска были введены в Афганистан: 1979 г; началось нашествие Батыя на Русь: 1237 г; была принята «сталинская» Конституция СССР: 1936 г."},
{"id":"history-004","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началось правление Екатерины II\nБ) произошла Курская битва\nВ) был заключён Брестский мир\nГ) началось нашествие Батыя на Русь\n\n1) 1147 г.\n2) 1237 г.\n3) 1762 г.\n4) 1918 г.\n5) 1942 г.\n6) 1943 г.","answers":["3642"],"points":2,"kind":"order","explanation":"началось правление Екатерины II: 1762 г; произошла Курская битва: 1943 г; был заключён Брестский мир: 1918 г; началось нашествие Батыя на Русь: 1237 г."},
{"id":"history-005","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) в Москве прошли летние Олимпийские игры\nБ) произошла Курская битва\nВ) была введена всеобщая воинская повинность\nГ) началась русско-японская война\n\n1) 1874 г.\n2) 1881 г.\n3) 1904 г.\n4) 1943 г.\n5) 1962 г.\n6) 1980 г.","answers":["6413"],"points":2,"kind":"order","explanation":"в Москве прошли летние Олимпийские игры: 1980 г; произошла Курская битва: 1943 г; была введена всеобщая воинская повинность: 1874 г; началась русско-японская война: 1904 г."},
{"id":"history-006","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) Крым был присоединён к Российской империи\nБ) началось строительство Транссибирской магистрали\nВ) в Москве прошли летние Олимпийские игры\nГ) состоялась Переяславская рада\n\n1) 1654 г.\n2) 1783 г.\n3) 1891 г.\n4) 1917 г.\n5) 1955 г.\n6) 1980 г.","answers":["2361"],"points":2,"kind":"order","explanation":"Крым был присоединён к Российской империи: 1783 г; началось строительство Транссибирской магистрали: 1891 г; в Москве прошли летние Олимпийские игры: 1980 г; состоялась Переяславская рада: 1654 г."},
{"id":"history-007","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) произошёл Карибский кризис\nБ) прервалась династия Рюриковичей на московском престоле\nВ) состоялся Любечский съезд князей\nГ) закончилась Великая Отечественная война\n\n1) 1097 г.\n2) 1598 г.\n3) 1801 г.\n4) 1918 г.\n5) 1945 г.\n6) 1962 г.","answers":["6215"],"points":2,"kind":"order","explanation":"произошёл Карибский кризис: 1962 г; прервалась династия Рюриковичей на московском престоле: 1598 г; состоялся Любечский съезд князей: 1097 г; закончилась Великая Отечественная война: 1945 г."},
{"id":"history-008","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) была полностью снята блокада Ленинграда\nБ) в Москве прошли летние Олимпийские игры\nВ) в СССР запустили первый искусственный спутник Земли\nГ) М. С. Горбачёв стал Генеральным секретарём ЦК КПСС\n\n1) 1944 г.\n2) 1957 г.\n3) 1980 г.\n4) 1985 г.\n5) 1986 г.\n6) 1993 г.","answers":["1324"],"points":2,"kind":"order","explanation":"была полностью снята блокада Ленинграда: 1944 г; в Москве прошли летние Олимпийские игры: 1980 г; в СССР запустили первый искусственный спутник Земли: 1957 г; М. С. Горбачёв стал Генеральным секретарём ЦК КПСС: 1985 г."},
{"id":"history-009","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) Москва впервые упомянута в летописи\nБ) была принята «брежневская» Конституция СССР\nВ) был подписан Парижский мир, завершивший Крымскую войну\nГ) был принят Судебник Ивана III\n\n1) 1147 г.\n2) 1497 г.\n3) 1856 г.\n4) 1936 г.\n5) 1953 г.\n6) 1977 г.","answers":["1632"],"points":2,"kind":"order","explanation":"Москва впервые упомянута в летописи: 1147 г; была принята «брежневская» Конституция СССР: 1977 г; был подписан Парижский мир, завершивший Крымскую войну: 1856 г; был принят Судебник Ивана III: 1497 г."},
{"id":"history-010","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) произошла Октябрьская революция\nБ) началась Северная война\nВ) состоялся Любечский съезд князей\nГ) состоялась Переяславская рада\n\n1) 1097 г.\n2) 1240 г.\n3) 1654 г.\n4) 1700 г.\n5) 1904 г.\n6) 1917 г.","answers":["6413"],"points":2,"kind":"order","explanation":"произошла Октябрьская революция: 1917 г; началась Северная война: 1700 г; состоялся Любечский съезд князей: 1097 г; состоялась Переяславская рада: 1654 г."},
{"id":"history-011","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) в СССР запустили первый искусственный спутник Земли\nБ) была введена всеобщая воинская повинность\nВ) ополчение Минина и Пожарского освободило Москву\nГ) произошла битва на реке Калке\n\n1) 1223 г.\n2) 1497 г.\n3) 1612 г.\n4) 1654 г.\n5) 1874 г.\n6) 1957 г.","answers":["6531"],"points":2,"kind":"order","explanation":"в СССР запустили первый искусственный спутник Земли: 1957 г; была введена всеобщая воинская повинность: 1874 г; ополчение Минина и Пожарского освободило Москву: 1612 г; произошла битва на реке Калке: 1223 г."},
{"id":"history-012","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началось строительство Транссибирской магистрали\nБ) произошла Курская битва\nВ) состоялся Любечский съезд князей\nГ) была принята «сталинская» Конституция СССР\n\n1) 1097 г.\n2) 1891 г.\n3) 1934 г.\n4) 1936 г.\n5) 1943 г.\n6) 1977 г.","answers":["2514"],"points":2,"kind":"order","explanation":"началось строительство Транссибирской магистрали: 1891 г; произошла Курская битва: 1943 г; состоялся Любечский съезд князей: 1097 г; была принята «сталинская» Конституция СССР: 1936 г."},
{"id":"history-013","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) русские войска вступили в Париж\nБ) Крым был присоединён к Российской империи\nВ) началась Вторая мировая война\nГ) началась Северная война\n\n1) 1700 г.\n2) 1783 г.\n3) 1814 г.\n4) 1874 г.\n5) 1939 г.\n6) 1980 г.","answers":["3251"],"points":2,"kind":"order","explanation":"русские войска вступили в Париж: 1814 г; Крым был присоединён к Российской империи: 1783 г; началась Вторая мировая война: 1939 г; началась Северная война: 1700 г."},
{"id":"history-014","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) был издан указ о вольных хлебопашцах\nБ) завершился вывод советских войск из Афганистана\nВ) закончилась Великая Отечественная война\nГ) произошла битва на реке Калке\n\n1) 1097 г.\n2) 1223 г.\n3) 1803 г.\n4) 1914 г.\n5) 1945 г.\n6) 1989 г.","answers":["3652"],"points":2,"kind":"order","explanation":"был издан указ о вольных хлебопашцах: 1803 г; завершился вывод советских войск из Афганистана: 1989 г; закончилась Великая Отечественная война: 1945 г; произошла битва на реке Калке: 1223 г."},
{"id":"history-015","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) была полностью снята блокада Ленинграда\nБ) завершился вывод советских войск из Афганистана\nВ) был созван первый Земский собор\nГ) умер И. В. Сталин\n\n1) 1223 г.\n2) 1549 г.\n3) 1814 г.\n4) 1944 г.\n5) 1953 г.\n6) 1989 г.","answers":["4625"],"points":2,"kind":"order","explanation":"была полностью снята блокада Ленинграда: 1944 г; завершился вывод советских войск из Афганистана: 1989 г; был созван первый Земский собор: 1549 г; умер И. В. Сталин: 1953 г."},
{"id":"history-016","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началась сплошная коллективизация\nБ) была принята Конституция Российской Федерации\nВ) было принято Соборное уложение\nГ) М. С. Горбачёв стал Генеральным секретарём ЦК КПСС\n\n1) 1649 г.\n2) 1762 г.\n3) 1853 г.\n4) 1929 г.\n5) 1985 г.\n6) 1993 г.","answers":["4615"],"points":2,"kind":"order","explanation":"началась сплошная коллективизация: 1929 г; была принята Конституция Российской Федерации: 1993 г; было принято Соборное уложение: 1649 г; М. С. Горбачёв стал Генеральным секретарём ЦК КПСС: 1985 г."},
{"id":"history-017","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началась Первая мировая война\nБ) был принят Судебник Ивана III\nВ) был принят Судебник Ивана IV\nГ) советские войска были введены в Афганистан\n\n1) 862 г.\n2) 1240 г.\n3) 1497 г.\n4) 1550 г.\n5) 1914 г.\n6) 1979 г.","answers":["5346"],"points":2,"kind":"order","explanation":"началась Первая мировая война: 1914 г; был принят Судебник Ивана III: 1497 г; был принят Судебник Ивана IV: 1550 г; советские войска были введены в Афганистан: 1979 г."},
{"id":"history-018","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) было принято Соборное уложение\nБ) Крым был присоединён к Российской империи\nВ) произошла битва на реке Калке\nГ) была принята «сталинская» Конституция СССР\n\n1) 1223 г.\n2) 1237 г.\n3) 1649 г.\n4) 1654 г.\n5) 1783 г.\n6) 1936 г.","answers":["3516"],"points":2,"kind":"order","explanation":"было принято Соборное уложение: 1649 г; Крым был присоединён к Российской империи: 1783 г; произошла битва на реке Калке: 1223 г; была принята «сталинская» Конституция СССР: 1936 г."},
{"id":"history-019","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) произошла Невская битва\nБ) была полностью снята блокада Ленинграда\nВ) произошла битва на реке Калке\nГ) началось нашествие Батыя на Русь\n\n1) 1097 г.\n2) 1223 г.\n3) 1237 г.\n4) 1240 г.\n5) 1917 г.\n6) 1944 г.","answers":["4623"],"points":2,"kind":"order","explanation":"произошла Невская битва: 1240 г; была полностью снята блокада Ленинграда: 1944 г; произошла битва на реке Калке: 1223 г; началось нашествие Батыя на Русь: 1237 г."},
{"id":"history-020","group":"h1_years","number":1,"topic":"Соответствие событий и дат","text":"Установите соответствие между событиями и годами: к каждой позиции первого столбца подберите соответствующую позицию из второго столбца. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) началась сплошная коллективизация\nБ) Россия была провозглашена империей\nВ) произошёл Карибский кризис\nГ) умер И. В. Сталин\n\n1) 1721 г.\n2) 1929 г.\n3) 1936 г.\n4) 1953 г.\n5) 1962 г.\n6) 1980 г.","answers":["2154"],"points":2,"kind":"order","explanation":"началась сплошная коллективизация: 1929 г; Россия была провозглашена империей: 1721 г; произошёл Карибский кризис: 1962 г; умер И. В. Сталин: 1953 г."},
{"id":"history-021","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) было принято Соборное уложение\n2) СССР вступил в Лигу Наций\n3) произошёл Карибский кризис","answers":["123"],"points":1,"kind":"order","explanation":"По порядку: 1649 г, 1934 г, 1962 г."},
{"id":"history-022","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) Крым был присоединён к Российской империи\n2) началось строительство Транссибирской магистрали\n3) ополчение Минина и Пожарского освободило Москву","answers":["312"],"points":1,"kind":"order","explanation":"По порядку: 1612 г, 1783 г, 1891 г."},
{"id":"history-023","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) был заключён Брестский мир\n2) началась Северная война\n3) была введена Табель о рангах","answers":["231"],"points":1,"kind":"order","explanation":"По порядку: 1700 г, 1722 г, 1918 г."},
{"id":"history-024","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) состоялся Любечский съезд князей\n2) был издан указ о вольных хлебопашцах\n3) началась Сталинградская битва","answers":["123"],"points":1,"kind":"order","explanation":"По порядку: 1097 г, 1803 г, 1942 г."},
{"id":"history-025","group":"h2_order","number":2,"topic":"Последовательность событий","text":"Расположите в хронологической последовательности исторические события. Запишите цифры, которыми обозначены события, в правильной последовательности.\n\n1) начала работу I Государственная дума\n2) началась опричнина\n3) был подписан Парижский мир, завершивший Крымскую войну","answers":["231"],"points":1,"kind":"order","explanation":"По порядку: 1565 г, 1856 г, 1906 г."},
