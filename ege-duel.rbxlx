{"id":"math_base-042","group":"b3_line_chart","number":3,"topic":"Чтение графиков и диаграмм","text":"На рисунке точками показана температура воздуха в полдень в течение 10 дней. По горизонтали указаны дни, по вертикали температура в градусах Цельсия. Сколько дней температура была выше 14 °C?","answers":["6"],"points":1,"kind":"number","explanation":"Точки выше отметки 14 стоят в 6 днях.","figure":{"w":420,"h":260,"items":[["line",46.0,228.0,46.0,20.0,0],["line",80.0,228.0,80.0,20.0,0],["text",80.0,241.0,"1","c"],["line",114.0,228.0,114.0,20.0,0],["text",114.0,241.0,"2","c"],["line",148.0,228.0,148.0,20.0,0],["text",148.0,241.0,"3","c"],["line",182.0,228.0,182.0,20.0,0],["text",182.0,241.0,"4","c"],["line",216.0,228.0,216.0,20.0,0],["text",216.0,241.0,"5","c"],["line",250.0,228.0,250.0,20.0,0],["text",250.0,241.0,"6","c"],["line",284.0,228.0,284.0,20.0,0],["text",284.0,241.0,"7","c"],["line",318.0,228.0,318.0,20.0,0],["text",318.0,241.0,"8","c"],["line",352.0,228.0,352.0,20.0,0],["text",352.0,241.0,"9","c"],["line",386.0,228.0,386.0,20.0,0],["text",386.0,241.0,"10","c"],["line",46.0,228.0,386.0,228.0,0],["line",46.0,215.0,386.0,215.0,0],["line",46.0,202.0,386.0,202.0,0],["text",38.0,202.0,"4","r"],["line",46.0,189.0,386.0,189.0,0],["line",46.0,176.0,386.0,176.0,0],["text",38.0,176.0,"8","r"],["line",46.0,163.0,386.0,163.0,0],["line",46.0,150.0,386.0,150.0,0],["text",38.0,150.0,"12","r"],["line",46.0,137.0,386.0,137.0,0],["line",46.0,124.0,386.0,124.0,0],["text",38.0,124.0,"16","r"],["line",46.0,111.0,386.0,111.0,0],["line",46.0,98.0,386.0,98.0,0],["text",38.0,98.0,"20","r"],["line",46.0,85.0,386.0,85.0,0],["line",46.0,72.0,386.0,72.0,0],["text",38.0,72.0,"24","r"],["line",46.0,59.0,386.0,59.0,0],["line",46.0,46.0,386.0,46.0,0],["text",38.0,46.0,"28","r"],["line",46.0,33.0,386.0,33.0,0],["line",46.0,20.0,386.0,20.0,0],["text",38.0,20.0,"32","r"],["line",46.0,228.0,399.6,228.0,1],["line",46.0,228.0,46.0,14.8,1],["text",38.0,241.0,"0","r"],["text",54.0,10.0,"°C","l"],[