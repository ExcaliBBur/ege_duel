{"id":"physics-393","group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость периода колебаний нитяного маятника от массы груза. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["34"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («масса груза»), остальные характеристики у них должны совпадать: это установки 3 и 4.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Длина нити","c"],["text",241.5,28.0,"Масса груза","c"],["text",366.5,28.0,"Материал груза","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"1,5 м","c"],["text",241.5,64.0,"200 г","c"],["text",366.5,64.0,"сталь","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"1,5 м","c"],["text",241.5,100.0,"300 г","c"],["text",366.5,100.0,"латунь","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"0,5 м","c"],["text",241.5,136.0,"300 г","c"],["text",366.5,136.0,"латунь","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"0,5 м","c"],["text",241.5,172.0,"200 г","c"],["text",366.5,172.0,"латунь","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"0,5 м","c"],["text",241.5,208.0,"100 г","c"],["text",366.5,208.0,"алюминий","c"]]}},
