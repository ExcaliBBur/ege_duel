{"id":"math_base-112","group":"b6_route","number":6,"topic":"Выбор оптимального варианта","text":"Из пункта А в пункт Б можно добраться тремя способами. В таблице показано время, которое нужно затратить на каждый участок пути. Какое наименьшее время потребуется на дорогу? Ответ дайте в часах.","answers":["2"],"points":1,"kind":"number","explanation":"Время в пути: Автобус: 165 мин, Электричка: 155 мин, Маршрутное такси: 120 мин. Наименьшее время 120 мин, это 2 ч.","figure":{"w":470,"h":156,"items":[["line",10.0,10.0,460.0,10.0,1],["line",10.0,44.0,460.0,44.0,0],["line",10.0,78.0,460.0,78.0,0],["line",10.0,112.0,460.0,112.0,0],["line",10.0,146.0,460.0,146.0,1],["line",10.0,10.0,10.0,146.0,1],["line",160.0,10.0,160.0,146.0,1],["line",260.0,10.0,260.0,146.0,0],["line",360.0,10.0,360.0,146.0,0],["line",460.0,10.0,460.0,146.0,1],["text",85.0,27.0,"Вид транспорта","c"],["text",210.0,27.0,"До станции","c"],["text",310.0,27.0,"В пути","c"],["text",410.0,27.0,"От станции","c"],["text",85.0,61.0,"Автобус","c"],["text",210.0,61.0,"25 мин","c"],["text",310.0,61.0,"110 мин","c"],["text",410.0,61.0,"30 мин","c"],["text",85.0,95.0,"Электричка","c"],["text",210.0,95.0,"25 мин","c"],["text",310.0,95.0,"105 мин","c"],["text",410.0,95.0,"25 мин","c"],["text",85.0,129.0,"Маршрутное такси","c"],["text",210.0,129.0,"15 мин","c"],["text",310.0,129.0,"85 мин","c"],["text",410.0,129.0,"20 мин","c"]]}},
