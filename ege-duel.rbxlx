      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">math_prof</string>
        </Properties>
        <Item class="StringValue" referent="54">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "math_prof", "tasks": [
{"id":"math_prof-001","group":"p1_right_triangle","number":1,"topic":"Планиметрия","text":"В треугольнике ABC угол C равен 90°, AC = 18, BC = 24. Найдите sin A.","answers":["0,8"],"points":1,"kind":"number","explanation":"AB = √(18² + 24²) = 30, sin A = BC : AB = 0,8."},
{"id":"math_prof-002","group":"p1_isosceles","number":1,"topic":"Планиметрия","text":"В треугольнике ABC стороны AC и BC равны, угол C равен 124°. Найдите внешний угол при вершине B. Ответ дайте в градусах.","answers":["152"],"points":1,"kind":"number","explanation":"Угол B равен 28°, внешний угол равен 180° - 28° = 152°."},
{"id":"math_prof-003","group":"p1_parallelogram","number":1,"topic":"Планиметрия","text":"Площадь параллелограмма равна 85, две его стороны равны 17 и 23. Найдите большую высоту этого параллелограмма.","answers":["5"],"points":1,"kind":"number","explanation":"Большая высота проведена к меньшей стороне: 85 : 17 = 5."},
{"id":"math_prof-004","group":"p1_trapezoid","number":1,"topic":"Планиметрия","text":"Основания трапеции равны 40 и 48. Найдите больший из отрезков, на которые делит среднюю линию этой трапеции одна из её диагоналей.","answers":["24"],"points":1,"kind":"number","explanation":"Диагональ делит среднюю линию на средние линии двух треугольников: 20 и 24."},
{"id":"math_prof-005","group":"p1_circle_angles","number":1,"topic":"Планиметрия","text":"Хорда AB стягивает дугу окружности в 64°. Найдите угол между этой хордой и касательной к окружности, проведённой через точку B. Ответ дайте в градусах.","answers":["32"],"points":1,"kind":"number","explanation":"Угол между касательной и хордой равен половине дуги, заключённой между ними: 64° : 2 = 32°."},
{"id":"math_prof-006","group":"p1_incircle","number":1,"topic":"Планиметрия","text":"Радиус окружности, вписанной в правильный треугольник, равен 12. Найдите высоту этого треугольника.","answers":["36"],"points":1,"kind":"number","explanation":"Центр вписанной окружности делит высоту в отношении 2 : 1, считая от вершины, поэтому высота равна 3r = 36."},
{"id":"math_prof-007","group":"p1_circumcircle","number":1,"topic":"Планиметрия","text":"Сторона AB треугольника ABC равна 33, противолежащий ей угол C равен 30°. Найдите радиус окружности, описанной около этого треугольника.","answers":["33"],"points":1,"kind":"number","explanation":"По теореме синусов R = AB : (2 · sin C) = 33 : (2 · 0,5) = 33."},
{"id":"math_prof-008","group":"p1_right_triangle","number":1,"topic":"Планиметрия","text":"В треугольнике ABC угол C равен 90°, AC = 12, tg A = 0,75. Найдите AB.","answers":["15"],"points":1,"kind":"number","explanation":"BC = AC · tg A = 9. По теореме Пифагора AB = √(12² + 9²) = 15."},
{"id":"math_prof-009","group":"p1_isosceles","number":1,"topic":"Планиметрия","text":"В треугольнике ABC стороны AC и BC равны, угол C равен 152°. Найдите угол A. Ответ дайте в градусах.","answers":["14"],"points":1,"kind":"number","explanation":"Углы при основании равны: (180° - 152°) : 2 = 14°."},
{"id":"math_prof-010","group":"p1_parallelogram","number":1,"topic":"Планиметрия","text":"Периметр параллелограмма равен 48. Одна сторона параллелограмма относится к другой как 1 : 2. Найдите большую сторону параллелограмма.","answers":["16"],"points":1,"kind":"number","explanation":"Полупериметр равен 24, на одну часть приходится 8, большая сторона равна 16."},
{"id":"math_prof-011","group":"p1_trapezoid","number":1,"topic":"Планиметрия","text":"Основания равнобедренной трапеции равны 19 и 33, боковая сторона равна 25. Найдите высоту трапеции.","answers":["24"],"points":1,"kind":"number","explanation":"Проекция боковой стороны на основание равна (33 - 19) : 2 = 7. Высота равна √(25² - 7²) = 24."},
{"id":"math_prof-012","group":"p1_circle_angles","number":1,"topic":"Планиметрия","text":"Найдите вписанный угол, опирающийся на дугу, длина которой равна 1/6 длины окружности. Ответ дайте в градусах.","answers":["30"],"points":1,"kind":"number","explanation":"Дуга содержит 360° : 6 = 60°, вписанный угол равен её половине."},
{"id":"math_prof-013","group":"p1_incircle","number":1,"topic":"Планиметрия","text":"Найдите сторону квадрата, описанного около окружности радиуса 20.","answers":["40"],"points":1,"kind":"number","explanation":"Сторона описанного квадрата равна диаметру окружности: 2 · 20 = 40."},
{"id":"math_prof-014","group":"p1_circumcircle","number":1,"topic":"Планиметрия","text":"Сторона AB треугольника ABC равна 15, противолежащий ей угол C равен 30°. Найдите радиус окружности, описанной около этого треугольника.","answers":["15"],"points":1,"kind":"number","explanation":"По теореме синусов R = AB : (2 · sin C) = 15 : (2 · 0,5) = 15."},
{"id":"math_prof-015","group":"p1_right_triangle","number":1,"topic":"Планиметрия","text":"В треугольнике ABC угол C равен 90°, AC = 24, BC = 18. Найдите sin A.","answers":["0,6"],"points":1,"kind":"number","explanation":"AB = √(24² + 18²) = 30, sin A = BC : AB = 0,6."},
{"id":"math_prof-016","group":"p1_isosceles","number":1,"topic":"Планиметрия","text":"В треугольнике ABC стороны AC и BC равны, угол C равен 100°. Найдите угол A. Ответ дайте в градусах.","answers":["40"],"points":1,"kind":"number","explanation":"Углы при основании равны: (180° - 100°) : 2 = 40°."},
{"id":"math_prof-017","group":"p1_parallelogram","number":1,"topic":"Планиметрия","text":"Один из углов параллелограмма на 50° больше другого. Найдите больший угол параллелограмма. Ответ дайте в градусах.","answers":["115"],"points":1,"kind":"number","explanation":"Сумма соседних углов равна 180°, больший угол равен (180° + 50°) : 2 = 115°."},
{"id":"math_prof-018","group":"p1_trapezoid","number":1,"topic":"Планиметрия","text":"Основания трапеции равны 6 и 10, а высота равна 2. Найдите площадь трапеции.","answers":["16"],"points":1,"kind":"number","explanation":"S = (6 + 10) : 2 · 2 = 16."},
{"id":"math_prof-019","group":"p1_circle_angles","number":1,"topic":"Планиметрия","text":"Найдите вписанный угол, опирающийся на дугу, длина которой равна 1/12 длины окружности. Ответ дайте в градусах.","answers":["15"],"points":1,"kind":"number","explanation":"Дуга содержит 360° : 12 = 30°, вписанный угол равен её половине."},
{"id":"math_prof-020","group":"p1_incircle","number":1,"topic":"Планиметрия","text":"Найдите сторону квадрата, описанного около окружности радиуса 28.","answers":["56"],"points":1,"kind":"number","explanation":"Сторона описанного квадрата равна диаметру окружности: 2 · 28 = 56."},
{"id":"math_prof-021","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(0; 4) и b(6; 4). Найдите длину вектора a + b.","answers":["10"],"points":1,"kind":"number","explanation":"Вектор a + b имеет координаты (6; 8), его длина равна √(36 + 64) = 10."},
{"id":"math_prof-022","group":"v_dot","number":2,"topic":"Векторы","text":"Даны векторы a(2; 9) и b(-7; 9). Найдите скалярное произведение a · b.","answers":["67"],"points":1,"kind":"number","explanation":"a · b = 2 · (-7) + 9 · (9) = 67."},
{"id":"math_prof-023","group":"v_cosine","number":2,"topic":"Векторы","text":"Даны векторы a(-8; 6) и b(-3; 4). Найдите косинус угла между ними.","answers":["0,96"],"points":1,"kind":"number","explanation":"a · b = 48, |a| = 10, |b| = 5; cos = 48 : (10 · 5) = 0,96."},
{"id":"math_prof-024","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; -2) и b(-7; -7) перпендикулярны?","answers":["2"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: -7x + (-2) · (-7) = 0, откуда x = 2."},
{"id":"math_prof-025","group":"v_endpoint","number":2,"topic":"Векторы","text":"Вектор AB с концом в точке B(-2; -2) имеет координаты (9; 4). Найдите абсциссу точки A.","answers":["-11"],"points":1,"kind":"number","explanation":"Абсцисса начала равна -2 - (9) = -11."},
{"id":"math_prof-026","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(0; 4) и b(6; -4). Найдите длину вектора a - b.","answers":["10"],"points":1,"kind":"number","explanation":"Вектор a - b имеет координаты (-6; 8), его длина равна √(36 + 64) = 10."},
{"id":"math_prof-027","group":"v_dot","number":2,"topic":"Векторы","text":"Длины векторов a и b равны 7 и 9, а угол между ними равен 0°. Найдите скалярное произведение a · b.","answers":["63"],"points":1,"kind":"number","explanation":"a · b = |a| · |b| · cos 0° = 7 · 9 · (1) = 63."},
{"id":"math_prof-028","group":"v_cosine","number":2,"topic":"Векторы","text":"Даны векторы a(10; 0) и b(-3; -4). Найдите косинус угла между ними.","answers":["-0,6"],"points":1,"kind":"number","explanation":"a · b = -30, |a| = 10, |b| = 5; cos = -30 : (10 · 5) = -0,6."},
{"id":"math_prof-029","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; -9) и b(-6; -2) перпендикулярны?","answers":["3"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: -6x + (-9) · (-2) = 0, откуда x = 3."},
{"id":"math_prof-030","group":"v_endpoint","number":2,"topic":"Векторы","text":"Вектор AB с концом в точке B(1; 2) имеет координаты (-2; -8). Найдите абсциссу точки A.","answers":["3"],"points":1,"kind":"number","explanation":"Абсцисса начала равна 1 - (-2) = 3."},
{"id":"math_prof-031","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(1; 2) и b(-13; -7). Найдите длину вектора a + b.","answers":["13"],"points":1,"kind":"number","explanation":"Вектор a + b имеет координаты (-12; -5), его длина равна √(144 + 25) = 13."},
{"id":"math_prof-032","group":"v_dot","number":2,"topic":"Векторы","text":"Длины векторов a и b равны 3 и 2, а угол между ними равен 120°. Найдите скалярное произведение a · b.","answers":["-3"],"points":1,"kind":"number","explanation":"a · b = |a| · |b| · cos 120° = 3 · 2 · (-0,5) = -3."},
{"id":"math_prof-033","group":"v_cosine","number":2,"topic":"Векторы","text":"Даны векторы a(6; -8) и b(-4; 3). Найдите косинус угла между ними.","answers":["-0,96"],"points":1,"kind":"number","explanation":"a · b = -48, |a| = 10, |b| = 5; cos = -48 : (10 · 5) = -0,96."},
{"id":"math_prof-034","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; -4) и b(-2; 7) перпендикулярны?","answers":["-14"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: -2x + (-4) · (7) = 0, откуда x = -14."},
