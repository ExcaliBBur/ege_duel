{"id":"math_prof-239","group":"g_two_lines","number":12,"topic":"Графики функций","text":"На рисунке изображены графики двух линейных функций. На каждой прямой отмечены две точки с целыми координатами. Найдите абсциссу точки пересечения графиков.","answers":["-14"],"points":1,"kind":"number","explanation":"Уравнения прямых: y = -x + 3 и y = -1,5x - 4. Приравниваем и получаем x = -14.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",150.0,10.0,390.0,250.0,2],["line",76.7,10.0,236.7,250.0,1],["circle",150.0,10.0,3.5,2],["circle",390.0,250.0,3.5,2],["circle",90.0,30.0,3.5,2],["circle",210.0,210.0,3.5,2]]}},
{"id":"math_prof-240","group":"g_parabola","number":12,"topic":"Графики функций","text":"На рисунке изображён график функции f(x) = ax² + bx + c. На графике отмечены вершина параболы и две соседние точки с целыми координатами. Найдите f(10).","answers":["-161"],"points":1,"kind":"number","explanation":"Вершина параболы находится в точке (1; 1), a = -2: f(x) = -2x² + 4x - 1.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",194.0,239.6,196.0,225.6,2],["line",196.0,225.6,198.0,212.4,2],["line",198.0,212.4,200.0,200.0,2],["line",200.0,200.0,202.0,188.4,2],["line",202.0,188.4,204.0,177.6,2],["line",204.0,177.6,206.0,167.6,2],["line",206.0,167.6,208.0,158.4,2],["line",208.0,158.4,210.0,150.0,2],["line",210.0,150.0,212.0,142.4,2],["line",212.0,142.4,214.0,135.6,2],["line",214.0,135.6,216.0,129.6,2],["line",216.0,129.6,218.0,124.4,2],["line",218.0,124.4,220.0,120.0,2],["line",220.0,120.0,222.0,116.4,2],["line",222.0,116.4,224.0,113.6,2],["line",224.0,113.6,226.0,111.6,2],["line",226.0,111.6,228.0,110.4,2],["line",228.0,110.4,230.0,110.0,2],["line",230.0,110.0,232.0,110.4,2],["line",232.0,110.4,234.0,111.6,2],["line",234.0,111.6,236.0,113.6,2],["line",236.0,113.6,238.0,116.4,2],["line",238.0,116.4,240.0,120.0,2],["line",240.0,120.0,242.0,124.4,2],["line",242.0,124.4,244.0,129.6,2],["line",244.0,129.6,246.0,135.6,2],["line",246.0,135.6,248.0,142.4,2],["line",248.0,142.4,250.0,150.0,2],["line",250.0,150.0,252.0,158.4,2],["line",252.0,158.4,254.0,167.6,2],["line",254.0,167.6,256.0,177.6,2],["line",256.0,177.6,258.0,188.4,2],["line",258.0,188.4,260.0,200.0,2],["line",260.0,200.0,262.0,212.4,2],["line",262.0,212.4,264.0,225.6,2],["line",264.0,225.6,266.0,239.6,2],["circle",210.0,150.0,3.5,2],["circle",230.0,110.0,3.5,2],["circle",250.0,150.0,3.5,2]]}}
