		text = "Какая из функций принадлежит Центральному банку РФ? Запишите номер ответа.\n1) приём вкладов у населения\n2) эмиссия денег\n3) выдача ипотечных кредитов гражданам\n4) страхование имущества",
	}, {
		answers = {"3"},
		explanation = "Социальная мобильность бывает вертикальной и горизонтальной.",
		group = "общество",
		id = "social-025",
		kind = "exact",
		points = 1,
		text = "Как называется переход человека из одной социальной группы в другую? Запишите номер ответа.\n1) социальная стратификация\n2) социализация\n3) социальная мобильность\n4) адаптация",
	}, {
		answers = {"социализация"},
		explanation = "Социализация продолжается всю жизнь.",
		group = "общество",
		id = "social-026",
		kind = "exact",
		points = 1,
		text = "Как называется процесс усвоения человеком социальных норм и культурных ценностей общества? Запишите одно слово.",
	}, {
		answers = {"2"},
		explanation = "Биологические потребности связаны с поддержанием жизни: пища, вода, сон.",
		group = "человек",
		id = "social-027",
		kind = "exact",
		points = 1,
		text = "Какая из потребностей человека относится к биологическим? Запишите номер ответа.\n1) в общении\n2) в пище\n3) в самореализации\n4) в уважении",
	}, {
		answers = {"135"},
		explanation = "Чувственное познание: ощущение, восприятие, представление. Понятие и суждение относятся к рациональному познанию.",
		group = "человек",
		id = "social-028",
		kind = "set",
		points = 2,
		text = "Что относится к формам чувственного познания? Запишите номера без пробелов.\n1) ощущение\n2) понятие\n3) восприятие\n4) суждение\n5) представление",
	}, {
		answers = {"235"},
		explanation = "Рациональное познание: понятие, суждение, умозаключение.",
		group = "человек",
		id = "social-029",
		kind = "set",
		points = 2,
		text = "Что относится к формам рационального познания? Запишите номера без пробелов.\n1) ощущение\n2) понятие\n3) суждение\n4) восприятие\n5) умозаключение",
	}, {
		answers = {"3"},
		explanation = "В командной экономике государство планирует, что, как и для кого производить.",
		group = "экономика",
		id = "social-030",
		kind = "exact",
		points = 1,
		text = "Как называется тип экономической системы, в которой основные решения о производстве принимает государство? Запишите номер ответа.\n1) традиционная\n2) рыночная\n3) командная",
	}},
}</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="30">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="31">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ExamScreen</string>
            <string name="Source"><![CDATA[-- Экран экзамена: задание с рисунком, поле ответа клетками как в бланке №1, навигатор, таймер, прогресс соперника.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Settings = require(Shared.Settings)
local Text = require(Shared.Text)
local Ui = require(script.Parent.Ui)
local Figure = require(script.Parent.Figure)

local ExamScreen = {}

local C = Ui.colors
local CELLS = Settings.answerMaxChars
local MAX_TASKS = 20

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

-- actions: answer(index, value), submit()
function ExamScreen.create(parent: Instance, actions)
	local screen = {}

	local tasks = {}
	local answers: { [number]: string } = {}
	local flags: { [number]: boolean } = {}
	local current = 1
	local submitted = false
	local timeUp = false
	local endsAt = 0
	local duration = 0
	local pending: { index: number, value: string }? = nil
	local sendToken = 0
	local lastBeepStage = 0
	local settingText = false
	local subjectName = ""
	local figureFrame: Frame? = nil

	local frame = Ui.frame({ Name = "Exam", Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent }, { Ui.corner(14) })

	local beep = Ui.new("Sound", { SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Parent = frame })

	-- Шапка: предмет и номер задания, таймер, кнопка сдачи. Кнопка стоит вверху, далеко от листания заданий.
	local header = Ui.frame({ Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.sunken, Parent = frame }, { Ui.corner(14) })
	local titleLabel = Ui.label({
		Font = Ui.fonts.bold,
		TextSize = 18,
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(1, -400, 1, 0),
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = header,
	})
	local timerLabel = Ui.label({
		Font = Ui.fonts.mono,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -370, 0, 0),
		Size = UDim2.fromOffset(130, 56),
		Parent = header,
	})
	local submitButton = Ui.button("Сдать работу", "danger", {
		Name = "Submit",
		Position = UDim2.new(1, -216, 0, 9),
		Size = UDim2.fromOffset(200, 38),
		Parent = header,
	})

	-- Соперник.
	local rivalPill = Ui.pill("", C.rival, C.rivalSoft, {
		Position = UDim2.fromOffset(20, 64),
		Size = UDim2.fromOffset(360, 26),
		Parent = frame,
	})
	local rivalText = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -420, 0, 64),
		Size = UDim2.fromOffset(400, 26),
		Parent = frame,
	})
	local rivalBar = Ui.frame({
		Position = UDim2.fromOffset(20, 96),
		Size = UDim2.new(1, -40, 0, 6),
		BackgroundColor3 = C.sunken,
		Parent = frame,
	}, { Ui.corner(3) })
	local rivalFill = Ui.frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.rival, Parent = rivalBar }, { Ui.corner(3) })

	-- Навигатор: номера всех заданий над текстом.
	local navButtons = {}
	for index = 1, MAX_TASKS do
		navButtons[index] = Ui.button(tostring(index), "plain", {
			Name = "Nav" .. index,
			Font = Ui.fonts.mono,
			TextSize = 16,
			Position = UDim2.fromOffset(20 + (index - 1) * 44, 112),
			Size = UDim2.fromOffset(38, 34),
			Visible = false,
			Parent = frame,
		})
	end
	Ui.label({
		Text = "Закрашено: ответ дан. Жёлтое: отмечено, чтобы вернуться. Толстая рамка: текущее задание.",
		TextSize = 12,
		TextColor3 = C.muted,
		Position = UDim2.fromOffset(20, 150),
		Size = UDim2.new(1, -40, 0, 16),
		Parent = frame,
	})

	-- Задание со стрелками по бокам.
	local prevButton = Ui.button("‹", "plain", {
		Name = "Prev",
		TextSize = 34,
		Position = UDim2.fromOffset(20, 174),
		Size = UDim2.fromOffset(40, 284),
		Parent = frame,
	})
	local nextButton = Ui.button("›", "plain", {
		Name = "Next",
		TextSize = 34,
		Position = UDim2.new(1, -60, 0, 174),
		Size = UDim2.fromOffset(40, 284),
		Parent = frame,
	})
	local taskScroll = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(72, 174),
		Size = UDim2.new(1, -144, 0, 284),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	})
	local pointsLabel = Ui.caption("", { Size = UDim2.new(1, -12, 0, 16), Parent = taskScroll })
	-- Текст слева, рисунок справа: так задание с рисунком помещается на экран без прокрутки.
	local taskLabel = Ui.label({
		Name = "TaskText",
		TextSize = 19,
		LineHeight = 1.15,
		TextYAlignment = Enum.TextYAlignment.Top,
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = taskScroll,
	})

	-- Поле ответа: настоящий TextBox невидим и лежит поверх клеток, клетки показывают введённые символы.
	Ui.caption("ОТВЕТ", { Position = UDim2.fromOffset(20, 466), Size = UDim2.fromOffset(100, 16), Parent = frame })
	Ui.label({
		Text = "Без пробелов, как в бланке. В дробях точка сама заменяется на запятую.",
		TextSize = 13,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -560, 0, 466),
		Size = UDim2.fromOffset(540, 16),
		Parent = frame,
	})
	local cellRow = Ui.frame({
		Position = UDim2.fromOffset(20, 486),
		Size = UDim2.fromOffset(CELLS * 40 - 4, 44),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	local cells = {}
	for index = 1, CELLS do
		local cell = Ui.label({
			Font = Ui.fonts.mono,
			TextSize = 24,
			TextXAlignment = Enum.TextXAlignment.Center,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.surface,
			Position = UDim2.fromOffset((index - 1) * 40, 0),
			Size = UDim2.fromOffset(36, 44),
			Parent = cellRow,
		})
		Ui.corner(3).Parent = cell
		Ui.stroke(C.line, 1.5).Parent = cell
		cells[index] = cell
	end
	local input = Ui.new("TextBox", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextTransparency = 1,
		TextSize = 1,
		Text = "",
		PlaceholderText = "",
		ClearTextOnFocus = false,
		MultiLine = false,
		ZIndex = 5,
		Parent = cellRow,
	})

	-- Нижний ряд: отметка и переход к заданию без ответа.
	local flagButton = Ui.button("Отметить", "plain", {
		Name = "Flag",
		Position = UDim2.new(0, 20, 1, -64),
		Size = UDim2.fromOffset(170, 44),
		Parent = frame,
	})
	local nextEmptyButton = Ui.button("К заданию без ответа", "plain", {
		Name = "NextEmpty",
		Position = UDim2.new(0, 200, 1, -64),
		Size = UDim2.fromOffset(240, 44),
		Parent = frame,
	})
	local hintLabel = Ui.label({
		Text = "Enter или Tab: следующее задание\nPageUp и PageDown: листать",
		TextSize = 13,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -440, 1, -64),
		Size = UDim2.fromOffset(420, 44),
		Parent = frame,
	})

	-- Подтверждение сдачи: отдельное окно по центру, главная кнопка в нём возвращает к заданиям.
	local confirmShade = Ui.frame({
		Name = "Confirm",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.ink,
		BackgroundTransparency = 0.35,
		Active = true,
		Visible = false,
		ZIndex = 30,
		Parent = frame,
	}, { Ui.corner(14) })
	local confirmCard = Ui.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 290),
		Parent = confirmShade,
	}, { Ui.corner(14), Ui.stroke(C.danger, 3) })
	Ui.label({
		Text = "Сдать работу?",
		Font = Ui.fonts.display,
		TextSize = 26,
		TextColor3 = C.danger,
		Position = UDim2.fromOffset(28, 22),
		Size = UDim2.new(1, -56, 0, 32),
		Parent = confirmCard,
	})
	local confirmText = Ui.label({
		TextSize = 17,
		TextYAlignment = Enum.TextYAlignment.Top,
		LineHeight = 1.2,
		Position = UDim2.fromOffset(28, 66),
		Size = UDim2.new(1, -56, 0, 120),
		Parent = confirmCard,
	})
	local confirmNo = Ui.button("Вернуться к заданиям", "primary", {
		Name = "ConfirmNo",
		Position = UDim2.new(0, 28, 1, -74),
		Size = UDim2.fromOffset(280, 50),
		Parent = confirmCard,
	})
	local confirmYes = Ui.button("Сдать окончательно", "danger", {
		Name = "ConfirmYes",
		Position = UDim2.new(1, -228, 1, -74),
		Size = UDim2.fromOffset(200, 50),
		Parent = confirmCard,
	})

	-- Заглушка после сдачи работы.
	local doneCover = Ui.frame({
		Position = UDim2.fromOffset(0, 106),
		Size = UDim2.new(1, 0, 1, -106),
		Visible = false,
		ZIndex = 20,
		Parent = frame,
	}, { Ui.corner(14) })
	local doneText = Ui.label({
		Font = Ui.fonts.bold,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.fromOffset(40, 0),
		Parent = doneCover,
	})

	local function isAnswered(index: number): boolean
		local answer = answers[index]
		return answer ~= nil and Text.normalize(answer) ~= ""
	end

	local function isLocked(): boolean
		return submitted or timeUp
	end

	local function flush()
		if pending then
			actions.answer(pending.index, pending.value)
			pending = nil
		end
	end

	local function renderCells()
		local chars = Text.chars(Text.upper(answers[current] or ""))
		local focused = input:IsFocused()
		for index, cell in cells do
			cell.Text = chars[index] or ""
			local stroke = cell:FindFirstChildOfClass("UIStroke")
			if index <= #chars then
				stroke.Color = C.accent
			elseif focused and index == #chars + 1 then
				stroke.Color = C.ink
			else
				stroke.Color = C.line
			end
		end
	end

	local function renderNav()
		for index, button in navButtons do
			if index <= #tasks then
				button.Visible = true
				local style = "plain"
				if flags[index] then
					style = "warn"
				elseif isAnswered(index) then
					style = "primary"
				end
				Ui.styleButton(button, style)
				local stroke = button:FindFirstChildOfClass("UIStroke")
				stroke.Thickness = if index == current then 4 else 1.5
				if index == current then
					stroke.Color = C.ink
				end
			else
				button.Visible = false
			end
		end
		Ui.styleButton(prevButton, if current > 1 then "plain" else "disabled")
		Ui.styleButton(nextButton, if current < #tasks then "plain" else "disabled")
	end

	local function renderTask()
		local task = tasks[current]
		if not task then
			return
		end
		titleLabel.Text = string.format("%s · задание %d из %d", subjectName, current, #tasks)
		pointsLabel.Text = if task.points == 2 then "2 БАЛЛА" else "1 БАЛЛ"
		taskLabel.Text = task.text
		if figureFrame then
			figureFrame:Destroy()
			figureFrame = nil
		end
		figureFrame = Figure.render(task.figure, taskScroll)
		if figureFrame then
			local width = figureFrame.Size.X.Offset
			figureFrame.AnchorPoint = Vector2.new(1, 0)
			figureFrame.Position = UDim2.new(1, -14, 0, 22)
			taskLabel.Size = UDim2.new(1, -(width + 40), 0, 0)
		else
			taskLabel.Size = UDim2.new(1, -12, 0, 0)
		end
		taskScroll.CanvasPosition = Vector2.zero
		flagButton.Text = if flags[current] then "Снять отметку" else "Отметить"

		settingText = true
		input.Text = answers[current] or ""
		settingText = false
		renderCells()
		renderNav()
	end

	-- Переходит к заданию. keepTyping: после перехода курсор остаётся в поле ответа.
	local function goTo(index: number, keepTyping: boolean?)
		if isLocked() or index < 1 or index > #tasks then
			return
		end
		if index ~= current then
			flush()
			current = index
			renderTask()
		end
		if keepTyping then
			task.defer(function()
				if frame.Visible and not isLocked() and not confirmShade.Visible then
					input:CaptureFocus()
				end
			end)
		end
	end

	local function nextEmpty(): number?
		for step = 1, #tasks do
			local index = (current + step - 1) % #tasks + 1
			if not isAnswered(index) then
				return index
			end
		end
		return nil
	end

	local function setLocked(text: string)
		flush()
		input:ReleaseFocus()
		input.TextEditable = false
		confirmShade.Visible = false
		doneText.Text = text
		doneCover.Visible = true
	end

	input:GetPropertyChangedSignal("Text"):Connect(function()
		if settingText or isLocked() then
			return
		end
		local cleaned = string.gsub(input.Text, "[\r\n\t]", "")
		cleaned = string.gsub(cleaned, "%.", ",") -- в бланке дробная часть отделяется запятой
		cleaned = Text.truncate(cleaned, CELLS)
		if cleaned ~= input.Text then
			-- Присваивание вызовет этот обработчик ещё раз, уже с чистым текстом.
			input.Text = cleaned
			return
		end
		answers[current] = cleaned
		renderCells()
		renderNav()

		pending = { index = current, value = cleaned }
		sendToken += 1
		local token = sendToken
		task.delay(0.35, function()
			if token == sendToken then
				flush()
			end
		end)
	end)
	input.Focused:Connect(renderCells)
	input.FocusLost:Connect(function(enterPressed: boolean)
		flush()
		renderCells()
		if enterPressed and current < #tasks then
			goTo(current + 1, true)
		end
	end)

	for index, button in navButtons do
		button.Activated:Connect(function()
			goTo(index)
		end)
	end
	prevButton.Activated:Connect(function()
		goTo(current - 1)
	end)
	nextButton.Activated:Connect(function()
		goTo(current + 1)
	end)
	flagButton.Activated:Connect(function()
		if isLocked() then
			return
		end
		flags[current] = not flags[current] or nil
		flagButton.Text = if flags[current] then "Снять отметку" else "Отметить"
		renderNav()
	end)
	nextEmptyButton.Activated:Connect(function()
		local index = nextEmpty()
		if index then
			goTo(index)
		else
			hintLabel.Text = "Ответы даны на все задания."
		end
	end)

	UserInputService.InputBegan:Connect(function(inputObject: InputObject)
		if not frame.Visible or isLocked() then
			return
		end
		local key = inputObject.KeyCode
		if confirmShade.Visible then
			if key == Enum.KeyCode.Escape then
				confirmShade.Visible = false
			end
			return
		end
		local typing = input:IsFocused()
		if key == Enum.KeyCode.PageDown or key == Enum.KeyCode.Tab then
			goTo(current + 1, typing)
		elseif key == Enum.KeyCode.PageUp then
			goTo(current - 1, typing)
		elseif not typing and key == Enum.KeyCode.Right then
			goTo(current + 1)
		elseif not typing and key == Enum.KeyCode.Left then
			goTo(current - 1)
		end
	end)

	submitButton.Activated:Connect(function()
		if isLocked() then
			return
		end
		flush()
		input:ReleaseFocus()
		local answered, flagged = 0, 0
		for index = 1, #tasks do
			if isAnswered(index) then
				answered += 1
			end
			if flags[index] then
				flagged += 1
			end
		end
		local lines = { string.format("Ответов дано: %d из %d.", answered, #tasks) }
		if answered < #tasks then
			table.insert(lines, string.format("Без ответа: %d.", #tasks - answered))
		end
		if flagged > 0 then
			table.insert(lines, string.format("Отмечено, чтобы вернуться: %d.", flagged))
		end
		table.insert(lines, "После сдачи изменить ответы будет нельзя.")
		confirmText.Text = table.concat(lines, "\n")
		confirmShade.Visible = true
	end)
	confirmNo.Activated:Connect(function()
		confirmShade.Visible = false
	end)
	confirmYes.Activated:Connect(function()
		if isLocked() then
			return
		end
		submitted = true
		setLocked("Работа сдана.\nЖдём, пока соперник закончит или выйдет время.")
		actions.submit()
	end)

	function screen.setRival(progress)
		local total = math.max(progress.total or 0, 1)
		rivalFill.Size = UDim2.fromScale(math.clamp((progress.answered or 0) / total, 0, 1), 1)
		if progress.left then
			rivalText.Text = "вышел из игры, победа за вами"
		elseif progress.submitted then
			rivalText.Text = string.format("сдал работу, ответов: %d из %d", progress.answered, progress.total)
		else
			rivalText.Text = string.format("ответил на %d из %d", progress.answered, progress.total)
		end
	end

	function screen.show(state)
		tasks = state.tasks
		answers = {}
		flags = {}
		current = 1
		submitted = false
		timeUp = false
		pending = nil
		lastBeepStage = 0
		endsAt = state.endsAt
		duration = state.endsAt - state.startedAt
		subjectName = Subjects.nameOf(state.subject)

		rivalPill.Text = string.format("%s · %s", state.rival.name, Subjects.nameOf(state.rival.subject))
		screen.setRival(state.rival)

		hintLabel.Text = "Enter или Tab: следующее задание\nPageUp и PageDown: листать"
		input.TextEditable = true
		confirmShade.Visible = false
		doneCover.Visible = false
		renderTask()
		frame.Visible = true
	end

	function screen.hide()
		frame.Visible = false
		input:ReleaseFocus()
	end

	RunService.Heartbeat:Connect(function()
		if not frame.Visible then
			return
		end
		local remaining = endsAt - serverNow()
		timerLabel.Text = Ui.clock(remaining)

		-- Жёлтый за 5 минут до конца (за 2 минуты в коротком матче), красный за минуту.
		local warnAt = if duration > 600 then 300 else 120
		local stage = 0
		if remaining <= 60 then
			stage = 2
			timerLabel.TextColor3 = C.danger
		elseif remaining <= warnAt then
			stage = 1
			timerLabel.TextColor3 = C.warn
		else
			timerLabel.TextColor3 = C.ink
		end
		if stage > lastBeepStage then
			lastBeepStage = stage
			if not submitted then
				SoundService:PlayLocalSound(beep)
			end
		end

		if remaining <= 0 and not timeUp then
			timeUp = true
			if not submitted then
				setLocked("Время вышло.\nПроверяем работы…")
			end
		end
	end)

	return screen
end

return ExamScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Figure</string>
            <string name="Source"><![CDATA[-- Рисунок к заданию. Сервер присылает список простых фигур, клиент рисует их рамками и подписями:
-- картинки-файлы не нужны.
--   { "line", x1, y1, x2, y2, стиль }     стиль: 0 сетка, 1 основная линия, 2 выделенная линия
--   { "rect", x, y, ширина, высота, стиль }
--   { "circle", x, y, радиус, стиль }      стиль 1: белый круг с обводкой, 2: закрашенная точка
--   { "text", x, y, строка, выравнивание }  выравнивание: "c", "l", "r"
local Ui = require(script.Parent.Ui)

local Figure = {}

local C = Ui.colors

local LINE_STYLES = {
	[0] = { color = C.line, thickness = 1, z = 1 },
	[1] = { color = C.ink, thickness = 2, z = 2 },
	[2] = { color = C.accent, thickness = 3, z = 3 },
}

local ALIGNMENTS = {
	c = { anchor = 0.5, enum = Enum.TextXAlignment.Center },
	l = { anchor = 0, enum = Enum.TextXAlignment.Left },
	r = { anchor = 1, enum = Enum.TextXAlignment.Right },
}

local function drawLine(parent: Instance, x1: number, y1: number, x2: number, y2: number, styleId: number)
	local style = LINE_STYLES[styleId] or LINE_STYLES[1]
	local dx, dy = x2 - x1, y2 - y1
	Ui.frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), style.thickness),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = style.color,
		ZIndex = style.z,
		Parent = parent,
	})
end

-- Создаёт рамку с рисунком. Возвращает nil, если рисунка нет.
function Figure.render(figure: any, parent: Instance?): Frame?
	if type(figure) ~= "table" or type(figure.items) ~= "table" then
		return nil
	end
	local canvas = Ui.frame({
		Name = "Figure",
		Size = UDim2.fromOffset(figure.w or 420, figure.h or 260),
		BackgroundColor3 = C.surface,
		ClipsDescendants = true,
	}, { Ui.corner(6), Ui.stroke(C.line, 1) })

	for _, shape in figure.items do
		local kind = shape[1]
		if kind == "line" then
			drawLine(canvas, shape[2], shape[3], shape[4], shape[5], shape[6])
		elseif kind == "rect" then
			local style = LINE_STYLES[shape[6]] or LINE_STYLES[2]
			Ui.frame({
				Position = UDim2.fromOffset(shape[2], shape[3]),
				Size = UDim2.fromOffset(shape[4], shape[5]),
				BackgroundColor3 = style.color,
				ZIndex = style.z,
				Parent = canvas,
			})
		elseif kind == "circle" then
			local radius = shape[4]
			local filled = shape[5] == 2
			Ui.frame({
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(shape[2], shape[3]),
				Size = UDim2.fromOffset(radius * 2, radius * 2),
				BackgroundColor3 = if filled then C.accent else C.surface,
				ZIndex = 4,
				Parent = canvas,
			}, { Ui.new("UICorner", { CornerRadius = UDim.new(1, 0) }), Ui.stroke(if filled then C.accent else C.ink, 2) })
		elseif kind == "text" then
			local alignment = ALIGNMENTS[shape[5]] or ALIGNMENTS.c
			Ui.label({
				Text = shape[4],
				Font = Ui.fonts.bold,
				TextSize = 14,
				TextWrapped = false,
				TextXAlignment = alignment.enum,
				AnchorPoint = Vector2.new(alignment.anchor, 0.5),
				Position = UDim2.fromOffset(shape[2], shape[3]),
				Size = UDim2.fromOffset(120, 18),
				ZIndex = 5,
				Parent = canvas,
			})
		end
	end

	canvas.Parent = parent
	return canvas
end

return Figure
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="35">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Точка входа клиента: получает состояние парты с сервера и показывает нужный экран.
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Ui = require(script.Parent.Ui)
local SetupScreen = require(script.Parent.SetupScreen)
local ExamScreen = require(script.Parent.ExamScreen)
local ResultsScreen = require(script.Parent.ResultsScreen)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local stateEvent: RemoteEvent = remotes:WaitForChild("State")
local rivalEvent: RemoteEvent = remotes:WaitForChild("Rival")
local actionEvent: RemoteEvent = remotes:WaitForChild("Action")

local C = Ui.colors
local PANEL_WIDTH, PANEL_HEIGHT = 920, 620

local function send(action: string, payload: any?)
	actionEvent:FireServer(action, payload)
end

local gui = Ui.new("ScreenGui", {
	Name = "EgeDuel",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 10,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local dim = Ui.frame({
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.ink,
	BackgroundTransparency = 0.45,
	Visible = false,
	Parent = gui,
})

-- Панель фиксированного размера, которая масштабируется под экран: так интерфейс одинаков на ПК и телефоне.
local scale = Ui.new("UIScale")
local panel = Ui.frame({
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(PANEL_WIDTH, PANEL_HEIGHT),
	BackgroundTransparency = 1,
	Parent = gui,
}, { scale })

local function updateScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local size = camera.ViewportSize
	-- Сверху экран занят кнопками Roblox, поэтому панель считается от высоты без этой полосы.
	local inset = GuiService:GetGuiInset()
	local height = size.Y - inset.Y
	scale.Scale = math.clamp(math.min(size.X / (PANEL_WIDTH + 40), height / (PANEL_HEIGHT + 24)), 0.3, 1.3)
	panel.Position = UDim2.new(0.5, 0, 0.5, inset.Y / 2)
end
updateScale()
if Workspace.CurrentCamera then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

local setup = SetupScreen.create(panel, {
	setSubject = function(id: string)
		send("setSubject", id)
	end,
	voteTime = function(minutes: number)
		send("voteTime", minutes)
	end,
	voteCount = function(count: number)
		send("voteCount", count)
	end,
	ready = function(value: boolean)
		send("ready", value)
	end,
	leave = function()
		send("leave")
	end,
})

local exam = ExamScreen.create(panel, {
	answer = function(index: number, value: string)
		send("answer", { index = index, value = value })
	end,
	submit = function()
		send("submit")
	end,
})

local results = ResultsScreen.create(panel, {
	rematch = function()
		send("rematch")
	end,
	leave = function()
		send("leave")
	end,
})

-- Плашка ожидания соперника внизу экрана.
local waiting = Ui.frame({
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(460, 64),
	Visible = false,
	Parent = gui,
}, { Ui.corner(12), Ui.stroke(C.line, 1.5) })
local waitingText = Ui.label({
	Font = Ui.fonts.bold,
	Position = UDim2.fromOffset(18, 0),
	Size = UDim2.new(1, -170, 1, 0),
	Parent = waiting,
})
local waitingLeave = Ui.button("Встать", "plain", {
	Position = UDim2.new(1, -140, 0.5, -20),
	Size = UDim2.fromOffset(124, 40),
	Parent = waiting,
})
waitingLeave.Activated:Connect(function()
	send("leave")
end)

-- Кнопка тестового соперника. Сервер разрешает его только при запуске в Studio.
local waitingBot = Ui.button("Позвать тестового соперника (только в Studio)", "primary", {
	TextSize = 14,
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -96),
	Size = UDim2.fromOffset(460, 40),
	Visible = false,
	Parent = gui,
})
waitingBot.Activated:Connect(function()
	send("addBot")
end)

-- Отсчёт перед началом.
local countdown = Ui.frame({ Name = "Countdown", Size = UDim2.fromScale(1, 1), Visible = false, Parent = panel }, { Ui.corner(14) })
local countdownNumber = Ui.label({
	Font = Ui.fonts.display,
	TextSize = 150,
	TextColor3 = C.accent,
	TextXAlignment = Enum.TextXAlignment.Center,
	Position = UDim2.fromOffset(0, 90),
	Size = UDim2.new(1, 0, 0, 180),
	Parent = countdown,
})
local countdownInfo = Ui.label({
	TextSize = 20,
	TextXAlignment = Enum.TextXAlignment.Center,
	TextYAlignment = Enum.TextYAlignment.Top,
	Position = UDim2.fromOffset(40, 300),
	Size = UDim2.new(1, -80, 0, 260),
	Parent = countdown,
})
local countdownEndsAt = 0

RunService.Heartbeat:Connect(function()
	if countdown.Visible then
		local remaining = countdownEndsAt - Workspace:GetServerTimeNow()
		countdownNumber.Text = tostring(math.max(1, math.ceil(remaining)))
	end
end)

-- Во время матча прыжок отключён, чтобы случайно не встать из-за парты.
local jumpLocked = false
local function applyJumpLock()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, not jumpLocked)
	end
end
player.CharacterAdded:Connect(function(character)
	character:WaitForChild("Humanoid")
	applyJumpLock()
end)

local function showOnly(name: string?)
	if name ~= "setup" then
		setup.hide()
	end
	if name ~= "exam" then
		exam.hide()
	end
	if name ~= "results" then
		results.hide()
	end
	countdown.Visible = name == "countdown"
	waiting.Visible = name == "waiting"
	waitingBot.Visible = false
	dim.Visible = name == "setup" or name == "exam" or name == "results" or name == "countdown"

	jumpLocked = name == "exam" or name == "countdown"
	applyJumpLock()
end

stateEvent.OnClientEvent:Connect(function(state)
	local phase = state.phase
	if phase == "none" then
		showOnly(nil)
	elseif phase == "waiting" then
		-- Итоги прошлого матча остаются на экране, пока игрок сам не встанет.
		if not results.isVisible() then
			showOnly("waiting")
			waitingText.Text = string.format("Парта %d. Ждём соперника…", state.tableId)
			waitingBot.Visible = state.canAddBot == true
		end
	elseif phase == "setup" then
		showOnly("setup")
		setup.show(state)
	elseif phase == "countdown" then
		showOnly("countdown")
		countdownEndsAt = state.startsAt
		local lines = {
			string.format("Ваш предмет: %s", Subjects.nameOf(state.subject)),
			string.format("%s: %s", state.rivalName, Subjects.nameOf(state.rivalSubject)),
			"",
			string.format(
				"%s %d мин",
				if state.lotTime then "Жребий выбрал время:" else "Время на работу:",
				state.time
			),
			string.format("%s %d", if state.lotCount then "Жребий выбрал число заданий:" else "Число заданий:", state.count),
		}
		countdownInfo.Text = table.concat(lines, "\n")
	elseif phase == "exam" then
		showOnly("exam")
		exam.show(state)
	elseif phase == "results" then
		showOnly("results")
		results.show(state)
	elseif phase == "resultsUpdate" then
		results.update(state)
	end
end)

rivalEvent.OnClientEvent:Connect(function(progress)
	exam.setRival(progress)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ResultsScreen</string>
            <string name="Source"><![CDATA[-- Экран итогов: исход, баллы и число верных ответов у обоих, разбор своей работы, реванш.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Ui = require(script.Parent.Ui)
local Figure = require(script.Parent.Figure)

local ResultsScreen = {}

local C = Ui.colors

local OUTCOME_TITLES = { win = "Победа", lose = "Поражение", draw = "Ничья" }

local function reasonText(outcome: string, reason: string): string
	if reason == "walkover" then
		return if outcome == "win" then "Соперник вышел из игры" else "Вы вышли из игры"
	elseif outcome == "draw" then
		return "Доля баллов и время сдачи совпали"
	elseif reason == "time" then
		return "Доля баллов равная, победил сдавший работу раньше"
	end
	return "Сравниваем долю набранных баллов от максимума по своему предмету"
end

-- Карточка игрока. Возвращает функцию заполнения.
local function scoreCard(parent: Instance, x: number, mine: boolean)
	local card = Ui.frame({
		Position = UDim2.fromOffset(x, 84),
		Size = UDim2.fromOffset(430, 150),
		Parent = parent,
	}, { Ui.corner(10) })
	local stroke = Ui.stroke(C.line, 1.5)
	stroke.Parent = card

	local pill = Ui.pill("", if mine then C.accent else C.rival, if mine then C.accentSoft else C.rivalSoft, {
		Position = UDim2.fromOffset(14, 12),
		Size = UDim2.fromOffset(402, 26),
		BackgroundTransparency = 0,
		Parent = card,
	})
	local percent = Ui.label({
		Font = Ui.fonts.display,
		TextSize = 44,
		Position = UDim2.fromOffset(14, 46),
		Size = UDim2.fromOffset(150, 56),
		Parent = card,
	})
	local points = Ui.label({ TextSize = 15, Position = UDim2.fromOffset(170, 48), Size = UDim2.fromOffset(250, 22), Parent = card })
	local correct = Ui.label({
		TextSize = 15,
		Font = Ui.fonts.bold,
		Position = UDim2.fromOffset(170, 72),
		Size = UDim2.fromOffset(250, 22),
		Parent = card,
	})
	local extra = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		Position = UDim2.fromOffset(14, 110),
		Size = UDim2.fromOffset(402, 30),
		Parent = card,
	})

	return function(data, winner: boolean)
		pill.Text = string.format("%s · %s", if mine then "Вы" else data.name, Subjects.nameOf(data.subject))
		percent.Text = data.percent .. "%"
		points.Text = string.format(
			"%d из %d %s",
			data.earned,
			data.max,
			Ui.plural(data.max, "первичного балла", "первичных баллов", "первичных баллов")
		)
		correct.Text = string.format("Верных ответов: %d из %d", data.correct, data.total)
		local parts = {}
		if data.partial > 0 then
			table.insert(parts, "частично верных: " .. data.partial)
		end
		table.insert(parts, "без ответа: " .. (data.total - data.answered))
		table.insert(parts, "время: " .. Ui.clock(data.elapsed))
		extra.Text = table.concat(parts, " · ")
		stroke.Color = if winner then (if mine then C.accent else C.rival) else C.line
		stroke.Thickness = if winner then 3 else 1.5
	end
end

-- actions: rematch(), leave()
function ResultsScreen.create(parent: Instance, actions)
	local screen = {}
	local state = nil
	local onlyMistakes = true

	local frame = Ui.frame({ Name = "Results", Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent }, { Ui.corner(14) })

	local header = Ui.frame({ Size = UDim2.new(1, 0, 0, 70), BackgroundColor3 = C.sunken, Parent = frame }, { Ui.corner(14) })
	local title = Ui.label({
		Font = Ui.fonts.display,
		TextSize = 26,
		Position = UDim2.fromOffset(20, 8),
		Size = UDim2.new(1, -40, 0, 32),
		Parent = header,
	})
	local reason = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		Position = UDim2.fromOffset(20, 40),
		Size = UDim2.new(1, -40, 0, 22),
		Parent = header,
	})

	local fillMine = scoreCard(frame, 20, true)
	local fillRival = scoreCard(frame, 470, false)

	Ui.caption("РАЗБОР ВАШЕЙ РАБОТЫ", { Position = UDim2.fromOffset(20, 250), Size = UDim2.fromOffset(400, 16), Parent = frame })
	local filterButton = Ui.button("", "plain", {
		TextSize = 14,
		Position = UDim2.new(1, -220, 0, 242),
		Size = UDim2.fromOffset(200, 30),
		Parent = frame,
	})

	local list = Ui.new("ScrollingFrame", {
		Position = UDim2.fromOffset(20, 280),
		Size = UDim2.new(1, -40, 0, 262),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = C.muted,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = frame,
	}, {
		Ui.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local emptyNote = Ui.label({
		Text = "Ошибок нет. Все ответы верные.",
		TextColor3 = C.ok,
		Font = Ui.fonts.bold,
		Position = UDim2.fromOffset(20, 290),
		Size = UDim2.new(1, -40, 0, 30),
		Visible = false,
		Parent = frame,
	})

	local leaveButton = Ui.button("Встать из-за стола", "plain", {
		Position = UDim2.new(0, 20, 1, -64),
		Size = UDim2.fromOffset(210, 44),
		Parent = frame,
	})
	leaveButton.Activated:Connect(actions.leave)

	local rematchNote = Ui.label({
		TextSize = 14,
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(0, 240, 1, -64),
		Size = UDim2.new(1, -480, 0, 44),
		Parent = frame,
	})
	local rematchButton = Ui.button("Реванш", "primary", {
		Position = UDim2.new(1, -220, 1, -64),
		Size = UDim2.fromOffset(200, 44),
		Parent = frame,
	})
	rematchButton.Activated:Connect(function()
		if state and state.rivalPresent and not state.rematch.me then
			actions.rematch()
		end
	end)

	local function reviewRow(index: number, item)
		local full = item.earned == item.points
		local row = Ui.frame({
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = if full then C.okSoft elseif item.earned > 0 then C.warnSoft else C.dangerSoft,
			LayoutOrder = index,
		}, {
			Ui.corner(8),
			Ui.new("UIPadding", {
				PaddingTop = UDim.new(0, 10),
				PaddingBottom = UDim.new(0, 10),
				PaddingLeft = UDim.new(0, 12),
				PaddingRight = UDim.new(0, 12),
			}),
			Ui.new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		})

		local yours = if item.your == "" then "ответа нет" else "ваш ответ: " .. item.your
		Ui.label({
			Text = string.format("№ %d · %d из %d · %s · верно: %s", index, item.earned, item.points, yours, item.correct),
			Font = Ui.fonts.bold,
			TextSize = 15,
			TextColor3 = if full then C.ok elseif item.earned > 0 then C.warn else C.danger,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 1,
			Parent = row,
		})
		Ui.label({
			Text = item.text,
			TextSize = 14,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
			Parent = row,
		})
		local figure = Figure.render(item.figure, row)
		if figure then
			figure.LayoutOrder = 3
		end
		if item.explanation and item.explanation ~= "" then
			Ui.label({
				Text = "Пояснение: " .. item.explanation,
				TextSize = 14,
				TextColor3 = C.muted,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextYAlignment = Enum.TextYAlignment.Top,
				LayoutOrder = 4,
				Parent = row,
			})
		end
		return row
	end

	local function renderReview()
		for _, child in list:GetChildren() do
			if child:IsA("Frame") then
				child:Destroy()
			end
		end
		local shown = 0
		for index, item in state.review do
			if not onlyMistakes or item.earned < item.points then
				reviewRow(index, item).Parent = list
				shown += 1
			end
		end
		list.CanvasPosition = Vector2.zero
		emptyNote.Visible = shown == 0
		filterButton.Text = if onlyMistakes then "Показать все задания" else "Показать только ошибки"
	end

	filterButton.Activated:Connect(function()
		if state then
			onlyMistakes = not onlyMistakes
			renderReview()
		end
	end)

	local function renderRematch()
		if not state.rivalPresent then
			rematchNote.Text = "Соперник ушёл. Можно остаться за партой и подождать нового."
			rematchButton.Text = "Реванш"
			Ui.styleButton(rematchButton, "disabled")
		elseif state.rematch.me then
			rematchNote.Text = "Ждём ответа соперника."
			rematchButton.Text = "Реванш предложен"
			Ui.styleButton(rematchButton, "disabled")
		elseif state.rematch.rival then
			rematchNote.Text = "Соперник хочет реванш."
			rematchButton.Text = "Принять реванш"
			Ui.styleButton(rematchButton, "primary")
		else
			rematchNote.Text = "Те же предметы и настройки, новый вариант."
			rematchButton.Text = "Реванш"
			Ui.styleButton(rematchButton, "primary")
		end
	end

	function screen.show(newState)
		state = newState
		onlyMistakes = true

		title.Text = OUTCOME_TITLES[state.outcome] or "Итоги"
		title.TextColor3 = if state.outcome == "win" then C.ok elseif state.outcome == "lose" then C.danger else C.ink
		reason.Text = reasonText(state.outcome, state.reason)

		fillMine(state.me, state.outcome == "win")
		fillRival(state.rival, state.outcome == "lose")
		renderReview()
		renderRematch()
		frame.Visible = true
	end

	-- Обновление без перерисовки разбора: реванш и уход соперника.
	function screen.update(patch)
		if not state then
			return
		end
		state.rivalPresent = patch.rivalPresent
		state.rematch = patch.rematch
		renderRematch()
	end

	function screen.isVisible(): boolean
		return frame.Visible
	end

	function screen.hide()
		frame.Visible = false
	end

	return screen
end

return ResultsScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">SetupScreen</string>
            <string name="Source"><![CDATA[-- Экран настройки матча: свой предмет, выбор соперника, голосование за время и число заданий.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Subjects = require(Shared.Subjects)
local Settings = require(Shared.Settings)
local Ui = require(script.Parent.Ui)

local SetupScreen = {}

local C = Ui.colors

-- Ряд кнопок голосования. Возвращает рамку и функцию обновления (мой голос, голос соперника).
local function voteRow(parent: Instance, y: number, title: string, options: { number }, suffix: string, onVote: (number) -> ())
	Ui.caption(title, { Position = UDim2.fromOffset(20, y), Size = UDim2.fromOffset(400, 16), Parent = parent })
	local buttons, marks = {}, {}
	for index, option in options do
		local x = 20 + (index - 1) * 142
		local button = Ui.button(option .. suffix, "plain", {
			Position = UDim2.fromOffset(x, y + 22),
			Size = UDim2.fromOffset(130, 40),
			Parent = parent,
		})
		button.Activated:Connect(function()
			onVote(option)
		end)
		buttons[option] = button
		marks[option] = Ui.label({
			Text = "выбор соперника",
			TextSize = 12,
			Font = Ui.fonts.bold,
			TextColor3 = C.rival,
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(x, y + 64),
			Size = UDim2.fromOffset(130, 14),
			Visible = false,
			Parent = parent,
		})
	end
	return function(mine: number, rivals: number)
		for option, button in buttons do
			Ui.styleButton(button, if option == mine then "selected" else "plain")
			marks[option].Visible = option == rivals
		end
	end
end

-- actions: setSubject(id), voteTime(n), voteCount(n), ready(bool), leave()
function SetupScreen.create(parent: Instance, actions)
	local screen = {}
	local state = nil

	local frame = Ui.frame({ Name = "Setup", Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent }, { Ui.corner(14) })

	local header = Ui.frame({ Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.sunken, Parent = frame }, { Ui.corner(14) })
	Ui.label({
		Text = "Настройка матча",
		Font = Ui.fonts.bold,
		TextSize = 20,
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(0.6, 0, 1, 0),
		Parent = header,
	})
	local tableLabel = Ui.label({
		TextColor3 = C.muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, -220, 0, 0),
		Size = UDim2.fromOffset(200, 56),
		Parent = header,
	})

	-- Мой предмет.
	Ui.pill("Вы", C.accent, C.accentSoft, { Position = UDim2.fromOffset(20, 70), Size = UDim2.fromOffset(60, 26), Parent = frame })
	Ui.caption("ВАШ ПРЕДМЕТ", { Position = UDim2.fromOffset(92, 75), Size = UDim2.fromOffset(300, 16), Parent = frame })

	local subjectButtons = {}
	for index, subject in Subjects.list do
		local column = (index - 1) % 3
		local row = (index - 1) // 3
		local button = Ui.button(subject.name, "plain", {
			TextSize = 14,
			Position = UDim2.fromOffset(20 + column * 184, 106 + row * 48),
			Size = UDim2.fromOffset(174, 40),
			Parent = frame,
		})
		button.Activated:Connect(function()
			if state and (state.counts[subject.id] or 0) > 0 then
				actions.setSubject(subject.id)
			end
		end)
		subjectButtons[subject.id] = button
	end

	-- Соперник.
	local rivalPanel = Ui.frame({
		Position = UDim2.fromOffset(590, 70),
		Size = UDim2.fromOffset(310, 226),
		BackgroundColor3 = C.rivalSoft,
		Parent = frame,
	}, { Ui.corner(10) })
	local rivalName = Ui.label({
		Font = Ui.fonts.bold,
		TextColor3 = C.rival,
		TextSize = 18,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 24),
		Parent = rivalPanel,
	})
	Ui.caption("ПРЕДМЕТ СОПЕРНИКА", { Position = UDim2.fromOffset(16, 52), Size = UDim2.new(1, -32, 0, 16), Parent = rivalPanel })
	local rivalSubject = Ui.label({
		Font = Ui.fonts.bold,
		TextSize = 22,
		Position = UDim2.fromOffset(16, 72),
		Size = UDim2.new(1, -32, 0, 60),
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = rivalPanel,
	})
	local rivalReady = Ui.pill("", C.muted, C.surface, {
		Position = UDim2.fromOffset(16, 180),
		Size = UDim2.fromOffset(150, 28),
		Parent = rivalPanel,
	})

	local updateTime = voteRow(frame, 312, "ВРЕМЯ НА РАБОТУ", Settings.timeOptions, " мин", actions.voteTime)
	local updateCount = voteRow(frame, 402, "ЧИСЛО ЗАДАНИЙ", Settings.countOptions, "", actions.voteCount)

	local status = Ui.label({
		TextSize = 15,
		Position = UDim2.fromOffset(20, 496),
		Size = UDim2.new(1, -40, 0, 40),
		Parent = frame,
	})

	local leaveButton = Ui.button("Встать из-за стола", "plain", {
		Position = UDim2.new(0, 20, 1, -64),
		Size = UDim2.fromOffset(210, 44),
		Parent = frame,
	})
	leaveButton.Activated:Connect(actions.leave)

	local readyButton = Ui.button("Готов", "primary", {
		Position = UDim2.new(1, -260, 1, -64),
		Size = UDim2.fromOffset(240, 44),
		Parent = frame,
	})
	readyButton.Activated:Connect(function()
		if state and state.me.subject then
			actions.ready(not state.me.ready)
		end
	end)

	local function render()
		local me, rival = state.me, state.rival
		tableLabel.Text = "Парта " .. state.tableId

		for id, button in subjectButtons do
			if (state.counts[id] or 0) == 0 then
				Ui.styleButton(button, "disabled")
			elseif id == me.subject then
				Ui.styleButton(button, "selected")
			else
				Ui.styleButton(button, "plain")
			end
		end

		rivalName.Text = "Соперник: " .. rival.name
		rivalSubject.Text = if rival.subject then Subjects.nameOf(rival.subject) else "выбирает…"
		rivalSubject.TextColor3 = if rival.subject then C.ink else C.muted
		rivalReady.Text = if rival.ready then "Готов" else "Не готов"
		rivalReady.TextColor3 = if rival.ready then C.ok else C.muted

		updateTime(me.time, rival.time)
		updateCount(me.count, rival.count)

		local notes = {}
		if me.subject and me.subject == rival.subject then
			table.insert(notes, "Предмет одинаковый: вы получите один и тот же вариант.")
		end
		if me.time ~= rival.time and me.count ~= rival.count then
			table.insert(notes, "Время и число заданий не совпали: их выберет жребий.")
		elseif me.time ~= rival.time then
			table.insert(notes, "Время не совпало: его выберет жребий.")
		elseif me.count ~= rival.count then
			table.insert(notes, "Число заданий не совпало: его выберет жребий.")
		end
		if not me.subject then
			table.insert(notes, "Выберите предмет, чтобы нажать «Готов».")
		elseif me.ready and not rival.ready then
			table.insert(notes, "Ждём, пока соперник нажмёт «Готов».")
		end
		status.Text = table.concat(notes, "\n")
		status.TextColor3 = if me.time ~= rival.time or me.count ~= rival.count then C.warn else C.muted

		if not me.subject then
			readyButton.Text = "Готов"
			Ui.styleButton(readyButton, "disabled")
		elseif me.ready then
			readyButton.Text = "Отменить готовность"
			Ui.styleButton(readyButton, "plain")
		else
			readyButton.Text = "Готов"
			Ui.styleButton(readyButton, "primary")
		end
	end

	function screen.show(newState)
		state = newState
		render()
		frame.Visible = true
	end

	function screen.hide()
		frame.Visible = false
	end

	return screen
end

return SetupScreen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Общие цвета и заготовки элементов интерфейса.
local Ui = {}

Ui.colors = {
	surface = Color3.fromRGB(255, 255, 255),
	sunken = Color3.fromRGB(240, 235, 242),
	ink = Color3.fromRGB(27, 20, 32),
	muted = Color3.fromRGB(107, 96, 114),
	line = Color3.fromRGB(224, 216, 228),
	accent = Color3.fromRGB(184, 21, 90), -- вы
	accentSoft = Color3.fromRGB(251, 227, 237),
	rival = Color3.fromRGB(13, 118, 128), -- соперник
	rivalSoft = Color3.fromRGB(221, 241, 242),
	ok = Color3.fromRGB(28, 127, 71),
	okSoft = Color3.fromRGB(223, 243, 231),
	warn = Color3.fromRGB(154, 98, 8),
	warnSoft = Color3.fromRGB(251, 239, 211),
	danger = Color3.fromRGB(190, 40, 40),
	dangerSoft = Color3.fromRGB(250, 226, 226),
}

Ui.fonts = {
	regular = Enum.Font.GothamMedium,
	bold = Enum.Font.GothamBold,
	display = Enum.Font.GothamBlack,
	mono = Enum.Font.RobotoMono,
}

-- Создаёт объект, задаёт свойства и вкладывает детей.
function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Ui.corner(radius: number): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius) })
end

function Ui.stroke(color: Color3, thickness: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.frame(props: { [string]: any }?, children: { Instance }?): Frame
	local merged = { BackgroundColor3 = Ui.colors.surface, BorderSizePixel = 0 }
	for key, value in props or {} do
		merged[key] = value
	end
	return Ui.new("Frame", merged, children)
end

function Ui.label(props: { [string]: any }?): TextLabel
	local merged = {
		BackgroundTransparency = 1,
		Font = Ui.fonts.regular,
		TextSize = 16,
		TextColor3 = Ui.colors.ink,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		Text = "",
	}
	for key, value in props or {} do
		merged[key] = value
	end
	return Ui.new("TextLabel", merged)
end

-- Маленькая надпись заглавными буквами над блоком.
function Ui.caption(text: string, props: { [string]: any }?): TextLabel
	local merged = {
		Text = text,
		Font = Ui.fonts.bold,
		TextSize = 12,
		TextColor3 = Ui.colors.muted,
		Size = UDim2.new(1, 0, 0, 16),
	}
	for key, value in props or {} do
		merged[key] = value
	end
	return Ui.label(merged)
end

-- Цветная плашка с текстом.
function Ui.pill(text: string, textColor: Color3, backColor: Color3, props: { [string]: any }?): TextLabel
	local merged = {
		Text = text,
		Font = Ui.fonts.bold,
		TextSize = 14,
		TextColor3 = textColor,
		BackgroundColor3 = backColor,
		BackgroundTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.fromOffset(200, 26),
	}
	for key, value in props or {} do
		merged[key] = value
	end
	local pill = Ui.label(merged)
	Ui.corner(13).Parent = pill
	return pill
end

local BUTTON_STYLES = {
	primary = { back = "accent", text = "surface", line = "accent" },
	plain = { back = "surface", text = "ink", line = "line" },
	selected = { back = "accentSoft", text = "accent", line = "accent" },
	rival = { back = "rivalSoft", text = "rival", line = "rival" },
	warn = { back = "warnSoft", text = "warn", line = "warn" },
	danger = { back = "dangerSoft", text = "danger", line = "danger" },
	disabled = { back = "sunken", text = "muted", line = "line" },
}

-- Меняет оформление кнопки: primary, plain, selected, rival, warn, danger, disabled.
function Ui.styleButton(button: TextButton, style: string)
	local spec = BUTTON_STYLES[style] or BUTTON_STYLES.plain
	button.BackgroundColor3 = Ui.colors[spec.back]
	button.TextColor3 = Ui.colors[spec.text]
	local stroke = button:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = Ui.colors[spec.line]
	end
	button.Active = style ~= "disabled"
	button.AutoButtonColor = style ~= "disabled"
end

function Ui.button(text: string, style: string, props: { [string]: any }?): TextButton
	local merged = {
		Text = text,
		Font = Ui.fonts.bold,
		TextSize = 16,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(160, 44),
		TextWrapped = true,
	}
	for key, value in props or {} do
		merged[key] = value
	end
	local button = Ui.new("TextButton", merged, { Ui.corner(8), Ui.stroke(Ui.colors.line, 1.5) })
	Ui.styleButton(button, style)
	return button
end

-- "мм:сс" из числа секунд.
function Ui.clock(seconds: number): string
	seconds = math.max(0, math.ceil(seconds))
	return string.format("%02d:%02d", seconds // 60, seconds % 60)
end

-- Форма слова по числу: plural(3, "задание", "задания", "заданий").
function Ui.plural(n: number, one: string, few: string, many: string): string
	local tens, units = n % 100, n % 10
	if tens >= 11 and tens <= 14 then
		return many
	elseif units == 1 then
		return one
	elseif units >= 2 and units <= 4 then
		return few
	end
	return many
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>