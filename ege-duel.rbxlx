            <string name="Value"><![CDATA[{"subject": "literature", "tasks": [
{"id":"literature-001","group":"авторы","text":"Кто автор романа в стихах «Евгений Онегин»? Запишите номер ответа.\n1) М. Ю. Лермонтов\n2) А. С. Пушкин\n3) Н. В. Гоголь\n4) И. С. Тургенев","answers":["2"],"points":1,"kind":"exact","explanation":"Роман написал А. С. Пушкин."},
{"id":"literature-002","group":"авторы","text":"Кто автор романа «Герой нашего времени»? Запишите номер ответа.\n1) М. Ю. Лермонтов\n2) А. С. Пушкин\n3) Л. Н. Толстой\n4) И. А. Гончаров","answers":["1"],"points":1,"kind":"exact","explanation":"Роман написал М. Ю. Лермонтов."},
{"id":"literature-003","group":"авторы","text":"Запишите фамилию автора поэмы «Мёртвые души».","answers":["Гоголь"],"points":1,"kind":"exact","explanation":"«Мёртвые души» написал Н. В. Гоголь."},
{"id":"literature-004","group":"авторы","text":"Запишите фамилию автора романа «Война и мир».","answers":["Толстой"],"points":1,"kind":"exact","explanation":"Роман написал Л. Н. Толстой."},
{"id":"literature-005","group":"авторы","text":"Запишите фамилию автора романа «Преступление и наказание».","answers":["Достоевский"],"points":1,"kind":"exact","explanation":"Роман написал Ф. М. Достоевский."},
{"id":"literature-006","group":"авторы","text":"Запишите фамилию автора романа «Отцы и дети».","answers":["Тургенев"],"points":1,"kind":"exact","explanation":"Роман написал И. С. Тургенев."},
{"id":"literature-007","group":"авторы","text":"Запишите фамилию автора пьесы «Вишнёвый сад».","answers":["Чехов"],"points":1,"kind":"exact","explanation":"Пьесу написал А. П. Чехов."},
{"id":"literature-008","group":"авторы","text":"Запишите фамилию автора романа «Мастер и Маргарита».","answers":["Булгаков"],"points":1,"kind":"exact","explanation":"Роман написал М. А. Булгаков."},
{"id":"literature-009","group":"авторы","text":"Запишите фамилию автора комедии «Горе от ума».","answers":["Грибоедов"],"points":1,"kind":"exact","explanation":"Комедию написал А. С. Грибоедов."},
{"id":"literature-010","group":"авторы","text":"Запишите фамилию автора драмы «Гроза».","answers":["Островский"],"points":1,"kind":"exact","explanation":"Драму написал А. Н. Островский."},
{"id":"literature-011","group":"авторы","text":"Запишите фамилию автора романа «Обломов».","answers":["Гончаров"],"points":1,"kind":"exact","explanation":"Роман написал И. А. Гончаров."},
{"id":"literature-012","group":"герои","text":"Запишите фамилию главного героя романа «Преступление и наказание».","answers":["Раскольников"],"points":1,"kind":"exact","explanation":"Главный герой романа Родион Раскольников."},
{"id":"literature-013","group":"герои","text":"Запишите фамилию героя романа «Отцы и дети», который называет себя нигилистом.","answers":["Базаров"],"points":1,"kind":"exact","explanation":"Нигилист в романе Евгений Базаров."},
{"id":"literature-014","group":"герои","text":"Запишите имя главной героини драмы А. Н. Островского «Гроза».","answers":["Катерина"],"points":1,"kind":"exact","explanation":"Главная героиня Катерина Кабанова."},
{"id":"literature-015","group":"герои","text":"Запишите фамилию главного героя поэмы «Мёртвые души».","answers":["Чичиков"],"points":1,"kind":"exact","explanation":"Павел Иванович Чичиков скупает мёртвые души."},
{"id":"literature-016","group":"герои","text":"Запишите фамилию главного героя комедии «Горе от ума».","answers":["Чацкий"],"points":1,"kind":"exact","explanation":"Главный герой комедии Александр Чацкий."},
{"id":"literature-017","group":"герои","text":"Установите соответствие между героями и произведениями. Запишите три цифры в порядке героев А, Б, В.\n\nА) Печорин\nБ) Обломов\nВ) Наташа Ростова\n\n1) «Война и мир»\n2) «Герой нашего времени»\n3) «Обломов»","answers":["231"],"points":2,"kind":"order","explanation":"Печорин из «Героя нашего времени», Обломов из одноимённого романа, Наташа Ростова из «Войны и мира»."},
{"id":"literature-018","group":"роды и жанры","text":"К какому роду литературы относится пьеса «Вишнёвый сад»? Запишите номер ответа.\n1) эпос\n2) лирика\n3) драма","answers":["3"],"points":1,"kind":"exact","explanation":"Пьеса предназначена для сцены, это драматический род."},
{"id":"literature-019","group":"роды и жанры","text":"Как Н. В. Гоголь определил жанр «Мёртвых душ»? Запишите номер ответа.\n1) роман\n2) повесть\n3) комедия\n4) поэма","answers":["4"],"points":1,"kind":"exact","explanation":"Автор назвал своё произведение поэмой."},
{"id":"literature-020","group":"роды и жанры","text":"К какому литературному направлению относится раннее творчество В. В. Маяковского? Запишите номер ответа.\n1) символизм\n2) акмеизм\n3) футуризм\n4) имажинизм","answers":["3"],"points":1,"kind":"exact","explanation":"Маяковский был одним из главных поэтов русского футуризма."},
{"id":"literature-021","group":"стихосложение","text":"Как называется двусложный стихотворный размер с ударением на втором слоге? Запишите одно слово.","answers":["ямб"],"points":1,"kind":"exact","explanation":"Схема ямба: безударный слог, затем ударный."},
{"id":"literature-022","group":"стихосложение","text":"Как называется двусложный стихотворный размер с ударением на первом слоге? Запишите одно слово.","answers":["хорей"],"points":1,"kind":"exact","explanation":"Схема хорея: ударный слог, затем безударный."},
{"id":"literature-023","group":"стихосложение","text":"Как называется трёхсложный стихотворный размер с ударением на первом слоге? Запишите одно слово.","answers":["дактиль"],"points":1,"kind":"exact","explanation":"Схема дактиля: ударный слог и два безударных."},
{"id":"literature-024","group":"стихосложение","text":"Как называется трёхсложный стихотворный размер с ударением на втором слоге? Запишите одно слово.","answers":["амфибрахий"],"points":1,"kind":"exact","explanation":"В амфибрахии ударный слог стоит между двумя безударными."},
{"id":"literature-025","group":"стихосложение","text":"Как называется трёхсложный стихотворный размер с ударением на третьем слоге? Запишите одно слово.","answers":["анапест"],"points":1,"kind":"exact","explanation":"Схема анапеста: два безударных слога и ударный."},
{"id":"literature-026","group":"стихосложение","text":"Сколько строк в сонете?","answers":["14"],"points":1,"kind":"number","explanation":"Сонет состоит из 14 строк."},
{"id":"literature-027","group":"тропы","text":"Как называется художественное преувеличение? Запишите одно слово.","answers":["гипербола"],"points":1,"kind":"exact","explanation":"Пример гиперболы: «сто раз тебе говорил»."},
{"id":"literature-028","group":"тропы","text":"Как называется скрытое сравнение, перенос названия с одного предмета на другой по сходству? Запишите одно слово.","answers":["метафора"],"points":1,"kind":"exact","explanation":"Пример метафоры: «золотая осень»."},
{"id":"literature-029","group":"тропы","text":"Как называется образное, выразительное определение предмета? Запишите одно слово.","answers":["эпитет"],"points":1,"kind":"exact","explanation":"Пример эпитета: «дремучий лес»."},
{"id":"literature-030","group":"тропы","text":"Как называется приём, при котором неживому предмету приписываются свойства живого существа? Запишите одно слово.","answers":["олицетворение"],"points":1,"kind":"exact","explanation":"Пример олицетворения: «ветер воет»."},
{"id":"literature-031","group":"lit_author","text":"Кто автор произведения «Муму»? Запишите номер ответа.\n1) Н. С. Лесков\n2) И. С. Тургенев\n3) М. А. Шолохов\n4) Н. А. Некрасов","answers":["2"],"points":1,"kind":"exact","explanation":"«Муму» написал(а) И. С. Тургенев."},
