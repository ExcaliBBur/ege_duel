{"id":"geography-227","group":"fig_wind_rose","text":"На рисунке показана роза ветров за месяц. Расстояние между соседними окружностями соответствует одному дню. Сколько дней дул юго-восточный ветер?","answers":["3"],"points":1,"kind":"number","explanation":"Точка на луче «ЮВ» лежит на окружности номер 3 от центра.","figure":{"w":420,"h":260,"items":[["circle",210.0,130.0,17.0,0],["circle",210.0,130.0,34.0,0],["circle",210.0,130.0,51.0,0],["circle",210.0,130.0,68.0,0],["circle",210.0,130.0,85.0,0],["circle",210.0,130.0,102.0,0],["line",210.0,130.0,210.0,28.0,0],["text",210.0,15.0,"С","c"],["line",210.0,130.0,282.1,57.9,0],["text",291.3,48.7,"СВ","c"],["line",210.0,130.0,312.0,130.0,0],["text",325.0,130.0,"В","c"],["line",210.0,130.0,282.1,202.1,0],["text",291.3,211.3,"ЮВ","c"],["line",210.0,130.0,210.0,232.0,0],["text",210.0,245.0,"Ю","c"],["line",210.0,130.0,137.9,202.1,0],["text",128.7,211.3,"ЮЗ","c"],["line",210.0,130.0,108.0,130.0,0],["text",95.0,130.0,"З","c"],["line",210.0,130.0,137.9,57.9,0],["text",128.7,48.7,"СЗ","c"],["line",210.0,113.0,222.0,118.0,2],["line",222.0,118.0,312.0,130.0,2],["line",312.0,130.0,246.1,166.1,2],["line",246.1,166.1,210.0,164.0,2],["line",210.0,164.0,161.9,178.1,2],["line",161.9,178.1,176.0,130.0,2],["line",176.0,130.0,186.0,106.0,2],["line",186.0,106.0,210.0,113.0,2],["circle",210.0,113.0,3.0,2],["circle",222.0,118.0,3.0,2],["circle",312.0,130.0,3.0,2],["circle",246.1,166.1,3.0,2],["circle",210.0,164.0,3.0,2],["circle",161.9,178.1,3.0,2],["circle",176.0,130.0,3.0,2],["circle",186.0,106.0,3.0,2]]}},
