{"id":"math_base-050","group":"b3_bar_chart","number":3,"topic":"Чтение графиков и диаграмм","text":"На диаграмме показана среднемесячная температура воздуха в Томске за каждый месяц года. По горизонтали указываются номера месяцев, по вертикали температура в градусах Цельсия. Определите по диаграмме, сколько было месяцев, когда среднемесячная температура превышала 8 градусов Цельсия.","answers":["4"],"points":1,"kind":"number","explanation":"По диаграмме получаем 4.","figure":{"w":420,"h":260,"items":[["line",40.0,228.0,412.0,228.0,0],["text",34.0,228.0,"-20","r"],["line",40.0,210.4,412.0,210.4,0],["text",34.0,210.4,"-16","r"],["line",40.0,192.8,412.0,192.8,0],["text",34.0,192.8,"-12","r"],["line",40.0,175.2,412.0,175.2,0],["text",34.0,175.2,"-8","r"],["line",40.0,157.6,412.0,157.6,0],["text",34.0,157.6,"-4","r"],["line",40.0,140.0,412.0,140.0,0],["text",34.0,140.0,"0","r"],["line",40.0,122.4,412.0,122.4,0],["text",34.0,122.4,"4","r"],["line",40.0,104.8,412.0,104.8,0],["text",34.0,104.8,"8","r"],["line",40.0,87.2,412.0,87.2,0],["text",34.0,87.2,"12","r"],["line",40.0,69.6,412.0,69.6,0],["text",34.0,69.6,"16","r"],["line",40.0,52.0,412.0,52.0,0],["text",34.0,52.0,"20","r"],["line",40.0,34.4,412.0,34.4,0],["text",34.0,34.4,"24","r"],["line",40.0,16.8,412.0,16.8,0],["text",34.0,16.8,"28","r"],["rect",46.0,140.0,19.0,61.6,2],["text",55.5,246.0,"1","c"],["rect",77.0,140.0,19.0,52.8,2],["text",86.5,246.0,"2","c"],["rect",108.0,140.0,19.0,35.2,2],["text",117.5,246.0,"3","c"],["rect",139.0,131.2,19.0,8.8,2],["text",148.5,246.0,"4","c"],["rect",170.0,104.8,19.0,35.2,2],["text",179.5,246.0,"5","c"],["rect",201.0,69.6,19.0,70.4,2],["text",210.5,246.0,"6","c"],["rect",232.0,43.2,19.0,96.8,2],["text",241.5,246.0,"7","c"],["rect",263.0,34.4,19.0,105.6,2],["text",272.5,246.0,"8","c"],["rect",294.0,78.4,19.0,61.6,2],["text",303.5,246.0,"9","c"],["rect",325.0,104.8,19.0,35.2,2],["text",334.5,246.0,"10","c"],["rect",356.0,131.2,19.0,8.8,2],["text",365.5,246.0,"11","c"],["rect",387.0,