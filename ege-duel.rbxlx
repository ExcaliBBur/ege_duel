{"id":"math_prof-167","group":"d_physical","number":9,"topic":"Производная и первообразная","text":"Материальная точка движется прямолинейно по закону x(t) = 4/3t³ - 4t² - 2t + 14, где x это расстояние от точки отсчёта в метрах, t это время в секундах, измеренное с начала движения. Найдите её скорость (в метрах в секунду) в момент времени t = 7 с.","answers":["138"],"points":1,"kind":"number","explanation":"v(t) = x'(t) = 4t² - 8t - 2; v(7) = 138."},
{"id":"math_prof-168","group":"d_parallel","number":9,"topic":"Производная и первообразная","text":"Прямая y = -7x - 5 параллельна касательной к графику функции y = -x² - 4x + 6. Найдите абсциссу точки касания.","answers":["1,5"],"points":1,"kind":"number","explanation":"Угловой коэффициент касательной равен производной: -2x - 4 = -7, откуда x = 1,5."},
{"id":"math_prof-169","group":"d_tangent_coefficient","number":9,"topic":"Производная и первообразная","text":"Прямая y = -14x - 55 является касательной к графику функции y = ax² + 4x - 1. Найдите a.","answers":["1,5"],"points":1,"kind":"number","explanation":"Уравнение ax² + 18x + 54 = 0 должно иметь один корень: дискриминант равен нулю, откуда a = 1,5."},
{"id":"math_prof-170","group":"d_graph_tangent","number":9,"topic":"Производная и первообразная","text":"На рисунке изображены график функции y = f(x) (чёрная линия) и касательная к нему в точке с абсциссой x₀ (цветная линия). На касательной отмечены три точки с целыми координатами, средняя из них является точкой касания. Найдите значение производной функции f(x) в точке x₀.","answers":["-3"],"points":1,"kind":"number","explanation":"Производная равна угловому коэффициенту касательной. При смещении на 1 вправо касательная поднимается на -3: k = -3.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",112.9,14.9,116.3,26.5,1],["line",116.3,26.5,119.7,37.