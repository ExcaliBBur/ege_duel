            <string name="Value"><![CDATA[group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость силы трения скольжения от площади соприкосновения бруска с поверхностью. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["14"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («площадь грани»), остальные характеристики у них должны совпадать: это установки 1 и 4.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Масса бруска","c"],["text",241.5,28.0,"Поверхность","c"],["text",366.5,28.0,"Площадь грани","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"300 г","c"],["text",241.5,64.0,"дерево","c"],["text",366.5,64.0,"40 см²","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"100 г","c"],["text",241.5,100.0,"резина","c"],["text",366.5,100.0,"40 см²","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"200 г","c"],["text",241.5,136.0,"дерево","c"],["text",366.5,136.0,"40 см²","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"300 г","c"],["text",241.5,172.0,"дерево","c"],["text",366.5,172.0,"20 см²","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"300 г","c"],["text",241.5,208.0,"резина","c"],["text",366.5,208.0,"40 см²","c"]]}},
{"id":"physics-388","group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость ёмкости плоского конденсатора от площади пластин. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["34"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («площадь пластин»), остальные характеристики у них должны совпадать: это установки 3 и 4.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Площадь пластин","c"],["text",241.5,28.0,"Расстояние","c"],["text",366.5,28.0,"Диэлектрик","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"100 см²","c"],["text",241.5,64.0,"2 мм","c"],["text",366.5,64.0,"воздух","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"200 см²","c"],["text",241.5,100.0,"4 мм","c"],["text",366.5,100.0,"воздух","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"100 см²","c"],["text",241.5,136.0,"4 мм","c"],["text",366.5,136.0,"парафин","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"50 см²","c"],["text",241.5,172.0,"4 мм","c"],["text",366.5,172.0,"парафин","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"100 см²","c"],["text",241.5,208.0,"1 мм","c"],["text",366.5,208.0,"парафин","c"]]}},
{"id":"physics-389","group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость сопротивления проводника от площади его поперечного сечения. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["25"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («сечение»), остальные характеристики у них должны совпадать: это установки 2 и 5.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Длина","c"],["text",241.5,28.0,"Сечение","c"],["text",366.5,28.0,"Материал","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"2 м","c"],["text",241.5,64.0,"1 мм²","c"],["text",366.5,64.0,"медь","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"3 м","c"],["text",241.5,100.0,"1 мм²","c"],["text",366.5,100.0,"никелин","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"2 м","c"],["text",241.5,136.0,"1 мм²","c"],["text",366.5,136.0,"никелин","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"1 м","c"],["text",241.5,172.0,"0,5 мм²","c"],["text",366.5,172.0,"никелин","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"3 м","c"],["text",241.5,208.0,"2 мм²","c"],["text",366.5,208.0,"никелин","c"]]}},
{"id":"physics-390","group":"x_setups","number":20,"topic":"Планирование эксперимента","text":"Необходимо экспериментально обнаружить зависимость сопротивления проводника от его длины. В таблице приведены характеристики пяти установок. Какие две установки нужно использовать для такого исследования? В ответе запишите номера выбранных установок без пробелов и запятых.","answers":["12"],"points":1,"kind":"set","explanation":"Установки должны различаться только исследуемой величиной («длина»), остальные характеристики у них должны совпадать: это установки 1 и 2.","figure":{"w":439,"h":236,"items":[["line",10.0,10.0,429.0,10.0,1],["line",10.0,46.0,429.0,46.0,0],["line",10.0,82.0,429.0,82.0,0],["line",10.0,118.0,429.0,118.0,0],["line",10.0,154.0,429.0,154.0,0],["line",10.0,190.0,429.0,190.0,0],["line",10.0,226.0,429.0,226.0,1],["line",10.0,10.0,10.0,226.0,1],["line",54.0,10.0,54.0,226.0,1],["line",179.0,10.0,179.0,226.0,0],["line",304.0,10.0,304.0,226.0,0],["line",429.0,10.0,429.0,226.0,1],["text",32.0,28.0,"№","c"],["text",116.5,28.0,"Длина","c"],["text",241.5,28.0,"Сечение","c"],["text",366.5,28.0,"Материал","c"],["text",32.0,64.0,"1","c"],["text",116.5,64.0,"3 м","c"],["text",241.5,64.0,"1 мм²","c"],["text",366.5,64.0,"никелин","c"],["text",32.0,100.0,"2","c"],["text",116.5,100.0,"1 м","c"],["text",241.5,100.0,"1 мм²","c"],["text",366.5,100.0,"никелин","c"],["text",32.0,136.0,"3","c"],["text",116.5,136.0,"3 м","c"],["text",241.5,136.0,"0,5 мм²","c"],["text",366.5,136.0,"железо","c"],["text",32.0,172.0,"4","c"],["text",116.5,172.0,"3 м","c"],["text",241.5,172.0,"2 мм²","c"],["text",366.5,172.0,"медь","c"],["text",32.0,208.0,"5","c"],["text",116.5,208.0,"2 м","c"],["text",241.5,208.0,"2 мм²","c"],["text",366.5,208.0,"никелин","c"]]}},
