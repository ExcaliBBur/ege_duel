      <Item class="Folder" referent="48">
        <Properties>
          <string name="Name">math_prof</string>
        </Properties>
        <Item class="StringValue" referent="49">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "math_prof", "tasks": [
{"id":"math_prof-001","group":"p1_right_triangle","number":1,"topic":"Планиметрия","text":"В треугольнике ABC угол C равен 90°, AC = 48, BC = 14. Найдите sin A.","answers":["0,28"],"points":1,"kind":"number","explanation":"AB = √(48² + 14²) = 50, sin A = BC : AB = 0,28."},
{"id":"math_prof-002","group":"p1_isosceles","number":1,"topic":"Планиметрия","text":"В треугольнике ABC стороны AC и BC равны, угол C равен 88°. Найдите угол A. Ответ дайте в градусах.","answers":["46"],"points":1,"kind":"number","explanation":"Углы при основании равны: (180° - 88°) : 2 = 46°."},
{"id":"math_prof-003","group":"p1_parallelogram","number":1,"topic":"Планиметрия","text":"Площадь параллелограмма равна 70, две его стороны равны 7 и 24. Найдите большую высоту этого параллелограмма.","answers":["10"],"points":1,"kind":"number","explanation":"Большая высота проведена к меньшей стороне: 70 : 7 = 10."},
{"id":"math_prof-004","group":"p1_trapezoid","number":1,"topic":"Планиметрия","text":"Основания трапеции равны 5 и 26, а высота равна 12. Найдите площадь трапеции.","answers":["186"],"points":1,"kind":"number","explanation":"S = (5 + 26) : 2 · 12 = 186."},
{"id":"math_prof-005","group":"p1_circle_angles","number":1,"topic":"Планиметрия","text":"Найдите вписанный угол, опирающийся на дугу, длина которой равна 1/10 длины окружности. Ответ дайте в градусах.","answers":["18"],"points":1,"kind":"number","explanation":"Дуга содержит 360° : 10 = 36°, вписанный угол равен её половине."},
{"id":"math_prof-006","group":"p1_incircle","number":1,"topic":"Планиметрия","text":"Катеты прямоугольного треугольника равны 18 и 80. Найдите радиус окружности, вписанной в этот треугольник.","answers":["8"],"points":1,"kind":"number","explanation":"Гипотенуза равна 82. r = (a + b - c) : 2 = (18 + 80 - 82) : 2 = 8."},
{"id":"math_prof-007","group":"p1_circumcircle","number":1,"topic":"Планиметрия","text":"Сторона AB треугольника ABC равна 18, противолежащий ей угол C равен 150°. Найдите радиус окружности, описанной около этого треугольника.","answers":["18"],"points":1,"kind":"number","explanation":"По теореме синусов R = AB : (2 · sin C) = 18 : (2 · 0,5) = 18."},
{"id":"math_prof-008","group":"p1_right_triangle","number":1,"topic":"Планиметрия","text":"В треугольнике ABC угол C равен 90°, AC = 3, BC = 4. Найдите sin A.","answers":["0,8"],"points":1,"kind":"number","explanation":"AB = √(3² + 4²) = 5, sin A = BC : AB = 0,8."},
{"id":"math_prof-009","group":"p1_isosceles","number":1,"topic":"Планиметрия","text":"В треугольнике ABC стороны AC и BC равны, угол C равен 124°. Найдите угол A. Ответ дайте в градусах.","answers":["28"],"points":1,"kind":"number","explanation":"Углы при основании равны: (180° - 124°) : 2 = 28°."},
{"id":"math_prof-010","group":"p1_parallelogram","number":1,"topic":"Планиметрия","text":"Периметр параллелограмма равен 70. Одна сторона параллелограмма относится к другой как 2 : 5. Найдите большую сторону параллелограмма.","answers":["25"],"points":1,"kind":"number","explanation":"Полупериметр равен 35, на одну часть приходится 5, большая сторона равна 25."},
{"id":"math_prof-011","group":"p1_trapezoid","number":1,"topic":"Планиметрия","text":"Средняя линия трапеции равна 31, а меньшее основание равно 28. Найдите большее основание трапеции.","answers":["34"],"points":1,"kind":"number","explanation":"Сумма оснований равна 62, большее основание равно 62 - 28 = 34."},
{"id":"math_prof-012","group":"p1_circle_angles","number":1,"topic":"Планиметрия","text":"Центральный угол на 45° больше острого вписанного угла, опирающегося на ту же дугу окружности. Найдите вписанный угол. Ответ дайте в градусах.","answers":["45"],"points":1,"kind":"number","explanation":"Центральный угол вдвое больше вписанного: 2x - x = 45, вписанный угол равен 45°."},
{"id":"math_prof-013","group":"p1_incircle","number":1,"topic":"Планиметрия","text":"Радиус окружности, вписанной в правильный треугольник, равен 17. Найдите высоту этого треугольника.","answers":["51"],"points":1,"kind":"number","explanation":"Центр вписанной окружности делит высоту в отношении 2 : 1, считая от вершины, поэтому высота равна 3r = 51."},
{"id":"math_prof-014","group":"p1_circumcircle","number":1,"topic":"Планиметрия","text":"Катеты прямоугольного треугольника равны 16 и 30. Найдите радиус окружности, описанной около этого треугольника.","answers":["17"],"points":1,"kind":"number","explanation":"Гипотенуза равна 34, центр описанной окружности лежит на её середине: R = 17."},
{"id":"math_prof-015","group":"p1_right_triangle","number":1,"topic":"Планиметрия","text":"В треугольнике ABC угол C равен 90°, AC = 8, tg A = 0,75. Найдите AB.","answers":["10"],"points":1,"kind":"number","explanation":"BC = AC · tg A = 6. По теореме Пифагора AB = √(8² + 6²) = 10."},
{"id":"math_prof-016","group":"p1_isosceles","number":1,"topic":"Планиметрия","text":"В треугольнике ABC AC = BC = 34, AB = 32. Найдите высоту CH.","answers":["30"],"points":1,"kind":"number","explanation":"Высота к основанию делит его пополам: AH = 16. CH = √(34² - 16²) = 30."},
{"id":"math_prof-017","group":"p1_parallelogram","number":1,"topic":"Планиметрия","text":"Периметр параллелограмма равен 160. Одна сторона параллелограмма относится к другой как 3 : 7. Найдите большую сторону параллелограмма.","answers":["56"],"points":1,"kind":"number","explanation":"Полупериметр равен 80, на одну часть приходится 8, большая сторона равна 56."},
{"id":"math_prof-018","group":"p1_trapezoid","number":1,"topic":"Планиметрия","text":"Основания трапеции равны 4 и 10, а высота равна 12. Найдите площадь трапеции.","answers":["84"],"points":1,"kind":"number","explanation":"S = (4 + 10) : 2 · 12 = 84."},
{"id":"math_prof-019","group":"p1_circle_angles","number":1,"topic":"Планиметрия","text":"Сторона AB треугольника ABC является диаметром описанной около него окружности, угол A равен 43°. Найдите угол B. Ответ дайте в градусах.","answers":["47"],"points":1,"kind":"number","explanation":"Угол C опирается на диаметр и равен 90°, поэтому угол B равен 90° - 43° = 47°."},
{"id":"math_prof-020","group":"p1_incircle","number":1,"topic":"Планиметрия","text":"Радиус окружности, вписанной в правильный треугольник, равен 25. Найдите высоту этого треугольника.","answers":["75"],"points":1,"kind":"number","explanation":"Центр вписанной окружности делит высоту в отношении 2 : 1, считая от вершины, поэтому высота равна 3r = 75."},
{"id":"math_prof-021","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(6; 1) и b(-1; 25). Найдите длину вектора a - b.","answers":["25"],"points":1,"kind":"number","explanation":"Вектор a - b имеет координаты (7; -24), его длина равна √(49 + 576) = 25."},
{"id":"math_prof-022","group":"v_dot","number":2,"topic":"Векторы","text":"Даны векторы a(8; -7) и b(1; -9). Найдите скалярное произведение a · b.","answers":["71"],"points":1,"kind":"number","explanation":"a · b = 8 · (1) + -7 · (-9) = 71."},
{"id":"math_prof-023","group":"v_cosine","number":2,"topic":"Векторы","text":"Даны векторы a(0; 5) и b(-4; 3). Найдите косинус угла между ними.","answers":["0,6"],"points":1,"kind":"number","explanation":"a · b = 15, |a| = 5, |b| = 5; cos = 15 : (5 · 5) = 0,6."},
{"id":"math_prof-024","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; 9) и b(-2; -6) перпендикулярны?","answers":["-27"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: -2x + (9) · (-6) = 0, откуда x = -27."},
{"id":"math_prof-025","group":"v_endpoint","number":2,"topic":"Векторы","text":"Вектор AB с началом в точке A(-6; -3) имеет координаты (-7; 6). Найдите сумму координат точки B.","answers":["-10"],"points":1,"kind":"number","explanation":"B(-13; 3), сумма координат равна -10."},
{"id":"math_prof-026","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(-1; 6) и b(-2; -10). Найдите длину вектора a + b.","answers":["5"],"points":1,"kind":"number","explanation":"Вектор a + b имеет координаты (-3; -4), его длина равна √(9 + 16) = 5."},
{"id":"math_prof-027","group":"v_dot","number":2,"topic":"Векторы","text":"Даны векторы a(4; 8) и b(-3; -6). Найдите скалярное произведение a · b.","answers":["-60"],"points":1,"kind":"number","explanation":"a · b = 4 · (-3) + 8 · (-6) = -60."},
{"id":"math_prof-028","group":"v_cosine","number":2,"topic":"Векторы","text":"Даны векторы a(6; -8) и b(-3; -4). Найдите косинус угла между ними.","answers":["0,28"],"points":1,"kind":"number","explanation":"a · b = 14, |a| = 10, |b| = 5; cos = 14 : (10 · 5) = 0,28."},
{"id":"math_prof-029","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; 7) и b(-7; 5) перпендикулярны?","answers":["5"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: -7x + (7) · (5) = 0, откуда x = 5."},
{"id":"math_prof-030","group":"v_endpoint","number":2,"topic":"Векторы","text":"Вектор AB с началом в точке A(-2; 2) и концом в точке B(-7; 14). Найдите длину вектора AB.","answers":["13"],"points":1,"kind":"number","explanation":"Координаты вектора: (-5; 12), длина равна √(25 + 144) = 13."},
{"id":"math_prof-031","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(-5; 5) и b(16; -2). Найдите длину вектора 2a + b.","answers":["10"],"points":1,"kind":"number","explanation":"Вектор 2a + b имеет координаты (6; 8), его длина равна √(36 + 64) = 10."},
{"id":"math_prof-032","group":"v_dot","number":2,"topic":"Векторы","text":"Длины векторов a и b равны 11 и 4, а угол между ними равен 0°. Найдите скалярное произведение a · b.","answers":["44"],"points":1,"kind":"number","explanation":"a · b = |a| · |b| · cos 0° = 11 · 4 · (1) = 44."},
{"id":"math_prof-033","group":"v_cosine","number":2,"topic":"Векторы","text":"Даны векторы a(-3; 4) и b(0; 5). Найдите косинус угла между ними.","answers":["0,8"],"points":1,"kind":"number","explanation":"a · b = 20, |a| = 5, |b| = 5; cos = 20 : (5 · 5) = 0,8."},
{"id":"math_prof-034","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; -1) и b(-1; 4) перпендикулярны?","answers":["-4"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: -1x + (-1) · (4) = 0, откуда x = -4."},
{"id":"math_prof-035","group":"v_endpoint","number":2,"topic":"Векторы","text":"Вектор AB с началом в точке A(2; -6) и концом в точке B(-4; -14). Найдите длину вектора AB.","answers":["10"],"points":1,"kind":"number","explanation":"Координаты вектора: (-6; -8), длина равна √(36 + 64) = 10."},
{"id":"math_prof-036","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(-2; 3) и b(5; -7). Найдите длину вектора a + b.","answers":["5"],"points":1,"kind":"number","explanation":"Вектор a + b имеет координаты (3; -4), его длина равна √(9 + 16) = 5."},
{"id":"math_prof-037","group":"v_dot","number":2,"topic":"Векторы","text":"Даны векторы a(-1; -6) и b(1; 1). Найдите скалярное произведение a · b.","answers":["-7"],"points":1,"kind":"number","explanation":"a · b = -1 · (1) + -6 · (1) = -7."},
{"id":"math_prof-038","group":"v_perpendicular","number":2,"topic":"Векторы","text":"При каком значении x векторы a(x; -9) и b(9; -5) перпендикулярны?","answers":["-5"],"points":1,"kind":"number","explanation":"Скалярное произведение должно быть равно нулю: 9x + (-9) · (-5) = 0, откуда x = -5."},
{"id":"math_prof-039","group":"v_endpoint","number":2,"topic":"Векторы","text":"Вектор AB с началом в точке A(-4; -4) и концом в точке B(-9; -16). Найдите длину вектора AB.","answers":["13"],"points":1,"kind":"number","explanation":"Координаты вектора: (-5; -12), длина равна √(25 + 144) = 13."},
{"id":"math_prof-040","group":"v_sum_length","number":2,"topic":"Векторы","text":"Даны векторы a(-1; -2) и b(10; -2). Найдите длину вектора 2a + b.","answers":["10"],"points":1,"kind":"number","explanation":"Вектор 2a + b имеет координаты (8; -6), его длина равна √(64 + 36) = 10."},
{"id":"math_prof-041","group":"s_cube","number":3,"topic":"Стереометрия","text":"Площадь поверхности куба равна 216. Найдите его объём.","answers":["216"],"points":1,"kind":"number","explanation":"Площадь грани равна 36, ребро равно 6, объём равен 216."},
{"id":"math_prof-042","group":"s_box","number":3,"topic":"Стереометрия","text":"Два ребра прямоугольного параллелепипеда, выходящие из одной вершины, равны 8 и 1. Диагональ параллелепипеда равна 9. Найдите объём параллелепипеда.","answers":["32"],"points":1,"kind":"number","explanation":"Третье ребро равно √(9² - 8² - 1²) = 4, объём равен 8 · 1 · 4 = 32."},
{"id":"math_prof-043","group":"s_prism","number":3,"topic":"Стереометрия","text":"В сосуд, имеющий форму правильной треугольной призмы, налили воду. Уровень воды достигает 8 см. На какой высоте будет находиться уровень воды, если её перелить в другой такой же сосуд, у которого сторона основания в 2 раза больше, чем у первого? Ответ выразите в сантиметрах.","answers":["2"],"points":1,"kind":"number","explanation":"Площадь основания больше в 4 раз, значит уровень воды ниже в 4 раз: 8 : 4 = 2."},
{"id":"math_prof-044","group":"s_pyramid","number":3,"topic":"Стереометрия","text":"Сторона основания правильной четырёхугольной пирамиды равна 6, высота равна 6. Найдите объём пирамиды.","answers":["72"],"points":1,"kind":"number","explanation":"Площадь основания равна 36, объём равен 36 · 6 : 3 = 72."},
{"id":"math_prof-045","group":"s_cylinder","number":3,"topic":"Стереометрия","text":"В цилиндрический сосуд налили 4300 см³ воды. Уровень воды при этом достигает высоты 15 см. В жидкость полностью погрузили деталь. При этом уровень жидкости в сосуде поднялся на 3 см. Чему равен объём детали? Ответ выразите в см³.","answers":["860"],"points":1,"kind":"number","explanation":"Объём детали равен объёму вытесненной воды: 4300 · 3 : 15 = 860."},
{"id":"math_prof-046","group":"s_cone","number":3,"topic":"Стереометрия","text":"Во сколько раз увеличится объём конуса, если радиус его основания увеличить в 2 раза, а высоту оставить прежней?","answers":["4"],"points":1,"kind":"number","explanation":"Объём пропорционален квадрату радиуса: 2² = 4."},
{"id":"math_prof-047","group":"s_sphere","number":3,"topic":"Стереометрия","text":"Шар вписан в цилиндр. Площадь поверхности шара равна 46. Найдите площадь полной поверхности цилиндра.","answers":["69"],"points":1,"kind":"number","explanation":"Площадь поверхности шара 4πr², цилиндра 6πr², то есть в 1,5 раза больше: 69."},
{"id":"math_prof-048","group":"s_cube","number":3,"topic":"Стереометрия","text":"Площадь поверхности куба равна 384. Найдите его объём.","answers":["512"],"points":1,"kind":"number","explanation":"Площадь грани равна 64, ребро равно 8, объём равен 512."},
{"id":"math_prof-049","group":"s_box","number":3,"topic":"Стереометрия","text":"Два ребра прямоугольного параллелепипеда, выходящие из одной вершины, равны 4 и 4. Объём параллелепипеда равен 112. Найдите площадь его поверхности.","answers":["144"],"points":1,"kind":"number","explanation":"Третье ребро равно 7, площадь поверхности равна 2 · (16 + 28 + 28) = 144."},
{"id":"math_prof-050","group":"s_prism","number":3,"topic":"Стереометрия","text":"Основанием прямой треугольной призмы служит прямоугольный треугольник с катетами 5 и 12, боковое ребро равно 5. Найдите объём призмы.","answers":["150"],"points":1,"kind":"number","explanation":"Площадь основания равна 30, объём равен 30 · 5 = 150."},
{"id":"math_prof-051","group":"s_pyramid","number":3,"topic":"Стереометрия","text":"Сторона основания правильной четырёхугольной пирамиды равна 4, высота равна 12. Найдите объём пирамиды.","answers":["64"],"points":1,"kind":"number","explanation":"Площадь основания равна 16, объём равен 16 · 12 : 3 = 64."},
{"id":"math_prof-052","group":"s_cylinder","number":3,"topic":"Стереометрия","text":"В цилиндрическом сосуде уровень жидкости достигает 45 см. На какой высоте будет находиться уровень жидкости, если её перелить во второй цилиндрический сосуд, диаметр которого в 3 раза больше диаметра первого? Ответ выразите в сантиметрах.","answers":["5"],"points":1,"kind":"number","explanation":"Площадь основания больше в 9 раз, уровень ниже в 9 раз: 5."},
{"id":"math_prof-053","group":"s_cone","number":3,"topic":"Стереометрия","text":"Высота конуса равна 4, образующая равна 5. Найдите площадь его осевого сечения.","answers":["12"],"points":1,"kind":"number","explanation":"Радиус основания равен √(5² - 4²) = 3. Осевое сечение это треугольник с основанием 6 и высотой 4: S = 12."},
{"id":"math_prof-054","group":"s_sphere","number":3,"topic":"Стереометрия","text":"Во сколько раз увеличится площадь поверхности шара, если радиус шара увеличить в 3 раза?","answers":["9"],"points":1,"kind":"number","explanation":"Площадь поверхности пропорциональна квадрату радиуса: 3² = 9."},
{"id":"math_prof-055","group":"s_cube","number":3,"topic":"Стереометрия","text":"Объём куба равен 64. Найдите площадь его поверхности.","answers":["96"],"points":1,"kind":"number","explanation":"Ребро равно 4, площадь поверхности равна 6 · 4² = 96."},
{"id":"math_prof-056","group":"s_box","number":3,"topic":"Стереометрия","text":"Два ребра прямоугольного параллелепипеда, выходящие из одной вершины, равны 8 и 4. Объём параллелепипеда равен 32. Найдите площадь его поверхности.","answers":["88"],"points":1,"kind":"number","explanation":"Третье ребро равно 1, площадь поверхности равна 2 · (32 + 4 + 8) = 88."},
