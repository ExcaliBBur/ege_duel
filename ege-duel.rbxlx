        <Item class="StringValue" referent="25">
          <Properties>
            <string name="Name">01</string>
            <string name="Value"><![CDATA[{"subject": "english", "tasks": [
{"id":"english-001","group":"времена","text":"Поставьте глагол в скобках в нужную форму и запишите её.\n\nShe ___ (go) to school every day.","answers":["goes"],"points":1,"kind":"exact","explanation":"Present Simple, третье лицо единственного числа: goes."},
{"id":"english-002","group":"времена","text":"Поставьте глагол в скобках в нужную форму и запишите её.\n\nThey ___ (be) at home yesterday.","answers":["were"],"points":1,"kind":"exact","explanation":"Past Simple глагола be для they: were."},
{"id":"english-003","group":"времена","text":"Поставьте глагол в скобках в нужную форму и запишите её.\n\nI have already ___ (see) this film.","answers":["seen"],"points":1,"kind":"exact","explanation":"Present Perfect требует третьей формы глагола: seen."},
{"id":"english-004","group":"времена","text":"Поставьте глагол в скобках в нужную форму и запишите её.\n\nHe ___ (write) a letter yesterday.","answers":["wrote"],"points":1,"kind":"exact","explanation":"Past Simple неправильного глагола write: wrote."},
{"id":"english-005","group":"времена","text":"Поставьте глагол в скобках в нужную форму и запишите её.\n\nLook! She ___ (read) a book now.","answers":["is reading","'s reading"],"points":1,"kind":"exact","explanation":"Действие происходит сейчас, нужен Present Continuous: is reading."},
{"id":"english-006","group":"времена","text":"Поставьте глагол в скобках в нужную форму и запишите её.\n\nThe letter ___ (write) by Tom yesterday.","answers":["was written"],"points":1,"kind":"exact","explanation":"Пассивный залог в Past Simple: was written."},
{"id":"english-007","group":"формы слов","text":"Запишите форму множественного числа слова «child».","answers":["children"],"points":1,"kind":"exact","explanation":"Исключение: child, children."},
{"id":"english-008","group":"формы слов","text":"Запишите форму множественного числа слова «mouse».","answers":["mice"],"points":1,"kind":"exact","explanation":"Исключение: mouse, mice."},
{"id":"english-009","group":"формы слов","text":"Запишите форму множественного числа слова «tooth».","answers":["teeth"],"points":1,"kind":"exact","explanation":"Исключение: tooth, teeth."},
{"id":"english-010","group":"формы слов","text":"Запишите сравнительную степень прилагательного «good».","answers":["better"],"points":1,"kind":"exact","explanation":"Good, better, the best."},
{"id":"english-011","group":"формы слов","text":"Запишите превосходную степень прилагательного «bad» без артикля.","answers":["worst"],"points":1,"kind":"exact","explanation":"Bad, worse, the worst."},
{"id":"english-012","group":"формы слов","text":"Запишите форму Past Simple глагола «buy».","answers":["bought"],"points":1,"kind":"exact","explanation":"Buy, bought, bought."},
{"id":"english-013","group":"формы слов","text":"Запишите третью форму (Past Participle) глагола «take».","answers":["taken"],"points":1,"kind":"exact","explanation":"Take, took, taken."},
{"id":"english-014","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nI saw ___ elephant at the zoo.\n1) a\n2) an\n3) much","answers":["2"],"points":1,"kind":"exact","explanation":"Перед гласным звуком используется артикль an."},
{"id":"english-015","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nShe is good ___ maths.\n1) in\n2) on\n3) at\n4) with","answers":["3"],"points":1,"kind":"exact","explanation":"Устойчивое сочетание: good at something."},
{"id":"english-016","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nI'm interested ___ history.\n1) in\n2) at\n3) on\n4) for","answers":["1"],"points":1,"kind":"exact","explanation":"Устойчивое сочетание: interested in something."},
{"id":"english-017","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nWe arrived ___ the airport two hours before the flight.\n1) to\n2) into\n3) on\n4) at","answers":["4"],"points":1,"kind":"exact","explanation":"Arrive at используется с небольшими местами: аэропорт, вокзал, отель."},
{"id":"english-018","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nIf it rains tomorrow, we ___ at home.\n1) stay\n2) will stay\n3) stayed\n4) would stay","answers":["2"],"points":1,"kind":"exact","explanation":"Условное предложение первого типа: if + Present Simple, will + глагол."},
{"id":"english-019","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nIf I ___ you, I would apologize.\n1) am\n2) will be\n3) were\n4) be","answers":["3"],"points":1,"kind":"exact","explanation":"Условное предложение второго типа: if I were you."},
{"id":"english-020","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nThere isn't ___ milk in the fridge.\n1) some\n2) many\n3) few\n4) any","answers":["4"],"points":1,"kind":"exact","explanation":"В отрицательных предложениях используется any."},
{"id":"english-021","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nHow ___ money do you have?\n1) much\n2) many\n3) few\n4) lot","answers":["1"],"points":1,"kind":"exact","explanation":"Money неисчисляемое существительное, поэтому much."},
{"id":"english-022","group":"грамматика","text":"Выберите подходящий вариант и запишите его номер.\n\nHe has lived here ___ 2010.\n1) for\n2) since\n3) from\n4) during","answers":["2"],"points":1,"kind":"exact","explanation":"Since указывает на момент начала действия."},
