        <Item class="StringValue" referent="54">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "physics", "tasks": [
{"id":"physics-001","group":"k_law","number":1,"topic":"Кинематика","text":"Координата тела, движущегося вдоль оси Ox, меняется по закону x(t) = -20 - 2t + t², где все величины выражены в единицах СИ. Чему равна проекция скорости тела на ось Ox в момент времени t = 5 с? Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"v = v₀ + a · t, где v₀ = -2 м/с, a = 2 м/с²; при t = 5 с получаем 8 м/с."},
{"id":"physics-002","group":"k_circular","number":1,"topic":"Кинематика","text":"Материальная точка равномерно движется по окружности радиусом 4 м со скоростью 15 м/с. Чему равно центростремительное ускорение точки? Ответ дайте в м/с².","answers":["56,25"],"points":1,"kind":"number","explanation":"a = v² : R = 225 : 4 = 56,25 м/с²."},
{"id":"physics-003","group":"k_relative","number":1,"topic":"Кинематика","text":"Два автомобиля движутся по прямому шоссе в одном направлении: первый со скоростью 70 км/ч, второй со скоростью 40 км/ч. Чему равен модуль скорости первого автомобиля в системе отсчёта, связанной со вторым автомобилем? Ответ дайте в км/ч.","answers":["30"],"points":1,"kind":"number","explanation":"При движении в одну сторону скорости вычитаются: |70 - 40| = 30 км/ч."},
{"id":"physics-004","group":"k_average","number":1,"topic":"Кинематика","text":"Первую половину пути автомобиль проехал со скоростью 20 км/ч, а вторую половину пути со скоростью 30 км/ч. Найдите среднюю скорость автомобиля на всём пути. Ответ дайте в км/ч.","answers":["24"],"points":1,"kind":"number","explanation":"vср = 2 · v₁ · v₂ : (v₁ + v₂) = 2 · 20 · 30 : 50 = 24 км/ч."},
{"id":"physics-005","group":"k_throw","number":1,"topic":"Кинематика","text":"Тело свободно падает без начальной скорости с высоты 20 м. Чему равна скорость тела в момент падения на землю? Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в м/с.","answers":["20"],"points":1,"kind":"number","explanation":"v = √(2gh) = √(20 · 20) = 20 м/с."},
{"id":"physics-006","group":"fig_velocity_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости скорости тела от времени. Найдите модуль ускорения тела в интервале от 6 до 8 с. Ответ дайте в м/с².","answers":["4"],"points":1,"kind":"number","explanation":"a = Δv : Δt = 8 : 2 = 4 м/с².","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["text",50.0,238.0,"0","c"],["line",92.0,225.0,92.0,25.0,0],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"2","r"],["line",50.0,165.0,386.0,165.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"4","r"],["line",50.0,125.0,386.0,125.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"6","r"],["line",50.0,85.0,386.0,85.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"8","r"],["line",50.0,45.0,386.0,45.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"10","r"],["line",50.0,225.0,398.6,225.0,1],["line",50.0,225.0,50.0,15.0,1],["text",80.0,12.0,"v, м/с","c"],["text",402.0,238.0,"t, с","l"],["line",50.0,145.0,218.0,225.0,2],["line",218.0,225.0,302.0,225.0,2],["line",302.0,225.0,386.0,65.0,2]]}},
{"id":"physics-007","group":"fig_xt_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости координаты тела от времени. Найдите модуль скорости тела в интервале от 0 до 2 с. Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"v = Δx : Δt = 16 : 2 = 8 м/с.","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["line",92.0,225.0,92.0,25.0,0],["text",92.0,238.0,"1","c"],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["text",176.0,238.0,"3","c"],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["text",260.0,238.0,"5","c"],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["text",344.0,238.0,"7","c"],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,215.0,386.0,215.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,195.0,386.0,195.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"4","r"],["line",50.0,175.0,386.0,175.0,0],["line",50.0,165.0,386.0,165.0,0],["line",50.0,155.0,386.0,155.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"8","r"],["line",50.0,135.0,386.0,135.0,0],["line",50.0,125.0,386.0,125.0,0],["line",50.0,115.0,386.0,115.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"12","r"],["line",50.0,95.0,386.0,95.0,0],["line",50.0,85.0,386.0,85.0,0],["line",50.0,75.0,386.0,75.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"16","r"],["line",50.0,55.0,386.0,55.0,0],["line",50.0,45.0,386.0,45.0,0],["line",50.0,35.0,386.0,35.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"20","r"],["line",50.0,225.0,402.8,225.0,1],["line",50.0,225.0,50.0,21.0,1],["text",42.0,238.0,"0","r"],["text",58.0,15.0,"x, м","l"],["text",412.0,212.0,"t, с","r"],["line",50.0,225.0,134.0,65.0,2],["line",134.0,65.0,386.0,145.0,2]]}},
{"id":"physics-008","group":"k_law","number":1,"topic":"Кинематика","text":"Координата тела, движущегося вдоль оси Ox, меняется по закону x(t) = 8 + 10t - 2t², где все величины выражены в единицах СИ. Чему равна проекция скорости тела на ось Ox в момент времени t = 4 с? Ответ дайте в м/с.","answers":["-6"],"points":1,"kind":"number","explanation":"v = v₀ + a · t, где v₀ = 10 м/с, a = -4 м/с²; при t = 4 с получаем -6 м/с."},
{"id":"physics-009","group":"k_circular","number":1,"topic":"Кинематика","text":"Материальная точка равномерно движется по окружности радиусом 25 м со скоростью 12 м/с. Чему равно центростремительное ускорение точки? Ответ дайте в м/с².","answers":["5,76"],"points":1,"kind":"number","explanation":"a = v² : R = 144 : 25 = 5,76 м/с²."},
{"id":"physics-010","group":"k_relative","number":1,"topic":"Кинематика","text":"Два автомобиля движутся по прямому шоссе в одном направлении: первый со скоростью 90 км/ч, второй со скоростью 120 км/ч. Чему равен модуль скорости первого автомобиля в системе отсчёта, связанной со вторым автомобилем? Ответ дайте в км/ч.","answers":["30"],"points":1,"kind":"number","explanation":"При движении в одну сторону скорости вычитаются: |90 - 120| = 30 км/ч."},
{"id":"physics-011","group":"k_average","number":1,"topic":"Кинематика","text":"Первую половину пути автомобиль проехал со скоростью 60 км/ч, а вторую половину пути со скоростью 40 км/ч. Найдите среднюю скорость автомобиля на всём пути. Ответ дайте в км/ч.","answers":["48"],"points":1,"kind":"number","explanation":"vср = 2 · v₁ · v₂ : (v₁ + v₂) = 2 · 60 · 40 : 100 = 48 км/ч."},
{"id":"physics-012","group":"k_throw","number":1,"topic":"Кинематика","text":"Тело свободно падает без начальной скорости с высоты 1,8 м. Чему равна скорость тела в момент падения на землю? Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в м/с.","answers":["6"],"points":1,"kind":"number","explanation":"v = √(2gh) = √(20 · 1,8) = 6 м/с."},
{"id":"physics-013","group":"fig_velocity_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости скорости тела от времени. Какой путь прошло тело за первые 8 с? Ответ дайте в метрах.","answers":["48"],"points":1,"kind":"number","explanation":"Путь равен площади под графиком скорости от 0 до 8 с: 48 м.","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["text",50.0,238.0,"0","c"],["line",92.0,225.0,92.0,25.0,0],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"2","r"],["line",50.0,165.0,386.0,165.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"4","r"],["line",50.0,125.0,386.0,125.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"6","r"],["line",50.0,85.0,386.0,85.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"8","r"],["line",50.0,45.0,386.0,45.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"10","r"],["line",50.0,225.0,398.6,225.0,1],["line",50.0,225.0,50.0,15.0,1],["text",80.0,12.0,"v, м/с","c"],["text",402.0,238.0,"t, с","l"],["line",50.0,145.0,218.0,25.0,2],["line",218.0,25.0,302.0,145.0,2],["line",302.0,145.0,386.0,185.0,2]]}},
{"id":"physics-014","group":"fig_xt_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости координаты тела от времени. Найдите модуль скорости тела в интервале от 4 до 8 с. Ответ дайте в м/с.","answers":["1"],"points":1,"kind":"number","explanation":"v = Δx : Δt = 4 : 4 = 1 м/с.","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["line",92.0,225.0,92.0,25.0,0],["text",92.0,238.0,"1","c"],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["text",176.0,238.0,"3","c"],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["text",260.0,238.0,"5","c"],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["text",344.0,238.0,"7","c"],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,215.0,386.0,215.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,195.0,386.0,195.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"4","r"],["line",50.0,175.0,386.0,175.0,0],["line",50.0,165.0,386.0,165.0,0],["line",50.0,155.0,386.0,155.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"8","r"],["line",50.0,135.0,386.0,135.0,0],["line",50.0,125.0,386.0,125.0,0],["line",50.0,115.0,386.0,115.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"12","r"],["line",50.0,95.0,386.0,95.0,0],["line",50.0,85.0,386.0,85.0,0],["line",50.0,75.0,386.0,75.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"16","r"],["line",50.0,55.0,386.0,55.0,0],["line",50.0,45.0,386.0,45.0,0],["line",50.0,35.0,386.0,35.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"20","r"],["line",50.0,225.0,402.8,225.0,1],["line",50.0,225.0,50.0,21.0,1],["text",42.0,238.0,"0","r"],["text",58.0,15.0,"x, м","l"],["text",412.0,212.0,"t, с","r"],["line",50.0,25.0,218.0,185.0,2],["line",218.0,185.0,386.0,145.0,2]]}},
{"id":"physics-015","group":"k_law","number":1,"topic":"Кинематика","text":"Координата тела, движущегося вдоль оси Ox, меняется по закону x(t) = 19 - 6t - t², где все величины выражены в единицах СИ. Чему равна проекция скорости тела на ось Ox в момент времени t = 2 с? Ответ дайте в м/с.","answers":["-10"],"points":1,"kind":"number","explanation":"v = v₀ + a · t, где v₀ = -6 м/с, a = -2 м/с²; при t = 2 с получаем -10 м/с."},
{"id":"physics-016","group":"k_circular","number":1,"topic":"Кинематика","text":"Материальная точка равномерно движется по окружности радиусом 5 м со скоростью 20 м/с. Чему равно центростремительное ускорение точки? Ответ дайте в м/с².","answers":["80"],"points":1,"kind":"number","explanation":"a = v² : R = 400 : 5 = 80 м/с²."},
{"id":"physics-017","group":"k_relative","number":1,"topic":"Кинематика","text":"Два автомобиля движутся по прямому шоссе в одном направлении: первый со скоростью 55 км/ч, второй со скоростью 50 км/ч. Чему равен модуль скорости первого автомобиля в системе отсчёта, связанной со вторым автомобилем? Ответ дайте в км/ч.","answers":["5"],"points":1,"kind":"number","explanation":"При движении в одну сторону скорости вычитаются: |55 - 50| = 5 км/ч."},
{"id":"physics-018","group":"k_average","number":1,"topic":"Кинематика","text":"Первую половину времени движения автомобиль ехал со скоростью 90 км/ч, а вторую половину времени со скоростью 45 км/ч. Найдите среднюю скорость автомобиля за всё время движения. Ответ дайте в км/ч.","answers":["67,5"],"points":1,"kind":"number","explanation":"При равных промежутках времени vср = (v₁ + v₂) : 2 = 67,5 км/ч."},
{"id":"physics-019","group":"k_throw","number":1,"topic":"Кинематика","text":"Тело брошено вертикально вверх с начальной скоростью 20 м/с. Через какое время после броска оно достигнет высшей точки траектории? Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в секундах.","answers":["2"],"points":1,"kind":"number","explanation":"t = v₀ : g = 20 : 10 = 2 с."},
{"id":"physics-020","group":"fig_velocity_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости скорости тела от времени. Какой путь прошло тело за первые 8 с? Ответ дайте в метрах.","answers":["34"],"points":1,"kind":"number","explanation":"Путь равен площади под графиком скорости от 0 до 8 с: 34 м.","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["text",50.0,238.0,"0","c"],["line",92.0,225.0,92.0,25.0,0],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"2","r"],["line",50.0,165.0,386.0,165.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"4","r"],["line",50.0,125.0,386.0,125.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"6","r"],["line",50.0,85.0,386.0,85.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"8","r"],["line",50.0,45.0,386.0,45.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"10","r"],["line",50.0,225.0,398.6,225.0,1],["line",50.0,225.0,50.0,15.0,1],["text",80.0,12.0,"v, м/с","c"],["text",402.0,238.0,"t, с","l"],["line",50.0,145.0,134.0,105.0,2],["line",134.0,105.0,218.0,185.0,2],["line",218.0,185.0,386.0,105.0,2]]}},
{"id":"physics-021","group":"d_resultant","number":2,"topic":"Динамика","text":"На тело массой 8 кг действуют две силы, направленные перпендикулярно друг другу: 9 Н и 12 Н. С каким ускорением движется тело? Ответ дайте в м/с².","answers":["1,875"],"points":1,"kind":"number","explanation":"Равнодействующая равна √(9² + 12²) = 15 Н, a = F : m = 1,875 м/с²."},
{"id":"physics-022","group":"d_friction","number":2,"topic":"Динамика","text":"Брусок массой 2,5 кг скользит по горизонтальной поверхности. Коэффициент трения между бруском и поверхностью равен 0,2. Чему равна сила трения скольжения, действующая на брусок? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["5"],"points":1,"kind":"number","explanation":"Fтр = μ · m · g = 0,2 · 2,5 · 10 = 5 Н."},
{"id":"physics-023","group":"d_spring","number":2,"topic":"Динамика","text":"Под действием силы 12 Н пружина удлинилась на 3 см. Чему равна жёсткость пружины? Ответ дайте в Н/м.","answers":["400"],"points":1,"kind":"number","explanation":"k = F : x = 12 : 0,03 = 400 Н/м."},
{"id":"physics-024","group":"d_gravity","number":2,"topic":"Динамика","text":"Два однородных шара притягиваются друг к другу с силой 128 мкН. Какой станет сила притяжения, если расстояние между их центрами увеличить в 4 раза, а массу одного из шаров увеличить в 2 раза? Ответ дайте в мкН.","answers":["16"],"points":1,"kind":"number","explanation":"Сила пропорциональна массам и обратно пропорциональна квадрату расстояния: 128 · 2 : 16 = 16 мкН."},
{"id":"physics-025","group":"d_elevator","number":2,"topic":"Динамика","text":"Человек массой 80 кг стоит в лифте, который движется с ускорением 3 м/с², направленным вверх. Чему равен вес человека? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["1040"],"points":1,"kind":"number","explanation":"P = m · (g + a) = 80 · 13 = 1040 Н."},
{"id":"physics-026","group":"d_second_law","number":2,"topic":"Динамика","text":"Под действием силы 24 Н тело движется с ускорением 3 м/с². С каким ускорением будет двигаться это тело под действием силы 8 Н? Ответ дайте в м/с².","answers":["1"],"points":1,"kind":"number","explanation":"Масса тела равна 24 : 3 = 8 кг, a = 8 : 8 = 1 м/с²."},
{"id":"physics-027","group":"fig_forces","number":2,"topic":"Динамика","text":"На рисунке показаны горизонтальные силы, действующие на тело на гладкой поверхности. Найдите модуль равнодействующей этих сил. Ответ дайте в ньютонах.","answers":["9"],"points":1,"kind":"number","explanation":"Силы направлены в противоположные стороны: 23 - 14 = 9 Н.","figure":{"w":420,"h":260,"items":[["line",30.0,190.0,390.0,190.0,1],["line",170.0,130.0,250.0,130.0,2],["line",250.0,130.0,250.0,190.0,2],["line",250.0,190.0,170.0,190.0,2],["line",170.0,190.0,170.0,130.0,2],["text",210.0,160.0,"2 кг","c"],["line",170.0,160.0,60.0,160.0,1],["line",60.0,160.0,69.4,154.3,1],["line",60.0,160.0,69.4,165.7,1],["line",250.0,160.0,360.0,160.0,1],["line",360.0,160.0,350.6,165.7,1],["line",360.0,160.0,350.6,154.3,1],["text",110.0,140.0,"F₁ = 14 Н","c"],["text",310.0,140.0,"F₂ = 23 Н","c"]]}},
{"id":"physics-028","group":"d_resultant","number":2,"topic":"Динамика","text":"На тело массой 10 кг действуют две силы, направленные перпендикулярно друг другу: 6 Н и 8 Н. С каким ускорением движется тело? Ответ дайте в м/с².","answers":["1"],"points":1,"kind":"number","explanation":"Равнодействующая равна √(6² + 8²) = 10 Н, a = F : m = 1 м/с²."},
{"id":"physics-029","group":"d_friction","number":2,"topic":"Динамика","text":"Брусок массой 1,5 кг скользит по горизонтальной поверхности. Коэффициент трения между бруском и поверхностью равен 0,1. Чему равна сила трения скольжения, действующая на брусок? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["1,5"],"points":1,"kind":"number","explanation":"Fтр = μ · m · g = 0,1 · 1,5 · 10 = 1,5 Н."},
{"id":"physics-030","group":"d_spring","number":2,"topic":"Динамика","text":"Под действием силы 16 Н пружина удлинилась на 8 см. На сколько сантиметров удлинится эта пружина под действием силы 6 Н?","answers":["3"],"points":1,"kind":"number","explanation":"Удлинение пропорционально силе: x = 8 · 6 : 16 = 3 см."},
{"id":"physics-031","group":"d_gravity","number":2,"topic":"Динамика","text":"Два однородных шара притягиваются друг к другу с силой 63 мкН. Какой станет сила притяжения, если расстояние между их центрами увеличить в 3 раза, а массу одного из шаров увеличить в 4 раза? Ответ дайте в мкН.","answers":["28"],"points":1,"kind":"number","explanation":"Сила пропорциональна массам и обратно пропорциональна квадрату расстояния: 63 · 4 : 9 = 28 мкН."},
{"id":"physics-032","group":"d_elevator","number":2,"topic":"Динамика","text":"Человек массой 80 кг стоит в лифте, который движется с ускорением 3 м/с², направленным вниз. Чему равен вес человека? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["560"],"points":1,"kind":"number","explanation":"P = m · (g - a) = 80 · 7 = 560 Н."},
{"id":"physics-033","group":"d_second_law","number":2,"topic":"Динамика","text":"Под действием силы 20 Н тело движется с ускорением 5 м/с². С каким ускорением будет двигаться это тело под действием силы 24 Н? Ответ дайте в м/с².","answers":["6"],"points":1,"kind":"number","explanation":"Масса тела равна 20 : 5 = 4 кг, a = 24 : 4 = 6 м/с²."},
{"id":"physics-034","group":"fig_forces","number":2,"topic":"Динамика","text":"На рисунке показаны горизонтальные силы, действующие на тело на гладкой поверхности. Найдите модуль равнодействующей этих сил. Ответ дайте в ньютонах.","answers":["7"],"points":1,"kind":"number","explanation":"Силы направлены в противоположные стороны: 29 - 22 = 7 Н.","figure":{"w":420,"h":260,"items":[["line",30.0,190.0,390.0,190.0,1],["line",170.0,130.0,250.0,130.0,2],["line",250.0,130.0,250.0,190.0,2],["line",250.0,190.0,170.0,190.0,2],["line",170.0,190.0,170.0,130.0,2],["text",210.0,160.0,"1 кг","c"],["line",170.0,160.0,60.0,160.0,1],["line",60.0,160.0,69.4,154.3,1],["line",60.0,160.0,69.4,165.7,1],["line",250.0,160.0,360.0,160.0,1],["line",360.0,160.0,350.6,165.7,1],["line",360.0,160.0,350.6,154.3,1],["text",110.0,140.0,"F₁ = 29 Н","c"],["text",310.0,140.0,"F₂ = 22 Н","c"]]}},
{"id":"physics-035","group":"d_resultant","number":2,"topic":"Динамика","text":"На тело массой 10 кг действуют две силы, направленные перпендикулярно друг другу: 12 Н и 16 Н. С каким ускорением движется тело? Ответ дайте в м/с².","answers":["2"],"points":1,"kind":"number","explanation":"Равнодействующая равна √(12² + 16²) = 20 Н, a = F : m = 2 м/с²."},
{"id":"physics-036","group":"d_friction","number":2,"topic":"Динамика","text":"Брусок массой 5 кг скользит по горизонтальной поверхности. Коэффициент трения между бруском и поверхностью равен 0,3. Чему равна сила трения скольжения, действующая на брусок? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["15"],"points":1,"kind":"number","explanation":"Fтр = μ · m · g = 0,3 · 5 · 10 = 15 Н."},
{"id":"physics-037","group":"d_spring","number":2,"topic":"Динамика","text":"Под действием силы 2 Н пружина удлинилась на 2 см. На сколько сантиметров удлинится эта пружина под действием силы 6 Н?","answers":["6"],"points":1,"kind":"number","explanation":"Удлинение пропорционально силе: x = 2 · 6 : 2 = 6 см."},
{"id":"physics-038","group":"d_elevator","number":2,"topic":"Динамика","text":"Человек массой 50 кг стоит в лифте, который движется с ускорением 1 м/с², направленным вниз. Чему равен вес человека? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["450"],"points":1,"kind":"number","explanation":"P = m · (g - a) = 50 · 9 = 450 Н."},
{"id":"physics-039","group":"d_second_law","number":2,"topic":"Динамика","text":"Под действием силы 4 Н тело движется с ускорением 1 м/с². С каким ускорением будет двигаться это тело под действием силы 24 Н? Ответ дайте в м/с².","answers":["6"],"points":1,"kind":"number","explanation":"Масса тела равна 4 : 1 = 4 кг, a = 24 : 4 = 6 м/с²."},
{"id":"physics-040","group":"fig_forces","number":2,"topic":"Динамика","text":"На рисунке показаны горизонтальные силы, действующие на тело на гладкой поверхности, масса тела подписана. Найдите модуль ускорения тела. Ответ дайте в м/с².","answers":["16"],"points":1,"kind":"number","explanation":"Равнодействующая равна 16 Н, a = F : m = 16 : 1 = 16 м/с².","figure":{"w":420,"h":260,"items":[["line",30.0,190.0,390.0,190.0,1],["line",170.0,130.0,250.0,130.0,2],["line",250.0,130.0,250.0,190.0,2],["line",250.0,190.0,170.0,190.0,2],["line",170.0,190.0,170.0,130.0,2],["text",210.0,160.0,"1 кг","c"],["line",170.0,160.0,60.0,160.0,1],["line",60.0,160.0,69.4,154.3,1],["line",60.0,160.0,69.4,165.7,1],["line",250.0,160.0,360.0,160.0,1],["line",360.0,160.0,350.6,165.7,1],["line",360.0,160.0,350.6,154.3,1],["text",110.0,140.0,"F₁ = 4 Н","c"],["text",310.0,140.0,"F₂ = 20 Н","c"]]}},
{"id":"physics-041","group":"z_inelastic","number":3,"topic":"Законы сохранения в механике","text":"Тележка массой 4 кг, движущаяся со скоростью 10 м/с, сталкивается с неподвижной тележкой массой 1 кг и сцепляется с ней. С какой скоростью будут двигаться тележки после сцепки? Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"По закону сохранения импульса 4 · 10 = (4 + 1) · u, откуда u = 8 м/с."},
{"id":"physics-042","group":"z_rebound","number":3,"topic":"Законы сохранения в механике","text":"Мяч массой 400 г, летящий со скоростью 2 м/с перпендикулярно стене, упруго отскакивает от неё с такой же по модулю скоростью. Чему равен модуль изменения импульса мяча? Ответ дайте в кг·м/с.","answers":["1,6"],"points":1,"kind":"number","explanation":"Импульс меняет направление на противоположное: Δp = 2 · m · v = 2 · 0,4 · 2 = 1,6 кг·м/с."},
{"id":"physics-043","group":"z_energy_height","number":3,"topic":"Законы сохранения в механике","text":"Камень брошен вертикально вверх с начальной скоростью 10 м/с. На какой высоте кинетическая энергия камня будет равна его потенциальной энергии? Потенциальную энергию отсчитывайте от уровня броска. Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в метрах.","answers":["2,5"],"points":1,"kind":"number","explanation":"m · v₀² : 2 = 2 · m · g · h, откуда h = v₀² : (4g) = 100 : 40 = 2,5 м."},
{"id":"physics-044","group":"z_power","number":3,"topic":"Законы сохранения в механике","text":"Автомобиль движется равномерно со скоростью 15 м/с, сила тяги двигателя равна 5 кН. Какую мощность развивает двигатель? Ответ дайте в кВт.","answers":["75"],"points":1,"kind":"number","explanation":"N = F · v = 5 кН · 15 м/с = 75 кВт."},
{"id":"physics-045","group":"z_kinetic_change","number":3,"topic":"Законы сохранения в механике","text":"Кинетическая энергия тела равна 13 Дж. Чему станет равна кинетическая энергия тела, если его скорость увеличить в 3 раза? Ответ дайте в джоулях.","answers":["117"],"points":1,"kind":"number","explanation":"Энергия пропорциональна квадрату скорости: 13 · 9 = 117 Дж."},
{"id":"physics-046","group":"z_spring_energy","number":3,"topic":"Законы сохранения в механике","text":"Пружину жёсткостью 800 Н/м растянули на 2 см. Чему равна потенциальная энергия упругой деформации пружины? Ответ дайте в джоулях.","answers":["0,16"],"points":1,"kind":"number","explanation":"E = k · x² : 2 = 800 · 0,02² : 2 = 0,16 Дж."},
{"id":"physics-047","group":"z_work","number":3,"topic":"Законы сохранения в механике","text":"Подъёмник равномерно поднимает груз массой 16 кг на высоту 6 м за 4 с. Какую полезную мощность он развивает? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ваттах.","answers":["240"],"points":1,"kind":"number","explanation":"N = m · g · h : t = 16 · 10 · 6 : 4 = 240 Вт."},
{"id":"physics-048","group":"z_inelastic","number":3,"topic":"Законы сохранения в механике","text":"Тележка массой 4 кг, движущаяся со скоростью 12 м/с, сталкивается с неподвижной тележкой массой 2 кг и сцепляется с ней. С какой скоростью будут двигаться тележки после сцепки? Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"По закону сохранения импульса 4 · 12 = (4 + 2) · u, откуда u = 8 м/с."},
{"id":"physics-049","group":"z_rebound","number":3,"topic":"Законы сохранения в механике","text":"Мяч массой 500 г, летящий со скоростью 8 м/с перпендикулярно стене, упруго отскакивает от неё с такой же по модулю скоростью. Чему равен модуль изменения импульса мяча? Ответ дайте в кг·м/с.","answers":["8"],"points":1,"kind":"number","explanation":"Импульс меняет направление на противоположное: Δp = 2 · m · v = 2 · 0,5 · 8 = 8 кг·м/с."},
{"id":"physics-050","group":"z_energy_height","number":3,"topic":"Законы сохранения в механике","text":"Камень брошен вертикально вверх с начальной скоростью 30 м/с. На какой высоте кинетическая энергия камня будет равна его потенциальной энергии? Потенциальную энергию отсчитывайте от уровня броска. Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в метрах.","answers":["22,5"],"points":1,"kind":"number","explanation":"m · v₀² : 2 = 2 · m · g · h, откуда h = v₀² : (4g) = 900 : 40 = 22,5 м."},
{"id":"physics-051","group":"z_power","number":3,"topic":"Законы сохранения в механике","text":"Автомобиль движется равномерно со скоростью 30 м/с, сила тяги двигателя равна 8 кН. Какую мощность развивает двигатель? Ответ дайте в кВт.","answers":["240"],"points":1,"kind":"number","explanation":"N = F · v = 8 кН · 30 м/с = 240 кВт."},
{"id":"physics-052","group":"z_kinetic_change","number":3,"topic":"Законы сохранения в механике","text":"Кинетическая энергия тела равна 112 Дж. Чему станет равна кинетическая энергия тела, если его скорость уменьшить в 2 раза? Ответ дайте в джоулях.","answers":["28"],"points":1,"kind":"number","explanation":"Энергия пропорциональна квадрату скорости: 112 : 4 = 28 Дж."},
{"id":"physics-053","group":"z_work","number":3,"topic":"Законы сохранения в механике","text":"Подъёмник равномерно поднимает груз массой 19 кг на высоту 11 м за 10 с. Какую полезную мощность он развивает? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ваттах.","answers":["209"],"points":1,"kind":"number","explanation":"N = m · g · h : t = 19 · 10 · 11 : 10 = 209 Вт."},
