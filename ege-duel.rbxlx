          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "math_prof", "tasks": [
{"id":"math_prof-001","group":"mp_quadratic","text":"Решите уравнение x² - x = 0. Если уравнение имеет более одного корня, в ответе запишите больший из них.","answers":["1"],"points":1,"kind":"number","explanation":"Корни уравнения: 0 и 1. Больший корень равен 1."},
{"id":"math_prof-002","group":"mp_quadratic","text":"Решите уравнение x² + 6x + 5 = 0. Если уравнение имеет более одного корня, в ответе запишите больший из них.","answers":["-1"],"points":1,"kind":"number","explanation":"Корни уравнения: -5 и -1. Больший корень равен -1."},
{"id":"math_prof-003","group":"mp_quadratic","text":"Решите уравнение x² - 5x = 0. Если уравнение имеет более одного корня, в ответе запишите больший из них.","answers":["5"],"points":1,"kind":"number","explanation":"Корни уравнения: 0 и 5. Больший корень равен 5."},
{"id":"math_prof-004","group":"mp_quadratic","text":"Решите уравнение x² - 6x - 7 = 0. Если уравнение имеет более одного корня, в ответе запишите больший из них.","answers":["7"],"points":1,"kind":"number","explanation":"Корни уравнения: -1 и 7. Больший корень равен 7."},
{"id":"math_prof-005","group":"mp_quadratic","text":"Решите уравнение x² + 8x - 9 = 0. Если уравнение имеет более одного корня, в ответе запишите больший из них.","answers":["1"],"points":1,"kind":"number","explanation":"Корни уравнения: -9 и 1. Больший корень равен 1."},
