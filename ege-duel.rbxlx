0.0,56.1,1],["line",139.6,130.0,139.6,183.3,0],["circle",139.6,130.0,3.5,2],["text",139.6,118.0,"A","c"],["line",221.2,130.0,221.2,76.7,0],["circle",221.2,130.0,3.5,2],["text",221.2,142.0,"B","c"],["line",262.0,130.0,262.0,76.7,0],["circle",262.0,130.0,3.5,2],["text",262.0,142.0,"C","c"],["line",343.6,130.0,343.6,183.3,0],["circle",343.6,130.0,3.5,2],["text",343.6,118.0,"D","c"]]}},
{"id":"math_base-140","group":"b7_speed_intervals","number":7,"topic":"Анализ графиков и диаграмм","text":"На графике показано изменение температуры воздуха в течение 12 часов. По горизонтали указано время в часах, по вертикали температура в градусах Цельсия. Пользуясь графиком, поставьте в соответствие каждому интервалу времени характеристику изменения температуры на этом интервале. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) 0:00-3:00\nБ) 3:00-6:00\nВ) 6:00-9:00\nГ) 9:00-12:00\n\n1) температура росла медленнее всего\n2) температура росла быстрее всего\n3) температура падала медленнее всего\n4) температура падала быстрее всего","answers":["4213"],"points":1,"kind":"order","explanation":"Скорость изменения температуры видна по наклону отрезка графика: чем круче, тем быстрее.","figure":{"w":420,"h":260,"items":[["line",46.0,228.0,46.0,28.0,0],["line",74.0,228.0,74.0,28.0,0],["line",102.0,228.0,102.0,28.0,0],["line",130.0,228.0,130.0,28.0,0],["text",130.0,241.0,"3","c"],["line",158.0,228.0,158.0,28.0,0],["line",186.0,228.0,186.0,28.0,0],["line",214.0,228.0,214.0,28.0,0],["text",214.0,241.0,"6","c"],["line",242.0,228.0,242.0,28.0,0],["line",270.0,228.0,270.0,28.0,0],["line",298.0,228.0,298.0,28.0,0],["text",298.0,241.0,"9","c"],["line",326.0,228.0,326.0,28.0,0],["line",354.0,228.0,354.0,28.0,0],["line",382.0,228.0,382.0,28.0,0],["text",382.0,241.0,"12","c"],["line",46.0,228.0,382.0,228.0,0],["line",46.0,218.0,382.0,218.0,0],["line",46.0,208.0,382.0,208.0,0],["text",38.0,208.0,"2","r"],["line",46.0,198.0,382.0,198.0,0],["line",46.0,188.0,382.0,188.0,0],["text",38.0,188.0,"4","r"],["line",46.0,178.0,382.0,178.0,0],["line",46.0,168.0,382.0,168.0,0],["text",38.0,168.0,"6","r"],["line",46.0,158.0,382.0,158.0,0],["line",46.0,148.0,382.0,148.0,0],["text",38.0,148.0,"8","r"],["line",46.0,138.0,382.0,138.0,0],["line",46.0,128.0,382.0,128.0,0],["text",38.0,128.0,"10","r"],["line",46.0,118.0,382.0,118.0,0],["line",46.0,108.0,382.0,108.0,0],["text",38.0,108.0,"12","r"],["line",46.0,98.0,382.0,98.0,0],["line",46.0,88.0,382.0,88.0,0],["text",38.0,88.0,"14","r"],["line",46.0,78.0,382.0,78.0,0],["line",46.0,68.0,382.0,68.0,0],["text",38.0,68.0,"16","r"],["line",46.0,58.0,382.0,58.0,0],["line",46.0,48.0,382.0,48.0,0],["text",38.0,48.0,"18","r"],["line",46.0,38.0,382.0,38.0,0],["line",46.0,28.0,382.0,28.0,0],["text",38.0,28.0,"20","r"],["line",46.0,228.0,393.2,228.0,1],["line",46.0,228.0,46.0,24.0,1],["text",38.0,241.0,"0","r"],["text",54.0,18.0,"°C","l"],["text",408.0,215.0,"ч","r"],["line",46.0,148.0,130.0,208.0,2],["line",130.0,208.0,214.0,148.0,2],["line",214.0,148.0,298.0,118.0,2],["line",298.0,118.0,382.0,148.0,2],["circle",46.0,148.0,3.5,2],["circle",130.0,208.0,3.5,2],["circle",214.0,148.0,3.5,2],["circle",298.0,118.0,3.5,2],["circle",382.0,148.0,3.5,2]]}},
{"id":"math_base-141","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 22 человек, из них 16 человек посещают кружок по физике, а 16 человек посещают кружок по химии. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Не найдётся 17 учеников из этого класса, которые посещают оба кружка.\n2) Не больше 16 учеников этого класса посещают оба кружка.\n3) Если ученик из этого класса ходит на кружок по физике, то он обязательно ходит на кружок по химии.\n4) В этом классе меньше 10 учеников посещают оба кружка.","answers":["12"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 16 + 16 - 22 = 10 и не больше 16 учеников."},
{"id":"math_base-142","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Вера выше, чем Юля; Юля выше, чем Аня; Лена ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Вера самая высокая из подруг.\n2) Аня выше, чем Вера.\n3) Юля самая низкая из подруг.\n4) Аня ниже, чем Вера.","answers":["14"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Вера, Юля, Аня, Лена."},
{"id":"math_base-143","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали на даче, а некоторые на море. Все сотрудники, которые не отдыхали на море, отдыхали на даче. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Все сотрудники этой фирмы отдыхали на море.\n2) Каждый сотрудник этой фирмы отдыхал летом либо на даче, либо на море, либо и там, и там.\n3) Если сотрудник этой фирмы не отдыхал на даче, то он отдыхал на море.\n4) Если Борис не отдыхал ни на даче, ни на море, то он не является сотрудником этой фирмы.","answers":["234"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-144","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 20 человек, из них 15 человек посещают кружок по истории, а 7 человек посещают кружок по математике. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Не найдётся 8 учеников из этого класса, которые посещают оба кружка.\n2) Если ученик из этого класса ходит на кружок по истории, то он обязательно ходит на кружок по математике.\n3) Каждый ученик этого класса посещает оба кружка.\n4) Найдутся хотя бы 2 учеников из этого класса, которые посещают оба кружка.","answers":["14"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 15 + 7 - 20 = 2 и не больше 7 учеников."},
{"id":"math_base-145","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Маша выше, чем Вера; Вера выше, чем Зина; Аня ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Среди подруг есть хотя бы две, которые выше, чем Зина.\n2) Вера ниже, чем Маша, но выше, чем Аня.\n3) Вера самая низкая из подруг.\n4) Зина ниже, чем Маша.","answers":["124"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Маша, Вера, Зина, Аня."},
{"id":"math_base-146","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в горах, а некоторые в деревне. Все сотрудники, которые не отдыхали в деревне, отдыхали в горах. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Все сотрудники этой фирмы отдыхали в деревне.\n2) Каждый сотрудник этой фирмы отдыхал летом либо в горах, либо в деревне, либо и там, и там.\n3) Если Борис не отдыхал ни в горах, ни в деревне, то он не является сотрудником этой фирмы.\n4) Если сотрудник этой фирмы не отдыхал в горах, то он отдыхал в деревне.","answers":["234"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-147","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 24 человек, из них 15 человек посещают кружок по истории, а 20 человек посещают кружок по математике. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Найдутся хотя бы 10 учеников из этого класса, которые посещают оба кружка.\n2) Не больше 15 учеников этого класса посещают оба кружка.\n3) Не найдётся 16 учеников из этого класса, которые посещают оба кружка.\n4) Каждый ученик этого класса посещает оба кружка.","answers":["123"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 15 + 20 - 24 = 11 и не больше 15 учеников."},
{"id":"math_base-148","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Юля выше, чем Зина; Зина выше, чем Лена; Аня ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Лена ниже, чем Юля.\n2) Юля самая высокая из подруг.\n3) Зина ниже, чем Юля, но выше, чем Аня.\n4) Лена выше, чем Юля.","answers":["123"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Юля, Зина, Лена, Аня."},
{"id":"math_base-149","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в горах, а некоторые в деревне. Все сотрудники, которые не отдыхали в деревне, отдыхали в горах. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Каждый сотрудник этой фирмы отдыхал летом либо в горах, либо в деревне, либо и там, и там.\n2) Если Борис не отдыхал ни в горах, ни в деревне, то он не является сотрудником этой фирмы.\n3) Если Фаина не отдыхала ни в горах, ни в деревне, то она является сотрудником этой фирмы.\n4) Если сотрудник этой фирмы не отдыхал в горах, то он отдыхал в деревне.","answers":["124"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-150","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 21 человек, из них 18 человек посещают кружок по шахматам, а 15 человек посещают кружок по рисованию. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Найдутся хотя бы 9 учеников из этого класса, которые посещают оба кружка.\n2) Не найдётся 16 учеников из этого класса, которые посещают оба кружка.\n3) В этом классе меньше 12 учеников посещают оба кружка.\n4) Не больше 15 учеников этого класса посещают оба кружка.","answers":["124"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 18 + 15 - 21 = 12 и не больше 15 учеников."},
{"id":"math_base-151","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Катя выше, чем Вера; Вера выше, чем Маша; Лена ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Лена и Маша одного роста.\n2) Маша выше, чем Катя.\n3) Вера самая низкая из подруг.\n4) Среди подруг есть хотя бы две, которые выше, чем Маша.","answers":["4"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Катя, Вера, Маша, Лена."},
{"id":"math_base-152","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали на даче, а некоторые на море. Все сотрудники, которые не отдыхали на море, отдыхали на даче. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Сотрудник этой фирмы, который не отдыхал на море, не отдыхал и на даче.\n2) Если Фаина не отдыхала ни на даче, ни на море, то она является сотрудником этой фирмы.\n3) Все сотрудники этой фирмы отдыхали на море.\n4) Каждый сотрудник этой фирмы отдыхал летом либо на даче, либо на море, либо и там, и там.","answers":["4"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-153","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 30 человек, из них 24 человек посещают кружок по физике, а 23 человек посещают кружок по химии. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Найдутся хотя бы 5 учеников из этого класса, которые посещают оба кружка.\n2) Не больше 23 учеников этого класса посещают оба кружка.\n3) Не найдётся 24 учеников из этого класса, которые посещают оба кружка.\n4) В этом классе меньше 17 учеников посещают оба кружка.","answers":["123"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 24 + 23 - 30 = 17 и не больше 23 учеников."},
{"id":"math_base-154","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Катя выше, чем Зина; Зина выше, чем Маша; Лена ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Маша выше, чем Катя.\n2) Катя самая высокая из подруг.\n3) Среди подруг есть хотя бы две, которые выше, чем Маша.\n4) Лена и Маша одного роста.","answers":["23"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Катя, Зина, Маша, Лена."},
{"id":"math_base-155","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в горах, а некоторые в деревне. Все сотрудники, которые не отдыхали в деревне, отдыхали в горах. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Сотрудник этой фирмы, который не отдыхал в деревне, не отдыхал и в горах.\n2) Все сотрудники этой фирмы отдыхали в деревне.\n3) Если Борис не отдыхал ни в горах, ни в деревне, то он не является сотрудником этой фирмы.\n4) Если сотрудник этой фирмы не отдыхал в горах, то он отдыхал в деревне.","answers":["34"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-156","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 21 человек, из них 12 человек посещают кружок по истории, а 13 человек посещают кружок по математике. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Если ученик из этого класса ходит на кружок по истории, то он обязательно ходит на кружок по математике.\n2) В этом классе меньше 4 учеников посещают оба кружка.\n3) Каждый ученик этого класса посещает оба кружка.\n4) Не больше 12 учеников этого класса посещают оба кружка.","answers":["4"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 12 + 13 - 21 = 4 и не больше 12 учеников."},
{"id":"math_base-157","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Вера выше, чем Катя; Катя выше, чем Маша; Лена ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Катя самая низкая из подруг.\n2) Среди подруг есть хотя бы две, которые выше, чем Маша.\n3) Катя ниже, чем Вера, но выше, чем Лена.\n4) Лена и Маша одного роста.","answers":["23"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Вера, Катя, Маша, Лена."},
{"id":"math_base-158","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в горах, а некоторые в деревне. Все сотрудники, которые не отдыхали в деревне, отдыхали в горах. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Если Фаина не отдыхала ни в горах, ни в деревне, то она является сотрудником этой фирмы.\n2) Каждый сотрудник этой фирмы отдыхал летом либо в горах, либо в деревне, либо и там, и там.\n3) Если Борис не отдыхал ни в горах, ни в деревне, то он не является сотрудником этой фирмы.\n4) Если сотрудник этой фирмы не отдыхал в горах, то он отдыхал в деревне.","answers":["234"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-159","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 24 человек, из них 19 человек посещают кружок по шахматам, а 9 человек посещают кружок по рисованию. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Каждый ученик этого класса посещает оба кружка.\n2) Найдутся хотя бы 3 учеников из этого класса, которые посещают оба кружка.\n3) Если ученик из этого класса ходит на кружок по шахматам, то он обязательно ходит на кружок по рисованию.\n4) Не найдётся 10 учеников из этого класса, которые посещают оба кружка.","answers":["24"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 19 + 9 - 24 = 4 и не больше 9 учеников."},
{"id":"math_base-160","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Лена выше, чем Маша; Маша выше, чем Аня; Юля ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Маша самая низкая из подруг.\n2) Аня выше, чем Лена.\n3) Юля и Аня одного роста.\n4) Маша ниже, чем Лена, но выше, чем Юля.","answers":["4"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Лена, Маша, Аня, Юля."},
{"id":"math_base-161","group":"b9_triangle","number":9,"topic":"Задачи на квадратной решётке","text":"На клетчатой бумаге с размером клетки 1 × 1 изображён треугольник. Найдите его площадь.","answers":["20"],"points":1,"kind":"number","explanation":"Площадь можно найти как площадь описанного прямоугольника минус площади лишних прямоугольных треугольников. Получается 20.","figure":{"w":420,"h":260,"items":[["line",30.0,235.0,30.0,25.0,0],["line",60.0,235.0,60.0,25.0,0],["line",90.0,235.0,90.0,25.0,0],["line",120.0,235.0,120.0,25.0,0],["line",150.0,235.0,150.0,25.0,0],["line",180.0,235.0,180.0,25.0,0],["line",210.0,235.0,210.0,25.0,0],["line",240.0,235.0,240.0,25.0,0],["line",270.0,235.0,270.0,25.0,0],["line",300.0,235.0,300.0,25.0,0],["line",330.0,235.0,330.0,25.0,0],["line",360.0,235.0,360.0,25.0,0],["line",390.0,235.0,390.0,25.0,0],["line",30.0,235.0,390.0,235.0,0],["line",30.0,205.0,390.0,205.0,0],["line",30.0,175.0,390.0,175.0,0],["line",30.0,145.0,390.0,145.0,0],["line",30.0,115.0,390.0,115.0,0],["line",30.0,85.0,390.0,85.0,0],["line",30.0,55.0,390.0,55.0,0],["line",30.0,25.0,390.0,25.0,0],["line",60.0,205.0,330.0,55.0,2],["line",330.0,55.0,90.0,55.0,2],["line",90.0,55.0,60.0,205.0,2]]}},
{"id":"math_base-162","group":"b9_trapezoid","number":9,"topic":"Задачи на квадратной решётке","text":"На клетчатой бумаге с размером клетки 1 × 1 изображена трапеция. Найдите её площадь.","answers":["15"],"points":1,"kind":"number","explanation":"Основания равны 3 и 2, высота 6. Площадь равна (3 + 2) : 2 · 6 = 15.","figure":{"w":420,"h":260,"items":[["line",30.0,235.0,30.0,25.0,0],["line",60.0,235.0,60.0,25.0,0],["line",90.0,235.0,90.0,25.0,0],["line",120.0,235.0,120.0,25.0,0],["line",150.0,235.0,150.0,25.0,0],["line",180.0,235.0,180.0,25.0,0],["line",210.0,235.0,210.0,25.0,0],["line",240.0,235.0,240.0,25.0,0],["line",270.0,235.0,270.0,25.0,0],["line",300.0,235.0,300.0,25.0,0],["line",330.0,235.0,330.0,25.0,0],["line",360.0,235.0,360.0,25.0,0],["line",390.0,235.0,390.0,25.0,0],["line",30.0,235.0,390.0,235.0,0],["line",30.0,205.0,390.0,205.0,0],["line",30.0,175.0,390.0,175.0,0],["line",30.0,145.0,390.0,145.0,0],["line",30.0,115.0,390.0,115.0,0],["line",30.0,85.0,390.0,85.0,0],["line",30.0,55.0,390.0,55.0,0],["line",30.0,25.0,390.0,25.0,0],["line",180.0,235.0,270.0,235.0,2],["line",270.0,235.0,180.0,55.0,2],["line",180.0,55.0,120.0,55.0,2],["line",120.0,55.0,180.0,235.0,2]]}},
