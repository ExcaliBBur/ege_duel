{"id":"informatics-001","group":"m_graph_table","number":1,"topic":"Анализ информационных моделей","text":"На рисунке справа схема дорог района изображена в виде графа, в таблице слева содержатся сведения о длинах этих дорог (в километрах). Таблицу и схему рисовали независимо друг от друга, поэтому нумерация населённых пунктов в таблице никак не связана с буквенными обозначениями на графе. Определите длину дороги из пункта А в пункт Е. В ответе запишите целое число.","answers":["28"],"points":1,"kind":"number","explanation":"Пункты сопоставляются по числу дорог, выходящих из них. Пункт А это П3, пункт Е это П6; длина дороги между ними 28 км.","figure":{"w":450,"h":240,"items":[["line",8.0,8.0,225.0,8.0,1],["line",8.0,8.0,8.0,225.0,1],["line",8.0,39.0,225.0,39.0,1],["line",39.0,8.0,39.0,225.0,1],["line",8.0,70.0,225.0,70.0,0],["line",70.0,8.0,70.0,225.0,0],["line",8.0,101.0,225.0,101.0,0],["line",101.0,8.0,101.0,225.0,0],["line",8.0,132.0,225.0,132.0,0],["line",132.0,8.0,132.0,225.0,0],["line",8.0,163.0,225.0,163.0,0],["line",163.0,8.0,163.0,225.0,0],["line",8.0,194.0,225.0,194.0,0],["line",194.0,8.0,194.0,225.0,0],["line",8.0,225.0,225.0,225.0,1],["line",225.0,8.0,225.0,225.0,1],["text",54.5,23.5,"П1","c"],["text",23.5,54.5,"П1","c"],["text",85.5,23.5,"П2","c"],["text",23.5,85.5,"П2","c"],["text",116.5,23.5,"П3","c"],["text",23.5,116.5,"П3","c"],["text",147.5,23.5,"П4","c"],["text",23.5,147.5,"П4","c"],["text",178.5,23.5,"П5","c"],["text",23.5,178.5,"П5","c"],["text",209.5,23.5,"П6","c"],["text",23.5,209.5,"П6","c"],["text",54.5,116.5,"42","c"],["text",116.5,54.5,"42","c"],["text",147.5,116.5,"43","c"],["text",116.5,147.5,"43","c"],["text",209.5,116.5,"28","c"],["text",116.5,209.5,"28","c"],["text",54.5,178.5,"13","c"],["text",178.5,54.5,"13","c"],["text",147.5,178.5,"44","c"],["text",178.5,147.5,"44","c"],["text",54.5,85.5,"34","c"],["text",85.5,54.5,"34","c"],["text",147.5,85.5,"24","c"],["text",85.5,147.5,"24","c"],["line",345.0,36.0,345.0,200.0,1],["line",345.0,36.0,274.0,159.0,1],["line",345.0,36.0,274.0,77.0,1],["line",416.0,77.0,345.0,200.0,1],["line",416.0,77.0,274.0,159.0,1],["line",416.0,159.0,345.0,200.0,1],["line",416.0,159.0,274.0,159.0,1],["circle",345.0,36.0,5.0,2],["text",345.0,19.0,"А","c"],["circle",416.0,77.0,5.0,2],["text",430.7,68.5,"Б","c"],["circle",416.0,159.0,5.0,2],["text",430.7,167.5,"В","c"],["circle",345.0,200.0,5.0,2],["text",345.0,217.0,"Г","c"],["circle",274.0,159.0,5.0,2],["text",259.3,167.5,"Д","c"],["circle",274.0,77.0,5.0,2],["text",259.3,68.5,"Е","c"]]}},
{"id":"informatics-002","group":"fig_roads","number":1,"topic":"Анализ информационных моделей","text":"На рисунке показана схема дорог между пунктами А, Б, В, Г, Д, Е. Числа обозначают длины дорог в километрах. Найдите длину кратчайшего пути из пункта А в пункт Е.","answers":["11"],"points":1,"kind":"number","explanation":"Перебираем маршруты из А в Е и выбираем самый короткий: 11 км.","figure":{"w":420,"h":260,"items":[["line",40.0,130.0,150.0,45.0,1],["text",86.4,110.5,"2","c"],["line",40.0,130.0,150.0,215.0,1],["text",70.6,170.0,"5","c"],["line",150.0,45.0,280.0,45.0,1],["text",195.5,58.0,"6","c"],["line",150.0,215.0,280.0,215.0,1],["text",195.5,228.0,"4","c"],["line",280.0,45.0,385.0,130.0,1],["text",308.6,84.9,"3","c"],["line",280.0,215.0,385.0,130.0,1],["text",324.9,195.4,"9","c"],["line",150.0,45.0,150.0,215.0,1],["text",137.0,104.5,"5","c"],["line",150.0,45.0,280.0,215.0,1],["text",185.2,112.4,"3","c"],["circle",40.0,130.0,15.0,1],["text",40.0,130.0,"А","c"],["circle",150.0,45.0,15.0,1],["text",150.0,45.0,"Б","c"],["circle",150.0,215.0,15.0,1],["text",150.0,215.0,"В","c"],["circle",280.0,45.0,15.0,1],["text",280.0,45.0,"Г","c"],["circle",280.0,215.0,15.0,1],["text",280.0,215.0,"Д","c"],["circle",385.0,130.0,15.0,1],["text",385.0,130.0,"Е","c"]]}},
{"id":"informatics-003","group":"m_graph_table","number":1,"topic":"Анализ информационных моделей","text":"На рисунке справа схема дорог района изображена в виде графа, в таблице слева содержатся сведения о длинах этих дорог (в километрах). Таблицу и схему рисовали независимо друг от друга, поэтому нумерация населённых пунктов в таблице никак не связана с буквенными обозначениями на графе. Определите длину дороги из пункта Б в пункт Е. В ответе запишите целое число.","answers":["10"],"points":1,"kind":"number","explanation":"Пункты сопоставляются по числу дорог, выходящих из них. Пункт Б это П5, пункт Е это П3; длина дороги между ними 10 км.","figure":{"w":450,"h":240,"items":[["line",8.0,8.0,225.0,8.0,1],["line",8.0,8.0,8.0,225.0,1],["line",8.0,39.0,225.0,39.0,1],["line",39.0,8.0,39.0,225.0,1],["line",8.0,70.0,225.0,70.0,0],["line",70.0,8.0,70.0,225.0,0],["line",8.0,101.0,225.0,101.0,0],["line",101.0,8.0,101.0,225.0,0],["line",8.0,132.0,225.0,132.0,0],["line",132.0,8.0,132.0,225.0,0],["line",8.0,163.0,225.0,163.0,0],["line",163.0,8.0,163.0,225.0,0],["line",8.0,194.0,225.0,194.0,0],["line",194.0,8.0,194.0,225.0,0],["line",8.0,225.0,225.0,225.0,1],["line",225.0,8.0,225.0,225.0,1],["text",54.5,23.5,"П1","c"],["text",23.5,54.5,"П1","c"],["text",85.5,23.5,"П2","c"],["text",23.5,85.5,"П2","c"],["text",116.5,23.5,"П3","c"],["text",23.5,116.5,"П3","c"],["text",147.5,23.5,"П4","c"],["text",23.5,147.5,"П4","c"],["text",178.5,23.5,"П5","c"],["text",23.5,178.5,"П5","c"],["text",209.5,23.5,"П6","c"],["text",23.5,209.5,"П6","c"],["text",178.5,209.5,"58","c"],["text",209.5,178.5,"58","c"],["text",147.5,209.5,"33","c"],["text",209.5,147.5,"33","c"],["text",54.5,209.5,"26","c"],["text",209.5,54.5,"26","c"],["text",54.5,178.5,"13","c"],["text",178.5,54.5,"13","c"],["text",85.5,178.5,"59","c"],["text",178.5,85.5,"59","c"],["text",116.5,178.5,"10","c"],["text",178.5,116.5,"10","c"],["text",85.5,147.5,"18","c"],["text",147.5,85.5,"18","c"],["text",85.5,54.5,"41","c"],["text",54.5,85.5,