        <Item class="StringValue" referent="55">
          <Properties>
            <string name="Name">01</string>
            <string name="Value">{"subject": "physics", "tasks": [
{"id":"physics-001","group":"k_law","number":1,"topic":"Кинематика","text":"Координата тела, движущегося вдоль оси Ox, меняется по закону x(t) = 18 - 10t + 3t², где все величины выражены в единицах СИ. Чему равна проекция скорости тела на ось Ox в момент времени t = 2 с? Ответ дайте в м/с.","answers":["2"],"points":1,"kind":"number","explanation":"v = v₀ + a · t, где v₀ = -10 м/с, a = 6 м/с²; при t = 2 с получаем 2 м/с."},
{"id":"physics-002","group":"k_circular","number":1,"topic":"Кинематика","text":"Материальная точка равномерно движется по окружности радиусом 25 м со скоростью 6 м/с. Чему равно центростремительное ускорение точки? Ответ дайте в м/с².","answers":["1,44"],"points":1,"kind":"number","explanation":"a = v² : R = 36 : 25 = 1,44 м/с²."},
{"id":"physics-003","group":"k_relative","number":1,"topic":"Кинематика","text":"Два автомобиля движутся по прямому шоссе в одном направлении: первый со скоростью 75 км/ч, второй со скоростью 45 км/ч. Чему равен модуль скорости первого автомобиля в системе отсчёта, связанной со вторым автомобилем? Ответ дайте в км/ч.","answers":["30"],"points":1,"kind":"number","explanation":"При движении в одну сторону скорости вычитаются: |75 - 45| = 30 км/ч."},
{"id":"physics-004","group":"k_average","number":1,"topic":"Кинематика","text":"Первую половину времени движения автомобиль ехал со скоростью 45 км/ч, а вторую половину времени со скоростью 90 км/ч. Найдите среднюю скорость автомобиля за всё время движения. Ответ дайте в км/ч.","answers":["67,5"],"points":1,"kind":"number","explanation":"При равных промежутках времени vср = (v₁ + v₂) : 2 = 67,5 км/ч."},
{"id":"physics-005","group":"k_throw","number":1,"topic":"Кинематика","text":"Тело свободно падает без начальной скорости с высоты 3,2 м. Чему равна скорость тела в момент падения на землю? Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"v = √(2gh) = √(20 · 3,2) = 8 м/с."},
{"id":"physics-006","group":"fig_velocity_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости скорости тела от времени. Найдите модуль ускорения тела в интервале от 0 до 4 с. Ответ дайте в м/с².","answers":["2"],"points":1,"kind":"number","explanation":"a = Δv : Δt = 8 : 4 = 2 м/с².","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["text",50.0,238.0,"0","c"],["line",92.0,225.0,92.0,25.0,0],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"2","r"],["line",50.0,165.0,386.0,165.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"4","r"],["line",50.0,125.0,386.0,125.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"6","r"],["line",50.0,85.0,386.0,85.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"8","r"],["line",50.0,45.0,386.0,45.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"10","r"],["line",50.0,225.0,398.6,225.0,1],["line",50.0,225.0,50.0,15.0,1],["text",80.0,12.0,"v, м/с","c"],["text",402.0,238.0,"t, с","l"],["line",50.0,185.0,218.0,25.0,2],["line",218.0,25.0,302.0,145.0,2],["line",302.0,145.0,386.0,185.0,2]]}},
{"id":"physics-007","group":"fig_xt_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости координаты тела от времени. Найдите модуль скорости тела в интервале от 0 до 5 с. Ответ дайте в м/с.","answers":["1,6"],"points":1,"kind":"number","explanation":"v = Δx : Δt = 8 : 5 = 1,6 м/с.","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["line",92.0,225.0,92.0,25.0,0],["text",92.0,238.0,"1","c"],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["text",176.0,238.0,"3","c"],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["text",260.0,238.0,"5","c"],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["text",344.0,238.0,"7","c"],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,215.0,386.0,215.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,195.0,386.0,195.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"4","r"],["line",50.0,175.0,386.0,175.0,0],["line",50.0,165.0,386.0,165.0,0],["line",50.0,155.0,386.0,155.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"8","r"],["line",50.0,135.0,386.0,135.0,0],["line",50.0,125.0,386.0,125.0,0],["line",50.0,115.0,386.0,115.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"12","r"],["line",50.0,95.0,386.0,95.0,0],["line",50.0,85.0,386.0,85.0,0],["line",50.0,75.0,386.0,75.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"16","r"],["line",50.0,55.0,386.0,55.0,0],["line",50.0,45.0,386.0,45.0,0],["line",50.0,35.0,386.0,35.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"20","r"],["line",50.0,225.0,402.8,225.0,1],["line",50.0,225.0,50.0,21.0,1],["text",42.0,238.0,"0","r"],["text",58.0,15.0,"x, м","l"],["text",412.0,212.0,"t, с","r"],["line",50.0,145.0,260.0,65.0,2],["line",260.0,65.0,386.0,185.0,2]]}},
{"id":"physics-008","group":"k_law","number":1,"topic":"Кинематика","text":"Координата тела, движущегося вдоль оси Ox, меняется по закону x(t) = 11 + 9t + t², где все величины выражены в единицах СИ. Чему равна проекция скорости тела на ось Ox в момент времени t = 6 с? Ответ дайте в м/с.","answers":["21"],"points":1,"kind":"number","explanation":"v = v₀ + a · t, где v₀ = 9 м/с, a = 2 м/с²; при t = 6 с получаем 21 м/с."},
{"id":"physics-009","group":"k_circular","number":1,"topic":"Кинематика","text":"Материальная точка равномерно движется по окружности радиусом 2 м со скоростью 4 м/с. Чему равно центростремительное ускорение точки? Ответ дайте в м/с².","answers":["8"],"points":1,"kind":"number","explanation":"a = v² : R = 16 : 2 = 8 м/с²."},
{"id":"physics-010","group":"k_relative","number":1,"topic":"Кинематика","text":"Два автомобиля движутся по прямому шоссе навстречу друг другу: первый со скоростью 45 км/ч, второй со скоростью 70 км/ч. Чему равен модуль скорости первого автомобиля в системе отсчёта, связанной со вторым автомобилем? Ответ дайте в км/ч.","answers":["115"],"points":1,"kind":"number","explanation":"При встречном движении скорости складываются: 45 + 70 = 115 км/ч."},
{"id":"physics-011","group":"k_average","number":1,"topic":"Кинематика","text":"Первую половину времени движения автомобиль ехал со скоростью 60 км/ч, а вторую половину времени со скоростью 40 км/ч. Найдите среднюю скорость автомобиля за всё время движения. Ответ дайте в км/ч.","answers":["50"],"points":1,"kind":"number","explanation":"При равных промежутках времени vср = (v₁ + v₂) : 2 = 50 км/ч."},
{"id":"physics-012","group":"k_throw","number":1,"topic":"Кинематика","text":"Тело брошено вертикально вверх с начальной скоростью 40 м/с. На какую максимальную высоту оно поднимется? Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в метрах.","answers":["80"],"points":1,"kind":"number","explanation":"h = v₀² : (2g) = 1600 : 20 = 80 м."},
{"id":"physics-013","group":"fig_velocity_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости скорости тела от времени. Найдите модуль ускорения тела в интервале от 0 до 2 с. Ответ дайте в м/с².","answers":["2"],"points":1,"kind":"number","explanation":"a = Δv : Δt = 4 : 2 = 2 м/с².","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["text",50.0,238.0,"0","c"],["line",92.0,225.0,92.0,25.0,0],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"2","r"],["line",50.0,165.0,386.0,165.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"4","r"],["line",50.0,125.0,386.0,125.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"6","r"],["line",50.0,85.0,386.0,85.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"8","r"],["line",50.0,45.0,386.0,45.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"10","r"],["line",50.0,225.0,398.6,225.0,1],["line",50.0,225.0,50.0,15.0,1],["text",80.0,12.0,"v, м/с","c"],["text",402.0,238.0,"t, с","l"],["line",50.0,25.0,134.0,105.0,2],["line",134.0,105.0,218.0,185.0,2],["line",218.0,185.0,386.0,185.0,2]]}},
{"id":"physics-014","group":"fig_xt_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости координаты тела от времени. Найдите модуль скорости тела в интервале от 0 до 2 с. Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"v = Δx : Δt = 16 : 2 = 8 м/с.","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["line",92.0,225.0,92.0,25.0,0],["text",92.0,238.0,"1","c"],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["text",176.0,238.0,"3","c"],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["text",260.0,238.0,"5","c"],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["text",344.0,238.0,"7","c"],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,215.0,386.0,215.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,195.0,386.0,195.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"4","r"],["line",50.0,175.0,386.0,175.0,0],["line",50.0,165.0,386.0,165.0,0],["line",50.0,155.0,386.0,155.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"8","r"],["line",50.0,135.0,386.0,135.0,0],["line",50.0,125.0,386.0,125.0,0],["line",50.0,115.0,386.0,115.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"12","r"],["line",50.0,95.0,386.0,95.0,0],["line",50.0,85.0,386.0,85.0,0],["line",50.0,75.0,386.0,75.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"16","r"],["line",50.0,55.0,386.0,55.0,0],["line",50.0,45.0,386.0,45.0,0],["line",50.0,35.0,386.0,35.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"20","r"],["line",50.0,225.0,402.8,225.0,1],["line",50.0,225.0,50.0,21.0,1],["text",42.0,238.0,"0","r"],["text",58.0,15.0,"x, м","l"],["text",412.0,212.0,"t, с","r"],["line",50.0,185.0,134.0,25.0,2],["line",134.0,25.0,386.0,145.0,2]]}},
{"id":"physics-015","group":"k_law","number":1,"topic":"Кинематика","text":"Координата тела, движущегося вдоль оси Ox, меняется по закону x(t) = -15 + 12t + 2t², где все величины выражены в единицах СИ. Чему равна проекция скорости тела на ось Ox в момент времени t = 5 с? Ответ дайте в м/с.","answers":["32"],"points":1,"kind":"number","explanation":"v = v₀ + a · t, где v₀ = 12 м/с, a = 4 м/с²; при t = 5 с получаем 32 м/с."},
{"id":"physics-016","group":"k_circular","number":1,"topic":"Кинематика","text":"Материальная точка равномерно движется по окружности радиусом 2,5 м со скоростью 10 м/с. Чему равно центростремительное ускорение точки? Ответ дайте в м/с².","answers":["40"],"points":1,"kind":"number","explanation":"a = v² : R = 100 : 2,5 = 40 м/с²."},
{"id":"physics-017","group":"k_relative","number":1,"topic":"Кинематика","text":"Два автомобиля движутся по прямому шоссе навстречу друг другу: первый со скоростью 95 км/ч, второй со скоростью 70 км/ч. Чему равен модуль скорости первого автомобиля в системе отсчёта, связанной со вторым автомобилем? Ответ дайте в км/ч.","answers":["165"],"points":1,"kind":"number","explanation":"При встречном движении скорости складываются: 95 + 70 = 165 км/ч."},
{"id":"physics-018","group":"k_average","number":1,"topic":"Кинематика","text":"Первую половину времени движения автомобиль ехал со скоростью 120 км/ч, а вторую половину времени со скоростью 40 км/ч. Найдите среднюю скорость автомобиля за всё время движения. Ответ дайте в км/ч.","answers":["80"],"points":1,"kind":"number","explanation":"При равных промежутках времени vср = (v₁ + v₂) : 2 = 80 км/ч."},
{"id":"physics-019","group":"k_throw","number":1,"topic":"Кинематика","text":"Тело брошено вертикально вверх с начальной скоростью 6 м/с. Через какое время после броска оно достигнет высшей точки траектории? Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в секундах.","answers":["0,6"],"points":1,"kind":"number","explanation":"t = v₀ : g = 6 : 10 = 0,6 с."},
{"id":"physics-020","group":"fig_velocity_graph","number":1,"topic":"Кинематика","text":"На рисунке показан график зависимости скорости тела от времени. Найдите модуль ускорения тела в интервале от 0 до 2 с. Ответ дайте в м/с².","answers":["1"],"points":1,"kind":"number","explanation":"a = Δv : Δt = 2 : 2 = 1 м/с².","figure":{"w":420,"h":260,"items":[["line",50.0,225.0,50.0,25.0,0],["text",50.0,238.0,"0","c"],["line",92.0,225.0,92.0,25.0,0],["line",134.0,225.0,134.0,25.0,0],["text",134.0,238.0,"2","c"],["line",176.0,225.0,176.0,25.0,0],["line",218.0,225.0,218.0,25.0,0],["text",218.0,238.0,"4","c"],["line",260.0,225.0,260.0,25.0,0],["line",302.0,225.0,302.0,25.0,0],["text",302.0,238.0,"6","c"],["line",344.0,225.0,344.0,25.0,0],["line",386.0,225.0,386.0,25.0,0],["text",386.0,238.0,"8","c"],["line",50.0,225.0,386.0,225.0,0],["line",50.0,205.0,386.0,205.0,0],["line",50.0,185.0,386.0,185.0,0],["text",42.0,185.0,"2","r"],["line",50.0,165.0,386.0,165.0,0],["line",50.0,145.0,386.0,145.0,0],["text",42.0,145.0,"4","r"],["line",50.0,125.0,386.0,125.0,0],["line",50.0,105.0,386.0,105.0,0],["text",42.0,105.0,"6","r"],["line",50.0,85.0,386.0,85.0,0],["line",50.0,65.0,386.0,65.0,0],["text",42.0,65.0,"8","r"],["line",50.0,45.0,386.0,45.0,0],["line",50.0,25.0,386.0,25.0,0],["text",42.0,25.0,"10","r"],["line",50.0,225.0,398.6,225.0,1],["line",50.0,225.0,50.0,15.0,1],["text",80.0,12.0,"v, м/с","c"],["text",402.0,238.0,"t, с","l"],["line",50.0,105.0,134.0,65.0,2],["line",134.0,65.0,218.0,225.0,2],["line",218.0,225.0,386.0,25.0,2]]}},
{"id":"physics-021","group":"d_resultant","number":2,"topic":"Динамика","text":"На тело массой 5 кг действуют две силы, направленные перпендикулярно друг другу: 21 Н и 28 Н. С каким ускорением движется тело? Ответ дайте в м/с².","answers":["7"],"points":1,"kind":"number","explanation":"Равнодействующая равна √(21² + 28²) = 35 Н, a = F : m = 7 м/с²."},
{"id":"physics-022","group":"d_friction","number":2,"topic":"Динамика","text":"Брусок массой 8 кг скользит по горизонтальной поверхности. Коэффициент трения между бруском и поверхностью равен 0,2. Чему равна сила трения скольжения, действующая на брусок? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["16"],"points":1,"kind":"number","explanation":"Fтр = μ · m · g = 0,2 · 8 · 10 = 16 Н."},
{"id":"physics-023","group":"d_spring","number":2,"topic":"Динамика","text":"Жёсткость пружины равна 500 Н/м. Какая сила упругости возникает в пружине при её растяжении на 1 см? Ответ дайте в ньютонах.","answers":["5"],"points":1,"kind":"number","explanation":"F = k · x = 500 · 0,01 = 5 Н."},
{"id":"physics-024","group":"d_gravity","number":2,"topic":"Динамика","text":"Два однородных шара притягиваются друг к другу с силой 32 мкН. Какой станет сила притяжения, если расстояние между их центрами увеличить в 4 раза, а массу одного из шаров увеличить в 3 раза? Ответ дайте в мкН.","answers":["6"],"points":1,"kind":"number","explanation":"Сила пропорциональна массам и обратно пропорциональна квадрату расстояния: 32 · 3 : 16 = 6 мкН."},
{"id":"physics-025","group":"d_elevator","number":2,"topic":"Динамика","text":"Человек массой 50 кг стоит в лифте, который движется с ускорением 3 м/с², направленным вниз. Чему равен вес человека? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["350"],"points":1,"kind":"number","explanation":"P = m · (g - a) = 50 · 7 = 350 Н."},
{"id":"physics-026","group":"d_second_law","number":2,"topic":"Динамика","text":"Под действием силы 16 Н тело движется с ускорением 2 м/с². С каким ускорением будет двигаться это тело под действием силы 24 Н? Ответ дайте в м/с².","answers":["3"],"points":1,"kind":"number","explanation":"Масса тела равна 16 : 2 = 8 кг, a = 24 : 8 = 3 м/с²."},
{"id":"physics-027","group":"fig_forces","number":2,"topic":"Динамика","text":"На рисунке показаны горизонтальные силы, действующие на тело на гладкой поверхности, масса тела подписана. Найдите модуль ускорения тела. Ответ дайте в м/с².","answers":["6"],"points":1,"kind":"number","explanation":"Равнодействующая равна 6 Н, a = F : m = 6 : 1 = 6 м/с².","figure":{"w":420,"h":260,"items":[["line",30.0,190.0,390.0,190.0,1],["line",170.0,130.0,250.0,130.0,2],["line",250.0,130.0,250.0,190.0,2],["line",250.0,190.0,170.0,190.0,2],["line",170.0,190.0,170.0,130.0,2],["text",210.0,160.0,"1 кг","c"],["line",170.0,160.0,60.0,160.0,1],["line",60.0,160.0,69.4,154.3,1],["line",60.0,160.0,69.4,165.7,1],["line",250.0,160.0,360.0,160.0,1],["line",360.0,160.0,350.6,165.7,1],["line",360.0,160.0,350.6,154.3,1],["text",110.0,140.0,"F₁ = 18 Н","c"],["text",310.0,140.0,"F₂ = 12 Н","c"]]}},
{"id":"physics-028","group":"d_resultant","number":2,"topic":"Динамика","text":"На тело массой 20 кг действуют две силы, направленные перпендикулярно друг другу: 3 Н и 4 Н. С каким ускорением движется тело? Ответ дайте в м/с².","answers":["0,25"],"points":1,"kind":"number","explanation":"Равнодействующая равна √(3² + 4²) = 5 Н, a = F : m = 0,25 м/с²."},
{"id":"physics-029","group":"d_friction","number":2,"topic":"Динамика","text":"Брусок массой 5 кг скользит по горизонтальной поверхности. Коэффициент трения между бруском и поверхностью равен 0,2. Чему равна сила трения скольжения, действующая на брусок? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["10"],"points":1,"kind":"number","explanation":"Fтр = μ · m · g = 0,2 · 5 · 10 = 10 Н."},
{"id":"physics-030","group":"d_spring","number":2,"topic":"Динамика","text":"Под действием силы 4 Н пружина удлинилась на 2 см. Чему равна жёсткость пружины? Ответ дайте в Н/м.","answers":["200"],"points":1,"kind":"number","explanation":"k = F : x = 4 : 0,02 = 200 Н/м."},
{"id":"physics-031","group":"d_gravity","number":2,"topic":"Динамика","text":"Два однородных шара притягиваются друг к другу с силой 112 мкН. Какой станет сила притяжения, если расстояние между их центрами увеличить в 4 раза, а массу одного из шаров увеличить в 4 раза? Ответ дайте в мкН.","answers":["28"],"points":1,"kind":"number","explanation":"Сила пропорциональна массам и обратно пропорциональна квадрату расстояния: 112 · 4 : 16 = 28 мкН."},
{"id":"physics-032","group":"d_elevator","number":2,"topic":"Динамика","text":"Человек массой 50 кг стоит в лифте, который движется с ускорением 4 м/с², направленным вверх. Чему равен вес человека? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["700"],"points":1,"kind":"number","explanation":"P = m · (g + a) = 50 · 14 = 700 Н."},
{"id":"physics-033","group":"d_second_law","number":2,"topic":"Динамика","text":"Под действием силы 5 Н тело движется с ускорением 1 м/с². С каким ускорением будет двигаться это тело под действием силы 25 Н? Ответ дайте в м/с².","answers":["5"],"points":1,"kind":"number","explanation":"Масса тела равна 5 : 1 = 5 кг, a = 25 : 5 = 5 м/с²."},
{"id":"physics-034","group":"fig_forces","number":2,"topic":"Динамика","text":"На рисунке показаны горизонтальные силы, действующие на тело на гладкой поверхности. Найдите модуль равнодействующей этих сил. Ответ дайте в ньютонах.","answers":["16"],"points":1,"kind":"number","explanation":"Силы направлены в противоположные стороны: 25 - 9 = 16 Н.","figure":{"w":420,"h":260,"items":[["line",30.0,190.0,390.0,190.0,1],["line",170.0,130.0,250.0,130.0,2],["line",250.0,130.0,250.0,190.0,2],["line",250.0,190.0,170.0,190.0,2],["line",170.0,190.0,170.0,130.0,2],["text",210.0,160.0,"1 кг","c"],["line",170.0,160.0,60.0,160.0,1],["line",60.0,160.0,69.4,154.3,1],["line",60.0,160.0,69.4,165.7,1],["line",250.0,160.0,360.0,160.0,1],["line",360.0,160.0,350.6,165.7,1],["line",360.0,160.0,350.6,154.3,1],["text",110.0,140.0,"F₁ = 9 Н","c"],["text",310.0,140.0,"F₂ = 25 Н","c"]]}},
{"id":"physics-035","group":"d_resultant","number":2,"topic":"Динамика","text":"На тело массой 25 кг действуют две силы, направленные перпендикулярно друг другу: 3 Н и 4 Н. С каким ускорением движется тело? Ответ дайте в м/с².","answers":["0,2"],"points":1,"kind":"number","explanation":"Равнодействующая равна √(3² + 4²) = 5 Н, a = F : m = 0,2 м/с²."},
{"id":"physics-036","group":"d_friction","number":2,"topic":"Динамика","text":"Брусок массой 5 кг скользит по горизонтальной поверхности. Коэффициент трения между бруском и поверхностью равен 0,1. Чему равна сила трения скольжения, действующая на брусок? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["5"],"points":1,"kind":"number","explanation":"Fтр = μ · m · g = 0,1 · 5 · 10 = 5 Н."},
{"id":"physics-037","group":"d_spring","number":2,"topic":"Динамика","text":"Под действием силы 2 Н пружина удлинилась на 2 см. Чему равна жёсткость пружины? Ответ дайте в Н/м.","answers":["100"],"points":1,"kind":"number","explanation":"k = F : x = 2 : 0,02 = 100 Н/м."},
{"id":"physics-038","group":"d_gravity","number":2,"topic":"Динамика","text":"Два однородных шара притягиваются друг к другу с силой 80 мкН. Какой станет сила притяжения, если расстояние между их центрами увеличить в 4 раза, а массу одного из шаров увеличить в 4 раза? Ответ дайте в мкН.","answers":["20"],"points":1,"kind":"number","explanation":"Сила пропорциональна массам и обратно пропорциональна квадрату расстояния: 80 · 4 : 16 = 20 мкН."},
{"id":"physics-039","group":"d_elevator","number":2,"topic":"Динамика","text":"Человек массой 40 кг стоит в лифте, который движется с ускорением 1 м/с², направленным вниз. Чему равен вес человека? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ньютонах.","answers":["360"],"points":1,"kind":"number","explanation":"P = m · (g - a) = 40 · 9 = 360 Н."},
{"id":"physics-040","group":"d_second_law","number":2,"topic":"Динамика","text":"Под действием силы 30 Н тело движется с ускорением 3 м/с². С каким ускорением будет двигаться это тело под действием силы 20 Н? Ответ дайте в м/с².","answers":["2"],"points":1,"kind":"number","explanation":"Масса тела равна 30 : 3 = 10 кг, a = 20 : 10 = 2 м/с²."},
{"id":"physics-041","group":"z_inelastic","number":3,"topic":"Законы сохранения в механике","text":"Тележка массой 4 кг, движущаяся со скоростью 10 м/с, сталкивается с неподвижной тележкой массой 1 кг и сцепляется с ней. С какой скоростью будут двигаться тележки после сцепки? Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"По закону сохранения импульса 4 · 10 = (4 + 1) · u, откуда u = 8 м/с."},
{"id":"physics-042","group":"z_rebound","number":3,"topic":"Законы сохранения в механике","text":"Мяч массой 400 г, летящий со скоростью 12 м/с перпендикулярно стене, упруго отскакивает от неё с такой же по модулю скоростью. Чему равен модуль изменения импульса мяча? Ответ дайте в кг·м/с.","answers":["9,6"],"points":1,"kind":"number","explanation":"Импульс меняет направление на противоположное: Δp = 2 · m · v = 2 · 0,4 · 12 = 9,6 кг·м/с."},
{"id":"physics-043","group":"z_energy_height","number":3,"topic":"Законы сохранения в механике","text":"Камень брошен вертикально вверх с начальной скоростью 12 м/с. На какой высоте кинетическая энергия камня будет равна его потенциальной энергии? Потенциальную энергию отсчитывайте от уровня броска. Ускорение свободного падения считайте равным 10 м/с². Сопротивлением воздуха пренебрегите. Ответ дайте в метрах.","answers":["3,6"],"points":1,"kind":"number","explanation":"m · v₀² : 2 = 2 · m · g · h, откуда h = v₀² : (4g) = 144 : 40 = 3,6 м."},
{"id":"physics-044","group":"z_power","number":3,"topic":"Законы сохранения в механике","text":"Автомобиль движется равномерно со скоростью 20 м/с, сила тяги двигателя равна 2 кН. Какую мощность развивает двигатель? Ответ дайте в кВт.","answers":["40"],"points":1,"kind":"number","explanation":"N = F · v = 2 кН · 20 м/с = 40 кВт."},
{"id":"physics-045","group":"z_kinetic_change","number":3,"topic":"Законы сохранения в механике","text":"Кинетическая энергия тела равна 48 Дж. Чему станет равна кинетическая энергия тела, если его скорость уменьшить в 4 раза? Ответ дайте в джоулях.","answers":["3"],"points":1,"kind":"number","explanation":"Энергия пропорциональна квадрату скорости: 48 : 16 = 3 Дж."},
{"id":"physics-046","group":"z_spring_energy","number":3,"topic":"Законы сохранения в механике","text":"Пружину жёсткостью 100 Н/м растянули на 4 см. Чему равна потенциальная энергия упругой деформации пружины? Ответ дайте в джоулях.","answers":["0,08"],"points":1,"kind":"number","explanation":"E = k · x² : 2 = 100 · 0,04² : 2 = 0,08 Дж."},
{"id":"physics-047","group":"z_work","number":3,"topic":"Законы сохранения в механике","text":"Подъёмник равномерно поднимает груз массой 3 кг на высоту 8 м за 4 с. Какую полезную мощность он развивает? Ускорение свободного падения считайте равным 10 м/с². Ответ дайте в ваттах.","answers":["60"],"points":1,"kind":"number","explanation":"N = m · g · h : t = 3 · 10 · 8 : 4 = 60 Вт."},
{"id":"physics-048","group":"z_inelastic","number":3,"topic":"Законы сохранения в механике","text":"Тележка массой 5 кг, движущаяся со скоростью 16 м/с, сталкивается с неподвижной тележкой массой 5 кг и сцепляется с ней. С какой скоростью будут двигаться тележки после сцепки? Ответ дайте в м/с.","answers":["8"],"points":1,"kind":"number","explanation":"По закону сохранения импульса 5 · 16 = (5 + 5) · u, откуда u = 8 м/с."},
{"id":"physics-049","group":"z_rebound","number":3,"topic":"Законы сохранения в механике","text":"Мяч массой 250 г, летящий со скоростью 6 м/с перпендикулярно стене, упруго отскакивает от неё с такой же по модулю скоростью. Чему равен модуль изменения импульса мяча? Ответ дайте в кг·м/с.","answers":["3"],"points":1,"kind":"number","explanation":"Импульс меняет направление на противоположное: Δp = 2 · m · v = 2 · 0,25 · 6 = 3 кг·м/с."},
