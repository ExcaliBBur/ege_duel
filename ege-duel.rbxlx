          <Properties>
            <string name="Name">02</string>
            <string name="Value">"kind":"number","explanation":"Сумма логарифмов равна логарифму произведения: log₃ 9 = 2."},
{"id":"math_prof-152","group":"t_trig","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения 12 sin (11π/12) · cos (11π/12).","answers":["-3"],"points":1,"kind":"number","explanation":"2 sin x cos x = sin 2x. Здесь sin 2x = -0,5, значение равно 6 · (-0,5) = -3."},
{"id":"math_prof-153","group":"t_powers","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения 2^(5/2) · 2^(1/2). Знак ^ означает возведение в степень.","answers":["8"],"points":1,"kind":"number","explanation":"При умножении показатели складываются: 5/2 + 1/2 = 3, 2³ = 8."},
{"id":"math_prof-154","group":"t_roots","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения 9√28 · √7.","answers":["126"],"points":1,"kind":"number","explanation":"√28 · √7 = √196 = 14, значение равно 9 · 14 = 126."},
{"id":"math_prof-155","group":"t_logs","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения (log₂ 8) · (log₃ 27).","answers":["9"],"points":1,"kind":"number","explanation":"log₂ 8 = 3, log₃ 27 = 3, произведение равно 9."},
{"id":"math_prof-156","group":"t_trig","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения 4 sin (11π/12) · cos (11π/12).","answers":["-1"],"points":1,"kind":"number","explanation":"2 sin x cos x = sin 2x. Здесь sin 2x = -0,5, значение равно 2 · (-0,5) = -1."},
{"id":"math_prof-157","group":"t_powers","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения (2⁶ · 5³) : 10³.","answers":["8"],"points":1,"kind":"number","explanation":"10³ = 2³ · 5³; остаётся 2³ · 5⁰ = 8."},
{"id":"math_prof-158","group":"t_roots","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения (√23 - √19)(√23 + √19).","answers":["4"],"points":1,"kind":"number","explanation":"По формуле разности квадратов: 23 - 19 = 4."},
{"id":"math_prof-159","group":"t_logs","number":8,"topic":"Вычисления и преобразования","text":"Найдите значение выражения log₄ 16.","answers":["2"],"points":1,"kind":"number","explanation":"16 = 2⁴, 4 = 2², логарифм равен 4 : 2 = 2."},
{"id":"math_prof-160","group":"t_trig","number":8,"topic":"Вычисления и преобразования","text":"Найдите tg α, если cos α = 5/13 и α ∈ (3π/2; 2π).","answers":["-2,4"],"points":1,"kind":"number","explanation":"sin²α = 1 - cos²α = 144/169; sin α = -12/13, tg α = sin α : cos α = -2,4."},
{"id":"math_prof-161","group":"d_physical","number":9,"topic":"Производная и первообразная","text":"Материальная точка движется прямолинейно по закону x(t) = 2t³ - 2t² + 11t + 8, где x это расстояние от точки отсчёта в метрах, t это время в секундах, измеренное с начала движения. В какой момент времени (в секундах) её скорость была равна 363 м/с?","answers":["8"],"points":1,"kind":"number","explanation":"v(t) = 6t² - 4t + 11 = 363; подходит неотрицательный корень t = 8."},
{"id":"math_prof-162","group":"d_parallel","number":9,"topic":"Производная и первообразная","text":"Прямая y = -7x - 3 параллельна касательной к графику функции y = -x² + 5x - 4. Найдите абсциссу точки касания.","answers":["6"],"points":1,"kind":"number","explanation":"Угловой коэффициент касательной равен производной: -2x + 5 = -7, откуда x = 6."},
{"id":"math_prof-163","group":"d_tangent_coefficient","number":9,"topic":"Производная и первообразная","text":"Прямая y = 10x - 5 является касательной к графику функции y = ax² + 6x + 5. Найдите a.","answers":["0,4"],"points":1,"kind":"number","explanation":"Уравнение ax² - 4x + 10 = 0 должно иметь один корень: дискриминант равен нулю, откуда a = 0,4."},
{"id":"math_prof-164","group":"d_graph_tangent","number":9,"topic":"Производная и первообразная","text":"На рисунке изображены график функции y = f(x) (чёрная линия) и касательная к нему в точке с абсциссой x₀ (цветная линия). На касательной отмечены три точки с целыми координатами, средняя из них является точкой касания. Найдите значение производной функции f(x) в точке x₀.","answers":["-1"],"points":1,"kind":"number","explanation":"Производная равна угловому коэффициенту касательной. При смещении на 4 вправо касательная поднимается на -4: k = -1.","figure":{"w":420,"h":260,"items":[["line",10.0,250.0,10.0,10.0,0],["line",30.0,250.0,30.0,10.0,0],["line",50.0,250.0,50.0,10.0,0],["line",70.0,250.0,70.0,10.0,0],["line",90.0,250.0,90.0,10.0,0],["line",110.0,250.0,110.0,10.0,0],["line",130.0,250.0,130.0,10.0,0],["line",150.0,250.0,150.0,10.0,0],["line",170.0,250.0,170.0,10.0,0],["line",190.0,250.0,190.0,10.0,0],["line",210.0,250.0,210.0,10.0,0],["line",230.0,250.0,230.0,10.0,0],["line",250.0,250.0,250.0,10.0,0],["line",270.0,250.0,270.0,10.0,0],["line",290.0,250.0,290.0,10.0,0],["line",310.0,250.0,310.0,10.0,0],["line",330.0,250.0,330.0,10.0,0],["line",350.0,250.0,350.0,10.0,0],["line",370.0,250.0,370.0,10.0,0],["line",390.0,250.0,390.0,10.0,0],["line",410.0,250.0,410.0,10.0,0],["line",10.0,250.0,410.0,250.0,0],["line",10.0,230.0,410.0,230.0,0],["line",10.0,210.0,410.0,210.0,0],["line",10.0,190.0,410.0,190.0,0],["line",10.0,170.0,410.0,170.0,0],["line",10.0,150.0,410.0,150.0,0],["line",10.0,130.0,410.0,130.0,0],["line",10.0,110.0,410.0,110.0,0],["line",10.0,90.0,410.0,90.0,0],["line",10.0,70.0,410.0,70.0,0],["line",10.0,50.0,410.0,50.0,0],["line",10.0,30.0,410.0,30.0,0],["line",10.0,10.0,410.0,10.0,0],["line",210.0,250.0,210.0,10.0,1],["text",219.0,14.0,"y","c"],["line",10.0,130.0,410.0,130.0,1],["text",406.0,140.0,"x","c"],["text",203.0,139.0,"0","c"],["text",230.0,139.0,"1","c"],["text",203.0,110.0,"1","c"],["line",190.0,190.0,193.1,183.8,1],["line",193.1,183.8,196.3,