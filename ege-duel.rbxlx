.8,1],["line",63.1,130.0,63.1,74.6,0],["circle",63.1,130.0,3.5,2],["text",63.1,142.0,"A","c"],["line",176.3,130.0,176.3,185.4,0],["circle",176.3,130.0,3.5,2],["text",176.3,118.0,"B","c"],["line",251.8,130.0,251.8,74.6,0],["circle",251.8,130.0,3.5,2],["text",251.8,142.0,"C","c"],["line",289.5,130.0,289.5,185.4,0],["circle",289.5,130.0,3.5,2],["text",289.5,118.0,"D","c"]]}},
{"id":"math_base-140","group":"b7_speed_intervals","number":7,"topic":"Анализ графиков и диаграмм","text":"На графике показано изменение температуры воздуха в течение 12 часов. По горизонтали указано время в часах, по вертикали температура в градусах Цельсия. Пользуясь графиком, поставьте в соответствие каждому интервалу времени характеристику изменения температуры на этом интервале. Запишите цифры в порядке букв АБВГ, без пробелов.\n\nА) 0:00-3:00\nБ) 3:00-6:00\nВ) 6:00-9:00\nГ) 9:00-12:00\n\n1) температура росла медленнее всего\n2) температура росла быстрее всего\n3) температура падала быстрее всего\n4) температура падала медленнее всего","answers":["1342"],"points":1,"kind":"order","explanation":"Скорость изменения температуры видна по наклону отрезка графика: чем круче, тем быстрее.","figure":{"w":420,"h":260,"items":[["line",46.0,228.0,46.0,28.0,0],["line",74.0,228.0,74.0,28.0,0],["line",102.0,228.0,102.0,28.0,0],["line",130.0,228.0,130.0,28.0,0],["text",130.0,241.0,"3","c"],["line",158.0,228.0,158.0,28.0,0],["line",186.0,228.0,186.0,28.0,0],["line",214.0,228.0,214.0,28.0,0],["text",214.0,241.0,"6","c"],["line",242.0,228.0,242.0,28.0,0],["line",270.0,228.0,270.0,28.0,0],["line",298.0,228.0,298.0,28.0,0],["text",298.0,241.0,"9","c"],["line",326.0,228.0,326.0,28.0,0],["line",354.0,228.0,354.0,28.0,0],["line",382.0,228.0,382.0,28.0,0],["text",382.0,241.0,"12","c"],["line",46.0,228.0,382.0,228.0,0],["line",46.0,218.0,382.0,218.0,0],["line",46.0,208.0,382.0,208.0,0],["text",38.0,208.0,"2","r"],["line",46.0,198.0,382.0,198.0,0],["line",46.0,188.0,382.0,188.0,0],["text",38.0,188.0,"4","r"],["line",46.0,178.0,382.0,178.0,0],["line",46.0,168.0,382.0,168.0,0],["text",38.0,168.0,"6","r"],["line",46.0,158.0,382.0,158.0,0],["line",46.0,148.0,382.0,148.0,0],["text",38.0,148.0,"8","r"],["line",46.0,138.0,382.0,138.0,0],["line",46.0,128.0,382.0,128.0,0],["text",38.0,128.0,"10","r"],["line",46.0,118.0,382.0,118.0,0],["line",46.0,108.0,382.0,108.0,0],["text",38.0,108.0,"12","r"],["line",46.0,98.0,382.0,98.0,0],["line",46.0,88.0,382.0,88.0,0],["text",38.0,88.0,"14","r"],["line",46.0,78.0,382.0,78.0,0],["line",46.0,68.0,382.0,68.0,0],["text",38.0,68.0,"16","r"],["line",46.0,58.0,382.0,58.0,0],["line",46.0,48.0,382.0,48.0,0],["text",38.0,48.0,"18","r"],["line",46.0,38.0,382.0,38.0,0],["line",46.0,28.0,382.0,28.0,0],["text",38.0,28.0,"20","r"],["line",46.0,228.0,393.2,228.0,1],["line",46.0,228.0,46.0,24.0,1],["text",38.0,241.0,"0","r"],["text",54.0,18.0,"°C","l"],["text",408.0,215.0,"ч","r"],["line",46.0,148.0,130.0,118.0,2],["line",130.0,118.0,214.0,178.0,2],["line",214.0,178.0,298.0,208.0,2],["line",298.0,208.0,382.0,148.0,2],["circle",46.0,148.0,3.5,2],["circle",130.0,118.0,3.5,2],["circle",214.0,178.0,3.5,2],["circle",298.0,208.0,3.5,2],["circle",382.0,148.0,3.5,2]]}},
{"id":"math_base-141","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 27 человек, из них 16 человек посещают кружок по физике, а 23 человек посещают кружок по химии. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Найдутся хотя бы 2 учеников из этого класса, которые посещают оба кружка.\n2) Если ученик из этого класса ходит на кружок по физике, то он обязательно ходит на кружок по химии.\n3) Не найдётся 17 учеников из этого класса, которые посещают оба кружка.\n4) Каждый ученик этого класса посещает оба кружка.","answers":["13"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 16 + 23 - 27 = 12 и не больше 16 учеников."},
{"id":"math_base-142","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Лена выше, чем Оля; Оля выше, чем Аня; Зина ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Аня выше, чем Лена.\n2) Зина и Аня одного роста.\n3) Оля ниже, чем Лена, но выше, чем Зина.\n4) Среди подруг есть хотя бы две, которые выше, чем Аня.","answers":["34"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Лена, Оля, Аня, Зина."},
{"id":"math_base-143","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в лагере, а некоторые у бабушки. Все сотрудники, которые не отдыхали у бабушки, отдыхали в лагере. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Если Борис не отдыхал ни в лагере, ни у бабушки, то он не является сотрудником этой фирмы.\n2) Каждый сотрудник этой фирмы отдыхал летом либо в лагере, либо у бабушки, либо и там, и там.\n3) Все сотрудники этой фирмы отдыхали у бабушки.\n4) Если Фаина не отдыхала ни в лагере, ни у бабушки, то она является сотрудником этой фирмы.","answers":["12"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-144","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 18 человек, из них 14 человек посещают кружок по шахматам, а 7 человек посещают кружок по рисованию. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Не найдётся 8 учеников из этого класса, которые посещают оба кружка.\n2) Не больше 7 учеников этого класса посещают оба кружка.\n3) Если ученик из этого класса ходит на кружок по шахматам, то он обязательно ходит на кружок по рисованию.\n4) В этом классе меньше 3 учеников посещают оба кружка.","answers":["12"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 14 + 7 - 18 = 3 и не больше 7 учеников."},
{"id":"math_base-145","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Аня выше, чем Зина; Зина выше, чем Катя; Вера ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Зина самая низкая из подруг.\n2) Вера и Катя одного роста.\n3) Зина ниже, чем Аня, но выше, чем Вера.\n4) Катя ниже, чем Аня.","answers":["34"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Аня, Зина, Катя, Вера."},
{"id":"math_base-146","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в лагере, а некоторые у бабушки. Все сотрудники, которые не отдыхали у бабушки, отдыхали в лагере. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Если Борис не отдыхал ни в лагере, ни у бабушки, то он не является сотрудником этой фирмы.\n2) Если Фаина не отдыхала ни в лагере, ни у бабушки, то она является сотрудником этой фирмы.\n3) Если сотрудник этой фирмы не отдыхал в лагере, то он отдыхал у бабушки.\n4) Сотрудник этой фирмы, который не отдыхал у бабушки, не отдыхал и в лагере.","answers":["13"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-147","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 21 человек, из них 16 человек посещают кружок по физике, а 13 человек посещают кружок по химии. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Каждый ученик этого класса посещает оба кружка.\n2) В этом классе меньше 8 учеников посещают оба кружка.\n3) Не больше 13 учеников этого класса посещают оба кружка.\n4) Найдутся хотя бы 7 учеников из этого класса, которые посещают оба кружка.","answers":["34"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 16 + 13 - 21 = 8 и не больше 13 учеников."},
{"id":"math_base-148","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Оля выше, чем Аня; Аня выше, чем Катя; Юля ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Катя ниже, чем Оля.\n2) Аня ниже, чем Оля, но выше, чем Юля.\n3) Аня самая низкая из подруг.\n4) Катя выше, чем Оля.","answers":["12"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Оля, Аня, Катя, Юля."},
{"id":"math_base-149","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в лагере, а некоторые у бабушки. Все сотрудники, которые не отдыхали у бабушки, отдыхали в лагере. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Если Фаина не отдыхала ни в лагере, ни у бабушки, то она является сотрудником этой фирмы.\n2) Каждый сотрудник этой фирмы отдыхал летом либо в лагере, либо у бабушки, либо и там, и там.\n3) Сотрудник этой фирмы, который не отдыхал у бабушки, не отдыхал и в лагере.\n4) Все сотрудники этой фирмы отдыхали у бабушки.","answers":["2"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-150","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 29 человек, из них 22 человек посещают кружок по шахматам, а 16 человек посещают кружок по рисованию. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Найдутся хотя бы 4 учеников из этого класса, которые посещают оба кружка.\n2) Каждый ученик этого класса посещает оба кружка.\n3) В этом классе меньше 9 учеников посещают оба кружка.\n4) Не больше 16 учеников этого класса посещают оба кружка.","answers":["14"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 22 + 16 - 29 = 9 и не больше 16 учеников."},
{"id":"math_base-151","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Маша выше, чем Аня; Аня выше, чем Оля; Вера ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Вера и Оля одного роста.\n2) Аня ниже, чем Маша, но выше, чем Вера.\n3) Оля ниже, чем Маша.\n4) Среди подруг есть хотя бы две, которые выше, чем Оля.","answers":["234"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Маша, Аня, Оля, Вера."},
{"id":"math_base-152","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали на даче, а некоторые на море. Все сотрудники, которые не отдыхали на море, отдыхали на даче. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Все сотрудники этой фирмы отдыхали на море.\n2) Сотрудник этой фирмы, который не отдыхал на море, не отдыхал и на даче.\n3) Каждый сотрудник этой фирмы отдыхал летом либо на даче, либо на море, либо и там, и там.\n4) Если Фаина не отдыхала ни на даче, ни на море, то она является сотрудником этой фирмы.","answers":["3"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-153","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 25 человек, из них 20 человек посещают кружок по шахматам, а 17 человек посещают кружок по рисованию. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Каждый ученик этого класса посещает оба кружка.\n2) Если ученик из этого класса ходит на кружок по шахматам, то он обязательно ходит на кружок по рисованию.\n3) Не больше 17 учеников этого класса посещают оба кружка.\n4) Не найдётся 18 учеников из этого класса, которые посещают оба кружка.","answers":["34"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 20 + 17 - 25 = 12 и не больше 17 учеников."},
{"id":"math_base-154","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Зина выше, чем Лена; Лена выше, чем Вера; Оля ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Оля и Вера одного роста.\n2) Зина самая высокая из подруг.\n3) Вера ниже, чем Зина.\n4) Вера выше, чем Зина.","answers":["23"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Зина, Лена, Вера, Оля."},
{"id":"math_base-155","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали на даче, а некоторые на море. Все сотрудники, которые не отдыхали на море, отдыхали на даче. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Если Фаина не отдыхала ни на даче, ни на море, то она является сотрудником этой фирмы.\n2) Сотрудник этой фирмы, который не отдыхал на море, не отдыхал и на даче.\n3) Если Борис не отдыхал ни на даче, ни на море, то он не является сотрудником этой фирмы.\n4) Все сотрудники этой фирмы отдыхали на море.","answers":["3"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-156","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 26 человек, из них 17 человек посещают кружок по физике, а 19 человек посещают кружок по химии. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Не найдётся 18 учеников из этого класса, которые посещают оба кружка.\n2) Не больше 17 учеников этого класса посещают оба кружка.\n3) Найдутся хотя бы 10 учеников из этого класса, которые посещают оба кружка.\n4) В этом классе меньше 10 учеников посещают оба кружка.","answers":["123"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 17 + 19 - 26 = 10 и не больше 17 учеников."},
{"id":"math_base-157","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Юля выше, чем Зина; Зина выше, чем Катя; Оля ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Зина ниже, чем Юля, но выше, чем Оля.\n2) Оля и Катя одного роста.\n3) Среди подруг есть хотя бы две, которые выше, чем Катя.\n4) Юля самая высокая из подруг.","answers":["134"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Юля, Зина, Катя, Оля."},
{"id":"math_base-158","group":"b8_implication","number":8,"topic":"Анализ утверждений","text":"Некоторые сотрудники фирмы летом отдыхали в лагере, а некоторые у бабушки. Все сотрудники, которые не отдыхали у бабушки, отдыхали в лагере. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Сотрудник этой фирмы, который не отдыхал у бабушки, не отдыхал и в лагере.\n2) Если сотрудник этой фирмы не отдыхал в лагере, то он отдыхал у бабушки.\n3) Если Борис не отдыхал ни в лагере, ни у бабушки, то он не является сотрудником этой фирмы.\n4) Если Фаина не отдыхала ни в лагере, ни у бабушки, то она является сотрудником этой фирмы.","answers":["23"],"points":1,"kind":"set","explanation":"Из условия следует: каждый сотрудник отдыхал хотя бы в одном из двух мест."},
{"id":"math_base-159","group":"b8_clubs","number":8,"topic":"Анализ утверждений","text":"В классе учится 22 человек, из них 12 человек посещают кружок по физике, а 14 человек посещают кружок по химии. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Не найдётся 13 учеников из этого класса, которые посещают оба кружка.\n2) Каждый ученик этого класса посещает оба кружка.\n3) В этом классе меньше 4 учеников посещают оба кружка.\n4) Если ученик из этого класса ходит на кружок по физике, то он обязательно ходит на кружок по химии.","answers":["1"],"points":1,"kind":"set","explanation":"Оба кружка посещают не меньше 12 + 14 - 22 = 4 и не больше 12 учеников."},
{"id":"math_base-160","group":"b8_order","number":8,"topic":"Анализ утверждений","text":"Среди четырёх подруг Катя выше, чем Зина; Зина выше, чем Оля; Маша ниже всех остальных. Выберите утверждения, которые верны при указанных условиях. В ответе запишите номера выбранных утверждений без пробелов и запятых.\n\n1) Зина самая низкая из подруг.\n2) Оля ниже, чем Катя.\n3) Оля выше, чем Катя.\n4) Среди подруг есть хотя бы две, которые выше, чем Оля.","answers":["24"],"points":1,"kind":"set","explanation":"По росту подруги идут так: Катя, Зина, Оля, Маша."},
{"id":"math_base-161","group":"b9_triangle","number":9,"topic":"Задачи на квадратной решётке","text":"На клетчатой бумаге с размером клетки 1 × 1 изображён треугольник. Найдите его площадь.","answers":["5"],"points":1,"kind":"number","explanation":"Площадь можно найти как площадь описанного прямоугольника минус площади лишних прямоугольных треугольников. Получается 5.","figure":{"w":420,"h":260,"items":[["line",30.0,235.0,30.0,25.0,0],["line",60.0,235.0,60.0,25.0,0],["line",90.0,235.0,90.0,25.0,0],["line",120.0,235.0,120.0,25.0,0],["line",150.0,235.0,150.0,25.0,0],["line",180.0,235.0,180.0,25.0,0],["line",210.0,235.0,210.0,25.0,0],["line",240.0,235.0,240.0,25.0,0],["line",270.0,235.0,270.0,25.0,0],["line",300.0,235.0,300.0,25.0,0],["line",330.0,235.0,330.0,25.0,0],["line",360.0,235.0,360.0,25.0,0],["line",390.0,235.0,390.0,25.0,0],["line",30.0,235.0,390.0,235.0,0],["line",30.0,205.0,390.0,205.0,0],["line",30.0,175.0,390.0,175.0,0],["line",30.0,145.0,390.0,145.0,0],["line",30.0,115.0,390.0,115.0,0],["line",30.0,85.0,390.0,85.0,0],["line",30.0,55.0,390.0,55.0,0],["line",30.0,25.0,390.0,25.0,0],["line",30.0,235.0,180.0,85.0,2],["line",180.0,85.0,90.0,235.0,2],["line",90.0,235.0,30.0,235.0,2]]}},
{"id":"math_base-162","group":"b9_trapezoid","number":9,"topic":"Задачи на квадратной решётке","text":"На клетчатой бумаге с размером клетки 1 × 1 изображена трапеция. Найдите её площадь.","answers":["26"],"points":1,"kind":"number","explanation":"Основания равны 10 и 3, высота 4. Площадь равна (10 + 3) : 2 · 4 = 26.","figure":{"w":420,"h":260,"items":[["line",30.0,235.0,30.0,25.0,0],["line",60.0,235.0,60.0,25.0,0],["line",90.0,235.0,90.0,25.0,0],["line",120.0,235.0,120.0,25.0,0],["line",150.0,235.0,150.0,25.0,0],["line",180.0,235.0,180.0,25.0,0],["line",210.0,235.0,210.0,25.0,0],["line",240.0,235.0,240.0,25.0,0],["line",270.0,235.0,270.0,25.0,0],["line",300.0,235.0,300.0,25.0,0],["line",330.0,235.0,330.0,25.0,0],["line",360.0,235.0,360.0,25.0,0],["line",390.0,235.0,390.0,25.0,0],["line",30.0,235.0,390.0,235.0,0],["line",30.0,205.0,390.0,205.0,0],["line",30.0,175.0,390.0,175.0,0],["line",30.0,145.0,390.0,145.0,0],["line",30.0,115.0,390.0,115.0,0],["line",30.0,85.0,390.0,85.0,0],["line",30.0,55.0,390.0,55.0,0],["line",30.0,25.0,390.0,25.0,0],["line",60.0,145.0,360.0,145.0,2],["line",360.0,145.0,360.0,25.0,2],["line",360.0,25.0,270.0,25.0,2],["line",270.0,25.0,60.0,145.0,2]]}},
