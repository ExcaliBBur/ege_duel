{"id":"chemistry-181","group":"fig_skeleton","text":"На рисунке показан углеродный скелет молекулы углеводорода. Двойная линия обозначает двойную связь. Все остальные валентности углерода заняты атомами водорода. Сколько атомов водорода в молекуле этого вещества?","answers":["14"],"points":1,"kind":"number","explanation":"Атомов углерода 6, двойных связей нет: это алкан, водорода 2 · 6 + 2 = 14.","figure":{"w":420,"h":260,"items":[["line",114.0,150.0,162.0,110.0,1],["line",162.0,110.0,210.0,150.0,1],["line",210.0,150.0,258.0,110.0,1],["line",258.0,110.0,306.0,150.0,1],["line",162.0,110.0,162.0,64.0,1],["circle",162.0,64.0,11.0,1],["text",162.0,64.0,"C","c"],["circle",114.0,150.0,11.0,1],["text",114.0,150.0,"C","c"],["circle",162.0,110.0,11.0,1],["text",162.0,110.0,"C","c"],["circle",210.0,150.0,11.0,1],["text",210.0,150.0,"C","c"],["circle",258.0,110.0,11.0,1],["text",258.0,110.0,"C","c"],["circle",306.0,150.0,11.0,1],["text",306.0,150.0,"C","c"]]}},
