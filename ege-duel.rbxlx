{"id":"informatics-023","group":"l_truth_table","number":2,"topic":"Таблицы истинности логических выражений","text":"Логическая функция F задаётся выражением (x → w) ∧ (w → z) ∧ (z → y). На рисунке приведён фрагмент таблицы истинности функции F, содержащий все наборы аргументов, при которых функция истинна. Определите, какому столбцу таблицы соответствует каждая из переменных w, x, y, z. В ответе запишите буквы w, x, y, z в том порядке, в котором идут соответствующие им столбцы, без пробелов и запятых.","answers":["zwxy"],"points":1,"kind":"exact","explanation":"Функция истинна на 5 наборах; сравнивая их со строками таблицы, получаем порядок столбцов zwxy.","figure":{"w":380,"h":212,"items":[["line",10.0,10.0,370.0,10.0,1],["line",10.0,42.0,370.0,42.0,0],["line",10.0,74.0,370.0,74.0,0],["line",10.0,106.0,370.0,106.0,0],["line",10.0,138.0,370.0,138.0,0],["line",10.0,170.0,370.0,170.0,0],["line",10.0,202.0,370.0,202.0,1],["line",10.0,10.0,10.0,202.0,1],["line",82.0,10.0,82.0,202.0,1],["line",154.0,10.0,154.0,202.0,0],["line",226.0,10.0,226.0,202.0,0],["line",298.0,10.0,298.0,202.0,0],["line",370.0,10.0,370.0,202.0,1],["text",46.0,26.0,"Перем. 1","c"],["text",118.0,26.0,"Перем. 2","c"],["text",190.0,26.0,"Перем. 3","c"],["text",262.0,26.0,"Перем. 4","c"],["text",334.0,26.0,"F","c"],["text",46.0,58.0,"0","c"],["text",118.0,58.0,"0","c"],["text",190.0,58.0,"0","c"],["text",262.0,58.0,"0","c"],["text",334.0,58.0,"1","c"],["text",46.0,90.0,"1","c"],["text",118.0,90.0,"0","c"],["text",190.0,90.0,"0","c"],["text",262.0,90.0,"1","c"],["text",334.0,90.0,"1","c"],["text",46.0,122.0,"0","c"],["text",118.0,122.0,"0","c"],["text",190.0,122.0,"0","c"],["text",262.0,122.0,"1","c"],["text",334.0,122.0,"1","c"],["text",46.0,154.0,"1","c"],["text",118.0,154.0,"1","c"],["text",190.0,154.0,"1","c"],["text",262.0,154.0,"1","c"],["text",334.0,154.0,"1","c"],["text",46.0,186.0,"1","c"],["text",118.0,186.0,"1","c"],["text",190.0,186.0,"0","c"],["text",262.0,186.0,"1","c"],["text",334.0,186.0