{"id":"biology-191","group":"fig_dna","text":"На рисунке показана последовательность нуклеотидов одной цепи ДНК. Запишите последовательность иРНК, которая синтезируется на этой цепи. Буквы записывайте подряд, без пробелов.","answers":["ЦААУЦГУАА"],"points":1,"kind":"exact","explanation":"По правилу комплементарности: А соединяется с У, Т с А, Г с Ц, Ц с Г. Получается ЦААУЦГУАА.","figure":{"w":420,"h":110,"items":[["line",48.0,35.0,84.0,35.0,1],["line",84.0,35.0,84.0,75.0,1],["line",84.0,75.0,48.0,75.0,1],["line",48.0,75.0,48.0,35.0,1],["text",66.0,55.0,"Г","c"],["line",84.0,35.0,120.0,35.0,1],["line",120.0,35.0,120.0,75.0,1],["line",120.0,75.0,84.0,75.0,1],["line",84.0,75.0,84.0,35.0,1],["text",102.0,55.0,"Т","c"],["line",120.0,35.0,156.0,35.0,1],["line",156.0,35.0,156.0,75.0,1],["line",156.0,75.0,120.0,75.0,1],["line",120.0,75.0,120.0,35.0,1],["text",138.0,55.0,"Т","c"],["line",156.0,35.0,192.0,35.0,1],["line",192.0,35.0,192.0,75.0,1],["line",192.0,75.0,156.0,75.0,1],["line",156.0,75.0,156.0,35.0,1],["text",174.0,55.0,"А","c"],["line",192.0,35.0,228.0,35.0,1],["line",228.0,35.0,228.0,75.0,1],["line",228.0,75.0,192.0,75.0,1],["line",192.0,75.0,192.0,35.0,1],["text",210.0,55.0,"Г","c"],["line",228.0,35.0,264.0,35.0,1],["line",264.0,35.0,264.0,75.0,1],["line",264.0,75.0,228.0,75.0,1],["line",228.0,75.0,228.0,35.0,1],["text",246.0,55.0,"Ц","c"],["line",264.0,35.0,300.0,35.0,1],["line",300.0,35.0,300.0,75.0,1],["line",300.0,75.0,264.0,75.0,1],["line",264.0,75.0,264.0,35.0,1],["text",282.0,55.0,"А","c"],["line",300.0,35.0,336.0,35.0,1],["line",336.0,35.0,336.0,75.0,1],["line",336.0,75.0,300.0,75.0,1],["line",300.0,75.0,300.0,35.0,1],["text",318.0,55.0,"Т","c"],["line",336.0,35.0,372.0,35.0,1],["line",372.0,35.0,372.0,75.0,1],["line",372.0,75.0,336.0,75.0,1],["line",336.0,75.0,336.0,35.0,1],["text",354.0,55.0,"Т","c"]]}},
{"id":"biology-192","group":"fig_dna","text":"На рисунке показана последовательность нуклеотидов одной цепи ДНК. Запишите последовательность второй цепи ДНК. Буквы записывайте подряд, без пробелов.","answers":["АГГТАТЦТГТ"],"points":1,"kind":"exact","explanation":"По правилу комплементарности: А соединяется с Т, Т с А, Г с Ц, Ц с Г. Получается АГГТАТЦТГТ.","figure":{"w":420,"h":110,"items":[["line",30.0,35.0,66.0,35.0,1],["line",66.0,35.0,66.0,75.0,1],["line",66.0,75.0,30.0,75.0,1],["line",30.0,75.0,30.0,35.0,1],["text",48.0,55.0,"Т","c"],["line",66.0,35.0,102.0,35.0,1],["line",102.0,35.0,102.0,75.0,1],["line",102.0,75.0,66.0,75.0,1],["line",66.0,75.0,66.0,35.0,1],["text",84.0,55.0,"Ц","c"],["line",102.0,35.0,138.0,35.0,1],["line",138.0,35.0,138.0,75.0,1],["line",138.0,75.0,102.0,75.0,1],["line",102.0,75.0,102.0,35.0,1],["text",120.0,55.0,"Ц","c"],["line",138.0,35.0,174.0,35.0,1],["line",174.0,35.0,174.0,75.0,1],["line",174.0,75.0,138.0,75.0,1],["line",138.0,75.0,138.0,35.0,1],["text",156.0,55.0,"А","c"],["line",174.0,35.0,210.0,35.0,1],["line",210.0,35.0,210.0,75.0,1],["line",210.0,75.0,174.0,75.0,1],["line",174.0,75.0,174.0,35.0,1],["text",192.0,55.0,"Т","c"],["line",210.0,35.0,246.0,35.0,1],["line",246.0,35.0,246.0,75.0,1],["line",246.0,75.0,210.0,75.0,1],["line",210.0,75.0,210.0,35.0,1],["text",228.0,55.0,"А","c"],["line",246.0,35.0,282.0,35.0,1],["line",282.0,35.0,282.0,75.0,1],["line",282.0,75.0,246.0,75.0,1],["line",246.0,75.0,246.0,35.0,1],["text",264.0,55.0,"Г","c"],["line",282.0,35.0,318.0,35.0,1],["line",318.0,35.0,318.0,75.0,1],["line",318.0,75.0,282.0,75.0,1],["line",282.0,75.0,282.0,35.0,1],["text",300.0,55.0,"А","c"],["line",318.0,35.0,354.0,35.0,1],["line",354.0,35.0,354.0,75.0,1],["line",354.0,75.0,318.0,75.0,1],["line",318.0,75.0,318.0,35.0,1],["text",336.0,55.0,"Ц","c"],["line",354.0,35.0,390.0,35.0,1],["line",390.0,35.0,390.0,75.0,1],["line",390.0,75.0,354.0,75.0,1],["line",354.0,75.0,354.0,35.0,1],["text",372.0,55.0,"А","c"]]}}
